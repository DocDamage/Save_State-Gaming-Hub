      "",
      "namespace ${1:Namespace}.Commands;",
      "",
      "/// <summary>",
      "/// Command to ${2:description}",
      "/// </summary>",
      "public sealed record ${3:CommandName}Command(${4:parameters}) : IRequest<Result<${5:int}>>;",
      "",
      "/// <summary>",
      "/// Handler for ${3}Command",
      "/// </summary>",
      "public sealed class ${3}CommandHandler : IRequestHandler<${3}Command, Result<${5}>>",
      "{",
      "    private readonly I${6:Repository} _repository;",
      "    private readonly ILogger<${3}CommandHandler> _logger;",
      "",
      "    public ${3}CommandHandler(I${6} repository, ILogger<${3}CommandHandler> logger)",
      "    {",
      "        _repository = repository;",
      "        _logger = logger;",
      "    }",
      "",
      "    public async Task<Result<${5}>> Handle(${3}Command request, CancellationToken ct)",
      "    {",
      "        try",
      "        {",
      "            ${7:// Implementation}",
      "            ",
      "            _logger.LogInformation(\"${3} executed successfully\");",
      "            return Result<${5}>.Success(result);",
      "        }",
      "        catch (Exception ex)",
      "        {",
      "            _logger.LogError(ex, \"${3} failed\");",
      "            return Result<${5}>.Failure($\"Error: {ex.Message}\", ErrorType.Internal);",
      "        }",
      "    }",
      "}"
    ]
  },
  
  "CQRS Query Handler": {
    "prefix": "query-handler",
    "description": "Create a CQRS Query Handler with Result pattern",
    "body": [
      "using MediatR;",
      "using SaveState.Core.Common;",
      "",
      "namespace ${1:Namespace}.Queries;",
      "",
      "/// <summary>",
      "/// Query to ${2:description}",
      "/// </summary>",
      "public sealed record Get${3:Entity}Query(${4:Guid Id}) : IRequest<Result<${5:EntityDto}>>;",
      "",
      "/// <summary>",
      "/// Handler for Get${3}Query",
      "/// </summary>",
      "public sealed class Get${3}QueryHandler : IRequestHandler<Get${3}Query, Result<${5}>>",
      "{",
      "    private readonly I${6:Repository} _repository;",
      "    private readonly ILogger<Get${3}QueryHandler> _logger;",
      "",
      "    public Get${3}QueryHandler(I${6} repository, ILogger<Get${3}QueryHandler> logger)",
      "    {",
      "        _repository = repository;",
      "        _logger = logger;",
      "    }",
      "",
      "    public async Task<Result<${5}>> Handle(Get${3}Query request, CancellationToken ct)",
      "    {",
      "        try",
      "        {",
      "            var entity = await _repository.GetByIdAsync(request.Id, ct);",
      "            ",
      "            if (entity == null)",
      "            {",
      "                _logger.LogWarning(\"${3} {Id} not found\", request.Id);",
      "                return Result<${5}>.Failure($\"${3} {request.Id} not found\", ErrorType.NotFound);",
      "            }",
      "            ",
      "            var dto = MapToDto(entity);",
      "            return Result<${5}>.Success(dto);",
      "        }",
      "        catch (Exception ex)",
      "        {",
      "            _logger.LogError(ex, \"Failed to get ${3} {Id}\", request.Id);",
      "            return Result<${5}>.Failure($\"Error: {ex.Message}\", ErrorType.Internal);",
      "        }",
      "    }",
      "",
      "    private static ${5} MapToDto(${7:Entity} entity)",
      "    {",
      "        return new ${5}",
      "        {",
      "            ${8:// Map properties}",
      "        };",
      "    }",
      "}"
    ]
  },
  
  "Entity Factory Method": {
    "prefix": "entity-factory",
    "description": "Create entity factory method with Guard clauses",
    "body": [
      "/// <summary>",
      "/// Creates a new ${1:Entity}",
      "/// </summary>",
      "/// <exception cref=\"ArgumentException\">Thrown when validation fails</exception>",
      "public static ${1} Create(${2:string name}, ${3:parameters})",
      "{",
      "    return new ${1}",
      "    {",
      "        Id = Guid.NewGuid(),",
      "        Name = Guard.Against.NullOrWhiteSpace(name, nameof(name)),",
      "        ${4:// Set other properties}",
      "        CreatedAt = DateTime.UtcNow",
      "    };",
      "}"
    ]
  },
  
  "Plugin Class": {
    "prefix": "plugin-class",
    "description": "Create a new plugin class implementing IPlugin",
    "body": [
      "using Microsoft.Extensions.DependencyInjection;",
      "using Microsoft.Extensions.Logging;",
      "using SaveState.Core.Common.Services;",
      "using SaveState.Core.Plugins;",
      "",
      "namespace SaveState.Plugins.${1:Category};",
      "",
      "/// <summary>",
      "/// ${2:Description}",
      "/// </summary>",
      "public class ${3:PluginName}Plugin : IPlugin",
      "{",
      "    private IPluginContext? _context;",
      "    private ILogger? _logger;",
      "    private ITimeProvider _timeProvider = null!;",
      "",
      "    public string Id => \"savestate.${4:category}.${5:name}\";",
      "    public string Name => \"${6:Display Name}\";",
      "    public string Version => \"1.0.0\";",
      "    public string Author => \"SaveState Team\";",
      "    public string? Description => \"${2}\";",
      "    public PluginCapabilities Capabilities => PluginCapabilities.${7:UIExtension};",
      "",
      "    public async Task InitializeAsync(IPluginContext context, CancellationToken ct = default)",
      "    {",
      "        _context = context;",
      "        _logger = context.Logger;",
      "        _timeProvider = context.Services.GetRequiredService<ITimeProvider>();",
      "",
      "        _logger.LogInformation(\"Initializing {PluginName}\", Name);",
      "",
      "        ${8:// Register menu items, commands, etc.}",
      "",
      "        _logger.LogInformation(\"{PluginName} initialized successfully\", Name);",
      "    }",
      "",
      "    public Task ShutdownAsync(CancellationToken ct = default)",
      "    {",
      "        _logger?.LogInformation(\"Shutting down {PluginName}\", Name);",
      "        return Task.CompletedTask;",
      "    }",
      "}"
    ]
  },
  
  "Repository Method": {
    "prefix": "repo-method",
    "description": "Create a repository method with Result pattern",
    "body": [
      "/// <summary>",
      "/// ${4:Description}",
      "/// </summary>",
      "public async Task<Result<${1:Entity}>> ${2:GetById}Async(${3:Guid id}, CancellationToken ct = default)",
      "{",
      "    var entity = await _dbContext.${1}s",
      "        .AsNoTracking()",
      "        .FirstOrDefaultAsync(e => e.Id == id, ct);",
      "    ",
      "    if (entity == null)",
      "    {",
      "        return Result<${1}>.Failure($\"${1} {id} not found\", ErrorType.NotFound);",
      "    }",
      "    ",
      "    return Result<${1}>.Success(entity);",
      "}"
    ]
  },
  
