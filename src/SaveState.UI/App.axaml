<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SaveState.UI.App"
             xmlns:local="clr-namespace:SaveState.UI"
             xmlns:vm="clr-namespace:SaveState.UI.ViewModels"
             xmlns:views="clr-namespace:SaveState.UI.Views"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <DataTemplate DataType="vm:GameGridViewModel">
            <views:GameGridView/>
        </DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel">
            <views:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="vm:GameDetailsViewModel">
            <views:GameDetailsView/>
        </DataTemplate>
        <DataTemplate DataType="vm:RomManagerViewModel">
            <views:RomManagerView/>
        </DataTemplate>
        <DataTemplate DataType="vm:AiAssistantViewModel">
            <views:AiAssistantView/>
        </DataTemplate>
        <DataTemplate DataType="vm:StatisticsViewModel">
            <views:StatisticsView/>
        </DataTemplate>
        <DataTemplate DataType="vm:CollectionsViewModel">
            <views:CollectionsView/>
        </DataTemplate>
        <DataTemplate DataType="vm:KnowledgeViewModel">
            <views:KnowledgeView/>
        </DataTemplate>
    </Application.DataTemplates>

    <Application.Resources>
        <StreamGeometry x:Key="library_regular">M19,15V3H5V15H19M19,17H5A2,2 0 0,1 3,15V3A2,2 0 0,1 5,1H19A2,2 0 0,1 21,3V15A2,2 0 0,1 19,17M7,21H17V19H7V21M7,24H17V22H7V24Z</StreamGeometry>
        <StreamGeometry x:Key="collections_regular">M15,9H5V5H15M12,19V17H12L12,18H5V14H12L12,15H12V13H5V9H12L12,10H15V13H15V11H18V14L15,14V12H15V15H12V15L12,16H18V19H12Z</StreamGeometry>
