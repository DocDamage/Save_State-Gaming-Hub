<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SaveState.UI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="SaveState.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="SaveState Reborn"
        Background="#121212"
        Foreground="White"
        WindowStartupLocation="CenterScreen">


    <Grid ColumnDefinitions="Auto, *">
        <!-- Sidebar -->
        <Border Grid.Column="0" 
                Width="240" 
                Background="#1E1E1E"
                IsVisible="{Binding IsSidebarOpen}">
            <StackPanel Spacing="5" Margin="10">
                <TextBlock Text="SAVESTATE" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           Margin="10,20,10,40"
                           Foreground="#BB86FC"/>
                
                <Button Command="{Binding NavigateCommand}" CommandParameter="Library" Classes="nav-btn">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <PathIcon Data="{DynamicResource library_regular}"/>
                        <TextBlock Text="Library"/>
                    </StackPanel>
                </Button>
                
                <Button Command="{Binding NavigateCommand}" CommandParameter="Collections" Classes="nav-btn">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <PathIcon Data="{DynamicResource collections_regular}"/>
                        <TextBlock Text="Collections"/>
                    </StackPanel>
                </Button>
                
                <Button Command="{Binding NavigateCommand}" CommandParameter="Collections" Classes="nav-btn">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="📁"/>
                        <TextBlock Text="Collections"/>
                    </StackPanel>
                </Button>
                
                <Separator Margin="0,10"/>
                
                <Button Command="{Binding ScanLibrariesCommand}" 
                        Classes="nav-btn"
                        IsEnabled="{Binding !IsScanning}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="🔍"/>
                        <TextBlock Text="Scan Libraries"/>
                    </StackPanel>
                </Button>
                
                <Button Command="{Binding NavigateCommand}" CommandParameter="ROMs" Classes="nav-btn">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="🕹️"/>
                        <TextBlock Text="ROMs"/>
                    </StackPanel>
                </Button>
                
                <Button Command="{Binding NavigateCommand}" CommandParameter="AI" Classes="nav-btn">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="🤖"/>
                        <TextBlock Text="AI Assistant"/>
                    </StackPanel>
                </Button>
                
                <Button Command="{Binding NavigateCommand}" CommandParameter="Stats" Classes="nav-btn">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="📊"/>
                        <TextBlock Text="Statistics"/>
                    </StackPanel>
                </Button>
                
                <Button Command="{Binding NavigateCommand}" CommandParameter="Settings" Classes="nav-btn">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="⚙️"/>
                        <TextBlock Text="Settings"/>
                    </StackPanel>
                </Button>
                
                <Button Command="{Binding NavigateCommand}" CommandParameter="AiSettings" Classes="nav-btn">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="🧠"/>
                        <TextBlock Text="AI Config"/>
                    </StackPanel>
                </Button>
                
                <Separator Margin="0,10"/>
                <TextBlock Text="GAMIFICATION" FontSize="11" FontWeight="SemiBold" Opacity="0.6" Margin="15,5,0,5"/>
                
                <Button Command="{Binding NavigateCommand}" CommandParameter="Achievements" Classes="nav-btn">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="🏆"/>
                        <TextBlock Text="Achievements"/>
                    </StackPanel>
                </Button>
                
                <Button Command="{Binding NavigateCommand}" CommandParameter="Challenges" Classes="nav-btn">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="🎯"/>
                        <TextBlock Text="Challenges"/>
                    </StackPanel>
                </Button>
                
                <Separator Margin="0,10"/>
                <TextBlock Text="MUGEN" FontSize="11" FontWeight="SemiBold" Opacity="0.6" Margin="15,5,0,5"/>
                
                <Button Command="{Binding NavigateCommand}" CommandParameter="Mugen" Classes="nav-btn">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="🎮"/>
                        <TextBlock Text="MUGEN Player"/>
                    </StackPanel>
                </Button>
                
                <Button Command="{Binding NavigateCommand}" CommandParameter="Fusion" Classes="nav-btn">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="✨"/>
                        <TextBlock Text="Character Fusion"/>
                    </StackPanel>
                </Button>
                
                <Button Command="{Binding NavigateCommand}" CommandParameter="Battle" Classes="nav-btn">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="⚔️"/>
                        <TextBlock Text="Cross-Game Battle"/>
                    </StackPanel>
                </Button>
                
                <Separator Margin="0,10"/>
                <TextBlock Text="EMULATOR SUITE" FontSize="11" FontWeight="SemiBold" Opacity="0.6" Margin="15,5,0,5"/>
                
                <Button Command="{Binding NavigateCommand}" CommandParameter="Rewind" Classes="nav-btn">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="⏪"/>
                        <TextBlock Text="Retro Rewind"/>
                    </StackPanel>
                </Button>
                
                <Button Command="{Binding NavigateCommand}" CommandParameter="Shaders" Classes="nav-btn">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="🎨"/>
                        <TextBlock Text="Shader Studio"/>
                    </StackPanel>
                </Button>
                
                <Button Command="{Binding NavigateCommand}" CommandParameter="Evolution" Classes="nav-btn">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="🧬"/>
                        <TextBlock Text="Memory Evolution"/>
                    </StackPanel>
                </Button>
                
                <Button Command="{Binding NavigateCommand}" CommandParameter="Dream" Classes="nav-btn">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="💭"/>
                        <TextBlock Text="Dream Sequence"/>
                    </StackPanel>
                </Button>
                
                <Button Command="{Binding NavigateCommand}" CommandParameter="Capsule" Classes="nav-btn">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="⏰"/>
                        <TextBlock Text="Time Capsule"/>
                    </StackPanel>
                </Button>
                
                <Button Command="{Binding NavigateCommand}" CommandParameter="Commentary" Classes="nav-btn">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="🎙️"/>
                        <TextBlock Text="Live Commentary"/>
                    </StackPanel>
                </Button>
                
                <TextBlock Text="{Binding StatusMessage}" 
                           FontSize="11" 
                           Opacity="0.7"
                           TextWrapping="Wrap"
                           Margin="5,10,5,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1" RowDefinitions="Auto, *">
            <!-- Header / Search -->
            <Border Grid.Row="0" Height="60" Background="#181818" Padding="20,0">
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <Button Grid.Column="0" 
                            Command="{Binding ToggleSidebarCommand}"
                            Background="Transparent"
                            BorderThickness="0">
                        <PathIcon Data="{DynamicResource line_horizontal_3_regular}"/>
                    </Button>
                    
                    <TextBox Grid.Column="1" 
                             Width="400" 
                             Margin="20,0"
                             Watermark="Search games..."
                             Text="{Binding SearchText}"
                             Classes="search-box"/>
                             
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                        <TextBlock Text="User Name" VerticalAlignment="Center"/>
                        <Ellipse Width="32" Height="32" Fill="#3700B3"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Page Content -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}">
            </ContentControl>
        </Grid>
    </Grid>

</Window>
