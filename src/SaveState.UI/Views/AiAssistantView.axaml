<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SaveState.UI.ViewModels"
             x:Class="SaveState.UI.Views.AiAssistantView"
             x:DataType="vm:AiAssistantViewModel">
    <UserControl.Styles>
        <Style Selector="Border.user">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Background" Value="#BB86FC"/>
            <Setter Property="CornerRadius" Value="10,10,0,10"/>
        </Style>
        <Style Selector="Border.ai">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="CornerRadius" Value="10,10,10,0"/>
        </Style>
        <Style Selector="Button.listening">
            <Setter Property="Background" Value="#CF6679"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, *, Auto">
        <!-- Header -->
        <Border Grid.Row="0" Background="#181818" Padding="20,15">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="🤖 AI Gaming Assistant" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="Chat, get recommendations, and gaming tips" 
                               Opacity="0.6" FontSize="13"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Button Content="Get Recommendations"
                            Command="{Binding GetRecommendationsCommand}"
                            IsEnabled="{Binding !IsLoading}"
                            Background="#BB86FC"
                            Foreground="White"
                            Padding="15,8"/>
                    <Button Content="Clear Chat"
                            Command="{Binding ClearChatCommand}"
                            Background="#2A2A2A"
                            Padding="15,8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" ColumnDefinitions="*, 300">
            <!-- Chat Area -->
            <Border Grid.Column="0" Background="#1E1E1E" Margin="0,0,10,0">
                <Grid RowDefinitions="*, Auto">
                    <!-- Messages -->
                    <ScrollViewer Grid.Row="0" Padding="20">
                        <ItemsControl ItemsSource="{Binding Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,5"
                                            Padding="15,10"
                                            CornerRadius="10"
                                            MaxWidth="600"
                                            Classes.user="{Binding IsUser}"
                                            Classes.ai="{Binding !IsUser}">
                                        <TextBlock Text="{Binding Content}" 
                                                   TextWrapping="Wrap"
                                                   Foreground="White"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Loading indicator -->
                    <Border Grid.Row="0" 
                            IsVisible="{Binding IsLoading}"
                            Background="#80000000"
                            VerticalAlignment="Bottom"
                            Padding="20">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                            <ProgressBar IsIndeterminate="True" Width="100"/>
                            <TextBlock Text="Thinking..." Foreground="#03DAC6"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Recommendations Panel -->
            <Border Grid.Column="1" Background="#2A2A2A" CornerRadius="10" Padding="15">
                <Grid RowDefinitions="Auto, *">
                    <TextBlock Grid.Row="0" Text="🎯 Recommendations" FontWeight="SemiBold" 
                               FontSize="16" Margin="0,0,0,15"/>
                    
                    <ScrollViewer Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding Recommendations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1E1E1E" 
                                            CornerRadius="8" 
                                            Padding="12" 
                                            Margin="0,0,0,10">
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="{Binding Title}" 
                                                       FontWeight="Bold"
                                                       Foreground="#BB86FC"/>
                                            <Border Background="#3A3A3A" 
                                                    CornerRadius="3" 
                                                    Padding="6,2"
                                                    HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Genre}" 
                                                           FontSize="10"/>
                                            </Border>
                                            <TextBlock Text="{Binding Reason}" 
                                                       TextWrapping="Wrap"
                                                       FontSize="12"
                                                       Opacity="0.8"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    
                    <!-- Empty state -->
                    <StackPanel Grid.Row="1" 
                                IsVisible="{Binding !Recommendations.Count}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="10">
                        <TextBlock Text="🎮" FontSize="32" HorizontalAlignment="Center"/>
                        <TextBlock Text="Click 'Get Recommendations'" 
                                   Opacity="0.5" 
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Input Area -->
        <Border Grid.Row="2" Background="#181818" Padding="20,15">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <Button Grid.Column="0"
                        Command="{Binding ToggleListeningCommand}"
                        Classes.listening="{Binding IsListening}"
                        Margin="0,0,10,0"
                        Width="40" Height="40"
                        Background="#333333">
                    <TextBlock Text="🎤" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                
                <TextBox Grid.Column="1"
                         Text="{Binding UserMessage}"
                         Watermark="Ask me anything about games..."
                         Height="40"
                         Margin="0,0,10,0"/>
                <Button Grid.Column="2"
                        Content="Send"
                        Command="{Binding SendMessageCommand}"
                        IsEnabled="{Binding !IsLoading}"
                        Background="#03DAC6"
                        Foreground="#1E1E1E"
                        FontWeight="Bold"
                        Width="80"
                        Height="40"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
