<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SaveState.UI.ViewModels"
             x:Class="SaveState.UI.Views.RetroRewindView"
             x:DataType="vm:RetroRewindViewModel">
    
    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="⏪ Retro Rewind" FontSize="28" FontWeight="Bold" 
                       Foreground="{DynamicResource BrandPrimaryBrush}"/>
            <TextBlock Text="Time-travel debugging with frame-by-frame control" 
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1" ColumnDefinitions="2*,*">
            <!-- Rewind Controls -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" 
                    CornerRadius="12" Padding="20" Margin="0,0,10,0">
                <StackPanel Spacing="20">
                    <!-- Session Status -->
                    <Border Background="{DynamicResource SurfaceLightBrush}" CornerRadius="8" Padding="15">
                        <StackPanel>
                            <TextBlock Text="Session Status" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <Grid ColumnDefinitions="*,*">
                                <StackPanel>
                                    <TextBlock Text="Current Frame" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding CurrentFrame}" FontSize="24" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Total Frames" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding TotalFrames}" FontSize="24" FontWeight="Bold"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Timeline Slider -->
                    <StackPanel>
                        <TextBlock Text="Timeline" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Slider Minimum="0" Maximum="{Binding TotalFrames}" Value="{Binding CurrentFrame}"
                                IsEnabled="{Binding IsSessionActive}"/>
                    </StackPanel>

                    <!-- Control Buttons -->
                    <Grid ColumnDefinitions="*,*,*,*" Margin="0,10">
                        <Button Grid.Column="0" Command="{Binding RewindCommand}" 
                                HorizontalAlignment="Stretch" Margin="0,0,5,0"
                                Background="{DynamicResource SurfaceLightBrush}" Padding="15,10">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="⏪" Margin="0,0,5,0"/>
                                <TextBlock Text="-10"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Command="{Binding StartSessionCommand}" 
                                HorizontalAlignment="Stretch" Margin="5,0"
                                Background="{DynamicResource BrandPrimaryBrush}" Foreground="White" Padding="15,10">
                            <TextBlock Text="▶ Start"/>
                        </Button>
                        <Button Grid.Column="2" Command="{Binding EndSessionCommand}" 
                                HorizontalAlignment="Stretch" Margin="5,0"
                                Background="#E53935" Foreground="White" Padding="15,10">
                            <TextBlock Text="⏹ End"/>
                        </Button>
                        <Button Grid.Column="3" Command="{Binding FastForwardCommand}" 
                                HorizontalAlignment="Stretch" Margin="5,0,0,0"
                                Background="{DynamicResource SurfaceLightBrush}" Padding="15,10">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="+10"/>
                                <TextBlock Text="⏩" Margin="5,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Add Bookmark -->
                    <Border Background="{DynamicResource SurfaceLightBrush}" CornerRadius="8" Padding="15">
                        <StackPanel>
                            <TextBlock Text="Add Bookmark" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Text="{Binding NewBookmarkName}" Watermark="Bookmark name..."
                                         Background="Transparent" BorderThickness="0"/>
                                <Button Grid.Column="1" Content="📌 Add" Command="{Binding AddBookmarkCommand}"
                                        Background="{DynamicResource BrandPrimaryBrush}" Foreground="White"
                                        Padding="15,8" CornerRadius="4" Margin="10,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Bookmarks List -->
            <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" 
                    CornerRadius="12" Padding="15" Margin="10,0,0,0">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Text="📌 Bookmarks" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Bookmarks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Background="{DynamicResource SurfaceLightBrush}" 
                                            CornerRadius="6" Padding="10" Margin="0,0,0,6"
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding $parent[ItemsControl].((vm:RetroRewindViewModel)DataContext).JumpToBookmarkCommand}"
                                            CommandParameter="{Binding Bookmark}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Bookmark}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding FrameNumber, StringFormat='Frame {0}'}" 
                                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" 
                CornerRadius="8" Padding="15,10" Margin="0,20,0,0">
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
