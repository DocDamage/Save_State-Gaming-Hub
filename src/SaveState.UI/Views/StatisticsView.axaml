<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SaveState.UI.ViewModels"
             x:Class="SaveState.UI.Views.StatisticsView"
             x:DataType="vm:StatisticsViewModel">

    <ScrollViewer Padding="20">
        <StackPanel Spacing="20">
            <!-- Header -->
            <TextBlock Text="📊 Library Statistics" FontSize="28" FontWeight="Bold"/>
            
            <!-- Overview Cards -->
            <UniformGrid Columns="4" Margin="0,10">
                <!-- Total Games -->
                <Border Background="#2A2A2A" CornerRadius="10" Padding="20" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="🎮" FontSize="32"/>
                        <TextBlock Text="{Binding TotalGames}" FontSize="36" FontWeight="Bold" Foreground="#BB86FC"/>
                        <TextBlock Text="Total Games" Opacity="0.7"/>
                    </StackPanel>
                </Border>
                
                <!-- Installed -->
                <Border Background="#2A2A2A" CornerRadius="10" Padding="20" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="✅" FontSize="32"/>
                        <TextBlock Text="{Binding InstalledGames}" FontSize="36" FontWeight="Bold" Foreground="#03DAC6"/>
                        <TextBlock Text="Installed" Opacity="0.7"/>
                    </StackPanel>
                </Border>
                
                <!-- ROMs -->
                <Border Background="#2A2A2A" CornerRadius="10" Padding="20" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="🕹️" FontSize="32"/>
                        <TextBlock Text="{Binding RomCount}" FontSize="36" FontWeight="Bold" Foreground="#CF6679"/>
                        <TextBlock Text="ROMs" Opacity="0.7"/>
                    </StackPanel>
                </Border>
                
                <!-- Play Time -->
                <Border Background="#2A2A2A" CornerRadius="10" Padding="20">
                    <StackPanel>
                        <TextBlock Text="⏱️" FontSize="32"/>
                        <TextBlock Text="{Binding TotalPlayTimeFormatted}" FontSize="36" FontWeight="Bold" Foreground="#FFAB40"/>
                        <TextBlock Text="Play Time" Opacity="0.7"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
            
            <!-- Source and Platform Breakdown -->
            <Grid ColumnDefinitions="*, *" Margin="0,10">
                <!-- By Source -->
                <Border Grid.Column="0" Background="#2A2A2A" CornerRadius="10" Padding="20" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Games by Source" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>
                        <ItemsControl ItemsSource="{Binding SourceStats}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*, Auto" Margin="0,5">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}"/>
                                        <Border Grid.Column="1" Background="#BB86FC" CornerRadius="3" Padding="8,2">
                                            <TextBlock Text="{Binding Count}" Foreground="White" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                
                <!-- By Platform -->
                <Border Grid.Column="1" Background="#2A2A2A" CornerRadius="10" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Top Platforms" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>
                        <ItemsControl ItemsSource="{Binding PlatformStats}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*, Auto" Margin="0,5">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}"/>
                                        <Border Grid.Column="1" Background="#03DAC6" CornerRadius="3" Padding="8,2">
                                            <TextBlock Text="{Binding Count}" Foreground="#1E1E1E" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
            
            <!-- Recent and Top Played -->
            <Grid ColumnDefinitions="*, *" Margin="0,10">
                <!-- Recent Games -->
                <Border Grid.Column="0" Background="#2A2A2A" CornerRadius="10" Padding="20" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="🆕 Recently Added" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>
                        <ItemsControl ItemsSource="{Binding RecentGames}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto, *" Margin="0,5">
                                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="5" ClipToBounds="True" Margin="0,0,10,0">
                                            <Border Background="#3A3A3A">
                                                <TextBlock Text="🎮" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Source}" FontSize="11" Opacity="0.6"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                
                <!-- Top Played -->
                <Border Grid.Column="1" Background="#2A2A2A" CornerRadius="10" Padding="20">
                    <StackPanel>
                        <TextBlock Text="🏆 Most Played" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>
                        <ItemsControl ItemsSource="{Binding TopPlayedGames}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,5">
                                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="5" ClipToBounds="True" Margin="0,0,10,0">
                                            <Border Background="#3A3A3A">
                                                <TextBlock Text="🎮" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="2" Text="{Binding PlayTime, StringFormat={}{0:h\\h\\ m\\m}}" VerticalAlignment="Center" Opacity="0.7"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
