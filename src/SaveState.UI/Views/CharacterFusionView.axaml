<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SaveState.UI.ViewModels"
             x:Class="SaveState.UI.Views.CharacterFusionView"
             x:DataType="vm:CharacterFusionViewModel">
    
    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="✨ Character Fusion Lab" FontSize="28" FontWeight="Bold" 
                       Foreground="{DynamicResource BrandPrimaryBrush}"/>
            <TextBlock Text="Combine two fighters to create a unique fusion character" 
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*,2*">
            <!-- Parent 1 Selection -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" 
                    CornerRadius="12" Padding="15" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Parent 1" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                    <ListBox ItemsSource="{Binding AvailableFighters}" 
                             SelectedItem="{Binding SelectedParent1}"
                             Height="300" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Padding="8,4"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- Fusion Controls -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20">
                <TextBlock Text="+" FontSize="40" FontWeight="Bold" HorizontalAlignment="Center"
                           Foreground="{DynamicResource BrandPrimaryBrush}"/>
                <ComboBox ItemsSource="{Binding FusionTypes}" 
                          SelectedItem="{Binding SelectedFusionType}"
                          Margin="0,20" Width="120"/>
                <Button Command="{Binding FuseCommand}" HorizontalAlignment="Center"
                        Background="{DynamicResource BrandPrimaryBrush}" Foreground="White"
                        Padding="20,10" CornerRadius="8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚡" Margin="0,0,8,0"/>
                        <TextBlock Text="FUSE"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Parent 2 Selection -->
            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" 
                    CornerRadius="12" Padding="15" Margin="10,0">
                <StackPanel>
                    <TextBlock Text="Parent 2" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                    <ListBox ItemsSource="{Binding AvailableFighters}" 
                             SelectedItem="{Binding SelectedParent2}"
                             Height="300" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Padding="8,4"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- Fusion Gallery -->
            <Border Grid.Column="3" Background="{DynamicResource SurfaceBrush}" 
                    CornerRadius="12" Padding="15" Margin="10,0,0,0">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Text="Fusion Gallery" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FusionGallery}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceLightBrush}" 
                                            CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Rarity, StringFormat='Rarity: {0}'}" 
                                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding Stats.Attack, StringFormat='ATK:{0}'}" 
                                                               FontSize="11" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding Stats.Defense, StringFormat='DEF:{0}'}" 
                                                               FontSize="11" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding Stats.Speed, StringFormat='SPD:{0}'}" 
                                                               FontSize="11"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="🗑" 
                                                    Command="{Binding $parent[ItemsControl].((vm:CharacterFusionViewModel)DataContext).DeleteFusionCommand}"
                                                    CommandParameter="{Binding Id}"
                                                    Background="Transparent" VerticalAlignment="Top"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" 
                CornerRadius="8" Padding="15,10" Margin="0,20,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="↻ Refresh" Command="{Binding RefreshFightersCommand}"
                        Background="Transparent"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
