<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SaveState.UI.ViewModels"
             xmlns:controls="using:SaveState.UI.Controls"
             xmlns:entities="clr-namespace:SaveState.Core.Entities;assembly=SaveState.Core"
             x:Class="SaveState.UI.Views.GameGridView"
             x:DataType="vm:GameGridViewModel">

    <Grid RowDefinitions="Auto, *">
        <!-- Filter Bar -->
        <Border Grid.Row="0" Background="#1A1A1A" Padding="15,10">
            <Grid ColumnDefinitions="*, Auto, Auto, Auto, Auto">
                <!-- Search -->
                <TextBox Grid.Column="0" 
                         Text="{Binding SearchQuery}"
                         Watermark="🔍 Search games..."
                         MaxWidth="300"
                         Height="32"
                         HorizontalAlignment="Left"/>
                
                <!-- Source Filter -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" Margin="20,0,0,0">
                    <TextBlock Text="Source:" VerticalAlignment="Center" Opacity="0.7"/>
                    <ComboBox ItemsSource="{Binding Sources}"
                              SelectedItem="{Binding SelectedSource}"
                              MinWidth="100"
                              Height="32"/>
                </StackPanel>
                
                <!-- Sort -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" Margin="15,0,0,0">
                    <TextBlock Text="Sort:" VerticalAlignment="Center" Opacity="0.7"/>
                    <ComboBox ItemsSource="{Binding SortOptions}"
                              SelectedItem="{Binding SelectedSort}"
                              MinWidth="120"
                              Height="32"/>
                </StackPanel>
                
                <!-- Installed Only -->
                <CheckBox Grid.Column="3" 
                          Content="Installed Only"
                          IsChecked="{Binding ShowInstalledOnly}"
                          Margin="15,0,0,0"
                          VerticalAlignment="Center"/>
                
                <!-- Count -->
                <TextBlock Grid.Column="4" 
                           Margin="20,0,0,0"
                           VerticalAlignment="Center"
                           Opacity="0.6">
                    <Run Text="{Binding FilteredGames}"/>
                    <Run Text=" of "/>
                    <Run Text="{Binding TotalGames}"/>
                    <Run Text=" games"/>
                </TextBlock>
            </Grid>
        </Border>
        
        <!-- Game Grid -->
        <Grid Grid.Row="1">
            <ScrollViewer Padding="20">
                <ItemsRepeater ItemsSource="{Binding Games}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="200" 
                                           MinItemHeight="300"
                                           MinColumnSpacing="10"
                                           MinRowSpacing="10"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="entities:Game">
                            <Button Command="{Binding $parent[UserControl].((vm:GameGridViewModel)DataContext).OpenDetailsCommand}"
                                    CommandParameter="{Binding}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch">
                                <controls:GameCard DataContext="{Binding}"/>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <!-- Empty state -->
            <StackPanel IsVisible="{Binding !Games.Count}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="15">
                <TextBlock Text="🎮" FontSize="64" HorizontalAlignment="Center"/>
                <TextBlock Text="No games found" FontSize="24" HorizontalAlignment="Center"/>
                <TextBlock Text="Try adjusting your filters or scan for more games" 
                           Opacity="0.6" HorizontalAlignment="Center"/>
            </StackPanel>

            <ProgressBar IsIndeterminate="True" 
                         IsVisible="{Binding IsLoading}"
                         VerticalAlignment="Bottom"/>
        </Grid>
    </Grid>
</UserControl>
