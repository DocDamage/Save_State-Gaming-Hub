<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SaveState.UI.ViewModels"
             x:Class="SaveState.UI.Views.LiveCommentaryView"
             x:DataType="vm:LiveCommentaryViewModel">
    
    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="🎙️ Live Commentary" FontSize="28" FontWeight="Bold" 
                       Foreground="{DynamicResource BrandPrimaryBrush}"/>
            <TextBlock Text="AI-powered commentary that reacts to your gameplay" 
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1" ColumnDefinitions="*,2*">
            <!-- Controls Panel -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" 
                    CornerRadius="12" Padding="20" Margin="0,0,10,0">
                <StackPanel Spacing="20">
                    <!-- Personality Selection -->
                    <StackPanel>
                        <TextBlock Text="🎭 Commentator Personality" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding AvailablePersonalities}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}" 
                                            Command="{Binding $parent[ItemsControl].((vm:LiveCommentaryViewModel)DataContext).SetPersonalityCommand}"
                                            CommandParameter="{Binding}"
                                            Margin="0,0,8,8" Padding="12,6" CornerRadius="16"
                                            Background="{DynamicResource SurfaceLightBrush}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Current Personality -->
                    <Border Background="{DynamicResource SurfaceLightBrush}" CornerRadius="8" Padding="15">
                        <StackPanel>
                            <TextBlock Text="Current Personality" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding SelectedPersonality}" FontWeight="Bold" FontSize="18"
                                       Foreground="{DynamicResource BrandPrimaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Simulate Events -->
                    <StackPanel>
                        <TextBlock Text="🎮 Simulate Event" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding AvailableEvents}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}" 
                                            Command="{Binding $parent[ItemsControl].((vm:LiveCommentaryViewModel)DataContext).SimulateEventCommand}"
                                            CommandParameter="{Binding}"
                                            Margin="0,0,5,5" Padding="10,5" CornerRadius="4"
                                            Background="{DynamicResource BrandPrimaryBrush}" Foreground="White"
                                            FontSize="11"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Commentary Feed -->
            <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" 
                    CornerRadius="12" Padding="15" Margin="10,0,0,0">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <TextBlock Text="💬 Commentary Feed" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                    
                    <!-- Latest Comment Highlight -->
                    <Border Grid.Row="1" Background="{DynamicResource BrandPrimaryBrush}" 
                            CornerRadius="8" Padding="20" Margin="0,0,0,15"
                            IsVisible="{Binding LatestComment, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding LatestComment}" FontSize="18" FontWeight="SemiBold" 
                                   Foreground="White" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- History -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CommentaryHistory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceLightBrush}" 
                                            CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <TextBlock Text="{Binding Personality}" FontSize="11" 
                                                           Foreground="{DynamicResource BrandPrimaryBrush}"/>
                                                <TextBlock Text=" • " Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding TriggerEvent}" FontSize="11" 
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Clear Button -->
                    <Button Grid.Row="3" Command="{Binding ClearHistoryCommand}" 
                            HorizontalAlignment="Center" Background="Transparent" Margin="0,10,0,0">
                        <TextBlock Text="🗑️ Clear History"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" 
                CornerRadius="8" Padding="15,10" Margin="0,20,0,0">
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
