<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SaveState.UI.ViewModels"
             x:Class="SaveState.UI.Views.TimeCapsuleView"
             x:DataType="vm:TimeCapsuleViewModel">
    
    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="⏰ Time Capsule" FontSize="28" FontWeight="Bold" 
                       Foreground="{DynamicResource BrandPrimaryBrush}"/>
            <TextBlock Text="Share save states that unlock in the future" 
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1" ColumnDefinitions="*,2*">
            <!-- Create Capsule Panel -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" 
                    CornerRadius="12" Padding="20" Margin="0,0,10,0">
                <StackPanel Spacing="15">
                    <TextBlock Text="📦 Create Capsule" FontWeight="SemiBold" FontSize="16"/>
                    
                    <StackPanel>
                        <TextBlock Text="Title" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding NewTitle}" Watermark="My Epic Save"
                                 Background="{DynamicResource SurfaceLightBrush}" CornerRadius="4"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Description" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding NewDescription}" Watermark="What's special about this moment?"
                                 Background="{DynamicResource SurfaceLightBrush}" CornerRadius="4"
                                 AcceptsReturn="True" Height="60"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Your Name" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding CreatorName}" 
                                 Background="{DynamicResource SurfaceLightBrush}" CornerRadius="4"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Unlock After (hours)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                        <NumericUpDown Value="{Binding UnlockDelayHours}" Minimum="1" Maximum="8760"
                                       Background="{DynamicResource SurfaceLightBrush}" CornerRadius="4"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Challenge (optional)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding ChallengeTypes}" 
                                  SelectedItem="{Binding ChallengeType}"
                                  HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <Button Command="{Binding CreateCapsuleCommand}"
                            Background="{DynamicResource BrandPrimaryBrush}" Foreground="White"
                            Padding="15,10" CornerRadius="8" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="📦" Margin="0,0,8,0"/>
                            <TextBlock Text="Seal Capsule"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Capsules List -->
            <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" 
                    CornerRadius="12" Padding="15" Margin="10,0,0,0">
                <Grid RowDefinitions="Auto,*">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="🗃️ Your Capsules" FontWeight="SemiBold" FontSize="16"/>
                        <TextBlock Text="{Binding AllCapsules.Count, StringFormat=' ({0})'}" 
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding AllCapsules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceLightBrush}" 
                                            CornerRadius="8" Padding="15" Margin="0,0,0,10">
                                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"/>
                                                <TextBlock Text="{Binding Description}" FontSize="12" 
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap" MaxWidth="300"/>
                                            </StackPanel>
                                            
                                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                                <Border CornerRadius="4" Padding="6,2"
                                                        Background="{DynamicResource BrandPrimaryBrush}">
                                                    <TextBlock Text="{Binding IsUnlocked}" 
                                                               FontSize="11" Foreground="White"/>
                                                </Border>
                                                <TextBlock Text="{Binding CreatorName, StringFormat='by {0}'}" 
                                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="5" Margin="0,8,0,0">
                                                <Button Content="🔓" 
                                                        Command="{Binding $parent[ItemsControl].((vm:TimeCapsuleViewModel)DataContext).TryUnlockCommand}"
                                                        CommandParameter="{Binding Id}"
                                                        Background="{DynamicResource BrandPrimaryBrush}" Foreground="White"
                                                        Padding="8,4" CornerRadius="4"/>
                                                <Button Content="👍" 
                                                        Command="{Binding $parent[ItemsControl].((vm:TimeCapsuleViewModel)DataContext).AddReactionCommand}"
                                                        CommandParameter="👍"
                                                        Background="Transparent" Padding="6,4"/>
                                                <Button Content="❤️" 
                                                        Command="{Binding $parent[ItemsControl].((vm:TimeCapsuleViewModel)DataContext).AddReactionCommand}"
                                                        CommandParameter="❤️"
                                                        Background="Transparent" Padding="6,4"/>
                                                <Button Content="🔥" 
                                                        Command="{Binding $parent[ItemsControl].((vm:TimeCapsuleViewModel)DataContext).AddReactionCommand}"
                                                        CommandParameter="🔥"
                                                        Background="Transparent" Padding="6,4"/>
                                            </StackPanel>

                                            <Button Grid.RowSpan="3" Grid.Column="1" Content="🗑" 
                                                    Command="{Binding $parent[ItemsControl].((vm:TimeCapsuleViewModel)DataContext).DeleteCapsuleCommand}"
                                                    CommandParameter="{Binding Id}"
                                                    Background="Transparent" VerticalAlignment="Top"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" 
                CornerRadius="8" Padding="15,10" Margin="0,20,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="↻ Refresh" Command="{Binding RefreshCommand}"
                        Background="Transparent"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
