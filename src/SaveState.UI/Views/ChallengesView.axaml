<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SaveState.UI.ViewModels"
             x:Class="SaveState.UI.Views.ChallengesView"
             x:DataType="vm:ChallengesViewModel">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" Spacing="20">
            <!-- Header -->
            <StackPanel>
                <TextBlock Text="🎯 Challenges" FontSize="28" FontWeight="Bold" 
                           Foreground="{DynamicResource BrandPrimaryBrush}"/>
                <TextBlock Text="{Binding StreakMessage}" FontSize="14" Margin="0,5,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>

            <!-- Stats -->
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="20">
                <Grid ColumnDefinitions="*,*">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🔥" FontSize="32" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Streak}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Day Streak" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" 
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="✅" FontSize="32" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding CompletedToday}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Completed Today" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" 
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Daily Challenges -->
            <StackPanel Spacing="10">
                <TextBlock Text="📅 Daily Challenges" FontSize="18" FontWeight="SemiBold"/>
                
                <ItemsControl ItemsSource="{Binding DailyChallenges}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" 
                                    Padding="15" Margin="0,0,0,10">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <!-- Icon -->
                                    <Border Width="50" Height="50" CornerRadius="25"
                                            Background="{DynamicResource SurfaceLightBrush}">
                                        <TextBlock Text="{Binding Icon}" FontSize="24" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    
                                    <!-- Info -->
                                    <StackPanel Grid.Column="1" Margin="15,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                            <Border Background="{DynamicResource BrandSecondaryBrush}" 
                                                    CornerRadius="3" Padding="5,2">
                                                <TextBlock Text="{Binding Difficulty}" FontSize="10" Foreground="White"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" FontSize="12" 
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        
                                        <!-- Progress -->
                                        <Grid Margin="0,8,0,0">
                                            <Border Background="{DynamicResource SurfaceLightBrush}" 
                                                    CornerRadius="3" Height="8"/>
                                            <Border Background="{DynamicResource BrandPrimaryBrush}" 
                                                    CornerRadius="3" Height="8" HorizontalAlignment="Left"
                                                    Width="{Binding ProgressPercent}"/>
                                        </Grid>
                                        <TextBlock Text="{Binding ProgressText}" FontSize="11" 
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    
                                    <!-- Reward/Claim -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding XPReward, StringFormat='+{0} XP'}" 
                                                   FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                        <Button Content="Claim!" IsVisible="{Binding CanClaim}"
                                                Command="{Binding $parent[ItemsControl].((vm:ChallengesViewModel)DataContext).ClaimRewardCommand}"
                                                CommandParameter="{Binding Id}"
                                                Background="{DynamicResource BrandPrimaryBrush}" 
                                                Foreground="White" Padding="15,5" CornerRadius="4" Margin="0,5,0,0"/>
                                        <TextBlock Text="✓ Complete" IsVisible="{Binding IsComplete}"
                                                   Foreground="{DynamicResource SuccessBrush}" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="No daily challenges available" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           IsVisible="{Binding !DailyChallenges.Count}"/>
            </StackPanel>

            <!-- Weekly Challenges -->
            <StackPanel Spacing="10">
                <TextBlock Text="📆 Weekly Challenges" FontSize="18" FontWeight="SemiBold"/>
                
                <ItemsControl ItemsSource="{Binding WeeklyChallenges}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" 
                                    Padding="15" Margin="0,0,0,10"
                                    BorderBrush="{DynamicResource BrandPrimaryBrush}" BorderThickness="1">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Width="50" Height="50" CornerRadius="25"
                                            Background="{DynamicResource BrandPrimaryBrush}">
                                        <TextBlock Text="{Binding Icon}" FontSize="24" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    
                                    <StackPanel Grid.Column="1" Margin="15,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="15"/>
                                        <TextBlock Text="{Binding Description}" FontSize="12" 
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        
                                        <Grid Margin="0,8,0,0">
                                            <Border Background="{DynamicResource SurfaceLightBrush}" 
                                                    CornerRadius="3" Height="10"/>
                                            <Border Background="{DynamicResource BrandSecondaryBrush}" 
                                                    CornerRadius="3" Height="10" HorizontalAlignment="Left"
                                                    Width="{Binding ProgressPercent}"/>
                                        </Grid>
                                        <TextBlock Text="{Binding ProgressText}" FontSize="11" 
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding XPReward, StringFormat='+{0} XP'}" 
                                                   FontWeight="Bold" FontSize="16" HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource BrandPrimaryBrush}"/>
                                        <Button Content="🎁 Claim Reward" IsVisible="{Binding CanClaim}"
                                                Command="{Binding $parent[ItemsControl].((vm:ChallengesViewModel)DataContext).ClaimRewardCommand}"
                                                CommandParameter="{Binding Id}"
                                                Background="{DynamicResource BrandPrimaryBrush}" 
                                                Foreground="White" Padding="15,8" CornerRadius="6" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Refresh -->
            <Button Command="{Binding RefreshCommand}" HorizontalAlignment="Center"
                    Content="↻ Refresh" Padding="20,10" CornerRadius="8"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
