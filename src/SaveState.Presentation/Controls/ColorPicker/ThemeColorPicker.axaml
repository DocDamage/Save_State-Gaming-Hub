<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="SaveState.Presentation.Controls.ColorPicker.ThemeColorPicker"
             x:Name="Root">

  <UserControl.Styles>
    <Style Selector="Border.ColorSwatch">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.ColorSwatch:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
    </Style>
    <Style Selector="Slider.RgbSlider">
      <Setter Property="Minimum" Value="0"/>
      <Setter Property="Maximum" Value="255"/>
      <Setter Property="TickFrequency" Value="1"/>
      <Setter Property="IsSnapToTickEnabled" Value="True"/>
    </Style>
  </UserControl.Styles>

  <Border Background="{DynamicResource SurfaceBrush}" 
          BorderBrush="{DynamicResource OutlineBrush}"
          BorderThickness="1"
          CornerRadius="12"
          Padding="16"
          Width="280">
    <Grid RowDefinitions="Auto, *, Auto" IsVisible="{Binding IsOpen, ElementName=Root}">
      
      <!-- Header -->
      <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,12">
        <TextBlock Grid.Column="0" 
                   Text="{Binding Header, ElementName=Root}"
                   FontWeight="SemiBold"/>
        <Button Grid.Column="1"
                Content="✕"
                Classes="Ghost"
                Padding="4"
                Click="OnCloseClick"/>
      </Grid>
      
      <!-- Color Picker Content -->
      <Grid Grid.Row="1" RowDefinitions="Auto, Auto, Auto">
        
        <!-- Color Wheel -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
          <Canvas x:Name="ColorWheelCanvas"
                  Width="200"
                  Height="200"
                  Background="Transparent"
                  PointerPressed="OnColorWheelPointerPressed"
                  PointerMoved="OnColorWheelPointerMoved"
                  PointerReleased="OnColorWheelPointerReleased">
            <Ellipse Width="200" 
                     Height="200"
                     Fill="{Binding ColorWheelBrush, ElementName=Root}"/>
            <Ellipse Canvas.Left="92"
                     Canvas.Top="92"
                     Width="16"
                     Height="16"
                     Fill="White"
                     Stroke="Black"
                     StrokeThickness="2"
                     x:Name="ColorSelector"
                     IsVisible="False"/>
          </Canvas>
        </Grid>
        
        <!-- Current Color Preview -->
        <Border Grid.Row="1" 
                Height="48"
                Background="{Binding SelectedColorBrush, ElementName=Root}"
                CornerRadius="8"
                Margin="0,0,0,16"
                BorderBrush="{DynamicResource OutlineBrush}"
                BorderThickness="1">
          <TextBlock Text="{Binding HexColor, ElementName=Root}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     FontFamily="Consolas, monospace"
                     FontWeight="SemiBold">
            <TextBlock.Styles>
              <Style Selector="TextBlock">
                <Setter Property="Foreground" Value="Black"/>
                <Style Selector="^:light-background">
                  <Setter Property="Foreground" Value="White"/>
                </Style>
              </Style>
            </TextBlock.Styles>
          </TextBlock>
        </Border>
        
        <!-- RGB Sliders -->
        <Grid Grid.Row="2" RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="Auto, *, Auto" RowSpacing="8">
          <!-- Red -->
          <TextBlock Grid.Row="0" Grid.Column="0" Text="R" Width="20" VerticalAlignment="Center"/>
          <Slider Grid.Row="0" 
                  Grid.Column="1" 
                  Classes="RgbSlider"
                  Value="{Binding RedValue, ElementName=Root, Mode=TwoWay}"
                  Background="#FFE0E0"/>
          <TextBlock Grid.Row="0" 
                     Grid.Column="2" 
                     Text="{Binding RedValue, ElementName=Root}"
                     Width="32"
                     TextAlignment="Right"
                     VerticalAlignment="Center"/>
          
          <!-- Green -->
          <TextBlock Grid.Row="1" Grid.Column="0" Text="G" Width="20" VerticalAlignment="Center"/>
          <Slider Grid.Row="1" 
                  Grid.Column="1" 
                  Classes="RgbSlider"
                  Value="{Binding GreenValue, ElementName=Root, Mode=TwoWay}"
                  Background="#FFE0FFE0"/>
          <TextBlock Grid.Row="1" 
                     Grid.Column="2" 
                     Text="{Binding GreenValue, ElementName=Root}"
                     Width="32"
                     TextAlignment="Right"
                     VerticalAlignment="Center"/>
          
          <!-- Blue -->
          <TextBlock Grid.Row="2" Grid.Column="0" Text="B" Width="20" VerticalAlignment="Center"/>
          <Slider Grid.Row="2" 
                  Grid.Column="1" 
                  Classes="RgbSlider"
                  Value="{Binding BlueValue, ElementName=Root, Mode=TwoWay}"
                  Background="#FFE0E0FF"/>
          <TextBlock Grid.Row="2" 
                     Grid.Column="2" 
                     Text="{Binding BlueValue, ElementName=Root}"
                     Width="32"
                     TextAlignment="Right"
                     VerticalAlignment="Center"/>
        </Grid>
        
      </Grid>
      
      <!-- HEX Input -->
      <Grid Grid.Row="2" ColumnDefinitions="Auto, *" Margin="0,16,0,0">
        <TextBlock Grid.Column="0" 
                   Text="#" 
                   VerticalAlignment="Center"
                   Margin="0,0,4,0"/>
        <TextBox Grid.Column="1"
                 Text="{Binding HexColor, ElementName=Root, Mode=TwoWay}"
                 MaxLength="8"
                 FontFamily="Consolas, monospace"/>
      </Grid>
      
    </Grid>
    
    <!-- Collapsed View -->
    <Border IsVisible="{Binding !IsOpen, ElementName=Root}"
            Background="{Binding SelectedColorBrush, ElementName=Root}"
            CornerRadius="8"
            Height="40"
            Cursor="Hand"
            PointerPressed="OnOpenClick">
      <TextBlock Text="{Binding HexColor, ElementName=Root}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 FontFamily="Consolas, monospace"
                 FontWeight="SemiBold"
                 Foreground="{Binding ContrastColor, ElementName=Root}"/>
    </Border>
  </Border>
  
</UserControl>
