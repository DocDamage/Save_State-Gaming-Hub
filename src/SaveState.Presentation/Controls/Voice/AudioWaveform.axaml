<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:voice="using:SaveState.Presentation.Models.Voice"
             x:Class="SaveState.Presentation.Controls.Voice.AudioWaveform"
             x:DataType="voice:VoiceVisualizerState">

    <UserControl.Styles>
        <!-- Bar Animation -->
        <Style Selector="Border.waveform-bar">
            <Style.Animations>
                <Animation Duration="0:0:0.1" FillMode="Both">
                    <KeyFrame Cue="0%">
                        <Setter Property="Height" Value="4" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Height" Value="{Binding $parent[ItemsControl].((UserControl)DataContext).Height, Mode=OneWay}" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <Grid>
        <!-- Idle State: Pulsing Circle -->
        <Grid IsVisible="{Binding State, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Idle}">
            <Ellipse Width="60"
                     Height="60"
                     Fill="{Binding State, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource VoiceStateToColorConverter}}"
                     Opacity="0.3">
                <Ellipse.Styles>
                    <Style>
                        <Style.Animations>
                            <Animation Duration="0:0:2" IterationCount="Infinite">
                                <KeyFrame Cue="0%">
                                    <Setter Property="ScaleTransform.ScaleX" Value="0.8" />
                                    <Setter Property="ScaleTransform.ScaleY" Value="0.8" />
                                    <Setter Property="Opacity" Value="0.3" />
                                </KeyFrame>
                                <KeyFrame Cue="50%">
                                    <Setter Property="ScaleTransform.ScaleX" Value="1.2" />
                                    <Setter Property="ScaleTransform.ScaleY" Value="1.2" />
                                    <Setter Property="Opacity" Value="0.1" />
                                </KeyFrame>
                                <KeyFrame Cue="100%">
                                    <Setter Property="ScaleTransform.ScaleX" Value="0.8" />
                                    <Setter Property="ScaleTransform.ScaleY" Value="0.8" />
                                    <Setter Property="Opacity" Value="0.3" />
                                </KeyFrame>
                            </Animation>
                        </Style.Animations>
                    </Style>
                </Ellipse.Styles>
            </Ellipse>
            <Ellipse Width="40"
                     Height="40"
                     Fill="{Binding State, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource VoiceStateToColorConverter}}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Grid>

        <!-- Muted State: Slash Icon -->
        <Grid IsVisible="{Binding State, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Muted}">
            <Ellipse Width="60"
                     Height="60"
                     Fill="#616161"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
            <TextBlock Text="🔇"
                      FontSize="32"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
        </Grid>

        <!-- Active Waveform -->
        <Grid IsVisible="{Binding State, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource VoiceStateToVisibilityConverter}}">
            <!-- Frequency Bands Mode -->
            <ItemsControl IsVisible="{Binding ShowFrequencyBands, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         ItemsSource="{Binding AudioData, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"
                                   Spacing="4"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Bottom" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="waveform-bar"
                               Width="8"
                               MinHeight="4"
                               MaxHeight="{Binding $parent[ItemsControl].Height, Mode=OneWay}"
                               Height="{Binding Converter={StaticResource AudioLevelToBarHeightConverter}, ConverterParameter={Binding $parent[ItemsControl].Height, Mode=OneWay}}"
                               Background="{Binding State, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource VoiceStateToColorConverter}}"
                               CornerRadius="4"
                               VerticalAlignment="Bottom"
                               Opacity="{Binding Converter={StaticResource VoiceActiveToOpacityConverter}}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Simple Wave Mode (Compact) -->
            <Canvas IsVisible="{Binding !ShowFrequencyBands, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Height="{Binding $parent[Grid].Height}"
                   VerticalAlignment="Center">
                <Path Stroke="{Binding State, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource VoiceStateToColorConverter}}"
                      StrokeThickness="3"
                      StrokeLineCap="Round"
                      StrokeLineJoin="Round">
                    <Path.Data>
                        <PathGeometry>
                            <PathFigure StartPoint="0,60">
                                <BezierSegment Point1="50,20"
                                              Point2="100,100"
                                              Point3="150,60" />
                                <BezierSegment Point1="200,20"
                                              Point2="250,100"
                                              Point3="300,60" />
                                <BezierSegment Point1="350,20"
                                              Point2="400,100"
                                              Point3="450,60" />
                            </PathFigure>
                        </PathGeometry>
                    </Path.Data>
                    <Path.Styles>
                        <Style>
                            <Style.Animations>
                                <Animation Duration="0:0:1" IterationCount="Infinite">
                                    <KeyFrame Cue="0%">
                                        <Setter Property="Opacity" Value="0.5" />
                                        <Setter Property="RenderTransform" Value="scale(1,0.5)" />
                                    </KeyFrame>
                                    <KeyFrame Cue="50%">
                                        <Setter Property="Opacity" Value="1.0" />
                                        <Setter Property="RenderTransform" Value="scale(1,1)" />
                                    </KeyFrame>
                                    <KeyFrame Cue="100%">
                                        <Setter Property="Opacity" Value="0.5" />
                                        <Setter Property="RenderTransform" Value="scale(1,0.5)" />
                                    </KeyFrame>
                                </Animation>
                            </Style.Animations>
                        </Style>
                    </Path.Styles>
                </Path>
            </Canvas>
        </Grid>

        <!-- Processing Indicator -->
        <Grid IsVisible="{Binding State, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Processing}"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="12"
                       Height="12"
                       Background="#FFC107"
                       CornerRadius="6">
                    <Border.Styles>
                        <Style>
                            <Style.Animations>
                                <Animation Duration="0:0:0.6" IterationCount="Infinite">
                                    <KeyFrame Cue="0%">
                                        <Setter Property="Opacity" Value="1.0" />
                                        <Setter Property="ScaleTransform.ScaleX" Value="1.0" />
                                        <Setter Property="ScaleTransform.ScaleY" Value="1.0" />
                                    </KeyFrame>
                                    <KeyFrame Cue="50%">
                                        <Setter Property="Opacity" Value="0.3" />
                                        <Setter Property="ScaleTransform.ScaleX" Value="0.5" />
                                        <Setter Property="ScaleTransform.ScaleY" Value="0.5" />
                                    </KeyFrame>
                                    <KeyFrame Cue="100%">
                                        <Setter Property="Opacity" Value="1.0" />
                                        <Setter Property="ScaleTransform.ScaleX" Value="1.0" />
                                        <Setter Property="ScaleTransform.ScaleY" Value="1.0" />
                                    </KeyFrame>
                                </Animation>
                            </Style.Animations>
                        </Style>
                    </Border.Styles>
                </Border>
                <Border Width="12"
                       Height="12"
                       Background="#FFC107"
                       CornerRadius="6"
                       Opacity="0.7">
                    <Border.Styles>
                        <Style>
                            <Style.Animations>
                                <Animation Duration="0:0:0.6" IterationCount="Infinite" Delay="0:0:0.1">
                                    <KeyFrame Cue="0%">
                                        <Setter Property="Opacity" Value="1.0" />
                                        <Setter Property="ScaleTransform.ScaleX" Value="1.0" />
                                        <Setter Property="ScaleTransform.ScaleY" Value="1.0" />
                                    </KeyFrame>
                                    <KeyFrame Cue="50%">
                                        <Setter Property="Opacity" Value="0.3" />
                                        <Setter Property="ScaleTransform.ScaleX" Value="0.5" />
                                        <Setter Property="ScaleTransform.ScaleY" Value="0.5" />
                                    </KeyFrame>
                                    <KeyFrame Cue="100%">
                                        <Setter Property="Opacity" Value="1.0" />
                                        <Setter Property="ScaleTransform.ScaleX" Value="1.0" />
                                        <Setter Property="ScaleTransform.ScaleY" Value="1.0" />
                                    </KeyFrame>
                                </Animation>
                            </Style.Animations>
                        </Style>
                    </Border.Styles>
                </Border>
                <Border Width="12"
                       Height="12"
                       Background="#FFC107"
                       CornerRadius="6"
                       Opacity="0.5">
                    <Border.Styles>
                        <Style>
                            <Style.Animations>
                                <Animation Duration="0:0:0.6" IterationCount="Infinite" Delay="0:0:0.2">
                                    <KeyFrame Cue="0%">
                                        <Setter Property="Opacity" Value="1.0" />
                                        <Setter Property="ScaleTransform.ScaleX" Value="1.0" />
                                        <Setter Property="ScaleTransform.ScaleY" Value="1.0" />
                                    </KeyFrame>
                                    <KeyFrame Cue="50%">
                                        <Setter Property="Opacity" Value="0.3" />
                                        <Setter Property="ScaleTransform.ScaleX" Value="0.5" />
                                        <Setter Property="ScaleTransform.ScaleY" Value="0.5" />
                                    </KeyFrame>
                                    <KeyFrame Cue="100%">
                                        <Setter Property="Opacity" Value="1.0" />
                                        <Setter Property="ScaleTransform.ScaleX" Value="1.0" />
                                        <Setter Property="ScaleTransform.ScaleY" Value="1.0" />
                                    </KeyFrame>
                                </Animation>
                            </Style.Animations>
                        </Style>
                    </Border.Styles>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Success Checkmark -->
        <Grid IsVisible="{Binding State, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Success}"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
            <Border Width="80"
                   Height="80"
                   Background="#4CAF50"
                   CornerRadius="40">
                <TextBlock Text="✓"
                          FontSize="48"
                          FontWeight="Bold"
                          Foreground="White"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                    <TextBlock.Styles>
                        <Style>
                            <Style.Animations>
                                <Animation Duration="0:0:0.3" FillMode="Both">
                                    <KeyFrame Cue="0%">
                                        <Setter Property="ScaleTransform.ScaleX" Value="0" />
                                        <Setter Property="ScaleTransform.ScaleY" Value="0" />
                                    </KeyFrame>
                                    <KeyFrame Cue="70%">
                                        <Setter Property="ScaleTransform.ScaleX" Value="1.2" />
                                        <Setter Property="ScaleTransform.ScaleY" Value="1.2" />
                                    </KeyFrame>
                                    <KeyFrame Cue="100%">
                                        <Setter Property="ScaleTransform.ScaleX" Value="1.0" />
                                        <Setter Property="ScaleTransform.ScaleY" Value="1.0" />
                                    </KeyFrame>
                                </Animation>
                            </Style.Animations>
                        </Style>
                    </TextBlock.Styles>
                </TextBlock>
            </Border>
        </Grid>

        <!-- Error X -->
        <Grid IsVisible="{Binding State, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Error}"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
            <Border Width="80"
                   Height="80"
                   Background="#F44336"
                   CornerRadius="40">
                <TextBlock Text="✕"
                          FontSize="48"
                          FontWeight="Bold"
                          Foreground="White"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                    <TextBlock.Styles>
                        <Style>
                            <Style.Animations>
                                <Animation Duration="0:0:0.3" FillMode="Both">
                                    <KeyFrame Cue="0%">
                                        <Setter Property="ScaleTransform.ScaleX" Value="0" />
                                        <Setter Property="ScaleTransform.ScaleY" Value="0" />
                                        <Setter Property="RotateTransform.Angle" Value="-180" />
                                    </KeyFrame>
                                    <KeyFrame Cue="70%">
                                        <Setter Property="ScaleTransform.ScaleX" Value="1.2" />
                                        <Setter Property="ScaleTransform.ScaleY" Value="1.2" />
                                        <Setter Property="RotateTransform.Angle" Value="10" />
                                    </KeyFrame>
                                    <KeyFrame Cue="100%">
                                        <Setter Property="ScaleTransform.ScaleX" Value="1.0" />
                                        <Setter Property="ScaleTransform.ScaleY" Value="1.0" />
                                        <Setter Property="RotateTransform.Angle" Value="0" />
                                    </KeyFrame>
                                </Animation>
                            </Style.Animations>
                        </Style>
                    </TextBlock.Styles>
                </TextBlock>
            </Border>
        </Grid>
    </Grid>
</UserControl>
