<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SaveState.Presentation.Controls.Loading.SkeletonLoader"
             xmlns:local="using:SaveState.Presentation.Controls.Loading">
    
    <Design.PreviewWith>
        <Border Width="400" Height="200" Padding="20">
            <local:SkeletonLoader />
        </Border>
    </Design.PreviewWith>

    <UserControl.Styles>
        <!-- Shimmer animation for skeleton loading effect -->
        <Style Selector="local|SkeletonLoader">
            <Style.Animations>
                <Animation Duration="0:0:1.5" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="Background">
                            <Setter.Value>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                    <GradientStop Offset="0" Color="#E0E0E0"/>
                                    <GradientStop Offset="0.3" Color="#F0F0F0"/>
                                    <GradientStop Offset="0.5" Color="#FFFFFF"/>
                                    <GradientStop Offset="0.7" Color="#F0F0F0"/>
                                    <GradientStop Offset="1" Color="#E0E0E0"/>
                                </LinearGradientBrush>
                            </Setter.Value>
                        </Setter>
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Background">
                            <Setter.Value>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                    <GradientStop Offset="0" Color="#F0F0F0"/>
                                    <GradientStop Offset="0.3" Color="#FFFFFF"/>
                                    <GradientStop Offset="0.5" Color="#E0E0E0"/>
                                    <GradientStop Offset="0.7" Color="#FFFFFF"/>
                                    <GradientStop Offset="1" Color="#F0F0F0"/>
                                </LinearGradientBrush>
                            </Setter.Value>
                        </Setter>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Background">
                            <Setter.Value>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                    <GradientStop Offset="0" Color="#E0E0E0"/>
                                    <GradientStop Offset="0.3" Color="#F0F0F0"/>
                                    <GradientStop Offset="0.5" Color="#FFFFFF"/>
                                    <GradientStop Offset="0.7" Color="#F0F0F0"/>
                                    <GradientStop Offset="1" Color="#E0E0E0"/>
                                </LinearGradientBrush>
                            </Setter.Value>
                        </Setter>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <!-- Main skeleton container -->
    <Border x:Name="RootBorder"
            Background="#E0E0E0"
            CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType=local:SkeletonLoader}}"
            ClipToBounds="True">
        
        <!-- Shimmer overlay -->
        <Rectangle x:Name="ShimmerRectangle"
                   Fill="{Binding Background, ElementName=RootBorder}"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch">
            <Rectangle.Clip>
                <RectangleGeometry Rect="0,0,200,1000">
                    <RectangleGeometry.Transform>
                        <TranslateTransform x:Name="ShimmerTransform" X="-200"/>
                    </RectangleGeometry.Transform>
                </RectangleGeometry>
            </Rectangle.Clip>
        </Rectangle>
        
    </Border>
</UserControl>
