<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SaveState.Presentation.Controls.Loading.SkeletonContainer"
             xmlns:local="using:SaveState.Presentation.Controls.Loading">
    
    <Design.PreviewWith>
        <local:SkeletonContainer Width="400" Height="200">
            <StackPanel Spacing="10">
                <TextBlock Text="Title" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="Description line 1"/>
                <TextBlock Text="Description line 2"/>
            </StackPanel>
        </local:SkeletonContainer>
    </Design.PreviewWith>

    <Grid x:Name="RootGrid">
        <!-- Content -->
        <ContentPresenter x:Name="ContentPresenter"
                          Content="{Binding Content, RelativeSource={RelativeSource AncestorType=local:SkeletonContainer}}"
                          ContentTemplate="{Binding ContentTemplate, RelativeSource={RelativeSource AncestorType=local:SkeletonContainer}}"
                          IsVisible="{Binding !IsLoading, RelativeSource={RelativeSource AncestorType=local:SkeletonContainer}}"/>
        
        <!-- Skeleton Overlay -->
        <Panel x:Name="SkeletonPanel"
               IsVisible="{Binding IsLoading, RelativeSource={RelativeSource AncestorType=local:SkeletonContainer}}"
               Background="{Binding SkeletonBackground, RelativeSource={RelativeSource AncestorType=local:SkeletonContainer}}">
            
            <!-- Shimmer effect -->
            <Rectangle x:Name="ShimmerRectangle"
                       Fill="{Binding ShimmerBrush, RelativeSource={RelativeSource AncestorType=local:SkeletonContainer}}"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch">
                <Rectangle.Clip>
                    <RectangleGeometry Rect="-200,0,200,1000">
                        <RectangleGeometry.Transform>
                            <TranslateTransform x:Name="ShimmerTransform" X="-200"/>
                        </RectangleGeometry.Transform>
                    </RectangleGeometry>
                </Rectangle.Clip>
            </Rectangle>
            
            <!-- Loading message -->
            <TextBlock x:Name="LoadingTextBlock"
                       Text="{Binding LoadingMessage, RelativeSource={RelativeSource AncestorType=local:SkeletonContainer}}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="14"
                       Opacity="0.6"
                       IsVisible="{Binding ShowLoadingMessage, RelativeSource={RelativeSource AncestorType=local:SkeletonContainer}}"/>
        </Panel>
    </Grid>
</UserControl>
