<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:SaveState.Presentation"
             xmlns:converters="using:SaveState.Presentation.Converters"
             x:Class="SaveState.Presentation.App">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Brushes must be loaded at application level for all controls to access them -->
        <ResourceInclude Source="avares://SaveState.Presentation/Styles/Brushes.axaml" />
        <!-- MobileStyles.axaml removed - not critical for E2E tests -->
      </ResourceDictionary.MergedDictionaries>

      <!-- Converters -->
      <converters:BoolToFlowDirectionConverter x:Key="BoolToFlowDirectionConverter" />
      <converters:StringEqualsConverter x:Key="StringEqualsConverter" />
      <converters:ReferenceEqualsConverter x:Key="ReferenceEqualsConverter" />
      <converters:NetworkStatusConverter x:Key="NetworkStatusConverter" />
      <converters:NullOrEmptyToBoolConverter x:Key="NullOrEmptyToBoolConverter" />
      <converters:FilePathToBitmapConverter x:Key="FilePathToBitmapConverter" />
      <converters:IntToBoolConverter x:Key="IntToBoolConverter" />
      <converters:StringContainsConverter x:Key="StringContainsConverter" />
      <converters:ViewModeToClassConverter x:Key="ViewModeToClassConverter" />
      <converters:BoolToClassConverter x:Key="BoolToClassConverter" />
      <converters:BoolToBrushConverter x:Key="BoolToBrushConverter" />
      <converters:BoolToStatusBrushConverter x:Key="BoolToStatusBrushConverter" />
      <converters:TabContentConverter x:Key="TabContentConverter" />
      <converters:GreaterThanConverter x:Key="GreaterThanConverter" />
      <converters:BoolToColorConverter x:Key="BoolToColorConverter" />
      <converters:EqualToConverter x:Key="EqualToConverter" />
      <converters:PercentageConverter x:Key="PercentageConverter" />
      <converters:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
      <converters:EqualityConverter x:Key="EqualityConverter" />
      <converters:InequalityConverter x:Key="InequalityConverter" />
      <converters:EqualityToFontWeightConverter x:Key="EqualityToFontWeightConverter" />
      <converters:ConnectionStatusToBrushConverter x:Key="ConnectionStatusToBrushConverter" />
      <converters:IsConnectedConverter x:Key="IsConnectedConverter" />
      <converters:IsDisconnectedConverter x:Key="IsDisconnectedConverter" />
      <converters:EnumToItemsConverter x:Key="EnumToItemsConverter" />
      <converters:IntToStatusBrushConverter x:Key="IntToStatusBrushConverter" />
      <converters:ObjectToBoolConverter x:Key="ObjectToBoolConverter" />
      <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
      <converters:SelectedBackgroundConverter x:Key="SelectedBackgroundConverter" />
      <converters:BoolToEnabledBrushConverter x:Key="BoolToEnabledBrushConverter" />
      <converters:BoolToStringConverter x:Key="BoolToStringConverter" />
      <converters:BoolToIntConverter x:Key="BoolToIntConverter" />
      <converters:EnumToIntConverter x:Key="EnumToIntConverter" />
      <converters:EnumEqualsConverter x:Key="EnumEqualsConverter" />
      <converters:AlertSeverityToBrushConverter x:Key="AlertSeverityToBrushConverter" />
      <converters:ProviderToIconConverter x:Key="ProviderToIconConverter" />
      <converters:ProviderToDisplayNameConverter x:Key="ProviderToDisplayNameConverter" />
      <converters:PlatformToIconConverter x:Key="PlatformToIconConverter" />
      <converters:BoolToYesNoConverter x:Key="BoolToYesNoConverter" />

      <!-- Mobile Companion Converters -->
      <converters:DeviceTypeToEmojiConverter x:Key="DeviceTypeToEmojiConverter" />
      <converters:TimeAgoConverter x:Key="TimeAgoConverter" />
      <converters:FileSizeConverter x:Key="FileSizeConverter" />
      <converters:NotificationTypeToEmojiConverter x:Key="NotificationTypeToEmojiConverter" />
      <converters:EnumToBoolConverter x:Key="EnumToBoolConverter" />
      <converters:CpuUsageToBrushConverter x:Key="CpuUsageToBrushConverter" />
      <converters:RamUsageToBrushConverter x:Key="RamUsageToBrushConverter" />
      <converters:TemperatureToBrushConverter x:Key="TemperatureToBrushConverter" />

      <converters:HealthStatusToBrushConverter x:Key="HealthStatusToBrushConverter" />
      <converters:ErrorSeverityToBrushConverter x:Key="ErrorSeverityToBrushConverter" />
      <converters:ByteToMegabytesConverter x:Key="ByteToMegabytesConverter" />
      <converters:ByteToGigabytesConverter x:Key="ByteToGigabytesConverter" />

      <!-- AI Companion Converters -->
      <converters:HealthToColorConverter x:Key="HealthToColorConverter" />
      <converters:SenderToBackgroundConverter x:Key="SenderToBackgroundConverter" />
      <converters:SenderToAvatarBrushConverter x:Key="SenderToAvatarBrushConverter" />
      <converters:SenderToIconConverter x:Key="SenderToIconConverter" />
      <converters:PersonalityToDescriptionConverter x:Key="PersonalityToDescriptionConverter" />
      <converters:SkillLevelToDescriptionConverter x:Key="SkillLevelToDescriptionConverter" />
      <converters:BoolToStatusColorConverter x:Key="BoolToStatusColorConverter" />

      <!-- Data Management Converters -->
      <converters:ItemTypeToIconConverter x:Key="ItemTypeToIconConverter" />
      <converters:ConflictResolutionToIndexConverter x:Key="ConflictResolutionToIndexConverter" />
      <converters:NullToBrushConverter x:Key="NullToBrushConverter" />

      <!-- Security & Auth Converters -->
      <converters:FirstCharConverter x:Key="FirstCharConverter" />
      <converters:RoleInCollectionConverter x:Key="RoleInCollectionConverter" />
      <converters:ScopeInCollectionConverter x:Key="ScopeInCollectionConverter" />
      <converters:NullToButtonClassConverter x:Key="NullToButtonClassConverter" />
      <converters:EqualsConverter x:Key="EqualsConverter" />
      <converters:IntThresholdToBrushConverter x:Key="IntThresholdToBrushConverter" />
      <converters:PermissionInCollectionConverter x:Key="PermissionInCollectionConverter" />
      <converters:SectionToBackgroundConverter x:Key="SectionToBackgroundConverter" />
      <converters:BoolToFavoriteColorConverter x:Key="BoolToFavoriteColorConverter" />
      <converters:EqualityToClassConverter x:Key="EqualityToClassConverter" />

      <!-- Voice Visualizer Converters -->
      <converters:VoiceStateToColorConverter x:Key="VoiceStateToColorConverter" />
      <converters:VoiceStateToIconConverter x:Key="VoiceStateToIconConverter" />
      <converters:VoiceStateToTextConverter x:Key="VoiceStateToTextConverter" />
      <converters:VoiceStateToAnimationIntensityConverter x:Key="VoiceStateToAnimationIntensityConverter" />
      <converters:VoiceStateToPulseSpeedConverter x:Key="VoiceStateToPulseSpeedConverter" />
      <converters:VoiceStateToVisibilityConverter x:Key="VoiceStateToVisibilityConverter" />
      <converters:ConfidenceToColorConverter x:Key="ConfidenceToColorConverter" />
      <converters:ConfidenceToPercentageConverter x:Key="ConfidenceToPercentageConverter" />
      <converters:AudioLevelToBarHeightConverter x:Key="AudioLevelToBarHeightConverter" />
      <converters:VoiceActiveToOpacityConverter x:Key="VoiceActiveToOpacityConverter" />
      <converters:ListeningDurationToTextConverter x:Key="ListeningDurationToTextConverter" />

      <!-- Achievement Converters - removed, not implemented yet -->

      <!-- Icons -->
      <Geometry x:Key="SettingsRegular">M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8zm0 2a2 2 0 1 1 0 4 2 2 0 0 1 0-4zm0-6.176l.375 2.155a5.952 5.952 0 0 1 3.518 1.458l2.067-.783 1.576 2.73-1.666 1.488a5.962 5.962 0 0 1 0 3.856l1.666 1.488-1.576 2.73-2.067-.783a5.952 5.952 0 0 1-3.518 1.458l-.375 2.155h-3.153l-.375-2.155a5.952 5.952 0 0 1-3.518-1.458l-2.067.783-1.576-2.73 1.666-1.488a5.962 5.962 0 0 1 0-3.856l-1.666-1.488 1.576-2.73 2.067.783a5.952 5.952 0 0 1 3.518-1.458l.375-2.155h3.153z</Geometry>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <!-- Modern Dark FluentTheme -->
    <FluentTheme />

    <!-- Global Font Settings -->
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Segoe UI, Inter, -apple-system, BlinkMacSystemFont, Roboto, Helvetica Neue, Arial, sans-serif" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
    </Style>

    <Style Selector="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI, Inter, -apple-system, BlinkMacSystemFont, Roboto, Helvetica Neue, Arial, sans-serif" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="Button">
      <Setter Property="FontFamily" Value="Segoe UI, Inter, -apple-system, BlinkMacSystemFont, Roboto, Helvetica Neue, Arial, sans-serif" />
    </Style>

    <!-- Custom Control Styles -->
    <StyleInclude Source="avares://SaveState.Presentation/Styles/Controls.axaml" />
  </Application.Styles>

  <Application.DataTemplates>
    <local:ViewLocator/>
  </Application.DataTemplates>
</Application>
