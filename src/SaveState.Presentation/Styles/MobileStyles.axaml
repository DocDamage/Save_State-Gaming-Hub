<!--
    MobileStyles.axaml
    
    Mobile-optimized styles for the companion app.
    Touch-friendly controls with minimum 44x44pt hit targets.
    
    Usage:
        <Button Classes="MobileButton Primary" />
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =========================================================================
         MOBILE BUTTON STYLES
         Minimum 44x44pt touch targets
         ========================================================================= -->

    <!-- Primary Mobile Button -->
    <Style Selector="Button.MobileButton.Primary">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.MobileButton.Primary:pointerover">
        <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
    </Style>
    <Style Selector="Button.MobileButton.Primary:pressed">
        <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
        <Setter Property="Opacity" Value="0.9" />
    </Style>
    <Style Selector="Button.MobileButton.Primary:disabled">
        <Setter Property="Background" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="Opacity" Value="0.5" />
    </Style>

    <!-- Secondary Mobile Button -->
    <Style Selector="Button.MobileButton.Secondary">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.MobileButton.Secondary:pointerover">
        <Setter Property="Background" Value="{StaticResource CardHoverBrush}" />
    </Style>
    <Style Selector="Button.MobileButton.Secondary:pressed">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Text Button (for links) -->
    <Style Selector="Button.TextButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="MinWidth" Value="44" />
    </Style>
    <Style Selector="Button.TextButton.Small">
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Icon Button -->
    <Style Selector="Button.IconButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.IconButton:pointerover">
        <Setter Property="Background" Value="{StaticResource CardHoverBrush}" />
    </Style>
    <Style Selector="Button.IconButton.Small">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="CornerRadius" Value="18" />
    </Style>

    <!-- Round Button -->
    <Style Selector="Button.RoundButton">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="56" />
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.RoundButton.Small">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="CornerRadius" Value="22" />
    </Style>
    <Style Selector="Button.RoundButton:pointerover">
        <Setter Property="Background" Value="{StaticResource CardHoverBrush}" />
    </Style>
    <Style Selector="Button.RoundButton:pressed">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    </Style>

    <!-- Quick Action Button -->
    <Style Selector="Button.QuickActionButton">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.QuickActionButton:pointerover">
        <Setter Property="Background" Value="{StaticResource CardHoverBrush}" />
    </Style>
    <Style Selector="Button.QuickActionButton:pressed">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    </Style>

    <!-- List Item Button -->
    <Style Selector="Button.ListItemButton">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.ListItemButton:pointerover">
        <Setter Property="Background" Value="{StaticResource CardHoverBrush}" />
    </Style>

    <!-- List Item Card -->
    <Style Selector="Button.ListItemCard">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="MinHeight" Value="80" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.ListItemCard:pointerover">
        <Setter Property="Background" Value="{StaticResource CardHoverBrush}" />
    </Style>

    <!-- Game Card -->
    <Style Selector="Button.GameCard">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.GameCard:pointerover /template/ ContentPresenter">
        <Setter Property="Opacity" Value="0.8" />
    </Style>

    <!-- Screenshot Card -->
    <Style Selector="Button.ScreenshotCard">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Button.ScreenshotCard:pointerover /template/ ContentPresenter">
        <Setter Property="Opacity" Value="0.9" />
    </Style>

    <!-- Notification Card -->
    <Style Selector="Button.NotificationCard">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="MinHeight" Value="72" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.NotificationCard:pointerover">
        <Setter Property="Background" Value="{StaticResource CardHoverBrush}" />
    </Style>

    <!-- =========================================================================
         NAVIGATION BUTTON
         ========================================================================= -->

    <Style Selector="Button.NavButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0,6,0,4" />
    </Style>
    <Style Selector="Button.NavButton.Active">
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style Selector="Button.NavButton:pointerover">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- =========================================================================
         MOBILE INPUT STYLES
         ========================================================================= -->

    <Style Selector="TextBox.MobileInput">
        <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="TextBox.MobileInput:focus">
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    </Style>

    <!-- =========================================================================
         COMBOBOX STYLES
         ========================================================================= -->

    <Style Selector="ComboBox.MobileComboBox">
        <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="PlaceholderForeground" Value="{StaticResource TextTertiaryBrush}" />
    </Style>

    <!-- =========================================================================
         FILTER CHIP
         ========================================================================= -->

    <Style Selector="ToggleButton.FilterChip">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinHeight" Value="36" />
    </Style>
    <Style Selector="ToggleButton.FilterChip:checked">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    </Style>

    <!-- =========================================================================
         SLIDER STYLES
         ========================================================================= -->

    <Style Selector="Slider.MobileSlider">
        <Setter Property="Height" Value="44" />
        <Setter Property="MinHeight" Value="44" />
    </Style>
    <Style Selector="Slider.MobileSlider /template/ Thumb">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
    </Style>

</ResourceDictionary>
