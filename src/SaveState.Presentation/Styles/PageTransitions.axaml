<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 
        Page Transition Styles for SaveStateReborn
        Following Material Design 3 motion guidelines
        
        Timing Standards:
        - Fast: 200ms (micro-interactions)
        - Normal: 300ms (standard transitions)
        - Medium: 350ms (page transitions)
        - Slow: 500ms (emphasis transitions)
    -->

    <!-- ============================================ -->
    <!-- Fade Transition -->
    <!-- ============================================ -->
    <Style Selector=".fade-transition">
        <Style.Animations>
            <Animation Duration="0:0:0.3" Easing="CubicEaseOut">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <Style Selector=".fade-transition-out">
        <Style.Animations>
            <Animation Duration="0:0:0.2" Easing="CubicEaseIn">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="1"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="0"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- ============================================ -->
    <!-- Slide Transitions -->
    <!-- ============================================ -->
    
    <!-- Slide In From Left -->
    <Style Selector=".slide-in-left">
        <Style.Animations>
            <Animation Duration="0:0:0.35" Easing="QuarticEaseOut">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="TranslateTransform.X" Value="-300"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="TranslateTransform.X" Value="0"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Slide In From Right -->
    <Style Selector=".slide-in-right">
        <Style.Animations>
            <Animation Duration="0:0:0.35" Easing="QuarticEaseOut">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="TranslateTransform.X" Value="300"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="TranslateTransform.X" Value="0"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Slide In From Bottom -->
    <Style Selector=".slide-in-up">
        <Style.Animations>
            <Animation Duration="0:0:0.35" Easing="QuarticEaseOut">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="TranslateTransform.Y" Value="200"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="TranslateTransform.Y" Value="0"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Slide In From Top -->
    <Style Selector=".slide-in-down">
        <Style.Animations>
            <Animation Duration="0:0:0.35" Easing="QuarticEaseOut">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="TranslateTransform.Y" Value="-200"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="TranslateTransform.Y" Value="0"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Slide Out To Left -->
    <Style Selector=".slide-out-left">
        <Style.Animations>
            <Animation Duration="0:0:0.3" Easing="QuarticEaseIn" FillMode="Forward">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="TranslateTransform.X" Value="0"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="TranslateTransform.X" Value="-300"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Slide Out To Right -->
    <Style Selector=".slide-out-right">
        <Style.Animations>
            <Animation Duration="0:0:0.3" Easing="QuarticEaseIn" FillMode="Forward">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="TranslateTransform.X" Value="0"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="TranslateTransform.X" Value="300"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- ============================================ -->
    <!-- Scale/Fade Transitions -->
    <!-- ============================================ -->
    
    <!-- Scale In (Modal/Dialog appearance) -->
    <Style Selector=".scale-in">
        <Style.Animations>
            <Animation Duration="0:0:0.3" Easing="ElasticEaseOut">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="ScaleTransform.ScaleX" Value="0.8"/>
                    <Setter Property="ScaleTransform.ScaleY" Value="0.8"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="ScaleTransform.ScaleX" Value="1"/>
                    <Setter Property="ScaleTransform.ScaleY" Value="1"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Scale Out -->
    <Style Selector=".scale-out">
        <Style.Animations>
            <Animation Duration="0:0:0.25" Easing="QuarticEaseIn" FillMode="Forward">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="ScaleTransform.ScaleX" Value="1"/>
                    <Setter Property="ScaleTransform.ScaleY" Value="1"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="ScaleTransform.ScaleX" Value="0.9"/>
                    <Setter Property="ScaleTransform.ScaleY" Value="0.9"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- ============================================ -->
    <!-- Crossfade Transition -->
    <!-- ============================================ -->
    <Style Selector=".crossfade-in">
        <Style.Animations>
            <Animation Duration="0:0:0.4" Easing="CubicEaseOut">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="ScaleTransform.ScaleX" Value="0.95"/>
                    <Setter Property="ScaleTransform.ScaleY" Value="0.95"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="ScaleTransform.ScaleX" Value="1"/>
                    <Setter Property="ScaleTransform.ScaleY" Value="1"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <Style Selector=".crossfade-out">
        <Style.Animations>
            <Animation Duration="0:0:0.3" Easing="CubicEaseIn" FillMode="Forward">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="ScaleTransform.ScaleX" Value="1"/>
                    <Setter Property="ScaleTransform.ScaleY" Value="1"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="ScaleTransform.ScaleX" Value="1.05"/>
                    <Setter Property="ScaleTransform.ScaleY" Value="1.05"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- ============================================ -->
    <!-- Flip Transition -->
    <!-- ============================================ -->
    <Style Selector=".flip-in">
        <Style.Animations>
            <Animation Duration="0:0:0.4" Easing="QuarticEaseOut">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="RotateYTransform.Angle" Value="-90"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="RotateYTransform.Angle" Value="0"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <Style Selector=".flip-out">
        <Style.Animations>
            <Animation Duration="0:0:0.35" Easing="QuarticEaseIn" FillMode="Forward">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="RotateYTransform.Angle" Value="0"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="RotateYTransform.Angle" Value="90"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- ============================================ -->
    <!-- Shared Element Transition -->
    <!-- ============================================ -->
    <Style Selector=".shared-element-in">
        <Style.Animations>
            <Animation Duration="0:0:0.5" Easing="QuinticEaseOut">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="ScaleTransform.ScaleX" Value="0.5"/>
                    <Setter Property="ScaleTransform.ScaleY" Value="0.5"/>
                </KeyFrame>
                <KeyFrame Cue="60%">
                    <Setter Property="Opacity" Value="1"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="ScaleTransform.ScaleX" Value="1"/>
                    <Setter Property="ScaleTransform.ScaleY" Value="1"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- ============================================ -->
    <!-- Page Container Transitions -->
    <!-- ============================================ -->
    <Style Selector=".page-transition-enter">
        <Style.Animations>
            <Animation Duration="0:0:0.35" Easing="QuarticEaseOut">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="TranslateTransform.X" Value="50"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="TranslateTransform.X" Value="0"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <Style Selector=".page-transition-exit">
        <Style.Animations>
            <Animation Duration="0:0:0.3" Easing="QuarticEaseIn" FillMode="Forward">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="TranslateTransform.X" Value="0"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="TranslateTransform.X" Value="-50"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- ============================================ -->
    <!-- Micro-interactions -->
    <!-- ============================================ -->
    
    <!-- Pulse Animation -->
    <Style Selector=".pulse-animation">
        <Style.Animations>
            <Animation Duration="0:0:0.6" Easing="CubicEaseOut">
                <KeyFrame Cue="0%">
                    <Setter Property="ScaleTransform.ScaleX" Value="1"/>
                    <Setter Property="ScaleTransform.ScaleY" Value="1"/>
                </KeyFrame>
                <KeyFrame Cue="50%">
                    <Setter Property="ScaleTransform.ScaleX" Value="1.1"/>
                    <Setter Property="ScaleTransform.ScaleY" Value="1.1"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="ScaleTransform.ScaleX" Value="1"/>
                    <Setter Property="ScaleTransform.ScaleY" Value="1"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Shake Animation (for errors) -->
    <Style Selector=".shake-animation">
        <Style.Animations>
            <Animation Duration="0:0:0.5" Easing="Linear">
                <KeyFrame Cue="0%">
                    <Setter Property="TranslateTransform.X" Value="0"/>
                </KeyFrame>
                <KeyFrame Cue="10%">
                    <Setter Property="TranslateTransform.X" Value="-10"/>
                </KeyFrame>
                <KeyFrame Cue="20%">
                    <Setter Property="TranslateTransform.X" Value="10"/>
                </KeyFrame>
                <KeyFrame Cue="30%">
                    <Setter Property="TranslateTransform.X" Value="-10"/>
                </KeyFrame>
                <KeyFrame Cue="40%">
                    <Setter Property="TranslateTransform.X" Value="10"/>
                </KeyFrame>
                <KeyFrame Cue="50%">
                    <Setter Property="TranslateTransform.X" Value="-10"/>
                </KeyFrame>
                <KeyFrame Cue="60%">
                    <Setter Property="TranslateTransform.X" Value="10"/>
                </KeyFrame>
                <KeyFrame Cue="70%">
                    <Setter Property="TranslateTransform.X" Value="-10"/>
                </KeyFrame>
                <KeyFrame Cue="80%">
                    <Setter Property="TranslateTransform.X" Value="10"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="TranslateTransform.X" Value="0"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Bounce Animation -->
    <Style Selector=".bounce-animation">
        <Style.Animations>
            <Animation Duration="0:0:0.8" Easing="BounceEaseOut">
                <KeyFrame Cue="0%">
                    <Setter Property="TranslateTransform.Y" Value="0"/>
                </KeyFrame>
                <KeyFrame Cue="50%">
                    <Setter Property="TranslateTransform.Y" Value="-30"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="TranslateTransform.Y" Value="0"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Hover Glow Effect -->
    <Style Selector=".hover-glow:pointerover">
        <Style.Animations>
            <Animation Duration="0:0:0.2" Easing="CubicEaseOut">
                <KeyFrame Cue="0%">
                    <Setter Property="BoxShadow" Value="0 0 0 0 transparent"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="BoxShadow" Value="0 4px 20px 0 rgba(128, 128, 255, 0.4)"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- ============================================ -->
    <!-- List Item Animations -->
    <!-- ============================================ -->
    <Style Selector=".list-item-add">
        <Style.Animations>
            <Animation Duration="0:0:0.3" Easing="CubicEaseOut">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="TranslateTransform.X" Value="-50"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="TranslateTransform.X" Value="0"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <Style Selector=".list-item-remove">
        <Style.Animations>
            <Animation Duration="0:0:0.25" Easing="CubicEaseIn" FillMode="Forward">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="ScaleTransform.ScaleX" Value="1"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="ScaleTransform.ScaleX" Value="0.8"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- ============================================ -->
    <!-- Skeleton Loading Animation -->
    <!-- ============================================ -->
    <Style Selector=".skeleton-shimmer">
        <Style.Animations>
            <Animation Duration="0:0:1.5" IterationCount="Infinite" Easing="Linear">
                <KeyFrame Cue="0%">
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                <GradientStop Offset="0" Color="#E0E0E0"/>
                                <GradientStop Offset="0.5" Color="#F5F5F5"/>
                                <GradientStop Offset="1" Color="#E0E0E0"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                </KeyFrame>
                <KeyFrame Cue="50%">
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                <GradientStop Offset="0" Color="#F5F5F5"/>
                                <GradientStop Offset="0.5" Color="#E0E0E0"/>
                                <GradientStop Offset="1" Color="#F5F5F5"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                <GradientStop Offset="0" Color="#E0E0E0"/>
                                <GradientStop Offset="0.5" Color="#F5F5F5"/>
                                <GradientStop Offset="1" Color="#E0E0E0"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- ============================================ -->
    <!-- Reduced Motion Support -->
    <!-- ============================================ -->
    <Style Selector=".reduced-motion .fade-transition, 
                     .reduced-motion .slide-in-left, 
                     .reduced-motion .slide-in-right, 
                     .reduced-motion .slide-in-up, 
                     .reduced-motion .slide-in-down,
                     .reduced-motion .scale-in,
                     .reduced-motion .crossfade-in,
                     .reduced-motion .flip-in,
                     .reduced-motion .shared-element-in,
                     .reduced-motion .page-transition-enter,
                     .reduced-motion .list-item-add">
        <Style.Animations>
            <Animation Duration="0:0:0.001">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="1"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

</ResourceDictionary>
