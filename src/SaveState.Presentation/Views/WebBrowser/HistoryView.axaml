<!--
    HistoryView.axaml
    
    Browser history viewer with grouped items and filtering.
    
    Usage:
        <web:HistoryView />
    
    Binding Context: HistoryViewModel
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SaveState.Presentation.ViewModels.WebBrowser"
             xmlns:models="using:SaveState.Core.WebBrowser.Models"
             x:Class="SaveState.Presentation.Views.WebBrowser.HistoryView"
             x:DataType="vm:HistoryViewModel"
             x:Name="Root">

    <UserControl.Styles>
        <Style Selector="Border.history-group">
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style Selector="TextBlock.group-header">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style Selector="Border.history-item">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.history-item:pointerover">
            <Setter Property="Background" Value="{StaticResource CardHoverBrush}" />
        </Style>
        <Style Selector="Border.history-item:selected">
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="16">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16">
                <TextBox Text="{Binding SearchQuery}"
                         Watermark="🔍 Search history..."
                         Width="300" />
                <Button Content="Search"
                        Command="{Binding SearchCommand}"
                        Classes="Secondary" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="🗑️ Clear All"
                        Command="{Binding ClearAllHistoryCommand}"
                        Classes="Danger" />
                <Button Content="🗑️ Delete Selected"
                        Command="{Binding DeleteSelectedCommand}"
                        Classes="Secondary"
                        IsEnabled="{Binding SelectedItems.Count, Converter={x:Static ObjectConverters.IsGreaterThan}, ConverterParameter=0}" />
            </StackPanel>
        </Grid>

        <!-- Date Filters -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,Auto,*" Margin="16,0,16,8">
            <TextBlock Grid.Column="0"
                       Text="From:"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <DatePicker Grid.Column="1"
                        SelectedDate="{Binding FilterDateFrom}"
                        Margin="0,0,16,0" />

            <TextBlock Grid.Column="2"
                       Text="To:"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <DatePicker Grid.Column="3"
                        SelectedDate="{Binding FilterDateTo}"
                        Margin="0,0,16,0" />

            <TextBlock Grid.Column="4"
                       Text="{Binding TotalHistoryCount, StringFormat='{}{0} items'}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Foreground="{StaticResource TextSecondaryBrush}" />
        </Grid>

        <!-- History List -->
        <ScrollViewer Grid.Row="2" Margin="16,0,16,16">
            <ItemsControl ItemsSource="{Binding GroupedHistory}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:HistoryGroup">
                        <Border Classes="history-group">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Classes="group-header" />

                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="models:BrowserHistoryItem">
                                            <Border Classes="history-item">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <!-- Icon -->
                                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                        <Image Source="{Binding Favicon}"
                                                               Width="24"
                                                               Height="24"
                                                               IsVisible="{Binding Favicon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                        <TextBlock Text="🌐"
                                                                   FontSize="20"
                                                                   IsVisible="{Binding Favicon, Converter={x:Static ObjectConverters.IsNull}}" />
                                                    </StackPanel>

                                                    <!-- Info -->
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Url}"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   FontSize="12"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <StackPanel Orientation="Horizontal"
                                                                    Spacing="8"
                                                                    Margin="0,4,0,0">
                                                            <TextBlock Text="{Binding VisitedAt, StringFormat='{}{0:HH:mm}'}"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                                            <TextBlock Text="{Binding VisitCount, StringFormat='Visited {0} times'}"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Actions -->
                                                    <StackPanel Grid.Column="2"
                                                                Orientation="Horizontal"
                                                                Spacing="4">
                                                        <Button Content="▶️"
                                                                Command="{Binding #Root.((vm:HistoryViewModel)DataContext).OpenItemCommand}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip.Tip="Open"
                                                                Classes="Secondary" />
                                                        <Button Content="➕"
                                                                Command="{Binding #Root.((vm:HistoryViewModel)DataContext).OpenInNewTabCommand}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip.Tip="Open in New Tab"
                                                                Classes="Secondary" />
                                                        <Button Content="🗑️"
                                                                Command="{Binding #Root.((vm:HistoryViewModel)DataContext).DeleteItemCommand}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip.Tip="Delete"
                                                                Classes="Danger" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
