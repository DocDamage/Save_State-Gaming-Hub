<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SaveState.Presentation.ViewModels.WebBrowser"
             xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
             xmlns:ia="clr-namespace:Avalonia.Xaml.Interactions.Core;assembly=Avalonia.Xaml.Interactions"
             x:Class="SaveState.Presentation.Views.WebBrowser.BrowserShellView"
             x:DataType="vm:BrowserShellViewModel">
    
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
        <!-- Navigation Bar -->
        <Border Grid.Row="0" Background="#2D2D2D" Padding="8,4">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto">
                <!-- Back/Forward/Refresh -->
                <Button Grid.Column="0" Content="◀" Command="{Binding GoBackCommand}" IsEnabled="{Binding CanGoBack}" Margin="0,0,4,0"/>
                <Button Grid.Column="1" Content="▶" Command="{Binding GoForwardCommand}" IsEnabled="{Binding CanGoForward}" Margin="0,0,4,0"/>
                <Button Grid.Column="2" Content="{Binding RefreshButtonContent, FallbackValue='↻'}" Command="{Binding RefreshCommand}" Margin="0,0,8,0"/>
                
                <!-- Home -->
                <Button Grid.Column="3" Content="🏠" Command="{Binding GoHomeCommand}" Margin="0,0,8,0"/>
                
                <!-- Address Bar -->
                <TextBox Grid.Column="4" 
                         Text="{Binding AddressBarText}" 
                         Watermark="Search or enter address"
                         VerticalAlignment="Center"
                         Margin="0,0,8,0">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding NavigateCommand}"/>
                    </TextBox.KeyBindings>
                </TextBox>
                
                <!-- Menu Buttons -->
                <Button Grid.Column="5" Content="🔖" Command="{Binding AddBookmarkCommand}" Margin="0,0,4,0"/>
                <Button Grid.Column="6" Content="⋮" Margin="0,0,4,0"/>
                <Button Grid.Column="7" Content="✕" Command="{Binding CloseCommand}" Margin="0,0,0,0"/>
            </Grid>
        </Border>
        
        <!-- Tab Bar -->
        <Border Grid.Row="1" Background="#2D2D2D" Padding="8,0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Tabs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:BrowserTab}">
                            <Border Background="{Binding IsActive, Converter={StaticResource BoolToBrushConverter}, ConverterParameter='#FF404040|Transparent'}'"
                                    Padding="12,6" CornerRadius="4,4,0,0"
                                    >
                                <Interaction.Behaviors>
                                    <EventTriggerBehavior EventName="PointerPressed">
                                        <InvokeCommandAction Command="{Binding $parent[ItemsControl].((vm:BrowserShellViewModel)DataContext).ActivateTabCommand}" CommandParameter="{Binding}" />
                                    </EventTriggerBehavior>
                                </Interaction.Behaviors>
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding Favicon, FallbackValue='🌐'}" Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                    <Button Grid.Column="2" Content="✕" Command="{Binding $parent[ItemsControl].((vm:BrowserShellViewModel)DataContext).CloseTabCommand}" CommandParameter="{Binding}" Margin="6,0,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        
        <!-- Bookmarks Bar -->
        <Border Grid.Row="2" Background="#252525" Padding="8,4" IsVisible="{Binding ShowBookmarksBar}">
            <ItemsControl ItemsSource="{Binding BookmarkBarItems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:BrowserBookmark}">
                        <Button Content="{Binding Title}" Command="{Binding NavigateCommand}" CommandParameter="{Binding Url}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
        
        <!-- Web Content -->
        <Border Grid.Row="3" Background="#1E1E1E">
            <ContentControl Content="{Binding ActiveTab}"/>
        </Border>
        
        <!-- Find Bar -->
        <Border Grid.Row="4" Background="#2D2D2D" Padding="8" IsVisible="{Binding ShowFindBar}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                <TextBlock Grid.Column="0" Text="Find:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" Text="{Binding FindText}" Watermark="Search text..." Margin="0,0,8,0">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding FindNextCommand}"/>
                    </TextBox.KeyBindings>
                </TextBox>
                <Button Grid.Column="2" Content="▲" Command="{Binding FindPreviousCommand}" Margin="0,0,4,0"/>
                <Button Grid.Column="3" Content="▼" Command="{Binding FindNextCommand}" Margin="0,0,8,0"/>
                <Button Grid.Column="4" Content="✕" Command="{Binding ToggleFindBarCommand}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
