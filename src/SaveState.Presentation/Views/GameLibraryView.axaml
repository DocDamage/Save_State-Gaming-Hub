<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SaveState.Presentation.ViewModels;assembly=SaveState.Presentation"
             xmlns:views="using:SaveState.Presentation.Views"
             xmlns:entities="using:SaveState.Core.GameLibrary.Entities"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="SaveState.Presentation.Views.GameLibraryView"
             x:DataType="vm:GameLibraryViewModel"
             Background="{StaticResource BackgroundBrush}">

    <Grid RowDefinitions="Auto, Auto, *">
        <!-- Top Navigation / Search Bar -->
        <Border Grid.Row="0" Classes="GlassContainer" Margin="20,20,20,10" Padding="15">
            <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                <TextBlock Text="{Binding Title}" Classes="Header" VerticalAlignment="Center" Margin="10,0" />

                <TextBox Grid.Column="1"
                         Width="350"
                         Text="{Binding SearchTerm}"
                         Watermark="{Binding SearchPlaceholder}"
                         Margin="20,0"
                         VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" Margin="10,0">
                    <Button Content="🔍 Scan for Games"
                            Classes="Primary"
                            Command="{Binding ScanForGamesCommand}" />

                    <Button Content="🎲 Random Game"
                            Classes="Accent"
                            Command="{Binding PickRandomGameCommand}" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10" Margin="10,0">
                    <Button Content="MUGEN"
                            Classes="Secondary"
                            Command="{Binding $parent[Window].DataContext.NavigateToMugen}" />

                    <Button Content="⚙️ Settings"
                            Classes="Secondary"
                            Command="{Binding $parent[Window].DataContext.NavigateToSettings}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Library Toolbar -->
        <Border Grid.Row="1" Classes="GlassContainer" Margin="20,0,20,10" Padding="15">
            <Grid ColumnDefinitions="Auto, Auto, Auto, *, Auto, Auto, Auto">
                <!-- View Mode Toggle -->
                <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,15,0">
                    <Button Content="⊞ Grid"
                            Classes="Secondary"
                            Command="{Binding SetGridViewCommand}" />
                    <Button Content="☰ List"
                            Classes="Secondary"
                            Command="{Binding SetListViewCommand}" />
                </StackPanel>

                <!-- Sort Options -->
                <ComboBox Grid.Column="1"
                         Width="150"
                         Margin="0,0,15,0"
                         ItemsSource="{Binding SortOptions}"
                         SelectedItem="{Binding SelectedSortOption}"
                         PlaceholderText="Sort by..." />

                <!-- Filter Options -->
                <ComboBox Grid.Column="2"
                         Width="120"
                         Margin="0,0,15,0"
                         ItemsSource="{Binding PlatformFilters}"
                         SelectedItem="{Binding SelectedPlatformFilter}"
                         PlaceholderText="Platform" />

                <!-- Collection Tabs -->
                <ScrollViewer Grid.Column="3" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Collections}" Margin="0,0,15,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="5" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}"
                                        Classes="Secondary"
                                        Command="{Binding $parent[UserControl].DataContext.SelectCollectionCommand}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Game Count -->
                <TextBlock Grid.Column="4"
                          Text="{Binding GameCountText}"
                          Classes="Body"
                          VerticalAlignment="Center"
                          Margin="15,0" />

                <!-- Selection Mode Toggle -->
                <ToggleButton Grid.Column="5"
                             Content="☑ Multi-Select"
                             IsChecked="{Binding IsSelectionMode}"
                             Classes="Secondary"
                             Margin="0,0,10,0" />

                <!-- Bulk Actions (shown when in selection mode) -->
                <StackPanel Grid.Column="6"
                           Orientation="Horizontal"
                           Spacing="5"
                           IsVisible="{Binding IsSelectionMode}">
                    <Button Content="➕ Add to Collection"
                            Classes="Secondary"
                            Command="{Binding AddSelectedToCollectionCommand}"
                            IsEnabled="{Binding HasSelectedGames}" />
                    <Button Content="🗑️ Delete Selected"
                            Classes="Danger"
                            Command="{Binding DeleteSelectedCommand}"
                            IsEnabled="{Binding HasSelectedGames}" />
                    <Button Content="📤 Export Selected"
                            Classes="Secondary"
                            Command="{Binding ExportSelectedCommand}"
                            IsEnabled="{Binding HasSelectedGames}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Game Content Area -->
        <Grid Grid.Row="2" Margin="20,0,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Collections Sidebar -->
            <Border Classes="GlassContainer" Margin="0,0,10,0" Padding="10">
                <StackPanel>
                    <TextBlock Text="📁 Collections" Classes="Subtitle" Margin="0,0,0,10" />

                    <ListBox ItemsSource="{Binding Collections}"
                             SelectedItem="{Binding SelectedCollection}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="5">
                                    <TextBlock Text="{Binding Icon}" FontSize="16" />
                                    <TextBlock Text="{Binding Name}" Classes="Body" />
                                    <TextBlock Text="{Binding GameCount, StringFormat='({0})'}"
                                              Classes="Body"
                                              Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Separator Margin="0,15" />

                    <TextBlock Text="🏷️ Quick Filters" Classes="Subtitle" Margin="0,0,0,10" />

                    <ListBox ItemsSource="{Binding QuickFilters}"
                             SelectedItem="{Binding SelectedQuickFilter}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="5">
                                    <TextBlock Text="{Binding Icon}" FontSize="16" />
                                    <TextBlock Text="{Binding Name}" Classes="Body" />
                                    <TextBlock Text="{Binding GameCount, StringFormat='({0})'}"
                                              Classes="Body"
                                              Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- Games Grid/List -->
            <ScrollViewer Grid.Column="1">
                <StackPanel>
                    <!-- Grid View -->
                    <ItemsControl ItemsSource="{Binding Games}"
                                 IsVisible="{Binding IsGridView}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <views:GameCard Margin="10" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- List View (Table) -->
                    <Border IsVisible="{Binding IsListView}" Classes="GlassContainer" Padding="10">
                        <Grid RowDefinitions="Auto, *">
                            <!-- Table Header -->
                            <Grid Grid.Row="0" ColumnDefinitions="60, *, 120, 100, 100, 100" Margin="10,5">
                                <TextBlock Grid.Column="0" Text="Select" Classes="Caption" FontWeight="Bold" />
                                <TextBlock Grid.Column="1" Text="Title" Classes="Caption" FontWeight="Bold" />
                                <TextBlock Grid.Column="2" Text="Platform" Classes="Caption" FontWeight="Bold" />
                                <TextBlock Grid.Column="3" Text="Status" Classes="Caption" FontWeight="Bold" />
                                <TextBlock Grid.Column="4" Text="Last Played" Classes="Caption" FontWeight="Bold" />
                                <TextBlock Grid.Column="5" Text="Playtime" Classes="Caption" FontWeight="Bold" />
                            </Grid>

                            <!-- Table Rows -->
                            <ListBox Grid.Row="1" ItemsSource="{Binding Games}" Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="60, *, 120, 100, 100, 100" Margin="0,2">
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" HorizontalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" Classes="Body" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Platform}" Classes="Caption" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding Status}" Classes="Caption" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="{Binding LastPlayed, StringFormat=d}" Classes="Caption" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="5" Text="{Binding TotalPlayTime}" Classes="Caption" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- No Games State -->
                    <TextBlock IsVisible="{Binding HasNoGames}"
                              Text="{Binding NoGamesMessage}"
                              Classes="Subtitle"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Margin="0,100,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Pagination Footer -->
        <Border Grid.Row="2" Classes="GlassContainer" Margin="20,10,20,20" Padding="15"
                IsVisible="{Binding TotalGames, Converter={StaticResource GreaterThanConverter}, ConverterParameter=0}">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <!-- Page Info -->
                <TextBlock Grid.Column="0"
                          Text="{Binding CurrentPage, StringFormat=Page \{0\} of}"
                          Classes="Body"
                          VerticalAlignment="Center" />

                <TextBlock Grid.Column="0"
                          Text="{Binding TotalGames, StringFormat=\{0\} total games}"
                          Classes="Caption"
                          Foreground="{StaticResource TextSecondaryBrush}"
                          VerticalAlignment="Center"
                          Margin="80,0,0,0" />

                <!-- Navigation Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                    <Button Content="◀ Previous"
                            Classes="Secondary"
                            Command="{Binding PreviousPageCommand}"
                            IsEnabled="{Binding HasPreviousPage}" />

                    <TextBlock Text="{Binding CurrentPage, StringFormat='Page {0}'}"
                              Classes="Body"
                              VerticalAlignment="Center"
                              Margin="10,0" />

                    <Button Content="Next ▶"
                            Classes="Secondary"
                            Command="{Binding NextPageCommand}"
                            IsEnabled="{Binding HasNextPage}" />

                    <Button Content="Load More"
                            Classes="Primary"
                            Command="{Binding LoadMoreCommand}"
                            IsEnabled="{Binding HasNextPage}"
                            Margin="20,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
