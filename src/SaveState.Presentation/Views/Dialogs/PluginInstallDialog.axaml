<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SaveState.Presentation.ViewModels.PluginStore;assembly=SaveState.Presentation"
        x:Class="SaveState.Presentation.Views.Dialogs.PluginInstallDialog"
        x:DataType="vm:PluginInstallDialogViewModel"
        Title="{Binding Title}"
        Width="500"
        Height="400"
        MinWidth="450"
        MinHeight="350"
        MaxWidth="600"
        MaxHeight="500"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{StaticResource DialogBackgroundBrush}">

  <Window.Styles>
    <Style Selector="TextBlock.status-text">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="TextBlock.step-complete">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
    </Style>

    <Style Selector="TextBlock.step-active">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
    </Style>

    <Style Selector="TextBlock.step-pending">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <Style Selector="ProgressBar">
      <Setter Property="Height" Value="8" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
      <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
    </Style>

    <Style Selector="Button.cancel-button">
      <Setter Property="Background" Value="{StaticResource ErrorBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="24,12" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.cancel-button:pointerover">
      <Setter Property="Background" Value="#D32F2F" />
    </Style>

    <Style Selector="Button.close-button">
      <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="24,12" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto, *, Auto" Margin="24">
    <!-- Header -->
    <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,24">
      <TextBlock Text="{Binding PluginName, FallbackValue='Installing Plugin'}"
                 FontSize="24"
                 FontWeight="Bold"
                 Foreground="White" />
      <TextBlock Text="{Binding PluginVersion, StringFormat='Version {0}', FallbackValue=''}"
                 FontSize="14"
                 Foreground="{StaticResource TextSecondaryBrush}" />
    </StackPanel>

    <!-- Installation Steps -->
    <StackPanel Grid.Row="1" Spacing="16">
      <!-- Download Step -->
      <Grid ColumnDefinitions="Auto, *, Auto">
        <TextBlock Grid.Column="0"
                   Classes.step-complete="{Binding IsDownloadComplete}"
                   Classes.step-active="{Binding IsDownloading}"
                   Classes.step-pending="{Binding !IsDownloadingAndNotComplete}"
                   Text="✓"
                   Margin="0,0,12,0"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="1"
                   Text="Downloading..."
                   Classes="status-text"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="2"
                   Text="{Binding DownloadProgress, StringFormat='{0:F1} MB / {1:F1} MB'}"
                   Classes="status-text"
                   IsVisible="{Binding IsDownloading}"
                   VerticalAlignment="Center" />
      </Grid>

      <!-- Verify Step -->
      <Grid ColumnDefinitions="Auto, *, Auto">
        <TextBlock Grid.Column="0"
                   Classes.step-complete="{Binding IsVerifyComplete}"
                   Classes.step-active="{Binding IsVerifying}"
                   Classes.step-pending="{Binding !IsVerifyingAndNotComplete}"
                   Text="{Binding VerifyIcon, FallbackValue='○'}"
                   Margin="0,0,12,0"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="1"
                   Text="Verifying..."
                   Classes="status-text"
                   VerticalAlignment="Center" />
      </Grid>

      <!-- Install Step -->
      <Grid ColumnDefinitions="Auto, *, Auto">
        <TextBlock Grid.Column="0"
                   Classes.step-complete="{Binding IsInstallComplete}"
                   Classes.step-active="{Binding IsInstalling}"
                   Classes.step-pending="{Binding !IsInstallingAndNotComplete}"
                   Text="{Binding InstallIcon, FallbackValue='○'}"
                   Margin="0,0,12,0"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="1"
                   Text="Installing..."
                   Classes="status-text"
                   VerticalAlignment="Center" />
      </Grid>

      <!-- Activate Step -->
      <Grid ColumnDefinitions="Auto, *, Auto">
        <TextBlock Grid.Column="0"
                   Classes.step-complete="{Binding IsActivateComplete}"
                   Classes.step-active="{Binding IsActivating}"
                   Classes.step-pending="{Binding !IsActivatingAndNotComplete}"
                   Text="{Binding ActivateIcon, FallbackValue='○'}"
                   Margin="0,0,12,0"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="1"
                   Text="Activating..."
                   Classes="status-text"
                   VerticalAlignment="Center" />
      </Grid>

      <!-- Progress Bar -->
      <ProgressBar Value="{Binding OverallProgress}"
                   Maximum="100"
                   Margin="0,16" />

      <!-- Current Action -->
      <TextBlock Text="{Binding CurrentAction, FallbackValue='Starting installation...'}"
                 FontSize="14"
                 Foreground="{StaticResource TextSecondaryBrush}"
                 TextAlignment="Center" />

      <!-- Error Message -->
      <Border Background="{StaticResource ErrorBrush}"
              CornerRadius="8"
              Padding="12"
              IsVisible="{Binding HasError}"
              Opacity="0.9">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="⚠️" FontSize="18" />
          <TextBlock Text="{Binding ErrorMessage}"
                     FontSize="14"
                     Foreground="White"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- Success Message -->
      <Border Background="{StaticResource SuccessBrush}"
              CornerRadius="8"
              Padding="12"
              IsVisible="{Binding IsComplete}"
              Opacity="0.9">
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
          <TextBlock Text="✅" FontSize="18" />
          <TextBlock Text="Installation completed successfully!"
                     FontSize="14"
                     Foreground="White"
                     FontWeight="SemiBold" />
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Footer Buttons -->
    <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Spacing="12"
                Margin="0,24,0,0">
      <Button Classes="cancel-button"
              Content="❌ Cancel"
              Command="{Binding CancelCommand}"
              IsVisible="{Binding !IsComplete}"
              IsEnabled="{Binding !IsComplete}" />

      <Button Classes="close-button"
              Content="Close"
              Command="{Binding CloseCommand}"
              IsVisible="{Binding IsComplete}" />
    </StackPanel>
  </Grid>
</Window>
