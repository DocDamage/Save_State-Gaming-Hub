<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SaveState.Presentation.ViewModels.Dialogs"
        x:Class="SaveState.Presentation.Views.Dialogs.NoteEditorDialog"
        x:DataType="vm:NoteEditorDialogViewModel"
        Title="Edit Note"
        Width="700"
        Height="600"
        MinWidth="500"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="{StaticResource DialogBackgroundBrush}">

    <Window.Styles>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="12,8" />
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="24,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="24,10" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="24">
        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,20">
            <TextBlock Text="Note Editor"
                      FontSize="24"
                      FontWeight="Bold"
                      Foreground="{StaticResource ForegroundBrush}" />
            <TextBlock Text="Create or edit your game note"
                      FontSize="14"
                      Opacity="0.7"
                      Foreground="{StaticResource ForegroundBrush}" />
        </StackPanel>

        <!-- Content -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16">
                <!-- Title -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Title"
                              FontWeight="SemiBold"
                              FontSize="13"
                              Foreground="{StaticResource ForegroundBrush}" />
                    <TextBox Text="{Binding Title}"
                            Watermark="Enter note title..."
                            MaxLength="200" />
                </StackPanel>

                <!-- Category -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Category"
                              FontWeight="SemiBold"
                              FontSize="13"
                              Foreground="{StaticResource ForegroundBrush}" />
                    <ComboBox SelectedItem="{Binding Category}"
                             ItemsSource="{Binding AvailableCategories}"
                             HorizontalAlignment="Stretch"
                             MinWidth="200">
                        <ComboBox.Styles>
                            <Style Selector="ComboBox">
                                <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
                                <Setter Property="CornerRadius" Value="4" />
                            </Style>
                        </ComboBox.Styles>
                    </ComboBox>
                </StackPanel>

                <!-- Content -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Content"
                              FontWeight="SemiBold"
                              FontSize="13"
                              Foreground="{StaticResource ForegroundBrush}" />
                    <TextBox Text="{Binding Content}"
                            Watermark="Write your note here..."
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            MinHeight="250"
                            MaxHeight="400"
                            VerticalAlignment="Stretch" />
                    <TextBlock Text="{Binding CharacterCount, StringFormat='{}{0} characters'}"
                              FontSize="11"
                              Opacity="0.6"
                              HorizontalAlignment="Right"
                              Foreground="{StaticResource ForegroundBrush}" />
                </StackPanel>

                <!-- Options -->
                <StackPanel Spacing="12">
                    <CheckBox IsChecked="{Binding IsPinned}"
                             Content="Pin this note to the top"
                             Foreground="{StaticResource ForegroundBrush}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="2"
              ColumnDefinitions="*,Auto,Auto"
              Margin="0,20,0,0">
            <StackPanel Grid.Column="0"
                       Orientation="Horizontal"
                       Spacing="8"
                       VerticalAlignment="Center">
                <TextBlock Text="💡"
                          FontSize="16"
                          VerticalAlignment="Center" />
                <TextBlock Text="Tip: Use markdown for formatting"
                          FontSize="12"
                          Opacity="0.6"
                          VerticalAlignment="Center"
                          Foreground="{StaticResource ForegroundBrush}" />
            </StackPanel>

            <Button Grid.Column="1"
                   Classes="secondary"
                   Content="Cancel"
                   Command="{Binding CancelCommand}"
                   Margin="0,0,12,0" />

            <Button Grid.Column="2"
                   Classes="primary"
                   Content="Save Note"
                   Command="{Binding SaveCommand}"
                   IsEnabled="{Binding CanSave}" />
        </Grid>
    </Grid>
</Window>
