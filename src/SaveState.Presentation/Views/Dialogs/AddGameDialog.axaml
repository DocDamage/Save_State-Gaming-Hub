<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:SaveState.Presentation.ViewModels.Dialogs"
        xmlns:core="using:SaveState.Core.GameLibrary.Entities"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="450"
        x:Class="SaveState.Presentation.Views.Dialogs.AddGameDialog"
        x:DataType="vm:AddGameDialogViewModel"
        Title="Add Game"
        Width="600"
        Height="450"
        MinWidth="500"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{StaticResource DialogBackgroundBrush}"
        TransparencyLevelHint="Mica"
        ExtendClientAreaToDecorationsHint="True">

    <Grid RowDefinitions="Auto,*,Auto" Margin="32">
        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="Add New Game"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,24"
                   Foreground="{StaticResource TextPrimaryBrush}" />

        <!-- Form -->
        <StackPanel Grid.Row="1" Spacing="20">
            <!-- Platform Selection -->
            <StackPanel Spacing="8">
                <TextBlock Text="Platform" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                <ComboBox ItemsSource="{Binding AvailablePlatforms}"
                          SelectedItem="{Binding SelectedPlatform}"
                          HorizontalAlignment="Stretch"
                          ToolTip.Tip="Select the game platform">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="core:Platform">
                            <TextBlock Text="{Binding Name.Value}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <!-- Title Input -->
            <StackPanel Spacing="8">
                <TextBlock Text="Game Title" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBox Text="{Binding Title}"
                         Watermark="Enter the game title"
                         ToolTip.Tip="Enter the title of the game" />
            </StackPanel>

            <!-- Path Selection -->
            <StackPanel Spacing="8">
                <TextBlock Text="Installation Location / ROM Folder" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                <Grid ColumnDefinitions="*,12,Auto">
                    <TextBox Grid.Column="0"
                             Text="{Binding Path}"
                             Watermark="Select folder..."
                             IsReadOnly="False"
                             ToolTip.Tip="Path to game executable or ROM folder" />
                    <Button Grid.Column="2"
                            Content="Browse"
                            Command="{Binding BrowsePathCommand}"
                            Classes="Secondary"
                            ToolTip.Tip="Browse for game folder"
                            AutomationProperties.Name="Browse Button" />
                </Grid>
            </StackPanel>

            <!-- Options -->
            <CheckBox Content="Scan folder automatically after adding"
                      IsChecked="{Binding ScanAutomatically}"
                      Margin="0,8,0,0"
                      Foreground="{StaticResource TextPrimaryBrush}"
                      ToolTip.Tip="Automatically scan the folder for game files after adding" />

            <!-- Error Message -->
            <TextBlock Text="{Binding ValidationError}"
                       Foreground="{StaticResource ErrorBrush}"
                       IsVisible="{Binding ValidationError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <ProgressBar IsIndeterminate="True"
                         IsVisible="{Binding IsLoading}"
                         Height="2"
                         Background="Transparent"
                         Foreground="{StaticResource AccentBrush}" />
        </StackPanel>

        <!-- Footer -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,24,0,0">
            <Button Grid.Column="1"
                    Content="Cancel"
                    Command="{Binding CancelCommand}"
                    Classes="Secondary"
                    Margin="0,0,12,0"
                    ToolTip.Tip="Cancel and close"
                    AutomationProperties.Name="Cancel Button" />

            <Button Grid.Column="2"
                    Content="Add Game"
                    Command="{Binding ConfirmCommand}"
                    Classes="Primary"
                    ToolTip.Tip="Add the game to your library"
                    AutomationProperties.Name="Add Game Button" />
        </Grid>
    </Grid>
</Window>
