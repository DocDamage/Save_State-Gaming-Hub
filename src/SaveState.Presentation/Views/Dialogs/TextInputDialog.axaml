<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:SaveState.Presentation.ViewModels.Dialogs"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="250"
        x:Class="SaveState.Presentation.Views.Dialogs.TextInputDialog"
        x:DataType="vm:TextInputDialogViewModel"
        Title="{Binding Title}"
        Width="400"
        Height="250"
        MinWidth="400"
        MinHeight="250"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{StaticResource DialogBackgroundBrush}">

    <Grid RowDefinitions="Auto,*,Auto" Margin="24">
        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,16">
            <TextBlock Text="{Binding Title}"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="{Binding Message}"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>

        <!-- Content -->
        <StackPanel Grid.Row="1" Spacing="12">
            <TextBox Text="{Binding InputText}"
                     Watermark="{Binding Placeholder}"
                     PasswordChar="{Binding PasswordChar}"
                     AcceptsReturn="False"
                     FontSize="14"
                     Background="{StaticResource InputBackgroundBrush}"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     BorderBrush="{StaticResource InputBorderBrush}"
                     BorderThickness="1"
                     CornerRadius="8"
                     Padding="12,10" />

            <CheckBox IsVisible="{Binding IsSensitive}"
                      IsChecked="{Binding ShowSensitiveText}"
                      Content="Show input"
                      Foreground="{StaticResource TextSecondaryBrush}"
                      FontSize="12"
                      ToolTip.Tip="Toggle password visibility" />
        </StackPanel>

        <!-- Footer -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="12"
                    Margin="0,20,0,0">
            <Button Command="{Binding CancelCommand}"
                    Content="{Binding CancelText}"
                    Classes="Secondary"
                    ToolTip.Tip="Cancel and close dialog"
                    AutomationProperties.Name="Cancel Button" />
            <Button Command="{Binding ConfirmCommand}"
                    Content="{Binding ConfirmText}"
                    Classes="Primary"
                    ToolTip.Tip="Confirm and save changes"
                    AutomationProperties.Name="Confirm Button" />
        </StackPanel>
    </Grid>
</Window>
