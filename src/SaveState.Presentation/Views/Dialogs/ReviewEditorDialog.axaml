<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SaveState.Presentation.ViewModels.Dialogs"
        x:Class="SaveState.Presentation.Views.Dialogs.ReviewEditorDialog"
        x:DataType="vm:ReviewEditorDialogViewModel"
        Title="Write Review"
        Width="650"
        Height="600"
        MinWidth="500"
        MinHeight="450"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="{StaticResource DialogBackgroundBrush}">

    <Window.Styles>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="12,8" />
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="24,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="24,10" />
        </Style>

        <Style Selector="Button.star">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="32" />
            <Setter Property="Padding" Value="4" />
        </Style>

        <Style Selector="Button.star:pointerover">
            <Setter Property="Opacity" Value="0.8" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="24">
        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,20">
            <TextBlock Text="✍️ Write Review"
                      FontSize="24"
                      FontWeight="Bold"
                      Foreground="{StaticResource ForegroundBrush}" />
            <TextBlock Text="Share your thoughts about this game"
                      FontSize="14"
                      Opacity="0.7"
                      Foreground="{StaticResource ForegroundBrush}" />
        </StackPanel>

        <!-- Content -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="20">
                <!-- Rating -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Your Rating *"
                              FontWeight="SemiBold"
                              FontSize="13"
                              Foreground="{StaticResource ForegroundBrush}" />

                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Classes="star"
                               Content="{Binding Star1}"
                               Command="{Binding SetRatingCommand}"
                               CommandParameter="1" />
                        <Button Classes="star"
                               Content="{Binding Star2}"
                               Command="{Binding SetRatingCommand}"
                               CommandParameter="2" />
                        <Button Classes="star"
                               Content="{Binding Star3}"
                               Command="{Binding SetRatingCommand}"
                               CommandParameter="3" />
                        <Button Classes="star"
                               Content="{Binding Star4}"
                               Command="{Binding SetRatingCommand}"
                               CommandParameter="4" />
                        <Button Classes="star"
                               Content="{Binding Star5}"
                               Command="{Binding SetRatingCommand}"
                               CommandParameter="5" />
                        <TextBlock Text="{Binding RatingText}"
                                  VerticalAlignment="Center"
                                  Margin="12,0,0,0"
                                  FontWeight="SemiBold"
                                  Foreground="{StaticResource ForegroundBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Review Text -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Your Review *"
                              FontWeight="SemiBold"
                              FontSize="13"
                              Foreground="{StaticResource ForegroundBrush}" />
                    <TextBox Text="{Binding ReviewText}"
                            Watermark="Write your review here... What did you like? What could be improved?"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            MinHeight="250"
                            MaxHeight="400" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0"
                                  Text="💡 Tip: Be specific and constructive"
                                  FontSize="11"
                                  Opacity="0.6"
                                  Foreground="{StaticResource ForegroundBrush}" />
                        <TextBlock Grid.Column="1"
                                  Text="{Binding CharacterCount, StringFormat='{}{0} characters'}"
                                  FontSize="11"
                                  Opacity="0.6"
                                  Foreground="{StaticResource ForegroundBrush}" />
                    </Grid>
                </StackPanel>

                <!-- Recommendation -->
                <StackPanel Spacing="12">
                    <CheckBox IsChecked="{Binding RecommendToFriends}"
                             Foreground="{StaticResource ForegroundBrush}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="I would recommend this game to friends"
                                      FontWeight="SemiBold" />
                            <TextBlock Text="This helps others discover great games"
                                      FontSize="11"
                                      Opacity="0.7" />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="2"
              ColumnDefinitions="*,Auto,Auto"
              Margin="0,20,0,0">
            <TextBlock Grid.Column="0"
                      Text="* Required fields"
                      FontSize="12"
                      Opacity="0.6"
                      VerticalAlignment="Center"
                      Foreground="{StaticResource ForegroundBrush}" />

            <Button Grid.Column="1"
                   Classes="secondary"
                   Content="Cancel"
                   Command="{Binding CancelCommand}"
                   Margin="0,0,12,0" />

            <Button Grid.Column="2"
                   Classes="primary"
                   Content="Save Review"
                   Command="{Binding SaveCommand}"
                   IsEnabled="{Binding CanSave}" />
        </Grid>
    </Grid>
</Window>
