<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SaveState.Presentation.ViewModels.Dialogs"
        x:Class="SaveState.Presentation.Views.Dialogs.SaveStateSettingsDialog"
        x:DataType="vm:SaveStateSettingsDialogViewModel"
        Title="Save State Settings"
        Width="650"
        Height="600"
        MinWidth="550"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="{StaticResource DialogBackgroundBrush}">

    <Window.Styles>
        <Style Selector="TextBox, ComboBox">
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="12,8" />
        </Style>

        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="24,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="24,10" />
        </Style>

        <Style Selector="Button.tag">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="4,2" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="24">
        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,20">
            <TextBlock Text="Save State Settings"
                      FontSize="24"
                      FontWeight="Bold"
                      Foreground="{StaticResource ForegroundBrush}" />
            <TextBlock Text="Edit metadata and properties for this save state"
                      FontSize="14"
                      Opacity="0.7"
                      Foreground="{StaticResource ForegroundBrush}" />
        </StackPanel>

        <!-- Content -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16">
                <!-- Description -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Description"
                              FontWeight="SemiBold"
                              FontSize="13"
                              Foreground="{StaticResource ForegroundBrush}" />
                    <TextBox Text="{Binding Description}"
                            Watermark="Enter save state description..."
                            MaxLength="200" />
                </StackPanel>

                <!-- Branch Selection -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Branch"
                              FontWeight="SemiBold"
                              FontSize="13"
                              Foreground="{StaticResource ForegroundBrush}" />
                    <ComboBox SelectedItem="{Binding BranchName}"
                             ItemsSource="{Binding AvailableBranches}"
                             HorizontalAlignment="Stretch" />
                    <TextBlock Text="Organize save states into different storylines or playthroughs"
                              FontSize="11"
                              Opacity="0.6"
                              Foreground="{StaticResource ForegroundBrush}" />
                </StackPanel>

                <!-- Is Current -->
                <StackPanel Spacing="6">
                    <CheckBox IsChecked="{Binding IsCurrent}"
                             Content="Mark as current save state" />
                    <TextBlock Text="This will be the default save when resuming the game"
                              FontSize="11"
                              Opacity="0.6"
                              Margin="32,0,0,0"
                              Foreground="{StaticResource ForegroundBrush}" />
                </StackPanel>

                <!-- Notes -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Notes"
                              FontWeight="SemiBold"
                              FontSize="13"
                              Foreground="{StaticResource ForegroundBrush}" />
                    <TextBox Text="{Binding Notes}"
                            Watermark="Add detailed notes about this save point..."
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            MinHeight="120"
                            MaxHeight="200"
                            VerticalAlignment="Stretch" />
                    <TextBlock Text="{Binding CharacterCount, StringFormat='{}{0} characters'}"
                              FontSize="11"
                              Opacity="0.6"
                              HorizontalAlignment="Right"
                              Foreground="{StaticResource ForegroundBrush}" />
                </StackPanel>

                <!-- Tags -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Tags"
                              FontWeight="SemiBold"
                              FontSize="13"
                              Foreground="{StaticResource ForegroundBrush}" />

                    <!-- Add Tag Input -->
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0"
                                Text="{Binding NewTag}"
                                Watermark="Add a tag..."
                                Margin="0,0,8,0" />
                        <Button Grid.Column="1"
                               Classes="secondary"
                               Content="Add"
                               Command="{Binding AddTagCommand}"
                               MinWidth="80" />
                    </Grid>

                    <!-- Tag List -->
                    <ItemsControl ItemsSource="{Binding Tags}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Classes="tag"
                                       Content="{Binding .}"
                                       Command="{Binding $parent[Window].DataContext.RemoveTagCommand}"
                                       CommandParameter="{Binding .}"
                                       ToolTip.Tip="Click to remove" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="2"
              ColumnDefinitions="*,Auto,Auto"
              Margin="0,20,0,0">
            <StackPanel Grid.Column="0"
                       Orientation="Horizontal"
                       Spacing="8"
                       VerticalAlignment="Center">
                <TextBlock Text="💡"
                          FontSize="16"
                          VerticalAlignment="Center" />
                <TextBlock Text="Use tags to organize and filter save states"
                          FontSize="12"
                          Opacity="0.6"
                          VerticalAlignment="Center"
                          Foreground="{StaticResource ForegroundBrush}" />
            </StackPanel>

            <Button Grid.Column="1"
                   Classes="secondary"
                   Content="Cancel"
                   Command="{Binding CancelCommand}"
                   Margin="0,0,12,0" />

            <Button Grid.Column="2"
                   Classes="primary"
                   Content="Save Changes"
                   Command="{Binding SaveCommand}"
                   IsEnabled="{Binding CanSave}" />
        </Grid>
    </Grid>
</Window>
