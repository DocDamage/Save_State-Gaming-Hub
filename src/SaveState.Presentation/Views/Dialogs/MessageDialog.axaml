<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SaveState.Presentation.ViewModels.Dialogs"
        x:Class="SaveState.Presentation.Views.Dialogs.MessageDialog"
        x:DataType="vm:MessageDialogViewModel"
        Title="{Binding Title}"
        Width="450"
        Height="220"
        MinWidth="350"
        MinHeight="180"
        MaxWidth="600"
        MaxHeight="300"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{StaticResource DialogBackgroundBrush}">

    <Window.Styles>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="24,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinWidth" Value="120" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*,Auto" Margin="24">
        <!-- Content -->
        <StackPanel Grid.Row="0" Spacing="16" VerticalAlignment="Center">
            <TextBlock Text="{Binding Icon}"
                      FontSize="48"
                      HorizontalAlignment="Center"
                      Margin="0,0,0,8" />

            <TextBlock Text="{Binding Message}"
                      FontSize="15"
                      TextWrapping="Wrap"
                      TextAlignment="Center"
                      HorizontalAlignment="Center"
                      MaxWidth="400"
                      Foreground="{StaticResource ForegroundBrush}" />
        </StackPanel>

        <!-- Button -->
        <Grid Grid.Row="1"
              Margin="0,20,0,0">
            <Button Classes="primary"
                   Content="OK"
                   Command="{Binding CloseCommand}"
                   HorizontalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
