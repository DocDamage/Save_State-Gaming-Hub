<!--
    MessageDialog.axaml
    
    Simple message dialog for displaying information, warnings, or errors.
    Shows an icon, message text, and an OK button.
    
    Dialog Types:
    - Information (ℹ️)
    - Warning (⚠️)
    - Error (❌)
    
    Usage: await IDialogService.ShowInformationAsync(title, message)
    
    Binding Context: MessageDialogViewModel
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SaveState.Presentation.ViewModels.Dialogs"
        x:Class="SaveState.Presentation.Views.Dialogs.MessageDialog"
        x:DataType="vm:MessageDialogViewModel"
        Title="{Binding Title}"
        Width="450"
        Height="220"
        MinWidth="400"
        MinHeight="200"
        MaxWidth="600"
        MaxHeight="300"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{StaticResource DialogBackgroundBrush}">

    <Grid RowDefinitions="*,Auto" Margin="24">
        <!-- Content -->
        <StackPanel Grid.Row="0" Spacing="16" VerticalAlignment="Center">
            <TextBlock Text="{Binding Icon}"
                      FontSize="48"
                      HorizontalAlignment="Center"
                      Margin="0,0,0,8" />

            <TextBlock Text="{Binding Message}"
                      FontSize="15"
                      TextWrapping="Wrap"
                      TextAlignment="Center"
                      HorizontalAlignment="Center"
                      MaxWidth="400"
                      Foreground="{StaticResource TextPrimaryBrush}" />
        </StackPanel>

        <!-- Button -->
        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Button Content="OK"
                   Classes="Primary"
                   Command="{Binding CloseCommand}"
                   HorizontalAlignment="Center"
                   ToolTip.Tip="Close this dialog"
                   AutomationProperties.Name="OK Button" />
        </Grid>
    </Grid>
</Window>
