<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:SaveState.Presentation.ViewModels.Dialogs"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="SaveState.Presentation.Views.Dialogs.BranchComparisonDialog"
        x:DataType="vm:BranchComparisonDialogViewModel"
        Title="Branch Comparison"
        Width="800" Height="600"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        TransparencyLevelHint="AcrylicBlur"
        Background="Transparent">

  <Panel>
    <ExperimentalAcrylicBorder IsHitTestVisible="False">
      <ExperimentalAcrylicBorder.Material>
        <ExperimentalAcrylicMaterial
            BackgroundSource="Digger"
            TintColor="{DynamicResource SystemChromeMediumColor}"
            TintOpacity="1"
            MaterialOpacity="0.65" />
      </ExperimentalAcrylicBorder.Material>
    </ExperimentalAcrylicBorder>

    <Border Background="{DynamicResource SolidBackgroundFillColorBase}"
            BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True">

      <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceStrokeColorDefault}"
                Padding="20,15"
                IsHitTestVisible="False">
            <Grid ColumnDefinitions="*, Auto, *">
                 <TextBlock Grid.Column="0" Text="{Binding LeftBranchName}"
                            HorizontalAlignment="Right"
                            Theme="{DynamicResource SubtitleTextBlockTheme}"
                            FontWeight="SemiBold"/>

                 <TextBlock Grid.Column="1" Text="↔" Margin="10,0" FontSize="20"/>

                 <TextBlock Grid.Column="2" Text="{Binding RightBranchName}"
                            HorizontalAlignment="Left"
                            Theme="{DynamicResource SubtitleTextBlockTheme}"
                            FontWeight="SemiBold"/>
            </Grid>
        </Border>

        <!-- Summary -->
        <Border Grid.Row="1" Padding="20,10" Background="{DynamicResource LayerFillColorDefault}">
            <StackPanel Orientation="Horizontal" Spacing="20" HorizontalAlignment="Center">
                 <StackPanel Orientation="Horizontal" Spacing="5">
                     <TextBlock Text="← Only in Left:" Opacity="0.7"/>
                     <TextBlock Text="{Binding AdditionsInLeft}" FontWeight="Bold"/>
                 </StackPanel>

                 <StackPanel Orientation="Horizontal" Spacing="5">
                     <TextBlock Text="✓ Common:" Opacity="0.7"/>
                     <TextBlock Text="{Binding CommonSaves}" FontWeight="Bold"/>
                 </StackPanel>

                 <StackPanel Orientation="Horizontal" Spacing="5">
                     <TextBlock Text="→ Only in Right:" Opacity="0.7"/>
                     <TextBlock Text="{Binding AdditionsInRight}" FontWeight="Bold"/>
                 </StackPanel>

                 <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding HasConflicts}">
                     <TextBlock Text="⚠️ Conflicts:" Foreground="#F44336" FontWeight="Bold"/>
                     <TextBlock Text="{Binding ConflictCount}" Foreground="#F44336" FontWeight="Bold"/>
                 </StackPanel>
            </StackPanel>
        </Border>

        <!-- List -->
        <ScrollViewer Grid.Row="2" Padding="10">
            <ItemsControl ItemsSource="{Binding Differences}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10" Margin="0,5" CornerRadius="4" Background="{DynamicResource LayerFillColorDefault}">
                            <Grid ColumnDefinitions="*, Auto, *">
                                <!-- Left Side -->
                                <Grid Grid.Column="0" RowDefinitions="Auto, Auto" Opacity="{Binding LeftTimestamp, Converter={x:Static ObjectConverters.IsNotNull}, ConverterParameter=1.0, FallbackValue=0.3}">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="5">
                                        <TextBlock Text="{Binding LeftTimestampText}" FontSize="11" Opacity="0.7"/>
                                        <TextBlock Text="{Binding LeftSizeText}" FontSize="11" Opacity="0.7"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Center Status -->
                                <Border Grid.Column="1" Margin="20,0"
                                        CornerRadius="15" Width="30" Height="30"
                                        Background="{Binding StatusColor}"
                                        ToolTip.Tip="{Binding StatusText}">
                                    <TextBlock Text="{Binding StatusIcon}"
                                               Foreground="White" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Right Side -->
                                <Grid Grid.Column="2" RowDefinitions="Auto, Auto" Opacity="{Binding RightTimestamp, Converter={x:Static ObjectConverters.IsNotNull}, ConverterParameter=1.0, FallbackValue=0.3}">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Spacing="5">
                                        <TextBlock Text="{Binding RightTimestampText}" FontSize="11" Opacity="0.7"/>
                                        <TextBlock Text="{Binding RightSizeText}" FontSize="11" Opacity="0.7"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="3"
                Padding="20"
                Background="{DynamicResource SurfaceStrokeColorDefault}">
          <Button Content="Close"
                  HorizontalAlignment="Right"
                  Command="{Binding CloseCommand}"/>
        </Border>
      </Grid>
    </Border>
  </Panel>
</Window>
