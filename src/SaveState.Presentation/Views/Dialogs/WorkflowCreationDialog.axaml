<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:SaveState.Presentation.ViewModels.Dialogs"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="400"
        x:Class="SaveState.Presentation.Views.Dialogs.WorkflowCreationDialog"
        x:DataType="vm:WorkflowCreationDialogViewModel"
        Width="400" Height="400"
        WindowStartupLocation="CenterOwner"
        Title="Create Workflow"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        SystemDecorations="None"
        TransparencyLevelHint="AcrylicBlur"
        Background="Transparent">

    <Border Classes="DialogSurface">
        <Grid RowDefinitions="Auto, *, Auto">
            <!-- Header -->
            <TextBlock Grid.Row="0" Text="Create Workflow" Classes="DialogTitle" />

            <!-- Content -->
            <StackPanel Grid.Row="1" Spacing="20" Margin="0,20">
                <StackPanel Spacing="8">
                    <TextBlock Text="Workflow Name" Classes="Label" />
                    <TextBox Text="{Binding Name}" Watermark="e.g., Optimize &amp; Launch" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Description" Classes="Label" />
                    <TextBox Text="{Binding Description}"
                             Height="80"
                             AcceptsReturn="True"
                             TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Icon" Classes="Label" />
                    <TextBox Text="{Binding Icon}" MaxLength="2" Width="60" HorizontalAlignment="Left" />
                </StackPanel>
            </StackPanel>

            <!-- Footer -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button Content="Cancel" Classes="Secondary" Click="OnCancelClick" />
                <Button Content="Create Workflow" Classes="Primary" Click="OnSaveClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
