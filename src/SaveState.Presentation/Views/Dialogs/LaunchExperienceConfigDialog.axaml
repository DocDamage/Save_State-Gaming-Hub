<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SaveState.Presentation.ViewModels.Dialogs"
        xmlns:dto="clr-namespace:SaveState.Core.GameLibrary.Services.DTOs;assembly=SaveState.Core"
        x:Class="SaveState.Presentation.Views.Dialogs.LaunchExperienceConfigDialog"
        x:DataType="vm:LaunchExperienceConfigDialogViewModel"
        Title="Launch Experience Settings"
        Width="550"
        Height="650"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#FF1E1E1E">

  <Design.DataContext>
    <vm:LaunchExperienceConfigDialogViewModel/>
  </Design.DataContext>

  <Window.Styles>
    <!-- Card Style -->
    <Style Selector="Border.Card">
      <Setter Property="Background" Value="#15FFFFFF"/>
      <Setter Property="BorderBrush" Value="#25FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
    </Style>

    <!-- Typography -->
    <Style Selector="TextBlock.H4">
      <Setter Property="FontSize" Value="24"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style Selector="TextBlock.H6">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style Selector="TextBlock.Body">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="#FFCCCCCC"/>
    </Style>

    <Style Selector="TextBlock.Caption">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Opacity" Value="0.7"/>
      <Setter Property="Foreground" Value="#FFAAAAAA"/>
    </Style>

    <!-- ToggleSwitch Style -->
    <Style Selector="ToggleSwitch">
      <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- ComboBox Style -->
    <Style Selector="ComboBox">
      <Setter Property="Background" Value="#20FFFFFF"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#40FFFFFF"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="12,8"/>
    </Style>

    <!-- Accent Button -->
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="#FF00CCFF"/>
      <Setter Property="Foreground" Value="#FF000000"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="24,12"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>

    <!-- Secondary Button -->
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="#20FFFFFF"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="24,12"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>

    <!-- Text Button -->
    <Style Selector="Button.text">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#FF00CCFF"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="12,8"/>
    </Style>
  </Window.Styles>

  <Border Background="#FF1E1E1E">
    <Grid RowDefinitions="Auto,*">
      <!-- Header -->
      <Border Background="#15FFFFFF"
              BorderBrush="#25FFFFFF"
              BorderThickness="0,0,0,1"
              Padding="24,20"
              Grid.Row="0">
        <StackPanel Spacing="4">
          <TextBlock Text="🎬 Launch Experience" Classes="H4"/>
          <TextBlock Text="Customize the cinematic game startup experience"
                     Classes="Body"
                     Opacity="0.8"/>
        </StackPanel>
      </Border>

      <!-- Content -->
      <ScrollViewer Grid.Row="1">
        <StackPanel Margin="24" Spacing="20">

          <!-- Enable Cinematic Launch -->
          <Border Classes="Card" Padding="20">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Enable Cinematic Launch" Classes="H6"/>
                <TextBlock Text="Show an immersive overlay when launching games"
                           Classes="Caption"/>
              </StackPanel>
              <ToggleSwitch Grid.Column="1"
                            IsChecked="{Binding EnableCinematicLaunch}"
                            VerticalAlignment="Center"/>
            </Grid>
          </Border>

          <!-- Settings Panel (enabled/disabled based on toggle) -->
          <StackPanel Spacing="20"
                      IsEnabled="{Binding EnableCinematicLaunch}">
            <StackPanel.Styles>
              <Style Selector="StackPanel:disabled">
                <Setter Property="Opacity" Value="0.4"/>
              </Style>
            </StackPanel.Styles>

            <!-- Animation Duration -->
            <Border Classes="Card" Padding="20">
              <StackPanel Spacing="12">
                <TextBlock Text="⏱ Animation Duration" Classes="H6"/>
                <TextBlock Text="How long to show the launch experience"
                           Classes="Caption"/>
                <ComboBox ItemsSource="{Binding DurationOptions}"
                          SelectedItem="{Binding SelectedDuration, Converter={StaticResource DurationOptionConverter}}"
                          Width="280"
                          HorizontalAlignment="Left">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:AnimationDurationOption">
                      <StackPanel>
                        <TextBlock Text="{Binding DisplayName}" Foreground="White"/>
                      </StackPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
            </Border>

            <!-- Background Style -->
            <Border Classes="Card" Padding="20">
              <StackPanel Spacing="12">
                <TextBlock Text="🎨 Background Style" Classes="H6"/>
                <TextBlock Text="Choose the visual style for the launch overlay"
                           Classes="Caption"/>
                <ComboBox ItemsSource="{Binding BackgroundStyleOptions}"
                          SelectedItem="{Binding SelectedBackgroundStyle, Converter={StaticResource BackgroundStyleOptionConverter}}"
                          Width="280"
                          HorizontalAlignment="Left">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:BackgroundStyleOption">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding DisplayName}" Foreground="White"/>
                        <TextBlock Text="{Binding Description}"
                                   FontSize="11"
                                   Foreground="#FF888888"/>
                      </StackPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
            </Border>

            <!-- Display Options -->
            <Border Classes="Card" Padding="20">
              <StackPanel Spacing="16">
                <TextBlock Text="👁 Display Options" Classes="H6"/>

                <!-- AI Briefing -->
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Show AI Briefing" Classes="Body"/>
                    <TextBlock Text="Display AI-generated game tagline and objectives"
                               Classes="Caption"/>
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                IsChecked="{Binding ShowAiBriefing}"
                                VerticalAlignment="Center"/>
                </Grid>

                <!-- Tips -->
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Show Tips" Classes="Body"/>
                    <TextBlock Text="Rotate helpful gameplay tips during launch"
                               Classes="Caption"/>
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                IsChecked="{Binding ShowTips}"
                                VerticalAlignment="Center"/>
                </Grid>

                <!-- Last Session -->
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Show Last Session Summary" Classes="Body"/>
                    <TextBlock Text="Display information about your previous play session"
                               Classes="Caption"/>
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                IsChecked="{Binding ShowLastSessionSummary}"
                                VerticalAlignment="Center"/>
                </Grid>

                <!-- Achievements -->
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Show Recent Achievements" Classes="Body"/>
                    <TextBlock Text="Display recently unlocked achievements"
                               Classes="Caption"/>
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                IsChecked="{Binding ShowAchievements}"
                                VerticalAlignment="Center"/>
                </Grid>

                <!-- Playtime -->
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Show Total Playtime" Classes="Body"/>
                    <TextBlock Text="Display your total time played"
                               Classes="Caption"/>
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                IsChecked="{Binding ShowPlaytime}"
                                VerticalAlignment="Center"/>
                </Grid>

                <!-- Allow Skip -->
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Allow Skip" Classes="Body"/>
                    <TextBlock Text="Let users skip the launch experience with Space/Enter"
                               Classes="Caption"/>
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                IsChecked="{Binding AllowSkip}"
                                VerticalAlignment="Center"/>
                </Grid>
              </StackPanel>
            </Border>

          </StackPanel>

          <!-- Reset to Defaults -->
          <Button Content="↺ Reset to Defaults"
                  Command="{Binding ResetToDefaultsCommand}"
                  Classes="text"
                  HorizontalAlignment="Left"/>

          <!-- Buttons -->
          <Border BorderBrush="#25FFFFFF"
                  BorderThickness="0,1,0,0"
                  Padding="0,20,0,0"
                  Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="12">
              <Button Content="Cancel"
                      Command="{Binding CancelCommand}"
                      Classes="secondary"/>
              <Button Content="Save Settings"
                      Command="{Binding SaveCommand}"
                      Classes="accent"/>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Border>

</Window>
