<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SaveState.Presentation.ViewModels.Dialogs"
        x:Class="SaveState.Presentation.Views.Dialogs.MemoryDetailsDialog"
        x:DataType="vm:MemoryDetailsDialogViewModel"
        Title="Conversation Memory Details"
        Width="900"
        Height="700"
        MinWidth="800"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

  <Grid RowDefinitions="Auto,*,Auto" Margin="20">
    <!-- Header -->
    <StackPanel Grid.Row="0" Spacing="12" Margin="0,0,0,16">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="4">
          <TextBlock Text="💬 Conversation Memory Details" Classes="Header" FontSize="22" />
          <TextBlock Text="View, search, and manage stored conversations."
                     Classes="Caption"
                     Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>
        <Button Grid.Column="1"
                Content="✕"
                Classes="Secondary"
                Click="OnCloseClick"
                VerticalAlignment="Top" />
      </Grid>

      <!-- Statistics -->
      <Border Background="{StaticResource SystemControlBackgroundAltHighBrush}"
              CornerRadius="8"
              Padding="16">
        <Grid ColumnDefinitions="*,*,*,*">
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding TotalCount}" 
                       FontSize="24" 
                       FontWeight="Bold" />
            <TextBlock Text="Total Conversations" Classes="Caption" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="4">
            <TextBlock Text="{Binding TotalMessageCount}" 
                       FontSize="24" 
                       FontWeight="Bold" />
            <TextBlock Text="Total Messages" Classes="Caption" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="4">
            <TextBlock Text="{Binding AverageConversationLength, StringFormat='{}{0:F1}'}" 
                       FontSize="24" 
                       FontWeight="Bold" />
            <TextBlock Text="Avg. Length" Classes="Caption" />
          </StackPanel>
          <StackPanel Grid.Column="3" Spacing="4">
            <TextBlock Text="{Binding FormattedTotalMemory}" 
                       FontSize="24" 
                       FontWeight="Bold" />
            <TextBlock Text="Total Memory" Classes="Caption" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Search and Filter Bar -->
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
        <TextBox Grid.Column="0"
                 Text="{Binding SearchQuery}"
                 Watermark="🔍 Search conversations..."
                 VerticalAlignment="Center" />
        
        <ComboBox Grid.Column="1"
                  ItemsSource="{Binding SortOptions}"
                  SelectedItem="{Binding SelectedSortOption}"
                  Width="180"
                  VerticalAlignment="Center" />
        
        <Button Grid.Column="2"
                Content="🔄 Refresh"
                Command="{Binding RefreshCommand}"
                VerticalAlignment="Center" />
      </Grid>

      <!-- Filtered count indicator -->
      <TextBlock Text="{Binding FilteredCount, StringFormat='Showing {0} of {1} conversations', FallbackValue='Showing all conversations'}"
                 Classes="Caption"
                 Foreground="{StaticResource TextSecondaryBrush}"
                 IsVisible="{Binding SearchQuery, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>

    <!-- Content Area -->
    <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="16">
      <!-- Conversation List -->
      <Border Grid.Column="0" 
              BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
              BorderThickness="1"
              CornerRadius="8">
        <Grid RowDefinitions="*,Auto">
          <!-- Loading Indicator -->
          <Panel Grid.Row="0" 
                 IsVisible="{Binding IsLoading}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center">
            <StackPanel Spacing="8">
              <ProgressBar IsIndeterminate="True" Width="200" />
              <TextBlock Text="Loading conversations..." 
                         HorizontalAlignment="Center"
                         Classes="Caption" />
            </StackPanel>
          </Panel>

          <!-- List -->
          <ListBox Grid.Row="0"
                   ItemsSource="{Binding FilteredConversations}"
                   SelectedItem="{Binding SelectedConversation}"
                   IsVisible="{Binding !IsLoading}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Padding="8" 
                        Background="Transparent"
                        ToolTip.Tip="Click to view full conversation">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                      <TextBlock Text="{Binding Title}" 
                                 FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Preview}"
                                 Classes="Caption"
                                 Foreground="{StaticResource TextSecondaryBrush}"
                                 TextTrimming="CharacterEllipsis"
                                 MaxLines="1" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding MessageCount, StringFormat='{}{0} messages'}" 
                                   Classes="Caption"
                                   FontSize="11" />
                        <TextBlock Text="•" Classes="Caption" FontSize="11" />
                        <TextBlock Text="{Binding FormattedMemoryUsage}" 
                                   Classes="Caption"
                                   FontSize="11" />
                        <TextBlock Text="•" Classes="Caption" FontSize="11" />
                        <TextBlock Text="{Binding LastMessageAt, StringFormat='{}{0:g}'}" 
                                   Classes="Caption"
                                   FontSize="11" />
                      </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" 
                                Orientation="Horizontal" 
                                Spacing="4"
                                VerticalAlignment="Center">
                      <Button Content="💾"
                              Command="{Binding DataContext.ExportConversationCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                              CommandParameter="{Binding}"
                              ToolTip.Tip="Export conversation"
                              Classes="IconButton"
                              Padding="6" />
                      <Button Content="🗑️"
                              Command="{Binding DataContext.DeleteConversationCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                              CommandParameter="{Binding}"
                              ToolTip.Tip="Delete conversation"
                              Classes="IconButton Danger"
                              Padding="6" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- Empty State -->
          <Panel Grid.Row="0"
                 IsVisible="{Binding FilteredConversations.Count, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=0}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center">
            <StackPanel Spacing="8" HorizontalAlignment="Center">
              <TextBlock Text="💬" FontSize="48" HorizontalAlignment="Center" />
              <TextBlock Text="No conversations found" 
                         FontWeight="SemiBold"
                         HorizontalAlignment="Center" />
              <TextBlock Text="Try adjusting your search query"
                         Classes="Caption"
                         Foreground="{StaticResource TextSecondaryBrush}"
                         HorizontalAlignment="Center" />
            </StackPanel>
          </Panel>

          <!-- Bulk Actions -->
          <Border Grid.Row="1" 
                  BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                  BorderThickness="0,1,0,0"
                  Padding="12">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Delete All"
                      Command="{Binding DeleteAllConversationsCommand}"
                      Classes="Danger"
                      IsEnabled="{Binding Conversations.Count, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter=0}" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- Preview Panel -->
      <Border Grid.Column="1"
              BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
              BorderThickness="1"
              CornerRadius="8">
        <Grid RowDefinitions="Auto,*">
          <Border Grid.Row="0"
                  Background="{StaticResource SystemControlBackgroundAltHighBrush}"
                  CornerRadius="8,8,0,0"
                  Padding="12">
            <TextBlock Text="Preview" FontWeight="SemiBold" />
          </Border>
          
          <ScrollViewer Grid.Row="1" Margin="12">
            <TextBlock Text="{Binding ConversationPreview}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding SelectedConversation, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </ScrollViewer>
          
          <Panel Grid.Row="1"
                 IsVisible="{Binding SelectedConversation, Converter={x:Static ObjectConverters.IsNull}}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center">
            <StackPanel Spacing="8" HorizontalAlignment="Center">
              <TextBlock Text="👈" FontSize="48" HorizontalAlignment="Center" />
              <TextBlock Text="Select a conversation to view details"
                         Classes="Caption"
                         Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
          </Panel>
        </Grid>
      </Border>
    </Grid>

    <!-- Footer -->
    <StackPanel Grid.Row="2" 
                Orientation="Horizontal" 
                HorizontalAlignment="Right"
                Spacing="12"
                Margin="0,16,0,0">
      <Button Content="Close"
              Classes="Primary"
              Width="100"
              Click="OnCloseClick" />
    </StackPanel>
  </Grid>
</Window>
