<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:SaveState.Presentation.ViewModels.Dialogs"
        mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="600"
        x:Class="SaveState.Presentation.Views.Dialogs.AccountConnectionWizard"
        x:DataType="vm:AccountConnectionWizardViewModel"
        Title="Connect Account"
        Width="700" Height="600"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        TransparencyLevelHint="AcrylicBlur"
        Background="Transparent">

  <Panel>
    <ExperimentalAcrylicBorder IsHitTestVisible="False">
      <ExperimentalAcrylicBorder.Material>
        <ExperimentalAcrylicMaterial
            BackgroundSource="Digger"
            TintColor="{DynamicResource SystemChromeMediumColor}"
            TintOpacity="1"
            MaterialOpacity="0.65" />
      </ExperimentalAcrylicBorder.Material>
    </ExperimentalAcrylicBorder>

    <Border Background="{DynamicResource SolidBackgroundFillColorBase}"
            BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True">

      <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceStrokeColorDefault}"
                Padding="20,15"
                IsHitTestVisible="False">
          <TextBlock Text="Connect External Account"
                     Theme="{DynamicResource SubtitleTextBlockTheme}"
                     FontWeight="SemiBold"/>
        </Border>

        <!-- Stepper -->
        <Border Grid.Row="1" Padding="20,15">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
            <!-- Step 1 -->
            <Border Classes.step="{Binding StepSelectProviderVisible}"
                    Classes.completed="{Binding CurrentStep, Converter={x:Static ObjectConverters.GreaterThan}, ConverterParameter=1}"
                    Width="32" Height="32" CornerRadius="16">
              <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
            </Border>
            <TextBlock Text="Platform" VerticalAlignment="Center" Classes="Caption"/>
            <Separator Width="30"/>

            <!-- Step 2 -->
            <Border Classes.step="{Binding StepAuthenticationVisible}"
                    Classes.completed="{Binding CurrentStep, Converter={x:Static ObjectConverters.GreaterThan}, ConverterParameter=2}"
                    Width="32" Height="32" CornerRadius="16">
              <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
            </Border>
            <TextBlock Text="Auth" VerticalAlignment="Center" Classes="Caption"/>
            <Separator Width="30"/>

            <!-- Step 3 -->
            <Border Classes.step="{Binding StepPermissionsVisible}"
                    Classes.completed="{Binding CurrentStep, Converter={x:Static ObjectConverters.GreaterThan}, ConverterParameter=3}"
                    Width="32" Height="32" CornerRadius="16">
              <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
            </Border>
            <TextBlock Text="Permissions" VerticalAlignment="Center" Classes="Caption"/>
            <Separator Width="30"/>

            <!-- Step 4 -->
            <Border Classes.step="{Binding StepTestConnectionVisible}"
                    Classes.completed="{Binding CurrentStep, Converter={x:Static ObjectConverters.GreaterThan}, ConverterParameter=4}"
                    Width="32" Height="32" CornerRadius="16">
              <TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
            </Border>
            <TextBlock Text="Test" VerticalAlignment="Center" Classes="Caption"/>
            <Separator Width="30"/>

            <!-- Step 5 -->
            <Border Classes.step="{Binding StepCompleteVisible}"
                    Width="32" Height="32" CornerRadius="16">
              <TextBlock Text="5" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
            </Border>
            <TextBlock Text="Complete" VerticalAlignment="Center" Classes="Caption"/>
          </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="2" Margin="40,20">

          <!-- Step 1: Select Provider -->
          <StackPanel IsVisible="{Binding StepSelectProviderVisible}" Spacing="24">
            <StackPanel Spacing="8">
              <TextBlock Text="Select Platform" Classes="TitleTextBlockStyle"/>
              <TextBlock Text="Choose the gaming platform or service you want to connect."
                         Classes="CaptionTextBlockStyle" Opacity="0.8"/>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding AvailableProviders}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="x:String">
                  <Button Command="{Binding DataContext.SelectProviderCommand, 
                                   RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding}"
                          Classes="ProviderButton"
                          Margin="8">
                    <Grid RowDefinitions="Auto,Auto" HorizontalAlignment="Center">
                      <TextBlock Grid.Row="0" 
                                 Text="{Binding, Converter={StaticResource ProviderToIconConverter}}"
                                 FontSize="32" 
                                 HorizontalAlignment="Center"/>
                      <TextBlock Grid.Row="1" 
                                 Text="{Binding, Converter={StaticResource ProviderToDisplayNameConverter}}"
                                 Classes="BodyStrong"
                                 HorizontalAlignment="Center"
                                 Margin="0,8,0,0"/>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                    CornerRadius="8"
                    Padding="16"
                    IsVisible="{Binding SelectedProvider, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <StackPanel Spacing="8">
                <TextBlock Text="Selected:" Classes="Caption"/>
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <TextBlock Text="{Binding SelectedProviderIcon}" FontSize="24"/>
                  <TextBlock Text="{Binding SelectedProviderDisplayName}" 
                             FontWeight="Bold" 
                             Foreground="{DynamicResource SystemAccentColor}"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Step 2: Authentication -->
          <StackPanel IsVisible="{Binding StepAuthenticationVisible}" Spacing="24">
            <StackPanel Spacing="8">
              <TextBlock Text="Authentication" Classes="TitleTextBlockStyle"/>
              <TextBlock Text="{Binding SelectedProviderDisplayName, StringFormat='Connect your {0} account'}"
                         Classes="CaptionTextBlockStyle" Opacity="0.8"/>
            </StackPanel>

            <!-- OAuth Flow -->
            <StackPanel IsVisible="{Binding UsesOAuth}" Spacing="16">
              <Border Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                      CornerRadius="8"
                      Padding="20">
                <StackPanel Spacing="16">
                  <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding SelectedProviderIcon}" FontSize="48"/>
                    <TextBlock Text="🔗" FontSize="32"/>
                    <TextBlock Text="💾" FontSize="48"/>
                  </StackPanel>

                  <TextBlock Text="We'll open your browser to authenticate with the selected service."
                             TextWrapping="Wrap"
                             HorizontalAlignment="Center"
                             TextAlignment="Center"/>

                  <TextBlock Text="After signing in, you'll be redirected back to SaveState Reborn."
                             Classes="Caption"
                             Opacity="0.7"
                             TextWrapping="Wrap"
                             HorizontalAlignment="Center"
                             TextAlignment="Center"/>
                </StackPanel>
              </Border>

              <TextBlock Text="Your credentials are never stored. We use OAuth tokens for secure access."
                         Classes="Caption"
                         Opacity="0.6"
                         TextWrapping="Wrap"
                         HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- API Key Flow -->
            <StackPanel IsVisible="{Binding UsesApiKey}" Spacing="16">
              <Border Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                      CornerRadius="8"
                      Padding="20">
                <StackPanel Spacing="16">
                  <TextBlock Text="Enter your API Key"
                             Classes="BodyStrong"
                             HorizontalAlignment="Center"/>

                  <TextBox Text="{Binding ApiKey}"
                           Watermark="Paste your API key here"
                           PasswordChar="•"
                           Classes="Large"/>

                  <TextBlock TextWrapping="Wrap" Classes="Caption" Opacity="0.8">
                    <Run Text="You can find your API key in your "/>
                    <Run Text="{Binding SelectedProviderDisplayName}" FontWeight="Bold"/>
                    <Run Text=" account settings under 'API' or 'Integrations'."/>
                  </TextBlock>
                </StackPanel>
              </Border>
            </StackPanel>
          </StackPanel>

          <!-- Step 3: Permissions -->
          <StackPanel IsVisible="{Binding StepPermissionsVisible}" Spacing="24">
            <StackPanel Spacing="8">
              <TextBlock Text="Permissions" Classes="TitleTextBlockStyle"/>
              <TextBlock Text="Select what data SaveState Reborn can access from your account."
                         Classes="CaptionTextBlockStyle" Opacity="0.8"/>
            </StackPanel>

            <Border Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                    CornerRadius="8"
                    Padding="20">
              <StackPanel Spacing="16">
                <TextBlock Text="Access Permissions" Classes="BodyStrong"/>

                <ToggleSwitch Content="Access your game library"
                              IsChecked="{Binding AllowLibraryAccess}"
                              OnContent="Yes" OffContent="No"/>
                <TextBlock Text="Import your games and playtime statistics."
                           Classes="Caption" Opacity="0.6" Margin="0,-12,0,0"/>

                <ToggleSwitch Content="Access achievements"
                              IsChecked="{Binding AllowAchievementsAccess}"
                              OnContent="Yes" OffContent="No"/>
                <TextBlock Text="Sync achievement progress and unlocks."
                           Classes="Caption" Opacity="0.6" Margin="0,-12,0,0"/>

                <ToggleSwitch Content="Access playtime data"
                              IsChecked="{Binding AllowPlaytimeAccess}"
                              OnContent="Yes" OffContent="No"/>
                <TextBlock Text="Track how long you've played each game."
                           Classes="Caption" Opacity="0.6" Margin="0,-12,0,0"/>

                <ToggleSwitch Content="Access friends list"
                              IsChecked="{Binding AllowFriendsAccess}"
                              OnContent="Yes" OffContent="No"/>
                <TextBlock Text="See what your friends are playing (optional)."
                           Classes="Caption" Opacity="0.6" Margin="0,-12,0,0"/>
              </StackPanel>
            </Border>

            <TextBlock Text="You can change these permissions at any time in account settings."
                       Classes="Caption"
                       Opacity="0.6"
                       HorizontalAlignment="Center"/>
          </StackPanel>

          <!-- Step 4: Test Connection -->
          <StackPanel IsVisible="{Binding StepTestConnectionVisible}" Spacing="24">
            <StackPanel Spacing="8">
              <TextBlock Text="Test Connection" Classes="TitleTextBlockStyle"/>
              <TextBlock Text="Verify that we can connect to your account."
                         Classes="CaptionTextBlockStyle" Opacity="0.8"/>
            </StackPanel>

            <Border Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                    CornerRadius="8"
                    Padding="24">
              <StackPanel Spacing="20">
                <!-- Test Button -->
                <Button Content="Test Connection"
                        Command="{Binding TestConnectionCommand}"
                        IsEnabled="{Binding IsLoading, Converter={x:Static BoolConverters.Not}}"
                        HorizontalAlignment="Center"
                        Classes="Large Accent"/>

                <!-- Loading Indicator -->
                <StackPanel IsVisible="{Binding IsLoading}" Spacing="12">
                  <ProgressBar IsIndeterminate="True" HorizontalAlignment="Stretch"/>
                  <TextBlock Text="{Binding StatusMessage}" 
                             HorizontalAlignment="Center" 
                             Classes="Caption"/>
                </StackPanel>

                <!-- Test Result -->
                <StackPanel IsVisible="{Binding ConnectionTested}" Spacing="12">
                  <StackPanel IsVisible="{Binding TestResult.Success}" Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                      <TextBlock Text="✅" FontSize="32"/>
                      <StackPanel>
                        <TextBlock Text="Connection Successful!" 
                                   Classes="BodyStrong" 
                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                        <TextBlock Text="{Binding TestResult.Username, StringFormat='Authenticated as: {0}'}"
                                   Classes="Caption"/>
                      </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{Binding TestResult.ResponseTime, StringFormat='Response time: {0:F0}ms'}"
                               Classes="Caption" 
                               Opacity="0.6"
                               HorizontalAlignment="Center"/>
                  </StackPanel>

                  <StackPanel IsVisible="{Binding TestResult.Success, Converter={x:Static BoolConverters.Not}}" Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                      <TextBlock Text="❌" FontSize="32"/>
                      <StackPanel>
                        <TextBlock Text="Connection Failed" 
                                   Classes="BodyStrong" 
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                        <TextBlock Text="{Binding TestResult.ErrorMessage}"
                                   Classes="Caption"
                                   TextWrapping="Wrap"
                                   MaxWidth="400"/>
                      </StackPanel>
                    </StackPanel>
                    <Button Content="Retry"
                            Command="{Binding TestConnectionCommand}"
                            Classes="Small"
                            HorizontalAlignment="Center"/>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Step 5: Complete -->
          <StackPanel IsVisible="{Binding StepCompleteVisible}" Spacing="24" VerticalAlignment="Center">
            <StackPanel Spacing="16" HorizontalAlignment="Center">
              <TextBlock Text="🎉" FontSize="64" HorizontalAlignment="Center"/>
              <TextBlock Text="Account Connected!" 
                         Classes="TitleTextBlockStyle"
                         HorizontalAlignment="Center"/>
            </StackPanel>

            <Border Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                    CornerRadius="8"
                    Padding="24">
              <StackPanel Spacing="16">
                <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
                  <TextBlock Text="{Binding SelectedProviderIcon}" FontSize="48"/>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedProviderDisplayName}" Classes="BodyStrong"/>
                    <TextBlock Text="{Binding TestResult.Username}" Classes="Caption" Opacity="0.8"/>
                  </StackPanel>
                </StackPanel>

                <Separator/>

                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" HorizontalAlignment="Center">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Library Access:" Classes="Caption" Margin="0,4"/>
                  <TextBlock Grid.Row="0" Grid.Column="1" 
                             Text="{Binding AllowLibraryAccess, Converter={StaticResource BoolToYesNoConverter}}"
                             Classes="Caption" Margin="8,4,0,4"/>

                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Achievements:" Classes="Caption" Margin="0,4"/>
                  <TextBlock Grid.Row="1" Grid.Column="1" 
                             Text="{Binding AllowAchievementsAccess, Converter={StaticResource BoolToYesNoConverter}}"
                             Classes="Caption" Margin="8,4,0,4"/>

                  <TextBlock Grid.Row="2" Grid.Column="0" Text="Playtime Tracking:" Classes="Caption" Margin="0,4"/>
                  <TextBlock Grid.Row="2" Grid.Column="1" 
                             Text="{Binding AllowPlaytimeAccess, Converter={StaticResource BoolToYesNoConverter}}"
                             Classes="Caption" Margin="8,4,0,4"/>

                  <TextBlock Grid.Row="3" Grid.Column="0" Text="Friends List:" Classes="Caption" Margin="0,4"/>
                  <TextBlock Grid.Row="3" Grid.Column="1" 
                             Text="{Binding AllowFriendsAccess, Converter={StaticResource BoolToYesNoConverter}}"
                             Classes="Caption" Margin="8,4,0,4"/>
                </Grid>
              </StackPanel>
            </Border>

            <TextBlock Text="Your games and achievements will now sync automatically."
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Opacity="0.8"/>
          </StackPanel>

        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="3"
                Padding="20"
                Background="{DynamicResource SurfaceStrokeColorDefault}">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Button Grid.Column="0" 
                    Content="Cancel" 
                    Command="{Binding CancelCommand}"
                    Classes="Flat"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
              <Button Content="Back" 
                      Command="{Binding PreviousStepCommand}" 
                      IsVisible="{Binding ShowBackButton}"
                      IsEnabled="{Binding CanGoBack}"/>
              <Button Content="{Binding NextButtonText}"
                      Classes="Accent"
                      Command="{Binding NextStepCommand}"
                      IsEnabled="{Binding CanGoNext}"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Panel>

  <Window.Styles>
    <!-- Step indicator styles -->
    <Style Selector="Border.step">
      <Setter Property="Background" Value="{DynamicResource SystemAccentColor}"/>
      <Setter Property="TextBlock.Foreground" Value="White"/>
    </Style>
    <Style Selector="Border.completed">
      <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
      <Setter Property="TextBlock.Foreground" Value="White"/>
    </Style>
    <Style Selector="Border:not(.step):not(.completed)">
      <Setter Property="Background" Value="{DynamicResource SurfaceStrokeColorDefault}"/>
      <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextFillColorPrimary}"/>
    </Style>

    <!-- Provider button style -->
    <Style Selector="Button.ProviderButton">
      <Setter Property="Width" Value="140"/>
      <Setter Property="Height" Value="120"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SurfaceStrokeColorDefault}"/>
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}"/>
    </Style>
    <Style Selector="Button.ProviderButton:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}"/>
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListMediumBrush}"/>
    </Style>
  </Window.Styles>
</Window>
