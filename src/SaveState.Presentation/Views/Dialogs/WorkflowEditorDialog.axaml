<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:SaveState.Presentation.ViewModels.Dialogs"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
        x:Class="SaveState.Presentation.Views.Dialogs.WorkflowEditorDialog"
        x:DataType="vm:WorkflowEditorDialogViewModel"
        Title="Workflow Editor"
        Width="1000" Height="700"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        TransparencyLevelHint="AcrylicBlur"
        Background="Transparent">

  <Panel>
    <ExperimentalAcrylicBorder IsHitTestVisible="False">
      <ExperimentalAcrylicBorder.Material>
        <ExperimentalAcrylicMaterial
            BackgroundSource="Digger"
            TintColor="{DynamicResource SystemChromeMediumColor}"
            TintOpacity="1"
            MaterialOpacity="0.65" />
      </ExperimentalAcrylicBorder.Material>
    </ExperimentalAcrylicBorder>

    <Border Background="{DynamicResource SolidBackgroundFillColorBase}"
            BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True">

      <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceStrokeColorDefault}"
                Padding="20,15"
                IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Workflow Editor:" Theme="{DynamicResource SubtitleTextBlockTheme}" VerticalAlignment="Center"/>
                <TextBox Text="{Binding WorkflowName}" Width="200"/>
            </StackPanel>
        </Border>

        <!-- Editor Area -->
        <Grid Grid.Row="1" ColumnDefinitions="250,*">
            <!-- Sidebar -->
            <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource SurfaceStrokeColorDefault}" Padding="15">
                <StackPanel Spacing="10">
                    <TextBlock Text="Triggers" FontWeight="Bold"/>
                    <Button Content="On Game Start" Command="{Binding AddNodeCommand}" CommandParameter="Game Start" HorizontalAlignment="Stretch"/>
                    <Button Content="On Save" Command="{Binding AddNodeCommand}" CommandParameter="Save Created" HorizontalAlignment="Stretch"/>
                    <Button Content="On Boss Fight" Command="{Binding AddNodeCommand}" CommandParameter="Boss Detected" HorizontalAlignment="Stretch"/>

                    <Separator/>

                    <TextBlock Text="Actions" FontWeight="Bold"/>
                    <Button Content="Backup Save" Command="{Binding AddNodeCommand}" CommandParameter="Backup" HorizontalAlignment="Stretch"/>
                    <Button Content="Upload to Cloud" Command="{Binding AddNodeCommand}" CommandParameter="Upload" HorizontalAlignment="Stretch"/>
                    <Button Content="Send Notification" Command="{Binding AddNodeCommand}" CommandParameter="Notify" HorizontalAlignment="Stretch"/>
                    <Button Content="Play Sound" Command="{Binding AddNodeCommand}" CommandParameter="Sound" HorizontalAlignment="Stretch"/>

                    <Separator/>
                    <Button Content="🔗 Connect Selected" Command="{Binding ConnectNodesCommand}" Classes="accent" HorizontalAlignment="Stretch"/>
                    <Button Content="🗑 Clear All" Command="{Binding ClearCommand}" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Border>

            <!-- Canvas (Simulated) -->
            <Canvas Grid.Column="1" Background="{DynamicResource LayerFillColorDefault}">
                <!-- Connections Layer -->
                <ItemsControl ItemsSource="{Binding Connections}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerTheme>
                        <ControlTheme TargetType="ContentPresenter">
                             <Setter Property="Canvas.Left" Value="{Binding Source.X}"/>
                             <Setter Property="Canvas.Top" Value="{Binding Source.Y}"/>
                        </ControlTheme>
                    </ItemsControl.ItemContainerTheme>
                     <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="Transparent" Padding="5">
                                <TextBlock Text="⬇" FontSize="20" Foreground="{DynamicResource SystemAccentColor}"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Nodes Layer -->
                <ItemsControl ItemsSource="{Binding Nodes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerTheme>
                        <ControlTheme TargetType="ContentPresenter">
                             <Setter Property="Canvas.Left" Value="{Binding X}"/>
                             <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                        </ControlTheme>
                    </ItemsControl.ItemContainerTheme>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceStrokeColorDefault}"
                                    BorderBrush="{DynamicResource SystemAccentColor}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="10"
                                    Width="150">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Type}" FontSize="11" Opacity="0.7"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Canvas>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2"
                Padding="20"
                Background="{DynamicResource SurfaceStrokeColorDefault}">
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Content="Cancel" Command="{Binding CloseCommand}"/>
            <Button Content="Save Workflow" Classes="accent" Command="{Binding SaveCommand}"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </Panel>
</Window>
