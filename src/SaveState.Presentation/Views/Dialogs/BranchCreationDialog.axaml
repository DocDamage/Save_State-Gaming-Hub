<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SaveState.Presentation.ViewModels.Dialogs"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="400"
        x:Class="SaveState.Presentation.Views.Dialogs.BranchCreationDialog"
        x:DataType="vm:BranchCreationDialogViewModel"
        Title="Create Branch"
        Width="500"
        Height="400"
        MinWidth="500"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="{StaticResource DialogBackgroundBrush}">

    <Grid RowDefinitions="Auto,*,Auto" Margin="24">
        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,20">
            <TextBlock Text="Create New Branch"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="Create a new save state branch for this game"
                       FontSize="14"
                       Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>

        <!-- Content -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16">
                <!-- Branch Name -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Branch Name"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBox Text="{Binding BranchName}"
                             Watermark="e.g. boss-fight-prep"
                             Background="{StaticResource InputBackgroundBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource InputBorderBrush}"
                             BorderThickness="1"
                             CornerRadius="8"
                             Padding="12,8" />
                </StackPanel>

                <!-- Description -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Description (Optional)"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBox Text="{Binding Description}"
                             Watermark="What is this branch for?"
                             Height="80"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Background="{StaticResource InputBackgroundBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource InputBorderBrush}"
                             BorderThickness="1"
                             CornerRadius="8"
                             Padding="12,8" />
                </StackPanel>

                <!-- Options -->
                <CheckBox IsChecked="{Binding CheckoutImmediately}"
                          Content="Switch to this branch immediately"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          ToolTip.Tip="Automatically switch to the new branch after creation" />
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="2"
              ColumnDefinitions="*,Auto,Auto"
              Margin="0,20,0,0">
            <Panel Grid.Column="0" />

            <Button Grid.Column="1"
                    Content="Cancel"
                    Command="{Binding CancelCommand}"
                    Classes="Secondary"
                    Margin="0,0,12,0"
                    ToolTip.Tip="Cancel branch creation"
                    AutomationProperties.Name="Cancel Button" />

            <Button Grid.Column="2"
                    Content="Create"
                    Command="{Binding ConfirmCommand}"
                    Classes="Primary"
                    ToolTip.Tip="Create the new branch"
                    AutomationProperties.Name="Create Branch Button" />
        </Grid>
    </Grid>
</Window>
