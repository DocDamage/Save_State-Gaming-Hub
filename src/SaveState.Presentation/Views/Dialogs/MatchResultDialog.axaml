<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SaveState.Presentation.ViewModels.Dialogs"
        x:Class="SaveState.Presentation.Views.Dialogs.MatchResultDialog"
        x:DataType="vm:MatchResultDialogViewModel"
        Title="Report Match Result"
        Width="550"
        Height="650"
        MinWidth="450"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="{StaticResource DialogBackgroundBrush}">

  <Window.Styles>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
      <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,8" />
    </Style>

    <Style Selector="NumericUpDown">
      <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
      <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Width" Value="80" />
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="24,10" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="24,10" />
    </Style>

    <Style Selector="Border.playerCard">
      <Setter Property="Background" Value="{StaticResource GlassBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16" />
    </Style>

    <Style Selector="Border.playerCard.winner">
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Background" Value="{StaticResource AccentBrush}20" />
    </Style>

    <Style Selector="Border.gameCard">
      <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Margin="24">
    <!-- Header -->
    <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,20">
      <TextBlock Text="🏆 Report Match Result"
                 FontSize="24"
                 FontWeight="Bold"
                 Foreground="{StaticResource ForegroundBrush}" />
      <TextBlock Text="Enter the final scores and winner"
                 FontSize="14"
                 Opacity="0.7"
                 Foreground="{StaticResource ForegroundBrush}" />
    </StackPanel>

    <!-- Content -->
    <ScrollViewer Grid.Row="1">
      <StackPanel Spacing="16">
        <!-- Players Score Card -->
        <Grid ColumnDefinitions="*,Auto,*" RowDefinitions="Auto,Auto">
          <!-- Player 1 -->
          <Border Grid.Row="0" Grid.Column="0" Classes="playerCard">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding Player1Name}"
                         FontSize="16"
                         FontWeight="SemiBold"
                         TextAlignment="Center" />
              <NumericUpDown Value="{Binding Player1Score}"
                             Minimum="0"
                             Maximum="99"
                             HorizontalAlignment="Center"
                             FontSize="20" />
              <Button Content="Set as Winner"
                      HorizontalAlignment="Center"
                      Command="{Binding SetWinnerCommand}"
                      CommandParameter="1"
                      IsVisible="{Binding WinnerId, Converter={x:Static ObjectConverters.IsNull}}" />
            </StackPanel>
          </Border>

          <!-- VS -->
          <TextBlock Grid.Row="0" Grid.Column="1"
                     Text="VS"
                     FontSize="18"
                     FontWeight="Bold"
                     VerticalAlignment="Center"
                     Margin="16,0" />

          <!-- Player 2 -->
          <Border Grid.Row="0" Grid.Column="2" Classes="playerCard">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding Player2Name}"
                         FontSize="16"
                         FontWeight="SemiBold"
                         TextAlignment="Center" />
              <NumericUpDown Value="{Binding Player2Score}"
                             Minimum="0"
                             Maximum="99"
                             HorizontalAlignment="Center"
                             FontSize="20" />
              <Button Content="Set as Winner"
                      HorizontalAlignment="Center"
                      Command="{Binding SetWinnerCommand}"
                      CommandParameter="2"
                      IsVisible="{Binding WinnerId, Converter={x:Static ObjectConverters.IsNull}}" />
            </StackPanel>
          </Border>

          <!-- Winner Display -->
          <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                  Classes="playerCard winner"
                  IsVisible="{Binding WinnerId, Converter={x:Static ObjectConverters.IsNotNull}}"
                  Margin="0,16,0,0">
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="🏆 WINNER"
                         FontSize="14"
                         FontWeight="Bold"
                         Opacity="0.7"
                         HorizontalAlignment="Center" />
              <TextBlock Text="{Binding Player1Score, Converter={StaticResource WinnerNameConverter}}"
                         FontSize="20"
                         FontWeight="Bold"
                         HorizontalAlignment="Center" />
            </StackPanel>
          </Border>
        </Grid>

        <!-- Game-by-Game Results -->
        <Border Classes="glassCard">
          <StackPanel Spacing="12">
            <TextBlock Text="Game Results (Optional)"
                       FontSize="16"
                       FontWeight="SemiBold" />

            <ItemsControl ItemsSource="{Binding GameResults}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:GameResultViewModel">
                  <Border Classes="gameCard">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,*">
                      <TextBlock Grid.Column="0"
                                 Text="{Binding GameLabel}"
                                 VerticalAlignment="Center" />

                      <NumericUpDown Grid.Column="1"
                                     Value="{Binding Player1Score}"
                                     Minimum="0"
                                     Maximum="99" />

                      <TextBlock Grid.Column="2"
                                 Text="-"
                                 Margin="8,0"
                                 VerticalAlignment="Center"
                                 FontWeight="Bold" />

                      <NumericUpDown Grid.Column="3"
                                     Value="{Binding Player2Score}"
                                     Minimum="0"
                                     Maximum="99" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Replay Upload -->
        <Border Classes="glassCard">
          <StackPanel Spacing="8">
            <TextBlock Text="Replay (Optional)"
                       FontSize="16"
                       FontWeight="SemiBold" />

            <Grid ColumnDefinitions="*,Auto">
              <TextBox Grid.Column="0"
                       Text="{Binding ReplayPath}"
                       Watermark="No replay selected"
                       IsReadOnly="True"
                       Margin="0,0,8,0" />
              <Button Grid.Column="1"
                      Classes="secondary"
                      Content="Browse..."
                      Command="{Binding SelectReplayCommand}" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- Notes -->
        <Border Classes="glassCard">
          <StackPanel Spacing="8">
            <TextBlock Text="Notes (Optional)"
                       FontSize="16"
                       FontWeight="SemiBold" />
            <TextBox Text="{Binding Notes}"
                     Watermark="Add any notes about the match..."
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="80" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- Footer -->
    <Grid Grid.Row="2"
          ColumnDefinitions="*,Auto,Auto"
          Margin="0,20,0,0">
      <StackPanel Grid.Column="0" VerticalAlignment="Center">
        <TextBlock Text="{Binding ValidationError}"
                   FontSize="12"
                   Foreground="{StaticResource ErrorBrush}"
                   IsVisible="{Binding ValidationError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>

      <Button Grid.Column="1"
              Classes="secondary"
              Content="Cancel"
              Command="{Binding CancelCommand}"
              Margin="0,0,12,0" />

      <Button Grid.Column="2"
              Classes="primary"
              Content="Submit Result"
              Command="{Binding SubmitCommand}"
              IsEnabled="{Binding CanSubmit}" />
    </Grid>
  </Grid>
</Window>
