<!--
    DownloadManagerDialog.axaml
    
    Download manager dialog with active and completed downloads.
    Shows progress bars, download speed, and file actions.
    
    Usage: await IDialogService.ShowDownloadManagerAsync()
    
    Binding Context: DownloadManagerDialogViewModel
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SaveState.Presentation.ViewModels.Dialogs"
        x:Class="SaveState.Presentation.Views.Dialogs.DownloadManagerDialog"
        x:DataType="vm:DownloadManagerDialogViewModel"
        Title="📥 Downloads"
        Width="700"
        Height="600"
        MinWidth="600"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource DialogBackgroundBrush}">

    <Window.Styles>
        <Style Selector="Border.download-item">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,8" />
        </Style>
        <Style Selector="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel>
                <TextBlock Text="📥 Download Manager"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding ActiveDownloadCount, StringFormat='{}{0} active downloads'}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="✕"
                    Command="{Binding CloseDialogCommand}"
                    Classes="widget-action" />
        </Grid>

        <!-- Search -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <TextBox Text="{Binding SearchQuery}"
                     Watermark="🔍 Search downloads..."
                     HorizontalAlignment="Stretch" />
        </Grid>

        <!-- Download Lists -->
        <TabControl Grid.Row="2" Margin="0,16,0,0">
            <!-- Active Downloads -->
            <TabItem Header="{Binding ActiveDownloadCount, StringFormat='Active ({0})'}">
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding FilteredActiveDownloads}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:DownloadItemViewModel">
                                <Border Classes="download-item">
                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto">
                                        <!-- File Info -->
                                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                            <StackPanel>
                                                <TextBlock Text="{Binding FileName}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Url}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding StatusText}"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Progress -->
                                        <ProgressBar Grid.Row="1"
                                                     Value="{Binding Progress}"
                                                     Maximum="1"
                                                     Margin="0,8" />

                                        <!-- Size Info -->
                                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto">
                                            <TextBlock Text="{Binding FormattedReceivedSize}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="/"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="4,0" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding FormattedTotalSize}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Grid>

                                        <!-- Actions -->
                                        <StackPanel Grid.Row="3"
                                                    Orientation="Horizontal"
                                                    Spacing="8"
                                                    Margin="0,8,0,0">
                                            <Button Content="⏸️ Pause"
                                                    Command="{Binding #Root.((vm:DownloadManagerDialogViewModel)DataContext).PauseDownloadCommand}"
                                                    CommandParameter="{Binding}"
                                                    Classes="Secondary"
                                                    IsVisible="{Binding CanPause}" />
                                            <Button Content="▶️ Resume"
                                                    Command="{Binding #Root.((vm:DownloadManagerDialogViewModel)DataContext).ResumeDownloadCommand}"
                                                    CommandParameter="{Binding}"
                                                    Classes="Secondary"
                                                    IsVisible="{Binding CanResume}" />
                                            <Button Content="❌ Cancel"
                                                    Command="{Binding #Root.((vm:DownloadManagerDialogViewModel)DataContext).CancelDownloadCommand}"
                                                    CommandParameter="{Binding}"
                                                    Classes="Danger"
                                                    IsVisible="{Binding CanCancel}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <!-- Completed Downloads -->
            <TabItem Header="{Binding CompletedDownloadCount, StringFormat='Completed ({0})'}">
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding FilteredCompletedDownloads}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:DownloadItemViewModel">
                                <Border Classes="download-item">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!-- Icon -->
                                        <TextBlock Text="📄"
                                                   FontSize="32"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,16,0" />

                                        <!-- Info -->
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding FileName}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding FormattedTotalSize}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="12" />
                                            <TextBlock Text="{Binding StatusText}"
                                                       Foreground="{StaticResource SuccessBrush}"
                                                       FontSize="12"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>

                                        <!-- Actions -->
                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    Spacing="8"
                                                    VerticalAlignment="Center">
                                            <Button Content="📂 Open"
                                                    Command="{Binding #Root.((vm:DownloadManagerDialogViewModel)DataContext).OpenFileCommand}"
                                                    CommandParameter="{Binding}"
                                                    Classes="Secondary"
                                                    IsVisible="{Binding CanOpen}" />
                                            <Button Content="📁 Folder"
                                                    Command="{Binding #Root.((vm:DownloadManagerDialogViewModel)DataContext).ShowInFolderCommand}"
                                                    CommandParameter="{Binding}"
                                                    Classes="Secondary" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="12"
                    Margin="0,16,0,0">
            <Button Content="🗑️ Clear Completed"
                    Command="{Binding ClearCompletedCommand}"
                    Classes="Secondary" />
            <Button Content="Close"
                    Command="{Binding CloseDialogCommand}"
                    Classes="Primary" />
        </StackPanel>
    </Grid>
</Window>
