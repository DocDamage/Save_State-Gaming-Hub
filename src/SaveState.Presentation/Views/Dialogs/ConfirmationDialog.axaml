<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SaveState.Presentation.ViewModels.Dialogs"
        x:Class="SaveState.Presentation.Views.Dialogs.ConfirmationDialog"
        x:DataType="vm:ConfirmationDialogViewModel"
        Title="{Binding Title}"
        Width="450"
        Height="220"
        MinWidth="350"
        MinHeight="180"
        MaxWidth="600"
        MaxHeight="300"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{StaticResource DialogBackgroundBrush}">

    <Window.Styles>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="24,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinWidth" Value="100" />
        </Style>

        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="24,10" />
            <Setter Property="MinWidth" Value="100" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*,Auto" Margin="24">
        <!-- Content -->
        <StackPanel Grid.Row="0" Spacing="16" VerticalAlignment="Center">
            <TextBlock Text="❓"
                      FontSize="48"
                      HorizontalAlignment="Center"
                      Margin="0,0,0,8" />

            <TextBlock Text="{Binding Message}"
                      FontSize="15"
                      TextWrapping="Wrap"
                      TextAlignment="Center"
                      HorizontalAlignment="Center"
                      MaxWidth="400"
                      Foreground="{StaticResource ForegroundBrush}" />
        </StackPanel>

        <!-- Buttons -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,Auto,Auto"
              Margin="0,20,0,0">
            <Panel Grid.Column="0" />

            <Button Grid.Column="1"
                   Classes="secondary"
                   Content="{Binding CancelText}"
                   Command="{Binding CancelCommand}"
                   Margin="0,0,12,0" />

            <Button Grid.Column="2"
                   Classes="primary"
                   Content="{Binding ConfirmText}"
                   Command="{Binding ConfirmCommand}" />
        </Grid>
    </Grid>
</Window>
