<!--
    ConfirmationDialog.axaml
    
    Confirmation dialog with customizable confirm/cancel buttons.
    Returns true if confirmed, false if cancelled.
    
    Usage: 
        var confirmed = await IDialogService.ShowConfirmationAsync(
            "Delete Game", 
            "Are you sure you want to delete this game?",
            confirmText: "Delete",
            cancelText: "Keep");
    
    Binding Context: ConfirmationDialogViewModel
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SaveState.Presentation.ViewModels.Dialogs"
        x:Class="SaveState.Presentation.Views.Dialogs.ConfirmationDialog"
        x:DataType="vm:ConfirmationDialogViewModel"
        Title="{Binding Title}"
        Width="450"
        Height="220"
        MinWidth="400"
        MinHeight="200"
        MaxWidth="600"
        MaxHeight="300"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{StaticResource DialogBackgroundBrush}">

    <Grid RowDefinitions="*,Auto" Margin="24">
        <!-- Content -->
        <StackPanel Grid.Row="0" Spacing="16" VerticalAlignment="Center">
            <TextBlock Text="❓"
                      FontSize="48"
                      HorizontalAlignment="Center"
                      Margin="0,0,0,8" />

            <TextBlock Text="{Binding Message}"
                      FontSize="15"
                      TextWrapping="Wrap"
                      TextAlignment="Center"
                      HorizontalAlignment="Center"
                      MaxWidth="400"
                      Foreground="{StaticResource TextPrimaryBrush}" />
        </StackPanel>

        <!-- Buttons -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,Auto,Auto"
              Margin="0,20,0,0">
            <Panel Grid.Column="0" />

            <Button Grid.Column="1"
                   Content="{Binding CancelText}"
                   Command="{Binding CancelCommand}"
                   Classes="Secondary"
                   Margin="0,0,12,0"
                   ToolTip.Tip="Cancel the operation"
                   AutomationProperties.Name="Cancel Button" />

            <Button Grid.Column="2"
                   Content="{Binding ConfirmText}"
                   Command="{Binding ConfirmCommand}"
                   Classes="Primary"
                   ToolTip.Tip="Confirm the operation"
                   AutomationProperties.Name="Confirm Button" />
        </Grid>
    </Grid>
</Window>
