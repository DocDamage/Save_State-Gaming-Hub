<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:SaveState.Presentation.ViewModels.Dialogs"
        xmlns:health="using:SaveState.Presentation.Models.Health"
        xmlns:converters="using:SaveState.Presentation.Converters"
        mc:Ignorable="d"
        x:Class="SaveState.Presentation.Views.Dialogs.ErrorLogViewerDialog"
        x:DataType="vm:ErrorLogViewerDialogViewModel"
        Title="Error Log Viewer"
        Width="1100"
        Height="700"
        WindowStartupLocation="CenterOwner">

  <Window.Resources>
    <converters:ErrorSeverityToBrushConverter x:Key="ErrorSeverityToBrushConverter" />
    <converters:RelativeTimeConverter x:Key="RelativeTimeConverter" />
  </Window.Resources>

  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="20">
    <!-- Header -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
      <StackPanel Grid.Column="0" Spacing="4">
        <TextBlock Text="Error Log Viewer" Classes="H5"/>
        <TextBlock Text="View and manage application error logs" 
                   Opacity="0.6" FontSize="12"/>
      </StackPanel>
      <Button Grid.Column="1"
              Content="✕"
              Command="{Binding CloseCommand}"
              Classes="Ghost"
              HorizontalAlignment="Right"/>
    </Grid>

    <!-- Filters -->
    <Border Grid.Row="1" 
            BorderBrush="{DynamicResource BorderBrush}" 
            BorderThickness="1"
            CornerRadius="8"
            Padding="16"
            Margin="0,0,0,16">
      <Grid ColumnDefinitions="*,*,*,*,Auto" ColumnSpacing="12">
        <StackPanel Grid.Column="0" Spacing="4">
          <TextBlock Text="Severity" Classes="Label" FontSize="11"/>
          <ComboBox ItemsSource="{Binding SeverityFilters}"
                    SelectedItem="{Binding SeverityFilter}"
                    HorizontalAlignment="Stretch"/>
        </StackPanel>
        
        <StackPanel Grid.Column="1" Spacing="4">
          <TextBlock Text="Component" Classes="Label" FontSize="11"/>
          <ComboBox ItemsSource="{Binding AvailableComponents}"
                    SelectedItem="{Binding ComponentFilter}"
                    HorizontalAlignment="Stretch"/>
        </StackPanel>
        
        <StackPanel Grid.Column="2" Spacing="4">
          <TextBlock Text="From Date" Classes="Label" FontSize="11"/>
          <DatePicker SelectedDate="{Binding StartDate}"
                      HorizontalAlignment="Stretch"/>
        </StackPanel>
        
        <StackPanel Grid.Column="3" Spacing="4">
          <TextBlock Text="To Date" Classes="Label" FontSize="11"/>
          <DatePicker SelectedDate="{Binding EndDate}"
                      HorizontalAlignment="Stretch"/>
        </StackPanel>
        
        <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
          <Button Content="Clear Filters"
                  Command="{Binding ClearFiltersCommand}"
                  Classes="Secondary"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Error List -->
    <Border Grid.Row="2"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True">
      <Grid ColumnDefinitions="*,300" IsVisible="{Binding IsDetailVisible}">
        <!-- Error List -->
        <ScrollViewer Grid.Column="0">
          <ItemsControl ItemsSource="{Binding Errors}" Margin="8">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="health:ErrorLogEntry">
                <Border Classes="ListItem" 
                        Padding="12" 
                        Margin="0,2"
                        Background="{Binding ., Converter={StaticResource NullToBrushConverter}, ConverterParameter={Binding DataContext.SelectedError, RelativeSource={RelativeSource AncestorType=ItemsControl}}}"
                        PointerPressed="OnErrorItemPointerPressed">
                  <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                               Width="130"
                               Opacity="0.6"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                    <Border Grid.Column="1"
                            Width="70"
                            Margin="0,0,12,0"
                            CornerRadius="4"
                            Padding="4,2"
                            Background="{Binding Severity, Converter={StaticResource ErrorSeverityToBrushConverter}}"
                            VerticalAlignment="Center">
                      <TextBlock Text="{Binding Severity}"
                                 HorizontalAlignment="Center"
                                 Foreground="White"
                                 FontSize="11"
                                 FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Grid.Column="2"
                               Text="{Binding Component}"
                               Width="120"
                               Margin="0,0,8,0"
                               Opacity="0.8"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="3"
                               Text="{Binding Message}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Opacity="0.9"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <!-- Detail Panel -->
        <Border Grid.Column="1" 
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="1,0,0,0"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
          <ScrollViewer>
            <StackPanel Spacing="16" Margin="16">
              <TextBlock Text="Error Details" Classes="H6"/>
              
              <StackPanel Spacing="8">
                <StackPanel Spacing="2">
                  <TextBlock Text="Timestamp" Classes="Label" FontSize="11"/>
                  <TextBlock Text="{Binding SelectedError.Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"/>
                </StackPanel>
                
                <StackPanel Spacing="2">
                  <TextBlock Text="Component" Classes="Label" FontSize="11"/>
                  <TextBlock Text="{Binding SelectedError.Component}"/>
                </StackPanel>
                
                <StackPanel Spacing="2">
                  <TextBlock Text="Severity" Classes="Label" FontSize="11"/>
                  <Border Width="80"
                          HorizontalAlignment="Left"
                          CornerRadius="4"
                          Padding="4,2"
                          Background="{Binding SelectedError.Severity, Converter={StaticResource ErrorSeverityToBrushConverter}}">
                    <TextBlock Text="{Binding SelectedError.Severity}"
                               HorizontalAlignment="Center"
                               Foreground="White"
                               FontSize="11"
                               FontWeight="SemiBold"/>
                  </Border>
                </StackPanel>
                
                <StackPanel Spacing="2">
                  <TextBlock Text="Message" Classes="Label" FontSize="11"/>
                  <TextBlock Text="{Binding SelectedError.Message}"
                             TextWrapping="Wrap"/>
                </StackPanel>
                
                <StackPanel Spacing="2" IsVisible="{Binding SelectedError.StackTrace, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <TextBlock Text="Stack Trace" Classes="Label" FontSize="11"/>
                  <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                          CornerRadius="4"
                          Padding="12">
                    <TextBlock Text="{Binding SelectedError.StackTrace}"
                               FontFamily="{StaticResource MonospaceFontFamily}"
                               FontSize="11"
                               TextWrapping="Wrap"/>
                  </Border>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
      
      <!-- List Only (when no selection) -->
      <ScrollViewer IsVisible="{Binding !IsDetailVisible}">
        <ItemsControl ItemsSource="{Binding Errors}" Margin="8">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="health:ErrorLogEntry">
              <Border Classes="ListItem" 
                      Padding="12" 
                      Margin="0,2"
                      PointerPressed="OnErrorItemPointerPressed">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                  <TextBlock Grid.Column="0"
                             Text="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                             Width="130"
                             Opacity="0.6"
                             FontSize="12"
                             VerticalAlignment="Center"/>
                  <Border Grid.Column="1"
                          Width="70"
                          Margin="0,0,12,0"
                          CornerRadius="4"
                          Padding="4,2"
                          Background="{Binding Severity, Converter={StaticResource ErrorSeverityToBrushConverter}}"
                          VerticalAlignment="Center">
                    <TextBlock Text="{Binding Severity}"
                               HorizontalAlignment="Center"
                               Foreground="White"
                               FontSize="11"
                               FontWeight="SemiBold"/>
                  </Border>
                  <TextBlock Grid.Column="2"
                             Text="{Binding Component}"
                             Width="120"
                             Margin="0,0,8,0"
                             Opacity="0.8"
                             VerticalAlignment="Center"
                             FontWeight="SemiBold"/>
                  <TextBlock Grid.Column="3"
                             Text="{Binding Message}"
                             TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center"
                             Opacity="0.9"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <!-- Status Bar -->
    <Border Grid.Row="3" 
            BorderBrush="{DynamicResource BorderBrush}" 
            BorderThickness="0,1,0,0"
            Padding="0,12,0,0"
            Margin="0,12,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0"
                   Text="{Binding Errors.Count, StringFormat='{}{0} errors displayed'}"
                   Opacity="0.6"
                   FontSize="12"
                   VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1"
                   Text="Click an error to view details"
                   Opacity="0.5"
                   FontSize="12"
                   FontStyle="Italic"/>
      </Grid>
    </Border>

    <!-- Bottom Buttons -->
    <StackPanel Grid.Row="4"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,16,0,0"
                Spacing="12">
      <Button Content="Refresh"
              Command="{Binding RefreshCommand}"
              Classes="Secondary"/>
      <Button Content="Export"
              Command="{Binding ExportCommand}"/>
      <Button Content="Clear All"
              Command="{Binding ClearCommand}"
              Classes="Danger"/>
      <Button Content="Close"
              Command="{Binding CloseCommand}"
              Classes="Primary"/>
    </StackPanel>
  </Grid>
</Window>
