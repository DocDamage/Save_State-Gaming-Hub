<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:SaveState.Presentation.ViewModels.Dialogs"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="400"
        x:Class="SaveState.Presentation.Views.Dialogs.RomScanProgressDialog"
        x:DataType="vm:RomScanProgressDialogViewModel"
        Title="Scanning ROMs"
        Width="550" Height="450"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        TransparencyLevelHint="Mica"
        Background="Transparent">

    <Panel>
        <!-- Background Layer -->
        <ExperimentalAcrylicBorder IsHitTestVisible="False">
            <ExperimentalAcrylicBorder.Material>
                <ExperimentalAcrylicMaterial
                    BackgroundSource="Digger"
                    TintColor="#1e1e1e"
                    TintOpacity="0.9"
                    MaterialOpacity="0.8" />
            </ExperimentalAcrylicBorder.Material>
        </ExperimentalAcrylicBorder>

        <Border BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="True">

            <Grid RowDefinitions="Auto, *, Auto, Auto">
                <!-- Header -->
                <Border Grid.Row="0" Padding="24,16" Background="#2d2d2d">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel VerticalAlignment="Center" Spacing="8">
                            <TextBlock Text="{Binding Title}"
                                       FontSize="18" FontWeight="SemiBold"
                                       Foreground="White"/>
                            <TextBlock Text="{Binding StatusMessage}"
                                       FontSize="12"
                                       Foreground="#aaaaaa"/>
                        </StackPanel>

                        <Button Grid.Column="1" Content="✕"
                                Command="{Binding CancelCommand}"
                                Classes="IconButton" FontSize="16"
                                Margin="0,0,0,0"
                                IsEnabled="{Binding CanCancel}"/>
                    </Grid>
                </Border>

                <!-- Progress Content -->
                <StackPanel Grid.Row="1" Margin="24" Spacing="20">

                    <!-- Overall Progress -->
                    <Border Classes="GlassContainer" Padding="20">
                        <StackPanel Spacing="15">
                            <TextBlock Text="Overall Progress" Classes="Subtitle" FontWeight="Bold"/>

                            <ProgressBar Value="{Binding OverallProgress}"
                                       Minimum="0" Maximum="1" Height="12"
                                       CornerRadius="6"
                                       Foreground="{DynamicResource SystemAccentColor}"/>

                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Grid.Column="0" Text="{Binding OverallStatus}"
                                          VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding OverallProgressPercent, StringFormat={}{0}%}"
                                          FontWeight="Bold" FontSize="16"
                                          Foreground="{DynamicResource SystemAccentColor}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Current Directory Progress -->
                    <Border Classes="GlassContainer" Padding="20">
                        <StackPanel Spacing="15">
                            <TextBlock Text="Current Directory" Classes="Subtitle" FontWeight="Bold"/>

                            <ProgressBar Value="{Binding CurrentDirectoryProgress}"
                                       Minimum="0" Maximum="1" Height="8"
                                       CornerRadius="4"
                                       Foreground="#4ecdc4"/>

                            <TextBlock Text="{Binding CurrentDirectoryStatus}"
                                      FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Statistics -->
                    <Border Classes="GlassContainer" Padding="20">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Scan Statistics" Classes="Subtitle" FontWeight="Bold"/>

                            <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto, Auto">
                                <TextBlock Grid.Column="0" Grid.Row="0" Text="Directories Processed:" Classes="Caption"/>
                                <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding DirectoriesProcessed}"/>

                                <TextBlock Grid.Column="0" Grid.Row="1" Text="Files Scanned:" Classes="Caption"/>
                                <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding FilesScanned}"/>

                                <TextBlock Grid.Column="0" Grid.Row="2" Text="ROMs Found:" Classes="Caption"/>
                                <TextBlock Grid.Column="1" Grid.Row="2" Text="{Binding RomsFound}"/>

                                <TextBlock Grid.Column="0" Grid.Row="3" Text="Time Elapsed:" Classes="Caption"/>
                                <TextBlock Grid.Column="1" Grid.Row="3" Text="{Binding TimeElapsed, StringFormat='{}{0:mm\\:ss}'}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Current File -->
                    <Border Classes="GlassContainer" Padding="15" Background="#1a1a1a">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Currently Processing:" FontSize="12" FontWeight="Medium"/>
                            <TextBlock Text="{Binding CurrentFileName}"
                                      FontSize="11" TextWrapping="Wrap"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      MaxHeight="40" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- Error Messages -->
                <Border Grid.Row="2" Margin="24,0" Padding="15"
                       IsVisible="{Binding HasErrors}" Background="#2a1a1a">
                    <ScrollViewer MaxHeight="80">
                        <ItemsControl ItemsSource="{Binding ErrorMessages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="#ff6b6b"
                                              FontSize="11" TextWrapping="Wrap" Margin="0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- Footer -->
                <Border Grid.Row="3" Padding="24,16" Background="#252525"
                        BorderBrush="{DynamicResource SurfaceStrokeColorDefault}" BorderThickness="0,1,0,0">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Grid.Column="0" Text="{Binding FooterMessage}"
                                  VerticalAlignment="Center" FontSize="12"
                                  Foreground="{StaticResource TextSecondaryBrush}"/>

                        <Button Grid.Column="1" Content="{Binding ActionButtonText}"
                               Command="{Binding ActionCommand}"
                               Classes="PrimaryButton"
                               IsEnabled="{Binding IsCompleted}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Panel>
</Window>