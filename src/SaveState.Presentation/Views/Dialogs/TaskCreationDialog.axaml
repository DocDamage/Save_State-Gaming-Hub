<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:SaveState.Presentation.ViewModels.Dialogs"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="350"
        x:Class="SaveState.Presentation.Views.Dialogs.TaskCreationDialog"
        x:DataType="vm:TaskCreationDialogViewModel"
        Width="400" Height="350"
        WindowStartupLocation="CenterOwner"
        Title="Create Scheduled Task"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        SystemDecorations="None"
        TransparencyLevelHint="AcrylicBlur"
        Background="Transparent">

    <Border Classes="DialogSurface">
        <Grid RowDefinitions="Auto, *, Auto">
            <!-- Header -->
            <TextBlock Grid.Row="0" Text="Create Task" Classes="DialogTitle" />

            <!-- Content -->
            <StackPanel Grid.Row="1" Spacing="20" Margin="0,20">
                <StackPanel Spacing="8">
                    <TextBlock Text="Task Name" Classes="Label" />
                    <TextBox Text="{Binding Name}" Watermark="e.g., Daily Cleanup" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Schedule" Classes="Label" />
                    <ComboBox ItemsSource="{Binding ScheduleOptions}"
                              SelectedItem="{Binding Schedule}"
                              HorizontalAlignment="Stretch" />
                </StackPanel>

                <CheckBox Content="Enable this task"
                          IsChecked="{Binding IsEnabled}" />
            </StackPanel>

            <!-- Footer -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button Content="Cancel" Classes="Secondary" Click="OnCancelClick" />
                <Button Content="Save Task" Classes="Primary" Click="OnSaveClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
