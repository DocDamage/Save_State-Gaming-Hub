<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SaveState.Presentation.ViewModels.Dialogs"
        x:Class="SaveState.Presentation.Views.Dialogs.ProviderConfigDialog"
        x:DataType="vm:ProviderConfigDialogViewModel"
        Title="{Binding DisplayName, StringFormat='Configure {0}'}"
        Width="520"
        Height="640"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

  <Grid RowDefinitions="*, Auto" Margin="24">
    <!-- Content -->
    <ScrollViewer Grid.Row="0">
      <StackPanel Spacing="20">
        <!-- Header -->
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding DisplayName, StringFormat='🤖 Configure {0}'}"
                     Classes="Header"
                     FontSize="20" />
          <TextBlock Text="Configure API credentials and model settings for this provider."
                     Classes="Caption"
                     Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>

        <!-- Enable Provider -->
        <Border Background="{StaticResource SystemControlBackgroundAltHighBrush}"
                CornerRadius="8"
                Padding="16">
          <ToggleSwitch Content="Enable this provider"
                        IsChecked="{Binding IsEnabled}"
                        FontWeight="SemiBold" />
        </Border>

        <!-- Connection Status -->
        <Border Background="{StaticResource SystemControlBackgroundAltMediumBrush}"
                CornerRadius="8"
                Padding="12"
                IsVisible="{Binding IsEnabled}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Status:" VerticalAlignment="Center" />
            <TextBlock Text="{Binding ConnectionStatusMessage}"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold" />
          </StackPanel>
        </Border>

        <!-- API Key (for cloud providers) -->
        <StackPanel Spacing="8" IsVisible="{Binding RequiresApiKey}">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="API Key" Classes="Label" />
            <TextBlock Text="*" Foreground="{StaticResource ErrorBrush}" 
                       IsVisible="{Binding IsEnabled}" />
          </StackPanel>
          
          <Grid ColumnDefinitions="*, Auto">
            <TextBox Grid.Column="0"
                     Text="{Binding ApiKey}"
                     Watermark="Enter your API key"
                     PasswordChar="•"
                     IsEnabled="{Binding IsEnabled}" />
            <Button Grid.Column="1"
                    Content="Show"
                    Command="{Binding ToggleApiKeyVisibilityCommand}"
                    Margin="8,0,0,0"
                    Padding="12,4" />
          </Grid>
          
          <TextBlock Text="Your API key is stored securely and encrypted at rest."
                     Classes="Subtitle"
                     FontSize="11"
                     Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>

        <!-- Endpoint (for local providers) -->
        <StackPanel Spacing="8" IsVisible="{Binding SupportsEndpoint}">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="Endpoint URL" Classes="Label" />
            <TextBlock Text="*" Foreground="{StaticResource ErrorBrush}" 
                       IsVisible="{Binding IsEnabled}" />
          </StackPanel>
          
          <TextBox Text="{Binding Endpoint}"
                   Watermark="http://localhost:11434"
                   IsEnabled="{Binding IsEnabled}" />
          
          <TextBlock Text="The URL where your Ollama instance is running."
                     Classes="Subtitle"
                     FontSize="11"
                     Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>

        <!-- Model Selection -->
        <StackPanel Spacing="8" IsVisible="{Binding IsEnabled}">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="Model" Classes="Label" />
            <TextBlock Text="*" Foreground="{StaticResource ErrorBrush}" />
          </StackPanel>
          
          <ComboBox ItemsSource="{Binding AvailableModels}"
                    SelectedItem="{Binding SelectedModel}"
                    HorizontalAlignment="Stretch"
                    PlaceholderText="Select a model..." />
          
          <TextBlock Text="{Binding ProviderName, StringFormat='Select the {0} model to use for AI features.'}"
                     Classes="Subtitle"
                     FontSize="11"
                     Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>

        <!-- Advanced Settings -->
        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                IsVisible="{Binding IsEnabled}">
          <StackPanel Spacing="16">
            <TextBlock Text="Advanced Settings" FontWeight="SemiBold" />

            <!-- Max Tokens -->
            <StackPanel Spacing="4">
              <Grid ColumnDefinitions="*, Auto">
                <TextBlock Text="Max Tokens" Classes="Label" />
                <TextBlock Text="{Binding MaxTokens, StringFormat='{}{0:N0}'}" 
                           Classes="Caption"
                           HorizontalAlignment="Right" />
              </Grid>
              <Slider Value="{Binding MaxTokens}"
                      Minimum="100"
                      Maximum="8000"
                      TickFrequency="100"
                      IsSnapToTickEnabled="False" />
              <TextBlock Text="Maximum number of tokens to generate in responses."
                         Classes="Subtitle"
                         FontSize="11"
                         Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>

            <!-- Temperature -->
            <StackPanel Spacing="4">
              <Grid ColumnDefinitions="*, Auto">
                <TextBlock Text="Temperature" Classes="Label" />
                <TextBlock Text="{Binding Temperature, StringFormat='{}{0:F1}'}" 
                           Classes="Caption"
                           HorizontalAlignment="Right" />
              </Grid>
              <Slider Value="{Binding Temperature}"
                      Minimum="0"
                      Maximum="2"
                      TickFrequency="0.1" />
              <TextBlock Text="Controls randomness: 0 = deterministic, 2 = very random."
                         Classes="Subtitle"
                         FontSize="11"
                         Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>

            <!-- Top-P -->
            <StackPanel Spacing="4">
              <Grid ColumnDefinitions="*, Auto">
                <TextBlock Text="Top-P (Nucleus Sampling)" Classes="Label" />
                <TextBlock Text="{Binding TopP, StringFormat='{}{0:F2}'}" 
                           Classes="Caption"
                           HorizontalAlignment="Right" />
              </Grid>
              <Slider Value="{Binding TopP}"
                      Minimum="0"
                      Maximum="1"
                      TickFrequency="0.05" />
              <TextBlock Text="Alternative to temperature: consider tokens with top P probability mass."
                         Classes="Subtitle"
                         FontSize="11"
                         Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Test Connection -->
        <StackPanel Spacing="8" IsVisible="{Binding IsEnabled}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Test Connection"
                    Command="{Binding TestConnectionCommand}"
                    IsEnabled="{Binding !IsTestingConnection}" />
            <ProgressBar IsIndeterminate="True" 
                         IsVisible="{Binding IsTestingConnection}"
                         Width="100"
                         VerticalAlignment="Center" />
          </StackPanel>
          
          <CheckBox Content="Test connection before saving"
                    IsChecked="{Binding TestOnSave}"
                    IsVisible="{Binding TestConnectionSuccessful}" />
        </StackPanel>

        <!-- Validation Error -->
        <Border Background="{StaticResource ErrorBrush}"
                CornerRadius="8"
                Padding="12">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="⚠️" FontSize="16" />
            <TextBlock Text="{Binding ValidationError}"
                       TextWrapping="Wrap"
                       Foreground="White" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- Action Buttons -->
    <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="12"
                Margin="0,20,0,0">
      <Button Content="Cancel"
              Classes="Secondary"
              Width="100"
              Click="OnCancelClick" />
      <Button Content="Save"
              Classes="Primary"
              Width="100"
              Click="OnSaveClick" />
    </StackPanel>
  </Grid>
</Window>
