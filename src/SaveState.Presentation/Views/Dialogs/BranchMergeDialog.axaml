<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SaveState.Presentation.ViewModels.Dialogs"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="450"
        x:Class="SaveState.Presentation.Views.Dialogs.BranchMergeDialog"
        x:DataType="vm:BranchMergeDialogViewModel"
        Title="Merge Branches" Width="500" Height="450"
        WindowStartupLocation="CenterOwner"
        TransparencyLevelHint="AcrylicBlur"
        Background="Transparent"
        ExtendClientAreaToDecorationsHint="True">

    <Border Background="#1E1E1E"
            CornerRadius="8"
            BorderBrush="#333333"
            BorderThickness="1"
            Padding="24">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top"
                       Text="Merge Branches"
                       FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,20"/>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,20,0,0">
                <Button Content="Cancel" Command="{Binding CancelCommand}" Width="100" Height="36" Background="#2D2D2D" Foreground="#FFFFFF"/>
                <Button Content="Merge" Command="{Binding ConfirmCommand}" IsEnabled="{Binding CanConfirm}" Width="100" Height="36" Background="#4CAF50" Foreground="#FFFFFF"/>
            </StackPanel>

            <StackPanel Spacing="20">
                <Grid ColumnDefinitions="*,Auto,*">
                    <StackPanel Grid.Column="0" Spacing="8">
                        <TextBlock Text="Source Branch" Foreground="#AAAAAA" FontSize="12"/>
                        <Border Background="#252525" CornerRadius="4" Padding="12" BorderBrush="#333333" BorderThickness="1">
                            <TextBlock Text="{Binding SourceBranchName}" Foreground="#FFFFFF" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="➜" FontSize="20" Foreground="#4CAF50" VerticalAlignment="Center" Margin="12,20,12,0"/>

                    <StackPanel Grid.Column="2" Spacing="8">
                        <TextBlock Text="Target Branch" Foreground="#AAAAAA" FontSize="12"/>
                        <Border Background="#252525" CornerRadius="4" Padding="12" BorderBrush="#333333" BorderThickness="1">
                            <TextBlock Text="{Binding TargetBranchName}" Foreground="#FFFFFF" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <StackPanel Spacing="8">
                    <TextBlock Text="Merge Message" Foreground="#AAAAAA" FontSize="12"/>
                    <TextBox Text="{Binding MergeMessage}" Watermark="Describe the merge..." Height="80" TextWrapping="Wrap" AcceptsReturn="True" Background="#252525" Foreground="#FFFFFF" BorderBrush="#333333"/>
                </StackPanel>

                <StackPanel Spacing="8">
                    <CheckBox IsChecked="{Binding DeleteSourceAfterMerge}" Content="Delete source branch after merge" Foreground="#FFFFFF"/>
                    <CheckBox IsChecked="{Binding CreateBackupBeforeMerge}" Content="Create backup save state before merging" Foreground="#FFFFFF"/>
                </StackPanel>

                <Border Background="#332200" CornerRadius="4" Padding="12" BorderBrush="#FF9800" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="⚠️" VerticalAlignment="Center"/>
                        <TextBlock Text="Conflicts will be resolved by keeping the source branch data."
                                   FontSize="12" Foreground="#FFCC80" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
