<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SaveState.Presentation.ViewModels.Dialogs"
        xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Xaml.Behaviors.Interactivity"
        xmlns:ia="clr-namespace:Avalonia.Xaml.Interactions.Core;assembly=Xaml.Behaviors.Interactions"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="500"
        x:Class="SaveState.Presentation.Views.Dialogs.BranchSelectionDialog"
        x:DataType="vm:BranchSelectionDialogViewModel"
        Title="Select Branch" Width="600" Height="500"
        WindowStartupLocation="CenterOwner"
        TransparencyLevelHint="AcrylicBlur"
        Background="Transparent"
        ExtendClientAreaToDecorationsHint="True">

    <Border Background="#1E1E1E"
            CornerRadius="8"
            BorderBrush="#333333"
            BorderThickness="1"
            Padding="24"
            MinWidth="600"
            MinHeight="400">

        <DockPanel>
            <!-- Header -->
            <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,20">
                <TextBlock Text="Switch Branch"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#FFFFFF"/>
                <TextBlock Text="Select a branch to switch to. Any unsaved changes may be lost."
                           FontSize="13"
                           Foreground="#AAAAAA"
                           TextWrapping="Wrap"/>

                <!-- Current Branch Info -->
                <Border Background="#2D2D2D"
                        CornerRadius="4"
                        Padding="12"
                        Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="🌿"
                                   FontSize="16"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Current Branch:"
                                   FontSize="13"
                                   Foreground="#AAAAAA"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentBranchName}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#4CAF50"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Footer Buttons -->
            <StackPanel DockPanel.Dock="Bottom"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="12"
                        Margin="0,20,0,0">
                <Button Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Width="100"
                        Height="36"
                        Background="#2D2D2D"
                        Foreground="#FFFFFF"
                        CornerRadius="4"/>
                <Button Content="Switch"
                        Command="{Binding ConfirmCommand}"
                        IsEnabled="{Binding CanConfirm}"
                        Width="100"
                        Height="36"
                        Background="#4CAF50"
                        Foreground="#FFFFFF"
                        CornerRadius="4"/>
            </StackPanel>

            <!-- Branch List -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Branches}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:BranchOptionViewModel">
                            <Border Background="{Binding IsCurrent, Converter={StaticResource BoolToBackgroundConverter}}"
                                    BorderBrush="#333333"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Margin="0,0,0,12"
                                    Padding="16"
                                    Cursor="Hand">

                                <Border.Styles>
                                    <Style Selector="Border:pointerover">
                                        <Setter Property="Background" Value="#2D2D2D"/>
                                    </Style>
                                    <Style Selector="Border">
                                        <Setter Property="Background" Value="#252525"/>
                                    </Style>
                                </Border.Styles>

                                <i:Interaction.Behaviors>
                                    <ia:EventTriggerBehavior EventName="PointerPressed">
                                        <ia:InvokeCommandAction Command="{Binding $parent[ItemsControl].((vm:BranchSelectionDialogViewModel)DataContext).SelectBranchCommand}"
                                                            CommandParameter="{Binding}"/>
                                    </ia:EventTriggerBehavior>
                                </i:Interaction.Behaviors>

                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <!-- Icon -->
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding BranchTypeIcon}"
                                               FontSize="24"
                                               VerticalAlignment="Center"
                                               Margin="0,0,16,0"/>

                                    <!-- Branch Info -->
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Foreground="#FFFFFF"
                                                       VerticalAlignment="Center"/>
                                            <Border Background="{Binding StatusColor}"
                                                    CornerRadius="3"
                                                    Padding="6,2"
                                                    IsVisible="{Binding IsCurrent}">
                                                <TextBlock Text="{Binding StatusText}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="#FFFFFF"/>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="12"
                                                   Foreground="#AAAAAA"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="400"
                                                   IsVisible="{Binding Description, Converter={StaticResource StringNotEmptyConverter}}"/>

                                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="📊"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding SaveCountText}"
                                                           FontSize="11"
                                                           Foreground="#999999"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="⏰"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding LastModifiedText}"
                                                           FontSize="11"
                                                           Foreground="#999999"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <Border Background="#2D2D2D"
                                                    CornerRadius="3"
                                                    Padding="6,2">
                                                <TextBlock Text="{Binding BranchType}"
                                                           FontSize="10"
                                                           Foreground="#888888"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Selection Indicator -->
                                    <Border Grid.Column="2"
                                            Width="24"
                                            Height="24"
                                            CornerRadius="12"
                                            BorderBrush="#4CAF50"
                                            BorderThickness="2"
                                            Background="{Binding $parent[ItemsControl].((vm:BranchSelectionDialogViewModel)DataContext).SelectedBranch.Name,
                                                                Converter={StaticResource BranchSelectionConverter},
                                                                ConverterParameter={Binding Name}}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="✓"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Foreground="#FFFFFF"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding $parent[ItemsControl].((vm:BranchSelectionDialogViewModel)DataContext).SelectedBranch.Name,
                                                                      Converter={StaticResource StringEqualsConverter},
                                                                      ConverterParameter={Binding Name}}"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
