<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SaveState.Presentation.ViewModels.BigPicture"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="800"
             x:Class="SaveState.Presentation.Views.BigPicture.GameDetailPanel"
             x:DataType="vm:GameDetailViewModel">

  <Design.DataContext>
    <vm:GameDetailViewModel/>
  </Design.DataContext>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="0,0,0,40">

      <!-- Large cover art -->
      <Border Background="#FF333333"
              CornerRadius="8"
              Margin="0,0,0,20"
              Height="300">
        <Image Source="{Binding SelectedGame.CoverImageUrl}"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Margin="20"/>
      </Border>

      <!-- Game title -->
      <TextBlock Text="{Binding SelectedGame.Title}"
                 FontSize="36"
                 FontWeight="Black"
                 Foreground="White"
                 TextWrapping="Wrap"
                 Margin="0,0,0,5"/>

      <!-- Platform and release year -->
      <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
        <Border Background="#FF00CCFF" CornerRadius="4" Padding="8,2" Margin="0,0,10,0">
          <TextBlock Text="{Binding SelectedGame.PlatformName}" FontSize="12" FontWeight="Bold" Foreground="Black"/>
        </Border>
        <TextBlock Text="{Binding SelectedGame.ReleaseYear}"
                   FontSize="16"
                   Foreground="#FFAAAAAA"
                   VerticalAlignment="Center"/>
      </StackPanel>

      <!-- Rating and Playtime -->
      <Grid ColumnDefinitions="*, *" Margin="0,0,0,25">
        <StackPanel Grid.Column="0">
          <TextBlock Text="RATING" FontSize="10" FontWeight="Bold" Foreground="#FFAAAAAA" Margin="0,0,0,5"/>
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Text="{Binding SelectedGame.Rating, StringFormat={}{0:F1}}" FontSize="24" FontWeight="Black" Foreground="White" />
            <TextBlock Text="⭐" FontSize="18" VerticalAlignment="Center" Foreground="#FFFFD700"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1">
          <TextBlock Text="PLAYTIME" FontSize="10" FontWeight="Bold" Foreground="#FFAAAAAA" Margin="0,0,0,5"/>
          <TextBlock Text="{Binding SelectedGame.TotalPlaytime, StringFormat='{}{0:hh}h {0:mm}m'}" FontSize="24" FontWeight="Black" Foreground="#FF00CCFF" />
        </StackPanel>
      </Grid>

      <!-- Description -->
      <TextBlock Text="{Binding SelectedGame.Description}"
                 FontSize="15"
                 Foreground="#FFDDDDDD"
                 TextWrapping="Wrap"
                 LineHeight="24"
                 Margin="0,0,0,30"
                 MaxLines="5"
                 TextTrimming="CharacterEllipsis"/>

      <!-- Action buttons -->
      <StackPanel Orientation="Vertical" Spacing="15">
        <Button Command="{Binding LaunchGameCommand}"
                Classes="Accent"
                HorizontalAlignment="Stretch"
                Height="60"
                CornerRadius="30">
          <StackPanel Orientation="Horizontal" Spacing="15">
            <TextBlock Text="▶️" FontSize="20"/>
            <TextBlock Text="LAUNCH GAME" FontSize="20" FontWeight="Black"/>
          </StackPanel>
        </Button>

        <Grid ColumnDefinitions="*, *">
          <Button Grid.Column="0" Content="BACKLOG" Classes="Secondary" Margin="0,0,5,0" HorizontalAlignment="Stretch" Height="50" CornerRadius="25"/>
          <Button Grid.Column="1" Content="DETAILS" Classes="Secondary" Margin="5,0,0,0" HorizontalAlignment="Stretch" Height="50" CornerRadius="25"/>
        </Grid>
      </StackPanel>

      <!-- Recent activity -->
      <Border Background="#FF333333" CornerRadius="6" Padding="15" Margin="0,20,0,0">
        <StackPanel>
          <TextBlock Text="Recent Activity"
                     FontSize="18"
                     FontWeight="SemiBold"
                     Foreground="#FFFFFFFF"
                     Margin="0,0,0,10"/>

          <ItemsControl ItemsSource="{Binding RecentActivity}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Margin="0,5">
                  <TextBlock Text="{Binding Timestamp, StringFormat='MMM dd'}"
                             FontSize="12"
                             Foreground="#FFAAAAAA"
                             Width="60"/>
                  <TextBlock Text="{Binding Description}"
                             FontSize="12"
                             Foreground="#FFCCCCCC"
                             Margin="10,0,0,0"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>

</UserControl>
