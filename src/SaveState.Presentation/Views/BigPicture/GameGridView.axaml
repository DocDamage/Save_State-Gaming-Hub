<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SaveState.Presentation.ViewModels.BigPicture"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="SaveState.Presentation.Views.BigPicture.GameGridView"
             x:DataType="vm:GameGridViewModel">

  <Design.DataContext>
    <vm:GameGridViewModel/>
  </Design.DataContext>

  <Grid RowDefinitions="Auto,*">

    <!-- Filter/Collection selector -->
    <Border Grid.Row="0" Background="#FF333333" CornerRadius="8" Margin="0,0,0,20" Padding="20">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Collection selector -->
        <ComboBox Grid.Column="0"
                  ItemsSource="{Binding AvailableCollections}"
                  SelectedItem="{Binding SelectedCollection}"
                  DisplayMemberBinding="{Binding Name}"
                  FontSize="18"
                  Width="250"
                  Margin="0,0,20,0"/>

        <!-- Search -->
        <TextBox Grid.Column="1"
                 Text="{Binding SearchText}"
                 Watermark="Search games..."
                 FontSize="18"
                 VerticalAlignment="Center"
                 Margin="0,0,20,0"/>

        <!-- Filter button -->
        <Button Grid.Column="2"
                Content="Filter"
                Command="{Binding ToggleFilterCommand}"
                Background="#FF404040"
                Foreground="#FFFFFFFF"
                FontSize="16"
                Padding="20,10"/>
      </Grid>
    </Border>

    <!-- Game grid -->
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Games}" Margin="0,0,-20,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Width="220" Height="300" Margin="0,0,20,20" Name="GameCard">
              <Panel>
                <!-- Focus Glow -->
                <Border IsVisible="{Binding IsFocused}"
                        Margin="-5"
                        CornerRadius="12"
                        BorderThickness="3"
                        BorderBrush="#FF00CCFF">
                  <Border.Effect>
                    <DropShadowEffect Color="#FF00CCFF" BlurRadius="20" Opacity="0.5" />
                  </Border.Effect>
                </Border>

                <!-- Main Card -->
                <Border Background="#FF2D2D2D"
                        BorderBrush="{Binding IsFocused, Converter={StaticResource BoolToBrushConverter}, ConverterParameter='#FF00CCFF|#FF404040'}"
                        BorderThickness="2"
                        CornerRadius="8"
                        ClipToBounds="True">
                  <Grid>
                    <!-- Game cover -->
                    <Image Source="{Binding CoverImage}"
                           Stretch="UniformToFill"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"
                           Opacity="{Binding IsFocused, Converter={StaticResource BoolToBrushConverter}, ConverterParameter='1.0|0.7'}" />

                    <!-- Stats Overlay -->
                    <Border IsVisible="{Binding IsFocused}"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Right"
                            Background="#CC000000"
                            CornerRadius="0,0,0,8"
                            Padding="8,4">
                       <TextBlock Text="{Binding Rating, StringFormat='⭐ {0:F1}'}" FontSize="12" Foreground="#FFFFD700" FontWeight="Bold"/>
                    </Border>

                    <!-- Title Banner -->
                    <Border Background="#EE1A1A1A"
                            VerticalAlignment="Bottom"
                            Height="60"
                            Padding="12,8">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1"/>
                        <TextBlock Text="{Binding PlatformName}"
                                   FontSize="11"
                                   Foreground="#FFAAAAAA"/>
                      </StackPanel>
                    </Border>
                  </Grid>
                </Border>
              </Panel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

  </Grid>

</UserControl>
