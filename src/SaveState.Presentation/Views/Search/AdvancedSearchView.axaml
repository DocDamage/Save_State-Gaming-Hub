<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SaveState.Presentation.ViewModels.Search"
             xmlns:search="using:SaveState.Presentation.Models.Search"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="SaveState.Presentation.Views.Search.AdvancedSearchView"
             x:DataType="vm:AdvancedSearchViewModel">

    <Design.DataContext>
        <vm:AdvancedSearchViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <!-- Search Result Item Style -->
        <Style Selector="Button.result-item">
            <Setter Property="Background" Value="{DynamicResource BackgroundSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style Selector="Button.result-item:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
        </Style>

        <!-- Filter Tag Style -->
        <Style Selector="Border.filter-tag">
            <Setter Property="Background" Value="{DynamicResource AccentBrushTransparent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,4" />
        </Style>

        <!-- Type Filter Button -->
        <Style Selector="Button.type-filter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.type-filter:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
        </Style>
        <Style Selector="Button.type-filter.active">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>

        <!-- Suggestion Item Style -->
        <Style Selector="Button.suggestion-item">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,6" />
        </Style>
        <Style Selector="Button.suggestion-item:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, Auto, Auto, *">
        <!-- Header -->
        <Border Grid.Row="0" Classes="GlassContainer" Padding="15" Margin="0,0,0,15">
            <StackPanel Spacing="5">
                <TextBlock Text="🔍 ADVANCED SEARCH" Classes="Subtitle" FontWeight="Bold"/>
                <TextBlock Text="Search across games, save states, achievements, and more" 
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <!-- Search Input -->
        <Border Grid.Row="1" Classes="GlassContainer" Padding="15" Margin="0,0,0,15">
            <Grid RowDefinitions="Auto, Auto">
                <!-- Search Box -->
                <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                    <TextBox Grid.Column="0" 
                             Text="{Binding SearchText}" 
                             Watermark="🔍 Search everything..."
                             FontSize="16"
                             Padding="12,8"/>
                    <Button Grid.Column="1" 
                            Content="🔍 Search" 
                            Classes="Primary" 
                            Margin="10,0,0,0"
                            Command="{Binding SearchCommand}"
                            IsEnabled="{Binding !IsSearching}"/>
                </Grid>

                <!-- Suggestions -->
                <Border Grid.Row="1" 
                        IsVisible="{Binding SearchSuggestions.Count, Converter={StaticResource CountToBoolConverter}}"
                        Background="{DynamicResource BackgroundSecondaryBrush}"
                        Margin="0,5,0,0"
                        CornerRadius="4">
                    <ItemsControl ItemsSource="{Binding SearchSuggestions}" MaxHeight="150">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Button Content="{Binding}" 
                                        Classes="suggestion-item"
                                        Command="{Binding DataContext.ApplySuggestionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Grid>
        </Border>

        <!-- Filters & Type Selection -->
        <Grid Grid.Row="2" ColumnDefinitions="*, Auto" Margin="0,0,0,15">
            <!-- Active Filters -->
            <Border Grid.Column="0" Classes="GlassContainer" Padding="15" Margin="0,0,15,0">
                <Grid RowDefinitions="Auto, Auto">
                    <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,10">
                        <TextBlock Text="ACTIVE FILTERS" Classes="Caption" FontWeight="Bold" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                            <DropDownButton Content="➕ Add Filter" Classes="Small">
                                <DropDownButton.Flyout>
                                    <MenuFlyout>
                                        <MenuItem Header="Platform" Command="{Binding AddFilterCommand}" CommandParameter="{x:Static search:SearchFilterType.Platform}"/>
                                        <MenuItem Header="Genre" Command="{Binding AddFilterCommand}" CommandParameter="{x:Static search:SearchFilterType.Genre}"/>
                                        <MenuItem Header="Tag" Command="{Binding AddFilterCommand}" CommandParameter="{x:Static search:SearchFilterType.Tag}"/>
                                        <MenuItem Header="Date" Command="{Binding AddFilterCommand}" CommandParameter="{x:Static search:SearchFilterType.Date}"/>
                                        <MenuItem Header="Rating" Command="{Binding AddFilterCommand}" CommandParameter="{x:Static search:SearchFilterType.Rating}"/>
                                        <MenuItem Header="Play Time" Command="{Binding AddFilterCommand}" CommandParameter="{x:Static search:SearchFilterType.PlayTime}"/>
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                            <Button Content="Clear All" 
                                    Classes="Secondary Small" 
                                    Command="{Binding ClearFiltersCommand}"
                                    IsVisible="{Binding HasActiveFilters}"/>
                        </StackPanel>
                    </Grid>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding ActiveFilters}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" Spacing="8"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SearchFilterViewModel">
                                <Border Classes="filter-tag">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding TypeDisplayName}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Value}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <Button Content="✕" 
                                                Classes="Ghost Small"
                                                Padding="2"
                                                Command="{Binding $parent[ItemsControl].((vm:AdvancedSearchViewModel)DataContext).RemoveFilterCommand}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- Sort Options -->
            <Border Grid.Column="1" Classes="GlassContainer" Padding="15">
                <StackPanel Spacing="10">
                    <TextBlock Text="SORT BY" Classes="Caption" FontWeight="Bold"/>
                    <ComboBox SelectedItem="{Binding SortField}" ItemsSource="{Binding AvailableSortFields}" Width="150"/>
                    <Button Content="{Binding SortDescending, Converter={StaticResource BoolToSortDirectionConverter}}" 
                            Command="{Binding ToggleSortDirectionCommand}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Results Area -->
        <Border Grid.Row="3" Classes="GlassContainer" Padding="15">
            <Grid RowDefinitions="Auto, *, Auto">
                <!-- Results Header -->
                <Grid ColumnDefinitions="*, Auto, Auto" Margin="0,0,0,10">
                    <TextBlock Text="{Binding TotalResults, StringFormat='RESULTS ({0} found)'}" 
                               Classes="Caption" FontWeight="Bold" VerticalAlignment="Center"/>
                    
                    <!-- Type Filter Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" Margin="0,0,15,0">
                        <Button Content="All" 
                                Classes.type-filter="{Binding !SelectedType}"
                                Command="{Binding SetPropertyCommand}"
                                CommandParameter="{x:Null}"/>
                        <Button Content="Games" 
                                Classes.type-filter="{Binding SelectedType, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static search:SearchResultType.Game}}"
                                Command="{Binding AddFilterCommand}"
                                CommandParameter="{x:Static search:SearchResultType.Game}"/>
                        <Button Content="Saves" 
                                Classes.type-filter="{Binding SelectedType, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static search:SearchResultType.SaveState}}"
                                Command="{Binding AddFilterCommand}"
                                CommandParameter="{x:Static search:SearchResultType.SaveState}"/>
                        <Button Content="Achievements" 
                                Classes.type-filter="{Binding SelectedType, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static search:SearchResultType.Achievement}}"
                                Command="{Binding AddFilterCommand}"
                                CommandParameter="{x:Static search:SearchResultType.Achievement}"/>
                        <Button Content="Replays" 
                                Classes.type-filter="{Binding SelectedType, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static search:SearchResultType.Replay}}"
                                Command="{Binding AddFilterCommand}"
                                CommandParameter="{x:Static search:SearchResultType.Replay}"/>
                    </StackPanel>

                    <Button Grid.Column="2" Content="💾 Save Search" Classes="Small" Command="{Binding SaveSearchCommand}"/>
                </Grid>

                <!-- Results List -->
                <ScrollViewer Grid.Row="1" IsVisible="{Binding Results.Count, Converter={StaticResource CountToBoolConverter}}">
                    <ItemsControl ItemsSource="{Binding Results}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="search:SearchResult">
                                <Button Classes="result-item" Command="{Binding $parent[ItemsControl].((vm:AdvancedSearchViewModel)DataContext).OpenResultCommand}" CommandParameter="{Binding}">
                                    <Grid ColumnDefinitions="Auto, *, Auto" Margin="15,12">
                                        <!-- Icon -->
                                        <TextBlock Text="{Binding Type, Converter={StaticResource SearchResultTypeToIconConverter}}" 
                                                   FontSize="32" 
                                                   Margin="0,0,15,0"
                                                   VerticalAlignment="Center"/>

                                        <!-- Content -->
                                        <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="4">
                                            <TextBlock Text="{Binding Title}" 
                                                       FontSize="16" 
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Description}" 
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap"/>
                                            
                                            <!-- Metadata Tags -->
                                            <ItemsControl ItemsSource="{Binding Metadata}" Margin="0,4,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" Spacing="8"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource BackgroundBrush}" 
                                                                CornerRadius="3" 
                                                                Padding="6,2">
                                                            <TextBlock Text="{Binding Value}" FontSize="11"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- Relevance Score -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="15,0,0,0">
                                            <Border Background="{DynamicResource AccentBrushTransparent}" 
                                                    CornerRadius="4" 
                                                    Padding="8,4">
                                                <TextBlock Text="{Binding RelevanceScore, StringFormat='{}{0:P0}'}" 
                                                           FontSize="12"
                                                           FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty State -->
                <Border Grid.Row="1" 
                        IsVisible="{Binding Results.Count, Converter={StaticResource InverseCountToBoolConverter}}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Padding="40">
                    <StackPanel Spacing="15" HorizontalAlignment="Center">
                        <TextBlock Text="🔍" FontSize="64" HorizontalAlignment="Center" Opacity="0.5"/>
                        <TextBlock Text="No results found" 
                                   FontSize="18" 
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Try adjusting your search or filters" 
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Loading Indicator -->
                <Border Grid.Row="1" 
                        IsVisible="{Binding IsSearching}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                    <StackPanel Spacing="10">
                        <ProgressBar IsIndeterminate="True" Width="40" Height="40"/>
                        <TextBlock Text="Searching..." Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Load More -->
                <Button Grid.Row="2" 
                        Content="Load More..." 
                        HorizontalAlignment="Center"
                        Margin="0,15,0,0"
                        IsVisible="{Binding HasMoreResults}"
                        Command="{Binding LoadMoreCommand}"
                        IsEnabled="{Binding !IsSearching}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
