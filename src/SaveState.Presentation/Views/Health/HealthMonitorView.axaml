<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SaveState.Presentation.ViewModels.Health"
             xmlns:health="using:SaveState.Core.Health.Models"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="700"
             x:Class="SaveState.Presentation.Views.Health.HealthMonitorView"
             x:DataType="vm:HealthMonitorViewModel">

  <UserControl.Styles>
    <!-- Health Score Circle Animation -->
    <Style Selector="Border.health-score-circle">
      <Style.Animations>
        <Animation Duration="0:0:0.5" IterationCount="1">
          <KeyFrame Cue="0%">
            <Setter Property="ScaleTransform.ScaleX" Value="0.9"/>
            <Setter Property="ScaleTransform.ScaleY" Value="0.9"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="ScaleTransform.ScaleX" Value="1.0"/>
            <Setter Property="ScaleTransform.ScaleY" Value="1.0"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- Status Card Hover -->
    <Style Selector="Border.status-card:pointerover">
      <Setter Property="Background" Value="#18FFFFFF"/>
    </Style>

    <!-- Alert Item -->
    <Style Selector="Border.alert-item">
      <Setter Property="Background" Value="#11FFFFFF"/>
    </Style>
    <Style Selector="Border.alert-item[IsVisible=True]">
      <Style.Animations>
        <Animation Duration="0:0:0.3" IterationCount="1">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="TranslateTransform.Y" Value="-10"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="TranslateTransform.Y" Value="0"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- Pulse animation for critical alerts -->
    <Style Selector="Border.critical-alert">
      <Style.Animations>
        <Animation Duration="0:0:1" IterationCount="Infinite">
          <KeyFrame Cue="0%">
            <Setter Property="BorderBrush" Value="#F44336"/>
          </KeyFrame>
          <KeyFrame Cue="50%">
            <Setter Property="BorderBrush" Value="#FF8A80"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="BorderBrush" Value="#F44336"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </UserControl.Styles>

  <Border Background="#DD0A0A0A"
          CornerRadius="16"
          BorderBrush="#33FFFFFF"
          BorderThickness="1"
          Width="480"
          MaxHeight="680"
          BoxShadow="0 8 32 #40000000">
    <Grid RowDefinitions="Auto,*,Auto" Margin="20">

      <!-- Header -->
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto">
        <StackPanel>
          <TextBlock Text="Health Monitor"
                     Foreground="White"
                     FontWeight="Bold"
                     FontSize="20"/>
          <TextBlock Text="{Binding StatusMessage}"
                     Foreground="#88FFFFFF"
                     FontSize="12"
                     TextTrimming="CharacterEllipsis"
                     Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Monitoring Indicator -->
        <Border Grid.Column="1"
                Background="#4CAF50"
                CornerRadius="4"
                Padding="8,2"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                IsVisible="{Binding IsMonitoring}">
          <TextBlock Text="● LIVE"
                     Foreground="White"
                     FontSize="10"
                     FontWeight="Bold"/>
        </Border>

        <!-- Settings Toggle -->
        <Button Grid.Column="2"
                Content="⚙"
                Command="{Binding ToggleSettingsCommand}"
                Background="Transparent"
                Foreground="#CCFFFFFF"
                Padding="8,4"
                FontSize="16"
                VerticalAlignment="Center"
                Margin="0,0,4,0"/>

        <Button Grid.Column="2"
                Content="✕"
                Command="{Binding CloseCommand}"
                Background="Transparent"
                Foreground="#CCFFFFFF"
                Padding="8,4"
                FontSize="16"
                VerticalAlignment="Center"/>
      </Grid>

      <!-- Main Content -->
      <ScrollViewer Grid.Row="1" Margin="0,16,0,0">
        <StackPanel Spacing="16">

          <!-- Settings Panel (Collapsible) -->
          <Border Background="#11FFFFFF"
                  CornerRadius="12"
                  Padding="16"
                  IsVisible="{Binding ShowSettings}">
            <StackPanel Spacing="12">
              <TextBlock Text="Settings" 
                         Foreground="White" 
                         FontWeight="SemiBold"
                         FontSize="14"/>

              <CheckBox Content="Enable Posture Detection"
                        IsChecked="{Binding EnablePostureDetection}"
                        Foreground="#CCFFFFFF"/>
              
              <CheckBox Content="Enable Eye Strain Monitoring"
                        IsChecked="{Binding EnableEyeStrainMonitoring}"
                        Foreground="#CCFFFFFF"/>
              
              <CheckBox Content="Enable Heart Rate Monitoring"
                        IsChecked="{Binding EnableHeartRateMonitoring}"
                        Foreground="#CCFFFFFF"/>
              
              <CheckBox Content="Enable Ergonomic Warnings"
                        IsChecked="{Binding EnableErgonomicWarnings}"
                        Foreground="#CCFFFFFF"/>
              
              <CheckBox Content="Enable Break Reminders"
                        IsChecked="{Binding EnableBreakReminders}"
                        Foreground="#CCFFFFFF"/>

              <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                <TextBlock Grid.Column="0" Text="Break Interval (minutes)" 
                           Foreground="#CCFFFFFF" VerticalAlignment="Center"/>
                <NumericUpDown Grid.Column="1" 
                               Value="{Binding BreakIntervalMinutes}"
                               Minimum="10" Maximum="180" Increment="5"
                               Width="80"/>
              </Grid>

              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="Break Duration (minutes)" 
                           Foreground="#CCFFFFFF" VerticalAlignment="Center"/>
                <NumericUpDown Grid.Column="1" 
                               Value="{Binding BreakDurationMinutes}"
                               Minimum="1" Maximum="30" Increment="1"
                               Width="80"/>
              </Grid>

              <Button Content="Save &amp; Apply"
                      Command="{Binding StartMonitoringCommand}"
                      Background="#224CAF50"
                      Foreground="White"
                      BorderBrush="#4CAF50"
                      BorderThickness="1"
                      CornerRadius="6"
                      Padding="12,8"
                      HorizontalAlignment="Right"
                      Margin="0,8,0,0"/>
            </StackPanel>
          </Border>

          <!-- Health Score Circle -->
          <Grid HorizontalAlignment="Center">
            <Border Classes="health-score-circle"
                    Width="140" Height="140"
                    CornerRadius="70"
                    Background="#11FFFFFF"
                    BorderBrush="{Binding HealthScoreColor}"
                    BorderThickness="4">
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{Binding HealthScoreDisplay}"
                           Foreground="{Binding HealthScoreColor}"
                           FontSize="36"
                           FontWeight="Bold"/>
                <TextBlock Text="Health Score"
                           Foreground="#88FFFFFF"
                           FontSize="11"/>
              </StackPanel>
            </Border>
          </Grid>

          <!-- Status Cards Row -->
          <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="8" ColumnSpacing="8">
            
            <!-- Posture Status -->
            <Border Grid.Row="0" Grid.Column="0"
                    Classes="status-card"
                    Background="#0AFFFFFF"
                    CornerRadius="10"
                    Padding="12">
              <StackPanel Spacing="4">
                <TextBlock Text="🪑 Posture" 
                           Foreground="#88FFFFFF" 
                           FontSize="11"/>
                <TextBlock Text="{Binding PostureStatusDisplay}"
                           Foreground="{Binding PostureStatusColor}"
                           FontSize="13"
                           FontWeight="SemiBold"/>
                <ProgressBar Value="{Binding PostureStatus, Converter={StaticResource EnumToIntConverter}}"
                             Maximum="4"
                             Foreground="{Binding PostureStatusColor}"
                             Background="#22FFFFFF"
                             Height="4"
                             Margin="0,4,0,0"/>
              </StackPanel>
            </Border>

            <!-- Eye Strain -->
            <Border Grid.Row="0" Grid.Column="1"
                    Classes="status-card"
                    Background="#0AFFFFFF"
                    CornerRadius="10"
                    Padding="12">
              <StackPanel Spacing="4">
                <TextBlock Text="👁️ Eye Strain" 
                           Foreground="#88FFFFFF" 
                           FontSize="11"/>
                <TextBlock Text="{Binding EyeStrainDisplay}"
                           Foreground="{Binding EyeStrainColor}"
                           FontSize="13"
                           FontWeight="SemiBold"/>
                <ProgressBar Value="{Binding EyeStrainLevel, Converter={StaticResource EnumToIntConverter}}"
                             Maximum="4"
                             Foreground="{Binding EyeStrainColor}"
                             Background="#22FFFFFF"
                             Height="4"
                             Margin="0,4,0,0"/>
              </StackPanel>
            </Border>

            <!-- Fatigue -->
            <Border Grid.Row="1" Grid.Column="0"
                    Classes="status-card"
                    Background="#0AFFFFFF"
                    CornerRadius="10"
                    Padding="12">
              <StackPanel Spacing="4">
                <TextBlock Text="😴 Fatigue" 
                           Foreground="#88FFFFFF" 
                           FontSize="11"/>
                <TextBlock Text="{Binding FatigueDisplay}"
                           Foreground="{Binding FatigueColor}"
                           FontSize="13"
                           FontWeight="SemiBold"/>
                <ProgressBar Value="{Binding FatigueLevel, Converter={StaticResource EnumToIntConverter}}"
                             Maximum="3"
                             Foreground="{Binding FatigueColor}"
                             Background="#22FFFFFF"
                             Height="4"
                             Margin="0,4,0,0"/>
              </StackPanel>
            </Border>

            <!-- Focus Level -->
            <Border Grid.Row="1" Grid.Column="1"
                    Classes="status-card"
                    Background="#0AFFFFFF"
                    CornerRadius="10"
                    Padding="12">
              <StackPanel Spacing="4">
                <TextBlock Text="🎯 Focus" 
                           Foreground="#88FFFFFF" 
                           FontSize="11"/>
                <TextBlock Text="{Binding FocusLevel}"
                           Foreground="#4CAF50"
                           FontSize="13"
                           FontWeight="SemiBold"/>
                <TextBlock Text="{Binding StressLevel}"
                           Foreground="#66FFFFFF"
                           FontSize="10"/>
              </StackPanel>
            </Border>
          </Grid>

          <!-- Break Timer -->
          <Border Background="#0AFFFFFF"
                  CornerRadius="10"
                  Padding="16"
                  IsVisible="{Binding IsMonitoring}">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Next Break In"
                           Foreground="#88FFFFFF"
                           FontSize="11"/>
                <TextBlock Text="{Binding BreakTimerDisplay}"
                           Foreground="{Binding IsBreakOverdue, Converter={StaticResource BoolToColorConverter}, ConverterParameter=#F44336|#FFFFFF}"
                           FontSize="24"
                           FontWeight="Bold"/>
                <TextBlock Text="{Binding SessionDurationDisplay, StringFormat='Session: {0}'}"
                           Foreground="#66FFFFFF"
                           FontSize="10"
                           Margin="0,4,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                <Button Content="Take Break"
                        Command="{Binding TakeBreakCommand}"
                        Background="#224CAF50"
                        Foreground="White"
                        BorderBrush="#4CAF50"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,6"
                        FontSize="12"/>
                <Button Content="20-20-20"
                        Command="{Binding TakeEyeBreakCommand}"
                        Background="#2203A9F4"
                        Foreground="White"
                        BorderBrush="#03A9F4"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,6"
                        FontSize="12"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- Active Alerts -->
          <Border Background="#11FFFFFF"
                  CornerRadius="10"
                  Padding="16"
                  IsVisible="{Binding HasActiveAlerts}">
            <StackPanel Spacing="8">
              <TextBlock Text="Active Alerts" 
                         Foreground="White" 
                         FontWeight="SemiBold"
                         FontSize="14"/>
              
              <ItemsControl ItemsSource="{Binding ActiveAlerts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="health:HealthAlert">
                    <Border Classes="alert-item"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,6"
                            Classes.critical-alert="{Binding Severity, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Critical}"
                            BorderBrush="{Binding Severity, Converter={StaticResource AlertSeverityToBrushConverter}}"
                            BorderThickness="1">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                          <TextBlock Text="{Binding Type, StringFormat='{}{0}'}"
                                     Foreground="#88FFFFFF"
                                     FontSize="10"
                                     TextTransform="Uppercase"/>
                          <TextBlock Text="{Binding Message}"
                                     Foreground="White"
                                     FontSize="12"
                                     TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding TriggeredAt, StringFormat='{}{0:HH:mm:ss}'}"
                                     Foreground="#66FFFFFF"
                                     FontSize="9"
                                     Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="✓"
                                Command="{Binding DataContext.AcknowledgeAlertCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding Id}"
                                Background="Transparent"
                                Foreground="#4CAF50"
                                Padding="8,4"
                                FontSize="14"
                                VerticalAlignment="Top"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Quick Actions -->
          <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
            <Button Grid.Column="0"
                    Content="{Binding IsMonitoring, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Stop Monitoring|Start Monitoring'}"
                    Command="{Binding IsMonitoring, Converter={StaticResource BoolToCommandConverter}, ConverterParameter={Binding StopMonitoringCommand}|{Binding StartMonitoringCommand}}"
                    Background="{Binding IsMonitoring, Converter={StaticResource BoolToObjectConverter}, ConverterParameter=#33F44336|#334CAF50}"
                    Foreground="White"
                    CornerRadius="8"
                    Padding="16,10"
                    FontWeight="SemiBold"/>
            
            <Button Grid.Column="1"
                    Content="Refresh"
                    Command="{Binding RefreshStatusCommand}"
                    Background="#22FFFFFF"
                    Foreground="White"
                    CornerRadius="8"
                    Padding="16,10"
                    FontWeight="SemiBold"/>
          </Grid>

          <!-- Simulation Buttons (Debug) -->
          <Border Background="#08FFFFFF"
                  CornerRadius="8"
                  Padding="12"
                  Margin="0,8,0,0">
            <StackPanel Spacing="8">
              <TextBlock Text="Simulate Posture (Debug)" 
                         Foreground="#66FFFFFF" 
                         FontSize="10"/>
              <WrapPanel Orientation="Horizontal" Spacing="6">
                <Button Content="Excellent"
                        Command="{Binding SimulatePostureCommand}"
                        CommandParameter="excellent"
                        Background="#224CAF50"
                        Foreground="White"
                        Padding="8,4"
                        FontSize="10"/>
                <Button Content="Good"
                        Command="{Binding SimulatePostureCommand}"
                        CommandParameter="good"
                        Background="#228BC34A"
                        Foreground="White"
                        Padding="8,4"
                        FontSize="10"/>
                <Button Content="Slouching"
                        Command="{Binding SimulatePostureCommand}"
                        CommandParameter="slouching"
                        Background="#22FFC107"
                        Foreground="White"
                        Padding="8,4"
                        FontSize="10"/>
                <Button Content="Poor"
                        Command="{Binding SimulatePostureCommand}"
                        CommandParameter="poor"
                        Background="#22FF9800"
                        Foreground="White"
                        Padding="8,4"
                        FontSize="10"/>
                <Button Content="Critical"
                        Command="{Binding SimulatePostureCommand}"
                        CommandParameter="critical"
                        Background="#22F44336"
                        Foreground="White"
                        Padding="8,4"
                        FontSize="10"/>
              </WrapPanel>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>

      <!-- Footer -->
      <Border Grid.Row="2"
              Background="#08FFFFFF"
              CornerRadius="8"
              Padding="12"
              Margin="0,12,0,0">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0"
                     Text="💡 20-20-20 Rule: Every 20 min, look 20 feet away for 20 sec"
                     Foreground="#88FFFFFF"
                     FontSize="10"
                     TextWrapping="Wrap"/>
          <TextBlock Grid.Column="1"
                     Text="{Binding BreakReminderCount, StringFormat='{}{0} reminders'}"
                     Foreground="#66FFFFFF"
                     FontSize="10"
                     Margin="8,0,0,0"/>
        </Grid>
      </Border>

    </Grid>
  </Border>
</UserControl>
