<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SaveState.Presentation.ViewModels.Overlays"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="400"
             x:Class="SaveState.Presentation.Views.Overlays.MemoryMonitorOverlay"
             x:DataType="vm:MemoryMonitorOverlayViewModel">

    <Border Background="#CC000000" CornerRadius="8" BorderBrush="#33FFFFFF" BorderThickness="1" Width="300">
        <Grid RowDefinitions="Auto, *, Auto">
            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="10">
                <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="Bold"/>
                <Button Grid.Column="1" Content="✕" Command="{Binding CloseCommand}"
                        Background="Transparent" Foreground="White" Padding="2" Margin="5,0,0,0"/>
            </Grid>

            <!-- List -->
            <ScrollViewer Grid.Row="1" Height="250">
                <ItemsControl ItemsSource="{Binding WatchedAddresses}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*, Auto, Auto, Auto" Margin="10,5">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Label}" Foreground="White" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Address}" Foreground="#88FFFFFF" FontSize="10"/>
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="{Binding Type}" Foreground="#88FFFFFF" FontSize="10" VerticalAlignment="Center" Margin="10,0"/>

                                <TextBlock Grid.Column="2" Text="{Binding Value}" Foreground="#4CAF50" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0"/>

                                <CheckBox Grid.Column="3" IsChecked="{Binding IsFrozen}" ToolTip.Tip="Freeze Value"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Footer -->
            <Button Grid.Row="2" Content="Add Address" Command="{Binding AddAddressCommand}"
                    HorizontalAlignment="Stretch" Margin="10"
                    Background="#33FFFFFF" Foreground="White"/>
        </Grid>
    </Border>
</UserControl>
