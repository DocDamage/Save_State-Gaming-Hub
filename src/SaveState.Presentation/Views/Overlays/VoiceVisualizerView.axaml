<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SaveState.Presentation.ViewModels.Overlays"
             xmlns:voice="using:SaveState.Presentation.Models.Voice"
             xmlns:controls="using:SaveState.Presentation.Controls.Voice"
             xmlns:converters="using:SaveState.Presentation.Converters"
             x:Class="SaveState.Presentation.Views.Overlays.VoiceVisualizerView"
             x:DataType="vm:VoiceVisualizerViewModel"
             IsVisible="{Binding IsVisible}"
             Opacity="{Binding CurrentState, Converter={StaticResource VoiceActiveToOpacityConverter}}">

    <UserControl.Resources>
        <!-- Converters -->
        <converters:VoiceStateToColorConverter x:Key="VoiceStateToColorConverter" />
        <converters:VoiceStateToIconConverter x:Key="VoiceStateToIconConverter" />
        <converters:VoiceStateToTextConverter x:Key="VoiceStateToTextConverter" />
        <converters:VoiceStateToAnimationIntensityConverter x:Key="VoiceStateToAnimationIntensityConverter" />
        <converters:VoiceStateToPulseSpeedConverter x:Key="VoiceStateToPulseSpeedConverter" />
        <converters:ConfidenceToColorConverter x:Key="ConfidenceToColorConverter" />
        <converters:ConfidenceToPercentageConverter x:Key="ConfidenceToPercentageConverter" />
        <converters:VoiceActiveToOpacityConverter x:Key="VoiceActiveToOpacityConverter" />
        <converters:ListeningDurationToTextConverter x:Key="ListeningDurationToTextConverter" />
        <converters:EnumEqualsConverter x:Key="EnumEqualsConverter" />
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Compact Mode Styles -->
        <Style Selector=":is(UserControl).compact">
            <Setter Property="Width" Value="280" />
            <Setter Property="Height" Value="120" />
        </Style>

        <Style Selector=":is(UserControl).full">
            <Setter Property="Width" Value="500" />
            <Setter Property="Height" Value="320" />
        </Style>

        <!-- Pulse Animation -->
        <Style Selector="Border.pulse">
            <Style.Animations>
                <Animation Duration="0:0:2" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1.0" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0.5" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1.0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Idle Pulse Animation -->
        <Style Selector="Border.idle-pulse">
            <Style.Animations>
                <Animation Duration="0:0:3" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1.0" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1.0" />
                        <Setter Property="Opacity" Value="0.7" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1.1" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1.1" />
                        <Setter Property="Opacity" Value="1.0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1.0" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1.0" />
                        <Setter Property="Opacity" Value="0.7" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Button Styles -->
        <Style Selector="Button.voice-button">
            <Setter Property="Background" Value="#20FFFFFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.voice-button:pointerover">
            <Setter Property="Background" Value="#40FFFFFF" />
        </Style>

        <Style Selector="Button.voice-button:pressed">
            <Setter Property="Background" Value="#60FFFFFF" />
        </Style>
    </UserControl.Styles>

    <!-- Main Container -->
    <Border Background="#E6000000"
            CornerRadius="16"
            BoxShadow="0 16 48 #60000000"
            Classes.full="{Binding !IsCompactMode}"
            Classes.compact="{Binding IsCompactMode}">

        <Grid RowDefinitions="Auto,*,Auto">
            <!-- Header -->
            <Grid Grid.Row="0"
                  ColumnDefinitions="Auto,*,Auto"
                  Margin="20,16,20,8">
                
                <!-- State Icon -->
                <Border Grid.Column="0"
                        Width="40"
                        Height="40"
                        Background="{Binding CurrentState, Converter={StaticResource VoiceStateToColorConverter}}"
                        CornerRadius="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Classes.idle-pulse="{Binding CurrentState, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Idle}"
                        Classes.pulse="{Binding CurrentState, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Listening}">
                    <TextBlock Text="{Binding CurrentState, Converter={StaticResource VoiceStateToIconConverter}}"
                              FontSize="20"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                </Border>

                <!-- Status Text -->
                <StackPanel Grid.Column="1" 
                           Margin="12,0,0,0"
                           VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentState, Converter={StaticResource VoiceStateToTextConverter}}"
                              FontSize="16"
                              FontWeight="SemiBold"
                              Foreground="White" />
                    <TextBlock Text="{Binding WakeWord}"
                              FontSize="12"
                              Opacity="0.6"
                              Foreground="White"
                              IsVisible="{Binding CurrentState, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Idle}" />
                    <TextBlock Text="{Binding ListeningDuration, Converter={StaticResource ListeningDurationToTextConverter}}"
                              FontSize="12"
                              Opacity="0.6"
                              Foreground="White"
                              IsVisible="{Binding CurrentState, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Listening}" />
                </StackPanel>

                <!-- Compact Mode Toggle -->
                <Button Grid.Column="2"
                       Classes="voice-button"
                       Command="{Binding ToggleCompactModeCommand}"
                       Content="{Binding IsCompactMode, Converter={StaticResource BoolToStringConverter}, ConverterParameter='◀|▶'}" />
            </Grid>

            <!-- Content Area -->
            <Grid Grid.Row="1" Margin="20,8">
                
                <!-- Full Mode Content -->
                <Grid IsVisible="{Binding !IsCompactMode}"
                      RowDefinitions="*,Auto,Auto">
                    
                    <!-- Audio Waveform -->
                    <controls:AudioWaveform Grid.Row="0"
                                           AudioData="{Binding FrequencyData}"
                                           AudioLevel="{Binding AudioLevel}"
                                           State="{Binding CurrentState}"
                                           ShowFrequencyBands="{Binding ShowFrequencyBands}"
                                           Height="120"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Center" />

                    <!-- Recognized Text -->
                    <TextBlock Grid.Row="1"
                              Text="{Binding RecognizedText}"
                              FontSize="18"
                              FontWeight="Medium"
                              Foreground="White"
                              TextAlignment="Center"
                              TextWrapping="Wrap"
                              Margin="0,12,0,0"
                              Opacity="{Binding RecognizedText, Converter={StaticResource ObjectToBoolConverter}}" />

                    <!-- Command Text & Confidence -->
                    <StackPanel Grid.Row="2"
                               Margin="0,12,0,0"
                               Spacing="8"
                               IsVisible="{Binding Confidence, Converter={StaticResource ObjectToBoolConverter}}">
                        <TextBlock Text="{Binding CommandText}"
                                  FontSize="14"
                                  Foreground="White"
                                  TextAlignment="Center"
                                  Opacity="0.8" />
                        
                        <!-- Confidence Bar -->
                        <Grid ColumnDefinitions="Auto,*,Auto" MaxWidth="300">
                            <TextBlock Grid.Column="0"
                                      Text="Confidence:"
                                      FontSize="12"
                                      Foreground="White"
                                      Opacity="0.6" />
                            <ProgressBar Grid.Column="1"
                                        Value="{Binding Confidence}"
                                        Maximum="1"
                                        Margin="8,0"
                                        Foreground="{Binding Confidence, Converter={StaticResource ConfidenceToColorConverter}}"
                                        Background="#20FFFFFF" />
                            <TextBlock Grid.Column="2"
                                      Text="{Binding Confidence, Converter={StaticResource ConfidenceToPercentageConverter}}"
                                      FontSize="12"
                                      Foreground="White"
                                      Opacity="0.8" />
                        </Grid>
                    </StackPanel>

                    <!-- Error Message -->
                    <TextBlock Grid.Row="2"
                              Text="{Binding ErrorMessage}"
                              FontSize="14"
                              Foreground="#F44336"
                              TextAlignment="Center"
                              TextWrapping="Wrap"
                              Margin="0,12,0,0"
                              IsVisible="{Binding CurrentState, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Error}" />
                </Grid>

                <!-- Compact Mode Content -->
                <Grid IsVisible="{Binding IsCompactMode}"
                      RowDefinitions="Auto,Auto">
                    <!-- Simple Waveform -->
                    <controls:AudioWaveform Grid.Row="0"
                                           AudioData="{Binding FrequencyData}"
                                           AudioLevel="{Binding AudioLevel}"
                                           State="{Binding CurrentState}"
                                           ShowFrequencyBands="False"
                                           Height="40"
                                           HorizontalAlignment="Stretch" />

                    <!-- Truncated Recognized Text -->
                    <TextBlock Grid.Row="1"
                              Text="{Binding RecognizedText}"
                              FontSize="14"
                              Foreground="White"
                              TextAlignment="Center"
                              TextTrimming="CharacterEllipsis"
                              Margin="0,8,0,0"
                              MaxLines="1" />
                </Grid>
            </Grid>

            <!-- Footer / Controls -->
            <StackPanel Grid.Row="2"
                       Orientation="Horizontal"
                       HorizontalAlignment="Center"
                       Spacing="12"
                       Margin="0,0,0,16">
                
                <!-- Mute/Unmute Button -->
                <Button Classes="voice-button"
                       Command="{Binding ToggleMuteCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding IsMuted, Converter={StaticResource BoolToStringConverter}, ConverterParameter='🔇|🎙️'}" />
                        <TextBlock Text="{Binding IsMuted, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Unmute|Mute'}" />
                    </StackPanel>
                </Button>

                <!-- Start/Stop Button -->
                <Button Classes="voice-button"
                       Command="{Binding StartListeningCommand}"
                       IsVisible="{Binding CurrentState, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Idle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="▶️" />
                        <TextBlock Text="Start" />
                    </StackPanel>
                </Button>

                <Button Classes="voice-button"
                       Command="{Binding StopListeningCommand}"
                       IsVisible="{Binding CurrentState, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Listening}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="⏹️" />
                        <TextBlock Text="Stop" />
                    </StackPanel>
                </Button>

                <!-- Cancel Button -->
                <Button Classes="voice-button"
                       Command="{Binding CancelCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="❌" />
                        <TextBlock Text="Cancel" />
                    </StackPanel>
                </Button>

                <!-- Help Button -->
                <Button Classes="voice-button"
                       Command="{Binding ShowHelpCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="❓" />
                        <TextBlock Text="Help" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
