<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SaveState.Presentation.ViewModels.Library.GameDetail;assembly=SaveState.Presentation"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="SaveState.Presentation.Views.Library.GameDetail.GameMediaTabView"
             x:DataType="vm:GameMediaTabViewModel">

    <Grid RowDefinitions="Auto, *">
        <!-- Header -->
        <Border Grid.Row="0" Classes="GlassContainer" Padding="20" Margin="0,0,0,15">
            <Grid ColumnDefinitions="Auto, *, Auto, Auto, Auto, Auto">
                <TextBlock Grid.Column="0" Text="🖼️ MEDIA" Classes="Subtitle" VerticalAlignment="Center" />

                <TextBlock Grid.Column="1"
                           Text="{Binding MediaCountText}"
                           Classes="Caption"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center" />

                <Button Grid.Column="2"
                        Content="📸 Take Screenshot"
                        Classes="Secondary"
                        Command="{Binding TakeScreenshotCommand}"
                        Margin="10,0" />

                <Button Grid.Column="3"
                        Content="🎬 Record Video"
                        Classes="Secondary"
                        Command="{Binding RecordVideoCommand}"
                        Margin="0,0,10,0" />

                <ComboBox Grid.Column="4"
                          ItemsSource="{Binding ViewModeOptions}"
                          SelectedItem="{Binding SelectedViewMode}"
                          Width="100"
                          Margin="0,0,10,0" />

                <Button Grid.Column="5"
                        Content="📁 Open Folder"
                        Classes="Secondary"
                        Command="{Binding OpenMediaFolderCommand}" />
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" ColumnDefinitions="*, Auto">
            <!-- Media Grid/List -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding MediaItems}" Margin="0,0,15,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding BackgroundBrush}"
                                    BorderBrush="{Binding BorderBrush}"
                                    BorderThickness="2"
                                    CornerRadius="8"
                                    Width="220" Height="180"
                                    Margin="10"
                                    Cursor="Hand">
                                <Grid>
                                    <!-- Media Preview -->
                                    <Image Source="{Binding PreviewUrl}"
                                           Stretch="UniformToFill"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Opacity="{Binding Opacity}" />

                                    <!-- Video Indicator -->
                                    <Border Background="Black"
                                            Opacity="0.7"
                                            CornerRadius="15"
                                            Width="30" Height="30"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding IsVideo}">
                                        <TextBlock Text="▶️"
                                                   FontSize="16"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Selection Overlay -->
                                    <Border Background="{StaticResource PrimaryBrush}"
                                            Opacity="0.8"
                                            CornerRadius="8"
                                            IsVisible="{Binding IsSelected}">
                                        <TextBlock Text="✓"
                                                   FontSize="24"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="White" />
                                    </Border>

                                    <!-- Media Info Overlay -->
                                    <Border Background="Black"
                                            Opacity="0.7"
                                            VerticalAlignment="Bottom"
                                            Height="50"
                                            CornerRadius="0,0,8,8">
                                        <StackPanel Spacing="2" Margin="10">
                                            <TextBlock Text="{Binding FileName}"
                                                       Classes="Caption"
                                                       Foreground="White"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />

                                            <TextBlock Text="{Binding DateText}"
                                                       Classes="Caption"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="10" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Quick Actions (on hover) -->
                                    <Border Background="Black"
                                            Opacity="0.8"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="8"
                                            CornerRadius="6">
                                        <StackPanel Orientation="Horizontal" Spacing="5" Margin="8,6">
                                            <Button Content="👁️"
                                                    Classes="IconButton"
                                                    Command="{Binding ViewCommand}"
                                                    ToolTip.Tip="View full size" />

                                            <Button Content="📋"
                                                    Classes="IconButton"
                                                    Command="{Binding CopyCommand}"
                                                    ToolTip.Tip="Copy to clipboard" />

                                            <Button Content="🗑️"
                                                    Classes="IconButton"
                                                    Command="{Binding DeleteCommand}"
                                                    ToolTip.Tip="Delete media" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Sidebar -->
            <Border Grid.Column="1" Classes="GlassContainer" Padding="20" Width="280">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="20">
                        <TextBlock Text="📊 MEDIA LIBRARY" Classes="Subtitle" />

                        <!-- Stats -->
                        <Border Background="{StaticResource SurfaceBrush}" Padding="15" CornerRadius="6">
                            <Grid RowDefinitions="Auto, Auto, Auto, Auto" ColumnDefinitions="*, Auto">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Screenshots:" Classes="Caption" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ScreenshotCount}" Classes="Caption" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Videos:" Classes="Caption" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding VideoCount}" Classes="Caption" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Total Size:" Classes="Caption" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TotalSize}" Classes="Caption" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Last Capture:" Classes="Caption" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LastCaptureText}" Classes="Caption" />
                            </Grid>
                        </Border>

                        <!-- Quick Filters -->
                        <StackPanel Spacing="10">
                            <TextBlock Text="🔍 FILTERS" Classes="Caption" FontWeight="Bold" />

                            <StackPanel Spacing="8">
                                <CheckBox Content="Show Screenshots" IsChecked="{Binding ShowScreenshots}" />
                                <CheckBox Content="Show Videos" IsChecked="{Binding ShowVideos}" />
                                <CheckBox Content="Show Favorites" IsChecked="{Binding ShowFavorites}" />
                            </StackPanel>

                            <ComboBox ItemsSource="{Binding DateRangeOptions}"
                                      SelectedItem="{Binding SelectedDateRange}"
                                      PlaceholderText="Date range..." />
                        </StackPanel>

                        <!-- Recent Captures -->
                        <StackPanel Spacing="10">
                            <TextBlock Text="🆕 RECENT CAPTURES" Classes="Caption" FontWeight="Bold" />

                            <ItemsControl ItemsSource="{Binding RecentCaptures}" MaxHeight="200">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SurfaceBrush}"
                                                CornerRadius="6"
                                                Padding="10"
                                                Margin="0,0,0,8">
                                            <Grid ColumnDefinitions="Auto, *">
                                                <Border Grid.Column="0"
                                                        Background="{StaticResource SurfaceBrush}"
                                                        CornerRadius="4"
                                                        Width="40" Height="30"
                                                        Margin="0,0,10,0">
                                                    <Image Source="{Binding ThumbnailUrl}"
                                                           Stretch="UniformToFill" />
                                                </Border>

                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Text="{Binding FileName}"
                                                               Classes="Caption"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />

                                                    <TextBlock Text="{Binding DateText}"
                                                               Classes="Caption"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="10" />

                                                    <TextBlock Text="{Binding SizeText}"
                                                               Classes="Caption"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="10" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Capture Settings -->
                        <StackPanel Spacing="10">
                            <TextBlock Text="⚙️ CAPTURE SETTINGS" Classes="Caption" FontWeight="Bold" />

                            <StackPanel Spacing="8">
                                <TextBlock Text="Screenshot Format:" Classes="Caption" />
                                <ComboBox ItemsSource="{Binding ScreenshotFormats}"
                                          SelectedItem="{Binding SelectedScreenshotFormat}" />

                                <TextBlock Text="Video Quality:" Classes="Caption" Margin="0,10,0,0" />
                                <ComboBox ItemsSource="{Binding VideoQualities}"
                                          SelectedItem="{Binding SelectedVideoQuality}" />

                                <CheckBox Content="Auto-save screenshots" IsChecked="{Binding AutoSaveScreenshots}" Margin="0,10,0,0" />
                                <CheckBox Content="Include UI in screenshots" IsChecked="{Binding IncludeUI}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Batch Actions -->
                        <StackPanel Spacing="10">
                            <TextBlock Text="🎬 BATCH ACTIONS" Classes="Caption" FontWeight="Bold" />

                            <StackPanel Spacing="8">
                                <Button Content="📤 Export Selected"
                                        Classes="Secondary"
                                        Command="{Binding ExportSelectedCommand}" />

                                <Button Content="❤️ Mark as Favorite"
                                        Classes="Secondary"
                                        Command="{Binding FavoriteSelectedCommand}" />

                                <Button Content="🗑️ Delete Selected"
                                        Classes="Danger"
                                        Command="{Binding DeleteSelectedCommand}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Storage Info -->
                        <StackPanel Spacing="10">
                            <TextBlock Text="💾 STORAGE" Classes="Caption" FontWeight="Bold" />

                            <StackPanel Spacing="5">
                                <TextBlock Text="{Binding StorageUsedText}" Classes="Caption" />
                                <ProgressBar Value="{Binding StorageUsagePercentage}"
                                            Maximum="100"
                                            Height="6" />
                                <TextBlock Text="{Binding StorageAvailableText}"
                                          Classes="Caption"
                                          Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>

                            <Button Content="🧹 Clean Old Media"
                                    Classes="Secondary"
                                    Command="{Binding CleanOldMediaCommand}"
                                    Margin="0,10,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
