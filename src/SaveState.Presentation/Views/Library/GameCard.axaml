<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SaveState.Presentation.ViewModels.Library;assembly=SaveState.Presentation"
             mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="280"
             x:Class="SaveState.Presentation.Views.Library.GameCard"
             x:DataType="vm:GameCardViewModel">

    <!-- 
        PERFORMANCE OPTIMIZATION NOTES:
        - Uses async image loading to prevent UI blocking
        - Binding modes optimized for read-only display
        - Fixed dimensions prevent layout recalculation
    -->

    <Button Classes="GameCardButton"
            Width="180" Height="260"
            Background="Transparent"
            BorderThickness="0"
            Command="{Binding OpenGameCommand}"
            ToolTip.Tip="{Binding Title, Mode=OneTime}">

        <Grid RowDefinitions="*, Auto, Auto, Auto">
            <!-- Selection Checkbox (shown in selection mode) -->
            <CheckBox Grid.Row="0"
                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      Margin="8"
                      IsVisible="{Binding IsSelectionMode, Mode=OneWay}"
                      ToolTip.Tip="Select game" />

            <!-- Cover Art - Loaded asynchronously -->
            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="6"
                    Margin="8,8,8,0">
                <Image Source="{Binding CoverArt, Mode=OneWay}"
                       Stretch="UniformToFill"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       ToolTip.Tip="{Binding Title, Mode=OneTime}" />
            </Border>

            <!-- Title -->
            <TextBlock Grid.Row="1"
                       Text="{Binding Title, Mode=OneTime}"
                       Classes="Body"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       MaxLines="2"
                       Height="40"
                       Margin="8,8,8,0"
                       TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding Title, Mode=OneTime}" />

            <!-- Platform & Status -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="8,4,8,0" Spacing="8">
                <TextBlock Text="{Binding PlatformIcon, Mode=OneTime}" FontSize="14" />
                <TextBlock Text="{Binding PlatformName, Mode=OneTime}"
                           Classes="Caption"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Text="{Binding StatusIcon, Mode=OneTime}"
                           FontSize="12"
                           Margin="4,0,0,0"
                           Foreground="{Binding StatusColor, Mode=OneTime}" />
            </StackPanel>

            <!-- Playtime & Rating -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="8,4,8,8" Spacing="8">
                <TextBlock Text="{Binding PlaytimeText, Mode=OneTime}"
                           Classes="Caption"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Text="{Binding RatingStars, Mode=OneTime}"
                           FontSize="12"
                           Margin="8,0,0,0" />
            </StackPanel>
        </Grid>
    </Button>
</UserControl>
