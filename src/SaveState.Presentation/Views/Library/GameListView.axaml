<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SaveState.Presentation.ViewModels.Library;assembly=SaveState.Presentation"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="SaveState.Presentation.Views.Library.GameListView"
             x:DataType="vm:GameListViewModel">

    <!-- 
        PERFORMANCE OPTIMIZATION NOTES:
        - Uses ListBox for efficient rendering of large collections
        - Images use async loading to prevent UI blocking
    -->
    <Border Classes="GlassContainer" Margin="20" Padding="0">
        <Grid RowDefinitions="Auto, *">
            <!-- Table Header -->
            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceBrush}"
                    Padding="15,10">
                <Grid ColumnDefinitions="50, 60, *, 120, 100, 100, 120, 80">
                <CheckBox Grid.Column="0"
                          IsChecked="{Binding IsAllSelected, Mode=TwoWay}"
                          Command="{Binding ToggleSelectAllCommand}"
                          ToolTip.Tip="Select/Deselect All" />

                <TextBlock Grid.Column="1" Text="Cover" Classes="Caption" FontWeight="Bold" />
                <TextBlock Grid.Column="2" Text="Title &amp; Developer" Classes="Caption" FontWeight="Bold" />
                <TextBlock Grid.Column="3" Text="Platform" Classes="Caption" FontWeight="Bold" />
                <TextBlock Grid.Column="4" Text="Status" Classes="Caption" FontWeight="Bold" />
                <TextBlock Grid.Column="5" Text="Last Played" Classes="Caption" FontWeight="Bold" />
                <TextBlock Grid.Column="6" Text="Playtime" Classes="Caption" FontWeight="Bold" />
                <TextBlock Grid.Column="7" Text="Rating" Classes="Caption" FontWeight="Bold" />
                </Grid>
            </Border>

            <!-- Table Rows - Virtualized for performance -->
            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ListBox ItemsSource="{Binding Games, Mode=OneWay}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemContainerTheme>
                        <ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                        </ControlTheme>
                    </ListBox.ItemContainerTheme>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding BackgroundBrush, Mode=OneTime}"
                                    Padding="15,8">
                                <Grid ColumnDefinitions="50, 60, *, 120, 100, 100, 120, 80">
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          VerticalAlignment="Center" />

                                <!-- Use AsyncImageLoader for non-blocking image loading -->
                                <Image Grid.Column="1"
                                       Source="{Binding CoverArt, Mode=OneWay}"
                                       Width="40"
                                       Height="60"
                                       Stretch="UniformToFill"
                                       VerticalAlignment="Center"
                                       ToolTip.Tip="{Binding Title, Mode=OneTime}" />

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding Title, Mode=OneTime}"
                                               Classes="Body"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Developer, Mode=OneTime}"
                                               Classes="Caption"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding PlatformIcon, Mode=OneTime}"
                                               FontSize="16" />
                                    <TextBlock Text="{Binding PlatformName, Mode=OneTime}"
                                               Classes="Caption"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <TextBlock Grid.Column="4"
                                           Text="{Binding StatusText, Mode=OneTime}"
                                           Classes="Caption"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding StatusColor, Mode=OneTime}" />

                                <TextBlock Grid.Column="5"
                                           Text="{Binding LastPlayedText, Mode=OneTime}"
                                           Classes="Caption"
                                           VerticalAlignment="Center" />

                                <TextBlock Grid.Column="6"
                                           Text="{Binding PlaytimeText, Mode=OneTime}"
                                           Classes="Caption"
                                           VerticalAlignment="Center" />

                                <StackPanel Grid.Column="7" VerticalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock Text="{Binding RatingStars, Mode=OneTime}" FontSize="14" />
                                    <TextBlock Text="{Binding RatingText, Mode=OneTime}"
                                               Classes="Caption"
                                               Margin="5,0,0,0"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
