<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SaveState.Presentation.ViewModels.Netplay"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="SaveState.Presentation.Views.Netplay.NetplayLobbyView"
             x:DataType="vm:NetplayLobbyViewModel">

  <Design.DataContext>
    <vm:NetplayLobbyViewModel />
  </Design.DataContext>

  <Grid Margin="20">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="400" />
      <ColumnDefinition Width="20" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Left Panel: Matchmaking Controls -->
    <StackPanel Grid.Column="0" Spacing="15">
      <TextBlock Text="Retro Gaming Network" 
                 FontSize="24" 
                 FontWeight="Bold" />

      <!-- Matchmaking Controls -->
      <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" 
              CornerRadius="8" 
              Padding="15">
        <StackPanel Spacing="10">
          <TextBlock Text="Matchmaking" 
                     FontSize="18" 
                     FontWeight="SemiBold" />

          <!-- Region Selection -->
          <TextBlock Text="Region:" />
          <ComboBox ItemsSource="{Binding Regions}" 
                    SelectedItem="{Binding SelectedRegion}" 
                    HorizontalAlignment="Stretch" />

          <!-- Skill Rating Selection -->
          <TextBlock Text="Skill Rating:" />
          <ComboBox ItemsSource="{Binding Ratings}" 
                    SelectedItem="{Binding SelectedRating}" 
                    HorizontalAlignment="Stretch" />

          <!-- Action Buttons -->
          <StackPanel Spacing="8" Margin="0,10,0,0">
            <Button Content="Start Matchmaking" 
                    Command="{Binding StartMatchmakingCommand}"
                    IsEnabled="{Binding !IsMatchmaking}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" />
            <Button Content="Cancel Matchmaking" 
                    Command="{Binding CancelMatchmakingCommand}"
                    IsEnabled="{Binding IsMatchmaking}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" />
            <Button Content="Connect to Match" 
                    Command="{Binding ConnectToSessionCommand}"
                    IsEnabled="{Binding IsMatchmaking}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Current Ticket Info -->
      <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" 
              CornerRadius="8" 
              Padding="15"
              IsVisible="{Binding CurrentTicket, Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel Spacing="5">
          <TextBlock Text="Current Ticket" 
                     FontSize="16" 
                     FontWeight="SemiBold" />
          <TextBlock Text="{Binding CurrentTicket.TicketId, StringFormat='ID: {0}'}" />
          <TextBlock Text="{Binding CurrentTicket.Status, StringFormat='Status: {0}'}" />
          <TextBlock Text="{Binding CurrentTicket.CreatedAt, StringFormat='Created: {0:HH:mm:ss}'}" />
        </StackPanel>
      </Border>

      <!-- Spectator Mode -->
      <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" 
              CornerRadius="8" 
              Padding="15">
        <StackPanel Spacing="10">
          <TextBlock Text="Spectator Mode" 
                     FontSize="18" 
                     FontWeight="SemiBold" />
          <ToggleSwitch Content="Enable Spectator Mode" 
                        IsChecked="{Binding IsSpectatorMode}" />
          <Button Content="Apply Spectator Mode" 
                  Command="{Binding ToggleSpectatorModeCommand}"
                  IsEnabled="{Binding SelectedSession, Converter={x:Static ObjectConverters.IsNotNull}}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center" />
        </StackPanel>
      </Border>

      <!-- Status Message -->
      <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" 
              CornerRadius="8" 
              Padding="15">
        <StackPanel Spacing="5">
          <TextBlock Text="Status" 
                     FontSize="16" 
                     FontWeight="SemiBold" />
          <TextBlock Text="{Binding StatusMessage}" 
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Right Panel: Sessions and Leaderboard -->
    <Grid Grid.Column="2" RowDefinitions="Auto,*,20,Auto,*">
      <!-- Active Sessions Header -->
      <TextBlock Grid.Row="0" 
                 Text="Active Sessions" 
                 FontSize="20" 
                 FontWeight="Bold"
                 Margin="0,0,0,10" />

      <!-- Active Sessions List -->
      <Border Grid.Row="1" 
              Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" 
              CornerRadius="8">
        <Grid RowDefinitions="Auto,*">
          <StackPanel Grid.Row="0" 
                      Orientation="Horizontal" 
                      HorizontalAlignment="Right"
                      Margin="10">
            <Button Content="Refresh" 
                    Command="{Binding RefreshSessionsCommand}"
                    Margin="0,0,10,0" />
            <Button Content="Disconnect" 
                    Command="{Binding DisconnectCommand}"
                    IsEnabled="{Binding SelectedSession, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>

          <DataGrid Grid.Row="1" 
                    ItemsSource="{Binding ActiveSessions}"
                    SelectedItem="{Binding SelectedSession}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    GridLinesVisibility="Horizontal"
                    Margin="10">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Session ID" 
                                  Binding="{Binding SessionId}" 
                                  Width="100" />
              <DataGridTextColumn Header="Game ID" 
                                  Binding="{Binding GameId}" 
                                  Width="150" />
              <DataGridTextColumn Header="Status" 
                                  Binding="{Binding Status}" 
                                  Width="120" />
              <DataGridTextColumn Header="Peers" 
                                  Binding="{Binding Peers.Count}" 
                                  Width="80" />
              <DataGridTextColumn Header="Started" 
                                  Binding="{Binding StartedAt, StringFormat={}{0:HH:mm}}" 
                                  Width="100" />
              <DataGridTextColumn Header="Input Delay" 
                                  Binding="{Binding RollbackConfig.InputDelay}" 
                                  Width="100" />
              <DataGridTextColumn Header="Max Rollback" 
                                  Binding="{Binding RollbackConfig.MaxRollbackFrames}" 
                                  Width="120" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>

      <!-- Leaderboard Header -->
      <TextBlock Grid.Row="3" 
                 Text="Leaderboard" 
                 FontSize="20" 
                 FontWeight="Bold"
                 Margin="0,0,0,10" />

      <!-- Leaderboard Table -->
      <Border Grid.Row="4" 
              Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" 
              CornerRadius="8">
        <Grid RowDefinitions="Auto,*">
          <StackPanel Grid.Row="0" 
                      Orientation="Horizontal" 
                      HorizontalAlignment="Right"
                      Margin="10">
            <Button Content="Refresh Leaderboard" 
                    Command="{Binding RefreshLeaderboardCommand}" />
          </StackPanel>

          <DataGrid Grid.Row="1" 
                    ItemsSource="{Binding LeaderboardEntries}"
                    SelectedItem="{Binding SelectedLeaderboardEntry}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    GridLinesVisibility="Horizontal"
                    Margin="10">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Rank" 
                                  Binding="{Binding Rank}" 
                                  Width="80" />
              <DataGridTextColumn Header="Player" 
                                  Binding="{Binding DisplayName}" 
                                  Width="200" />
              <DataGridTextColumn Header="Rating" 
                                  Binding="{Binding Rating}" 
                                  Width="100" />
              <DataGridTextColumn Header="Wins" 
                                  Binding="{Binding Wins}" 
                                  Width="80" />
              <DataGridTextColumn Header="Losses" 
                                  Binding="{Binding Losses}" 
                                  Width="80" />
              <DataGridTextColumn Header="Win Rate" 
                                  Width="100">
                <DataGridTextColumn.Binding>
                  <MultiBinding StringFormat="{}{0:F1}%">
                    <Binding Path="Wins" />
                    <Binding Path="Losses" />
                  </MultiBinding>
                </DataGridTextColumn.Binding>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Streak" 
                                  Binding="{Binding WinStreak}" 
                                  Width="80" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
