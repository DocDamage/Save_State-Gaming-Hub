<!--
    MobileSaveStatesView.axaml
    
    Save states management for mobile companion app.
    Browse, create, load, and share save states remotely.
    
    Binding Context: MobileSaveStatesViewModel
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SaveState.Presentation.ViewModels.MobileCompanion"
             xmlns:models="using:SaveState.Presentation.Models.Mobile"
             xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
             xmlns:ia="clr-namespace:Avalonia.Xaml.Interactions.Core;assembly=Avalonia.Xaml.Interactions"
             x:Class="SaveState.Presentation.Views.MobileCompanion.MobileSaveStatesView"
             x:DataType="vm:MobileSaveStatesViewModel"
             Background="{StaticResource BackgroundBrush}">

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- Header -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*,Auto"
              Margin="16,12"
              VerticalAlignment="Center">
            <Button Grid.Column="0"
                   Command="{Binding GoBackCommand}"
                   Classes="IconButton">
                <TextBlock Text="←" FontSize="24" />
            </Button>

            <TextBlock Grid.Column="1"
                      Text="Save States"
                      FontSize="17"
                      FontWeight="SemiBold"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Foreground="{StaticResource TextPrimaryBrush}" />

            <Button Grid.Column="2"
                   Command="{Binding RefreshSaveStatesCommand}"
                   Classes="IconButton">
                <TextBlock Text="🔄" FontSize="20" />
            </Button>
        </Grid>

        <!-- Game Selector & Search -->
        <StackPanel Grid.Row="1" Spacing="12" Margin="16,0,16,12">
            <ComboBox ItemsSource="{Binding AvailableGames}"
                     SelectedItem="{Binding SelectedGame}"
                     HorizontalAlignment="Stretch"
                     PlaceholderText="Select Game"
                     Classes="MobileComboBox" />

            <TextBox Text="{Binding SearchQuery}"
                    Watermark="🔍 Search save states..."
                    Classes="MobileInput" />
        </StackPanel>

        <!-- Save States List -->
        <ScrollViewer Grid.Row="2" Margin="16,0">
            <StackPanel Spacing="8">
                <!-- Loading Indicator -->
                <ProgressBar IsVisible="{Binding IsLoading}"
                            IsIndeterminate="True"
                            HorizontalAlignment="Stretch"
                            Height="4"
                            Margin="0,8" />

                <!-- Empty State -->
                <StackPanel IsVisible="{Binding FilteredSaveStates.Count, Converter={StaticResource EqualityConverter}, ConverterParameter=0}"
                           Spacing="16"
                           Margin="0,48"
                           HorizontalAlignment="Center">
                    <TextBlock Text="💾"
                              FontSize="64"
                              HorizontalAlignment="Center"
                              Opacity="0.5" />
                    <TextBlock Text="No save states found"
                              FontSize="16"
                              Foreground="{StaticResource TextTertiaryBrush}"
                              HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Save State Items -->
                <ItemsControl ItemsSource="{Binding FilteredSaveStates}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:SaveStateInfo">
                            <Button Command="{Binding $parent[ItemsControl].((vm:MobileSaveStatesViewModel)DataContext).OpenSaveStateDetailCommand}"
                                   CommandParameter="{Binding}"
                                   HorizontalAlignment="Stretch"
                                   Classes="ListItemCard"
                                   Margin="0,4">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <!-- Thumbnail -->
                                    <Border Grid.Column="0"
                                           Width="64"
                                           Height="64"
                                           CornerRadius="8"
                                           Background="{StaticResource SurfaceBrush}"
                                           Margin="0,0,12,0">
                                        <Image Source="{Binding ThumbnailUrl, FallbackValue={StaticResource DefaultSaveThumbnail}}"
                                              Stretch="UniformToFill" />
                                    </Border>

                                    <!-- Info -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                  FontSize="15"
                                                  FontWeight="SemiBold"
                                                  TextTrimming="CharacterEllipsis"
                                                  Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Description}"
                                                  FontSize="12"
                                                  TextTrimming="CharacterEllipsis"
                                                  MaxLines="1"
                                                  Foreground="{StaticResource TextSecondaryBrush}"
                                                  Margin="0,2,0,0" />
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding CreatedAt, Converter={StaticResource TimeAgoConverter}}"
                                                      FontSize="11"
                                                      Foreground="{StaticResource TextTertiaryBrush}" />
                                            <TextBlock IsVisible="{Binding IsCloudSynced}"
                                                      Text="☁️"
                                                      FontSize="11" />
                                            <TextBlock Text="{Binding FileSize, Converter={StaticResource FileSizeConverter}}"
                                                      FontSize="11"
                                                      Foreground="{StaticResource TextTertiaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Actions -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                        <Button Command="{Binding $parent[ItemsControl].((vm:MobileSaveStatesViewModel)DataContext).LoadSaveStateCommand}"
                                               CommandParameter="{Binding}"
                                               Classes="IconButton Small"
                                               ToolTip.Tip="Load">
                                            <TextBlock Text="▶️" FontSize="16" />
                                        </Button>
                                        <DropDownButton Classes="IconButton Small">
                                            <TextBlock Text="⋮" FontSize="16" />
                                            <DropDownButton.Flyout>
                                                <MenuFlyout>
                                                    <MenuItem Header="📤 Share"
                                                             Command="{Binding $parent[ItemsControl].((vm:MobileSaveStatesViewModel)DataContext).ShareSaveStateCommand}"
                                                             CommandParameter="{Binding}" />
                                                    <MenuItem Header="🗑️ Delete"
                                                             Command="{Binding $parent[ItemsControl].((vm:MobileSaveStatesViewModel)DataContext).DeleteSaveStateCommand}"
                                                             CommandParameter="{Binding}" />
                                                </MenuFlyout>
                                            </DropDownButton.Flyout>
                                        </DropDownButton>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Create Button -->
        <Button Grid.Row="3"
               Command="{Binding CreateSaveStateCommand}"
               HorizontalAlignment="Stretch"
               Height="48"
               Classes="Primary MobileButton"
               Margin="16,12">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="➕" FontSize="18" />
                <TextBlock Text="Create New Save State" VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <!-- Save State Detail Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="4"
               IsVisible="{Binding IsSaveStateDetailOpen}"
               Background="{StaticResource OverlayBackgroundBrush}"
               >
            <Interaction.Behaviors>
                <EventTriggerBehavior EventName="PointerPressed">
                    <InvokeCommandAction Command="{Binding CloseSaveStateDetailCommand}" />
                </EventTriggerBehavior>
            </Interaction.Behaviors>
            <Border Width="320"
                   Background="{StaticResource CardBackgroundBrush}"
                   CornerRadius="16"
                   Padding="24"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center">
                <StackPanel Spacing="16">
                    <TextBlock Text="{Binding SelectedSaveState.Name}"
                              FontSize="20"
                              FontWeight="Bold"
                              TextWrapping="Wrap"
                              Foreground="{StaticResource TextPrimaryBrush}" />
                    
                    <TextBlock Text="{Binding SelectedSaveState.Description}"
                              FontSize="14"
                              TextWrapping="Wrap"
                              Foreground="{StaticResource TextSecondaryBrush}" />
                    
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="0,8">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Created:" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedSaveState.CreatedAt, StringFormat='{}{0:MMM dd, yyyy}'}" FontSize="12" HorizontalAlignment="Right" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Size:" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,4,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedSaveState.FileSize, Converter={StaticResource FileSizeConverter}}" FontSize="12" HorizontalAlignment="Right" Margin="0,4,0,0" />
                    </Grid>

                    <StackPanel Spacing="8">
                        <Button Command="{Binding LoadSaveStateCommand}"
                               CommandParameter="{Binding SelectedSaveState}"
                               HorizontalAlignment="Stretch"
                               Height="48"
                               Classes="Primary MobileButton">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="▶️" FontSize="18" />
                                <TextBlock Text="Load Save State" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CloseSaveStateDetailCommand}"
                               HorizontalAlignment="Stretch"
                               Height="48"
                               Classes="Secondary MobileButton"
                               Content="Close" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
