<!--
    MobileLandingView.axaml
    
    Entry point for mobile companion app users.
    Provides pairing code entry and QR code scanning options.
    
    Binding Context: MobileLandingViewModel
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SaveState.Presentation.ViewModels.MobileCompanion"
             x:Class="SaveState.Presentation.Views.MobileCompanion.MobileLandingView"
             x:DataType="vm:MobileLandingViewModel"
             Background="{StaticResource BackgroundBrush}">

    <Grid RowDefinitions="*,Auto">
        <!-- Main Content -->
        <ScrollViewer Grid.Row="0">
            <StackPanel Spacing="24"
                       Margin="24,32,24,24"
                       HorizontalAlignment="Center"
                       MaxWidth="400">
                
                <!-- Logo and Header -->
                <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <TextBlock Text="📱"
                              FontSize="64"
                              HorizontalAlignment="Center" />
                    <TextBlock Text="SaveState"
                              FontSize="28"
                              FontWeight="Bold"
                              HorizontalAlignment="Center"
                              Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Mobile Companion"
                              FontSize="16"
                              HorizontalAlignment="Center"
                              Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>

                <!-- Welcome Text -->
                <TextBlock Text="Welcome! Connect to your gaming hub remotely."
                          FontSize="14"
                          TextAlignment="Center"
                          TextWrapping="Wrap"
                          Foreground="{StaticResource TextSecondaryBrush}"
                          Margin="0,16" />

                <!-- Pairing Section -->
                <Border Background="{StaticResource CardBackgroundBrush}"
                       CornerRadius="16"
                       Padding="24"
                       BoxShadow="0 4 20 0 #40000000">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Enter Pairing Code"
                                  FontSize="16"
                                  FontWeight="SemiBold"
                                  HorizontalAlignment="Center"
                                  Foreground="{StaticResource TextPrimaryBrush}" />
                        
                        <!-- Pairing Code Input -->
                        <TextBox Text="{Binding PairingCode}"
                                Watermark="_ _ _ _ _ _"
                                FontSize="32"
                                HorizontalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                MaxLength="6"
                                Width="200"
                                Height="56"
                                Classes="MobileInput" />

                        <!-- Error Message -->
                        <TextBlock IsVisible="{Binding HasError}"
                                  Text="{Binding ErrorMessage}"
                                  FontSize="12"
                                  TextAlignment="Center"
                                  TextWrapping="Wrap"
                                  Foreground="{StaticResource ErrorBrush}" />

                        <!-- Connect Button -->
                        <Button Content="Connect"
                               Command="{Binding CompletePairingCommand}"
                               IsEnabled="{Binding !IsPairing}"
                               HorizontalAlignment="Stretch"
                               Height="48"
                               Classes="Primary MobileButton"
                               Margin="0,8,0,0">
                            <Button.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                    <Binding Path="IsPairing" Converter="{x:Static BoolConverters.Not}" />
                                    <Binding Path="PairingCode.Length" Converter="{x:Static BoolConverters.Not}" ConverterParameter="0" />
                                </MultiBinding>
                            </Button.IsVisible>
                        </Button>

                        <!-- Start Pairing Button -->
                        <Button Content="Start Pairing"
                               Command="{Binding StartPairingCommand}"
                               IsVisible="{Binding !IsPairing}"
                               HorizontalAlignment="Stretch"
                               Height="48"
                               Classes="Primary MobileButton" />

                        <!-- Pairing Progress -->
                        <StackPanel IsVisible="{Binding IsPairing}"
                                   Spacing="8">
                            <ProgressBar IsIndeterminate="True"
                                        HorizontalAlignment="Stretch"
                                        Height="4"
                                        Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="Waiting for device..."
                                      FontSize="12"
                                      TextAlignment="Center"
                                      Foreground="{StaticResource TextTertiaryBrush}" />
                            <Button Content="Cancel"
                                   Command="{Binding CancelPairingCommand}"
                                   HorizontalAlignment="Center"
                                   Classes="TextButton" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Divider -->
                <Grid ColumnDefinitions="*,Auto,*"
                     Margin="0,8">
                    <Rectangle Grid.Column="0"
                              Height="1"
                              Fill="{StaticResource DividerBrush}"
                              VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                              Text="or"
                              FontSize="14"
                              Foreground="{StaticResource TextTertiaryBrush}"
                              Margin="16,0" />
                    <Rectangle Grid.Column="2"
                              Height="1"
                              Fill="{StaticResource DividerBrush}"
                              VerticalAlignment="Center" />
                </Grid>

                <!-- QR Code Button -->
                <Button Command="{Binding ScanQrCodeCommand}"
                       HorizontalAlignment="Stretch"
                       Height="48"
                       Classes="Secondary MobileButton">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="📷" FontSize="20" />
                        <TextBlock Text="Scan QR Code"
                                  VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Help Link -->
                <Button Content="ℹ️ How to pair?"
                       Classes="TextButton"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource AccentBrush}" />

                <!-- Paired Devices -->
                <StackPanel IsVisible="{Binding AvailableDevices.Count, Converter={StaticResource InequalityConverter}, ConverterParameter=0}"
                           Spacing="12"
                           Margin="0,16,0,0">
                    <TextBlock Text="Previously Paired"
                              FontSize="14"
                              FontWeight="SemiBold"
                              Foreground="{StaticResource TextSecondaryBrush}" />
                    
                    <ItemsControl ItemsSource="{Binding AvailableDevices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding $parent[ItemsControl].((vm:MobileLandingViewModel)DataContext).ConnectCommand}"
                                       CommandParameter="{Binding}"
                                       HorizontalAlignment="Stretch"
                                       Height="56"
                                       Classes="ListItemButton"
                                       Margin="0,4">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0"
                                                  Text="{Binding DeviceType, Converter={StaticResource DeviceTypeToEmojiConverter}}"
                                                  FontSize="24"
                                                  Margin="0,0,12,0"
                                                  VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DeviceName}"
                                                      FontSize="14"
                                                      FontWeight="SemiBold"
                                                      Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding LastConnectedAt, Converter={StaticResource TimeAgoConverter}}"
                                                      FontSize="12"
                                                      Foreground="{StaticResource TextTertiaryBrush}" />
                                        </StackPanel>
                                        <Ellipse Grid.Column="2"
                                                Width="8"
                                                Height="8"
                                                Fill="{Binding IsOnline, Converter={StaticResource BoolToStatusBrushConverter}}"
                                                VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Safe Area -->
        <Panel Grid.Row="1" Height="24" />
    </Grid>
</UserControl>
