<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SaveState.Presentation.ViewModels.Settings"
             xmlns:converters="using:SaveState.Presentation.Converters"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="900"
             x:Class="SaveState.Presentation.Views.Settings.SystemHealthView"
             x:DataType="vm:SystemHealthViewModel">

  <UserControl.Resources>
    <converters:HealthStatusToBrushConverter x:Key="HealthStatusToBrushConverter" />
    <converters:HealthStatusToTextConverter x:Key="HealthStatusToTextConverter" />
    <converters:BytesToHumanReadableConverter x:Key="BytesToHumanReadableConverter" />
    <converters:RelativeTimeConverter x:Key="RelativeTimeConverter" />
    <converters:ErrorSeverityToBrushConverter x:Key="ErrorSeverityToBrushConverter" />
  </UserControl.Resources>

  <ScrollViewer>
    <StackPanel Margin="24" Spacing="24">
      <!-- Header -->
      <TextBlock Text="⚙️ SETTINGS > SYSTEM HEALTH" Classes="H5" />

      <!-- Overall Status Banner -->
      <Border Classes="Card" Padding="20">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="4">
            <TextBlock Classes="H6">
              <TextBlock.Text>
                <MultiBinding StringFormat="Overall Status: {0}">
                  <Binding Path="OverallStatusMessage"/>
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
            <TextBlock Text="Last updated: {Binding LastUpdated, Converter={StaticResource RelativeTimeConverter}}"
                       Opacity="0.6" FontSize="12"/>
          </StackPanel>
          <Button Grid.Column="1"
                  Command="{Binding RefreshCommand}"
                  IsEnabled="{Binding !IsRefreshing}"
                  Classes="Primary">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ProgressBar IsIndeterminate="True"
                          Width="16" Height="16"
                          IsVisible="{Binding IsRefreshing}"/>
              <TextBlock Text="Refresh"/>
            </StackPanel>
          </Button>
        </Grid>
      </Border>

      <!-- Status Cards Row -->
      <Grid ColumnDefinitions="*,*,*" Margin="0,0,0,0">
        <!-- Database Card -->
        <Border Classes="Card" Margin="0,0,12,0" Padding="20" Grid.Column="0">
          <StackPanel Spacing="12">
            <TextBlock Text="🗄️ DATABASE" Classes="H6" FontSize="16"/>
            
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Ellipse Width="12" Height="12"
                       Fill="{Binding DatabaseHealth.Status, Converter={StaticResource HealthStatusToBrushConverter}}"/>
              <TextBlock Text="{Binding DatabaseHealth.Status}" 
                         VerticalAlignment="Center"
                         FontWeight="SemiBold"/>
            </StackPanel>
            
            <TextBlock>
              <TextBlock.Text>
                <MultiBinding StringFormat="Response: {0:F0}ms">
                  <Binding Path="DatabaseHealth.ResponseTime.TotalMilliseconds"/>
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
            
            <TextBlock Opacity="0.6" FontSize="12">
              <TextBlock.Text>
                <MultiBinding StringFormat="Size: {0}">
                  <Binding Path="DatabaseHealth.DatabaseSize" Converter="{StaticResource BytesToHumanReadableConverter}"/>
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
            
            <TextBlock Opacity="0.6" FontSize="12">
              <TextBlock.Text>
                <MultiBinding StringFormat="Last Backup: {0}">
                  <Binding Path="DatabaseHealth.LastBackup" Converter="{StaticResource RelativeTimeConverter}"/>
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
            
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
              <Button Content="Backup Now"
                      Command="{Binding BackupDatabaseCommand}"
                      Classes="Small Primary"/>
              <Button Content="View Logs"
                      Command="{Binding ViewLogsCommand}"
                      Classes="Small Secondary"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- External APIs Card -->
        <Border Classes="Card" Margin="6,0" Padding="20" Grid.Column="1">
          <StackPanel Spacing="12">
            <TextBlock Text="☁️ EXTERNAL APIs" Classes="H6" FontSize="16"/>
            <ItemsControl ItemsSource="{Binding ApiStatuses}" MaxHeight="180">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:ApiHealthStatus">
                  <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4">
                    <TextBlock Grid.Column="0"
                               Text="{Binding Name}"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="8,0">
                      <Ellipse Width="8" Height="8"
                               Fill="{Binding Status, Converter={StaticResource HealthStatusToBrushConverter}}"/>
                      <TextBlock Text="{Binding ResponseTime.TotalMilliseconds, StringFormat='{}{0:F0}ms'}"
                                 FontSize="11"
                                 Opacity="0.6"
                                 VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Content="Retry"
                            Classes="Small"
                            IsVisible="{Binding Status, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter={x:Static vm:HealthStatus.Healthy}}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Cache Card -->
        <Border Classes="Card" Margin="12,0,0,0" Padding="20" Grid.Column="2">
          <StackPanel Spacing="12">
            <TextBlock Text="💾 CACHE" Classes="H6" FontSize="16"/>
            
            <TextBlock>
              <TextBlock.Text>
                <MultiBinding StringFormat="Hit Rate: {0:P0}">
                  <Binding Path="CacheStats.HitRate"/>
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
            
            <TextBlock>
              <TextBlock.Text>
                <MultiBinding StringFormat="Size: {0}">
                  <Binding Path="CacheStats.Size" Converter="{StaticResource BytesToHumanReadableConverter}"/>
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
            
            <TextBlock>
              <TextBlock.Text>
                <MultiBinding StringFormat="Entries: {0:N0}">
                  <Binding Path="CacheStats.EntryCount"/>
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
            
            <TextBlock>
              <TextBlock.Text>
                <MultiBinding StringFormat="Evictions: {0:N0}">
                  <Binding Path="CacheStats.EvictionCount"/>
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
            
            <Button Content="Clear Cache"
                    Command="{Binding ClearCacheCommand}"
                    Classes="Small Danger"
                    Margin="0,8,0,0"/>
          </StackPanel>
        </Border>
      </Grid>

      <!-- System Resources -->
      <Border Classes="Card" Padding="20">
        <StackPanel Spacing="16">
          <TextBlock Text="📊 SYSTEM RESOURCES" Classes="H6" FontSize="16"/>
          
          <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="20" ColumnSpacing="32">
            <!-- CPU -->
            <StackPanel Grid.Row="0" Grid.Column="0">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="CPU" Classes="BodyStrong"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding Resources.CpuPercent, StringFormat='{}{0:F0}%'}"/>
              </Grid>
              <ProgressBar Value="{Binding Resources.CpuPercent}"
                           Maximum="100"
                           Margin="0,8,0,0"
                           Height="12"
                           CornerRadius="6">
                <ProgressBar.Foreground>
                  <Binding Path="Resources.CpuPercent" Converter="{StaticResource PercentageToBrushConverter}"/>
                </ProgressBar.Foreground>
              </ProgressBar>
            </StackPanel>

            <!-- Memory -->
            <StackPanel Grid.Row="0" Grid.Column="1">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Memory" Classes="BodyStrong"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding Resources.MemoryPercent, StringFormat='{}{0:F0}%'}"/>
              </Grid>
              <ProgressBar Value="{Binding Resources.MemoryPercent}"
                           Maximum="100"
                           Margin="0,8,0,0"
                           Height="12"
                           CornerRadius="6">
                <ProgressBar.Foreground>
                  <Binding Path="Resources.MemoryPercent" Converter="{StaticResource PercentageToBrushConverter}"/>
                </ProgressBar.Foreground>
              </ProgressBar>
            </StackPanel>

            <!-- GPU -->
            <StackPanel Grid.Row="1" Grid.Column="0">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="GPU" Classes="BodyStrong"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding Resources.GpuPercent, StringFormat='{}{0:F0}%'}"/>
              </Grid>
              <ProgressBar Value="{Binding Resources.GpuPercent}"
                           Maximum="100"
                           Margin="0,8,0,0"
                           Height="12"
                           CornerRadius="6">
                <ProgressBar.Foreground>
                  <Binding Path="Resources.GpuPercent" Converter="{StaticResource PercentageToBrushConverter}"/>
                </ProgressBar.Foreground>
              </ProgressBar>
            </StackPanel>

            <!-- Disk -->
            <StackPanel Grid.Row="1" Grid.Column="1">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Disk" Classes="BodyStrong"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding Resources.DiskPercent, StringFormat='{}{0:F0}%'}"/>
              </Grid>
              <ProgressBar Value="{Binding Resources.DiskPercent}"
                           Maximum="100"
                           Margin="0,8,0,0"
                           Height="12"
                           CornerRadius="6">
                <ProgressBar.Foreground>
                  <Binding Path="Resources.DiskPercent" Converter="{StaticResource PercentageToBrushConverter}"/>
                </ProgressBar.Foreground>
              </ProgressBar>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Recent Errors -->
      <Border Classes="Card" Padding="20">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="⚠️ RECENT ERRORS (Last 24h)" Classes="H6" FontSize="16"/>
            <Button Grid.Column="1"
                    Content="View Full Error Log"
                    Command="{Binding ViewErrorLogCommand}"
                    Classes="Small Secondary"/>
          </Grid>
          
          <ItemsControl ItemsSource="{Binding RecentErrors}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:ErrorLogEntry">
                <Border Classes="ListItem" Padding="12,8" Margin="0,2">
                  <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                               Opacity="0.6"
                               Width="140"
                               VerticalAlignment="Center"/>
                    <Border Grid.Column="1"
                            Width="80"
                            Margin="8,0,16,0"
                            CornerRadius="4"
                            Padding="4,2"
                            Background="{Binding Severity, Converter={StaticResource ErrorSeverityToBrushConverter}}">
                      <TextBlock Text="{Binding Severity}"
                                 HorizontalAlignment="Center"
                                 Foreground="White"
                                 FontSize="11"
                                 FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Grid.Column="2"
                               Text="{Binding Component}"
                               Width="140"
                               VerticalAlignment="Center"
                               Opacity="0.8"/>
                    <TextBlock Grid.Column="3"
                               Text="{Binding Message}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          
          <TextBlock Text="No recent errors"
                     HorizontalAlignment="Center"
                     Opacity="0.5"
                     Margin="0,16"
                     IsVisible="{Binding RecentErrors.Count, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter=0}"/>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
