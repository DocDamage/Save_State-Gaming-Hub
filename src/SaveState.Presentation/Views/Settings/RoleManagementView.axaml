<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SaveState.Presentation.ViewModels.Settings"
             xmlns:security="using:SaveState.Presentation.Models.Security"
             mc:Ignorable="d"
             x:Class="SaveState.Presentation.Views.Settings.RoleManagementView"
             x:DataType="vm:RoleManagementViewModel">

  <UserControl.Styles>
    <Style Selector="Border.Card">
      <Setter Property="Background" Value="#1AFFFFFF" />
      <Setter Property="BorderBrush" Value="#33FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="Border.GlassCard">
      <Setter Property="Background" Value="#15FFFFFF" />
      <Setter Property="BorderBrush" Value="#25FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Border.RoleCard">
      <Setter Property="Background" Value="#10FFFFFF" />
      <Setter Property="BorderBrush" Value="#20FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="Margin" Value="0,4" />
    </Style>
    <Style Selector="Border.RoleCard:pointerover">
      <Setter Property="Background" Value="#20FFFFFF" />
      <Setter Property="BorderBrush" Value="#40FFFFFF" />
    </Style>
    <Style Selector="Border.PermissionBadge">
      <Setter Property="Background" Value="#4060a5fa" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="Margin" Value="2" />
    </Style>
    <Style Selector="Border.SystemBadge">
      <Setter Property="Background" Value="#f59e0b" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="6,2" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="*,420" Margin="24">
    <!-- Left Panel - Role List -->
    <Border Grid.Column="0" Classes="Card" Margin="0,0,12,0" Padding="20">
      <Grid RowDefinitions="Auto,Auto,*">
        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,16">
          <TextBlock Text="⚙️ SETTINGS > ROLE MANAGEMENT" Classes="H5" />
          <TextBlock Text="Manage roles and their permissions."
                     Classes="Body" Opacity="0.8" />
        </StackPanel>

        <!-- Search & Actions -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,16">
          <TextBox Grid.Column="0"
                   Text="{Binding SearchQuery}"
                   Watermark="🔍 Search roles..."
                   Margin="0,0,12,0" />
          <Button Grid.Column="1"
                  Content="＋ New Role"
                  Command="{Binding ShowCreateRoleCommand}"
                  Classes="Primary"
                  Margin="0,0,8,0" />
          <Button Grid.Column="2"
                  Content="🔄"
                  Command="{Binding LoadRolesCommand}"
                  Classes="Secondary"
                  ToolTip.Tip="Refresh role list" />
        </Grid>

        <!-- Role List -->
        <Border Grid.Row="2"
                Background="Transparent"
                BorderBrush="#25FFFFFF"
                BorderThickness="1"
                CornerRadius="8">
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Roles}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="security:Role">
                  <Border Classes="RoleCard">
                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                      <!-- Header Row -->
                      <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Name}"
                                     FontWeight="SemiBold"
                                     FontSize="15" />
                          <Border Classes="SystemBadge"
                                  IsVisible="{Binding IsSystem}">
                            <TextBlock Text="SYSTEM"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="White" />
                          </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}"
                                   FontSize="12"
                                   Opacity="0.7"
                                   TextWrapping="Wrap" />
                      </StackPanel>

                      <!-- User Count -->
                      <StackPanel Grid.Row="0" Grid.Column="1"
                                  Orientation="Horizontal"
                                  Spacing="4"
                                  VerticalAlignment="Top">
                        <TextBlock Text="👤" FontSize="14" />
                        <TextBlock Text="{Binding UserCount}"
                                   FontSize="14"
                                   FontWeight="SemiBold" />
                      </StackPanel>

                      <!-- Permissions -->
                      <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                  Orientation="Horizontal"
                                  Spacing="4"
                                  Margin="0,12,0,0">
                        <ItemsControl ItemsSource="{Binding Permissions}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Classes="PermissionBadge">
                                <TextBlock Text="{Binding}"
                                           FontSize="10"
                                           Foreground="#bfdbfe" />
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                        </ItemsControl>
                      </StackPanel>

                      <!-- Actions -->
                      <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                  Orientation="Horizontal"
                                  Spacing="8"
                                  Margin="0,12,0,0">
                        <Button Content="✏️ Edit"
                                Command="{Binding DataContext.EditRoleCommand, Source={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Classes="Primary"
                                IsEnabled="{Binding !IsSystem}" />
                        <Button Content="📋 Duplicate"
                                Command="{Binding DataContext.DuplicateRoleCommand, Source={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Classes="Secondary" />
                        <Button Content="👥 View Users"
                                Command="{Binding DataContext.ViewUsersWithRoleCommand, Source={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Classes="Ghost" />
                        <Button Content="🗑️ Delete"
                                Command="{Binding DataContext.DeleteRoleCommand, Source={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Classes="Danger"
                                IsEnabled="{Binding !IsSystem}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </Grid>
    </Border>

    <!-- Right Panel - Create/Edit Form -->
    <Border Grid.Column="1" Classes="Card" Padding="20">
      <Grid RowDefinitions="Auto,*,Auto">
        <!-- Panel Header -->
        <TextBlock Grid.Row="0"
                   Text="{Binding IsCreatingRole, Converter={StaticResource BoolToStringConverter}, ConverterParameter='CREATE ROLE|EDIT ROLE'}"
                   Classes="H6"
                   Margin="0,0,0,20" />

        <!-- Create/Edit Form -->
        <StackPanel Grid.Row="1"
                    IsVisible="{Binding IsCreatingRole, Converter={x:Static BoolConverters.Or}, ConverterParameter={Binding IsEditing}}"
                    Spacing="16">
          <StackPanel Spacing="8">
            <TextBlock Text="Role Name" Classes="Label" />
            <TextBox Text="{Binding NewRoleName}"
                     Watermark="Enter role name..."
                     IsVisible="{Binding IsCreatingRole}" />
            <TextBox Text="{Binding EditRoleName}"
                     Watermark="Enter role name..."
                     IsVisible="{Binding IsEditing}" />
          </StackPanel>

          <StackPanel Spacing="8">
            <TextBlock Text="Description" Classes="Label" />
            <TextBox Text="{Binding NewRoleDescription}"
                     Watermark="Describe the role's purpose..."
                     AcceptsReturn="True"
                     Height="60"
                     TextWrapping="Wrap"
                     IsVisible="{Binding IsCreatingRole}" />
            <TextBox Text="{Binding EditRoleDescription}"
                     Watermark="Describe the role's purpose..."
                     AcceptsReturn="True"
                     Height="60"
                     TextWrapping="Wrap"
                     IsVisible="{Binding IsEditing}" />
          </StackPanel>

          <StackPanel Spacing="8">
            <TextBlock Text="Permissions" Classes="Label" />
            <Border Classes="GlassCard" Padding="12">
              <ScrollViewer MaxHeight="300">
                <StackPanel Spacing="8">
                  <!-- Group permissions by category -->
                  <ItemsControl ItemsSource="{Binding AvailablePermissions}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:Permission">
                        <CheckBox Content="{Binding Name, StringFormat='{}{0} - {1}', ConverterParameter={Binding Description}}"
                                  IsChecked="{Binding Id, Converter={StaticResource PermissionInCollectionConverter}, ConverterParameter={Binding EditRolePermissions, Source={RelativeSource AncestorType=UserControl}}}}"
                                  Command="{Binding DataContext.TogglePermissionCommand, Source={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding Id}"
                                  ToolTip.Tip="{Binding Description}"
                                  Margin="0,2" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
            </Border>
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0"
                      IsVisible="{Binding IsCreatingRole}">
            <Button Content="Create Role"
                    Command="{Binding CreateRoleCommand}"
                    Classes="Primary" />
            <Button Content="Cancel"
                    Command="{Binding CancelCreateRoleCommand}"
                    Classes="Secondary" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0"
                      IsVisible="{Binding IsEditing}">
            <Button Content="Save Changes"
                    Command="{Binding SaveRoleCommand}"
                    Classes="Primary" />
            <Button Content="Cancel"
                    Command="{Binding CancelEditCommand}"
                    Classes="Secondary" />
          </StackPanel>
        </StackPanel>

        <!-- Empty State -->
        <StackPanel Grid.Row="1"
                    IsVisible="{Binding IsCreatingRole, Converter={x:Static BoolConverters.Not}, ConverterParameter={Binding IsEditing}}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
          <TextBlock Text="🛡️" FontSize="48" Opacity="0.3" HorizontalAlignment="Center" />
          <TextBlock Text="Select or create a role"
                       Opacity="0.5"
                       Margin="0,16,0,0" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
