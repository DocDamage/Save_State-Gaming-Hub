<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SaveState.Presentation.ViewModels.Settings"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="700"
             x:Class="SaveState.Presentation.Views.Settings.AccessibilitySettingsView"
             x:DataType="vm:AccessibilitySettingsViewModel">

  <UserControl.Styles>
    <Style Selector="TextBlock.Header">
      <Setter Property="FontSize" Value="24"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="TextBlock.SectionHeader">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style Selector="Border.SettingsCard">
      <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="20"/>
      <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>
    <Style Selector="ToggleSwitch">
      <Setter Property="Margin" Value="0,8"/>
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Margin="20" Spacing="20">
      
      <!-- Header -->
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Text="♿" FontSize="24"/>
        <TextBlock Text="ACCESSIBILITY SETTINGS" Classes="Header"/>
      </StackPanel>

      <!-- Screen Reader Section -->
      <Border Classes="SettingsCard">
        <StackPanel>
          <TextBlock Text="SCREEN READER" Classes="SectionHeader"/>
          
          <ToggleSwitch Content="Enable screen reader support"
                        IsChecked="{Binding IsScreenReaderEnabled}"
                        OnContent="Enabled"
                        OffContent="Disabled"/>
          
          <StackPanel IsVisible="{Binding IsScreenReaderEnabled}" Margin="0,12,0,0">
            <TextBlock Text="Announcement speed:" 
                       Classes="Label"
                       Margin="0,0,0,8"/>
            <ComboBox ItemsSource="{Binding AnnouncementSpeeds}"
                     SelectedItem="{Binding SelectedAnnouncementSpeed}"
                     HorizontalAlignment="Left"
                     MinWidth="200"/>
          </StackPanel>
          
          <Button Content="Test Screen Reader"
                  Command="{Binding TestScreenReaderCommand}"
                  Classes="Secondary"
                  Margin="0,16,0,0"
                  HorizontalAlignment="Left"/>
        </StackPanel>
      </Border>

      <!-- Visual Aids Section -->
      <Border Classes="SettingsCard">
        <StackPanel>
          <TextBlock Text="VISUAL AIDS" Classes="SectionHeader"/>
          
          <ToggleSwitch Content="High contrast mode"
                        IsChecked="{Binding IsHighContrastEnabled}"
                        OnContent="Enabled"
                        OffContent="Disabled"/>
          
          <ToggleSwitch Content="Show focus indicators"
                        IsChecked="{Binding IsFocusVisualEnabled}"
                        OnContent="Enabled"
                        OffContent="Disabled"/>
          
          <ToggleSwitch Content="Reduce motion (animations)"
                        IsChecked="{Binding IsReducedMotionEnabled}"
                        OnContent="Enabled"
                        OffContent="Disabled"/>
          
          <StackPanel Margin="0,12,0,0">
            <TextBlock Text="Text size:" 
                       Classes="Label"
                       Margin="0,0,0,8"/>
            <ComboBox ItemsSource="{Binding TextScaleOptions}"
                     SelectedItem="{Binding SelectedTextScale}"
                     HorizontalAlignment="Left"
                     MinWidth="200"/>
          </StackPanel>
          
          <StackPanel Margin="0,16,0,0">
            <TextBlock Text="Color filter:" 
                       Classes="Label"
                       Margin="0,0,0,8"/>
            <ComboBox ItemsSource="{Binding ColorFilterOptions}"
                     SelectedItem="{Binding SelectedColorFilter}"
                     HorizontalAlignment="Left"
                     MinWidth="200"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Keyboard Navigation Section -->
      <Border Classes="SettingsCard">
        <StackPanel>
          <TextBlock Text="KEYBOARD NAVIGATION" Classes="SectionHeader"/>
          
          <ToggleSwitch Content="Enable full keyboard navigation"
                        IsChecked="{Binding IsKeyboardNavigationEnabled}"
                        OnContent="Enabled"
                        OffContent="Disabled"/>
          
          <ToggleSwitch Content="Show keyboard shortcuts in tooltips"
                        IsChecked="{Binding ShowShortcutsInTooltips}"
                        OnContent="Enabled"
                        OffContent="Disabled"/>
          
          <Button Content="⌨️ Configure Keyboard Shortcuts"
                  Command="{Binding OpenShortcutEditorCommand}"
                  Classes="Secondary"
                  Margin="0,16,0,0"
                  HorizontalAlignment="Left"/>
        </StackPanel>
      </Border>

      <!-- Audit Section -->
      <Border Classes="SettingsCard">
        <StackPanel>
          <TextBlock Text="ACCESSIBILITY AUDIT" Classes="SectionHeader"/>
          <TextBlock Text="Run an automated audit to check for accessibility issues in the application."
                     Classes="Body"
                     TextWrapping="Wrap"
                     Margin="0,0,0,12"/>
          
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Content="🔍 Run Audit"
                    Command="{Binding RunAuditCommand}"
                    Classes="Primary"/>
            <Button Content="📄 View Last Report"
                    Command="{Binding ViewAuditReportCommand}"
                    Classes="Secondary"
                    IsVisible="{Binding HasAuditReport}"/>
          </StackPanel>
          
          <Border Background="{StaticResource SurfaceBrush}"
                  CornerRadius="8"
                  Padding="16"
                  Margin="0,16,0,0"
                  IsVisible="{Binding LastAuditScore, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel>
              <TextBlock Text="Last Audit Results" 
                         FontWeight="SemiBold"
                         Margin="0,0,0,8"/>
              <TextBlock Text="{Binding LastAuditScore, StringFormat='Compliance Score: {0:F1}%'}"/>
              <TextBlock Text="{Binding LastAuditIssues, StringFormat='Issues Found: {0}'}"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- Save Button -->
      <Button Content="💾 Save Settings"
              Command="{Binding SaveSettingsCommand}"
              Classes="Primary"
              HorizontalAlignment="Right"
              Margin="0,8,0,0"/>

    </StackPanel>
  </ScrollViewer>
</UserControl>
