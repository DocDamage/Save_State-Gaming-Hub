<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:widgets="using:SaveState.Presentation.Services.Dashboard.Widgets"
             x:Class="SaveState.Presentation.Views.Dashboard.Widgets.TodaysStatsWidgetView"
             x:DataType="widgets:TodaysStatsWidget">

    <UserControl.Styles>
        <Style Selector="TextBlock.stat-value">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>

        <Style Selector="TextBlock.stat-label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <Style Selector="Border.stat-item">
            <Setter Property="Padding" Value="16" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*, *, *">
        <!-- Playtime -->
        <Border Grid.Row="0" Classes="stat-item" Margin="0,0,0,8">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                <TextBlock Text="{Binding PlaytimeText}" Classes="stat-value" />
                <TextBlock Text="Playtime Today" Classes="stat-label" />
            </StackPanel>
        </Border>

        <!-- Sessions -->
        <Border Grid.Row="1" Classes="stat-item" Margin="0,0,0,8">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                <TextBlock Text="{Binding Sessions}" Classes="stat-value" />
                <TextBlock Text="Sessions" Classes="stat-label" />
            </StackPanel>
        </Border>

        <!-- Achievements -->
        <Border Grid.Row="2" Classes="stat-item">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                <TextBlock Text="{Binding Achievements}" Classes="stat-value" />
                <TextBlock Text="Achievements" Classes="stat-label" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>