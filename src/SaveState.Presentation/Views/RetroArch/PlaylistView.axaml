<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SaveState.Presentation.ViewModels.RetroArch"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="SaveState.Presentation.Views.RetroArch.PlaylistView"
             x:DataType="vm:RetroArchPlaylistViewModel">

  <UserControl.Styles>
    <!-- Glassmorphism Card Style -->
    <Style Selector="Border.GlassCard">
      <Setter Property="Background" Value="{DynamicResource GlassBackgroundBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="12"/>
      <Setter Property="BoxShadow" Value="0 4 16 0 #33000000"/>
    </Style>
    
    <Style Selector="Border.GlassCard:pointerover">
      <Setter Property="Background" Value="{DynamicResource GlassHoverBrush}"/>
    </Style>

    <!-- Active Playlist Item -->
    <Style Selector="Border.PlaylistItem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="12,10"/>
    </Style>
    
    <Style Selector="Border.PlaylistItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
    </Style>
    
    <Style Selector="Border.PlaylistItem.active">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Opacity" Value="0.15"/>
    </Style>

    <!-- Game Cover Placeholder -->
    <Style Selector="Border.GameCover">
      <Setter Property="Background">
        <Setter.Value>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="{DynamicResource AccentColor}" Offset="0" Opacity="0.3"/>
            <GradientStop Color="{DynamicResource AccentColor}" Offset="1" Opacity="0.1"/>
          </LinearGradientBrush>
        </Setter.Value>
      </Setter>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="300,*">
    <!-- Left Panel - Playlists -->
    <Border Grid.Column="0" 
            Classes="GlassCard"
            Margin="16"
            Padding="0">
      <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- Header -->
        <Border Grid.Row="0" 
                Background="{DynamicResource AccentBrush}"
                Padding="16,14"
                CornerRadius="12,12,0,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="📁" FontSize="20"/>
            <TextBlock Text="PLAYLISTS" 
                       Classes="H6"
                       Foreground="White"/>
          </StackPanel>
        </Border>
        
        <!-- Search -->
        <Border Grid.Row="1" 
                Padding="12,10"
                BorderBrush="{DynamicResource GlassBorderBrush}"
                BorderThickness="0,0,0,1">
          <TextBox Text="{Binding SearchQuery}" 
                   Watermark="🔍 Search playlists..."
                   Classes="Search"/>
        </Border>
        
        <!-- Playlist List -->
        <ScrollViewer Grid.Row="2" Margin="8,8,8,0">
          <ItemsControl ItemsSource="{Binding Playlists}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="Flat" 
                        HorizontalAlignment="Stretch"
                        Margin="0,2"
                        Command="{Binding 
                                DataContext.SelectPlaylistCommand, 
                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}">
                  <Border Classes="PlaylistItem">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <TextBlock Grid.Column="0" 
                                 Text="📂" 
                                 FontSize="18"
                                 VerticalAlignment="Center"
                                 Margin="0,0,10,0"/>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" 
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding GameCount, StringFormat='{}{0} games'}" 
                                   Opacity="0.6" 
                                   FontSize="11"/>
                      </StackPanel>
                      <TextBlock Grid.Column="2" 
                                 Text="▶" 
                                 Opacity="0.4"
                                 VerticalAlignment="Center"/>
                    </Grid>
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        
        <!-- Empty State -->
        <StackPanel Grid.Row="2"
                    IsVisible="{Binding !Playlists.Count}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8">
          <TextBlock Text="📁" FontSize="48" Opacity="0.3"/>
          <TextBlock Text="No playlists" Opacity="0.6"/>
        </StackPanel>
        
        <!-- Create Button -->
        <Border Grid.Row="3" 
                Padding="12"
                BorderBrush="{DynamicResource GlassBorderBrush}"
                BorderThickness="0,1,0,0">
          <Button Content="➕ Create Playlist"
                  Command="{Binding CreatePlaylistCommand}"
                  Classes="accent"
                  HorizontalAlignment="Stretch"/>
        </Border>
      </Grid>
    </Border>
    
    <!-- Right Panel - Games -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="0,16,16,16">
      <!-- Toolbar -->
      <Border Grid.Row="0" 
              Classes="GlassCard"
              Margin="0,0,0,12">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" 
                      Orientation="Horizontal" 
                      Spacing="8"
                      VerticalAlignment="Center">
            <TextBlock Text="🎮" FontSize="18"/>
            <TextBlock Text="{Binding SelectedPlaylist.Name, FallbackValue='Select a playlist'}"
                       Classes="H6"/>
            <Border Background="{DynamicResource AccentBrush}"
                    Opacity="0.2"
                    Padding="8,2"
                    CornerRadius="10"
                    IsVisible="{Binding SelectedPlaylist, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBlock Text="{Binding SelectedPlaylist.Games.Count, StringFormat='{}{0} games'}"
                         FontSize="12"
                         Foreground="{DynamicResource AccentBrush}"
                         FontWeight="Bold"/>
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="1" 
                      Orientation="Horizontal" 
                      Spacing="10"
                      VerticalAlignment="Center">
            <ToggleButton Content="{Binding IsGridView, Converter={StaticResource BoolToStringConverter}, ConverterParameter='📋 List|⊞ Grid'}"
                          IsChecked="{Binding IsGridView}"
                          Classes="Flat"/>
            <TextBox Text="{Binding SearchQuery}" 
                     Watermark="🔍 Search games..."
                     Width="220"
                     Classes="Search"/>
          </StackPanel>
        </Grid>
      </Border>
      
      <!-- Games Grid/List -->
      <Border Grid.Row="1" Classes="GlassCard" Padding="12">
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding SelectedPlaylist.Games}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="{Binding IsGridView, Converter={StaticResource BoolToIntConverter}, ConverterParameter='4|1'}" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="GlassCard" Margin="6">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="6">
                      <Border Classes="GameCover" 
                              Height="{Binding IsGridView, Converter={StaticResource BoolToIntConverter}, ConverterParameter='100|40'}"/>
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Title}" 
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <Border Background="{DynamicResource AccentBrush}"
                                Opacity="0.15"
                                Padding="6,2"
                                CornerRadius="4"
                                HorizontalAlignment="Left">
                          <TextBlock Text="{Binding System}" 
                                     FontSize="10"
                                     Foreground="{DynamicResource AccentBrush}"
                                     Opacity="0.9"/>
                        </Border>
                      </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="🗑️"
                            ToolTip.Tip="Remove from playlist"
                            Command="{Binding 
                                    DataContext.RemoveGameFromPlaylistCommand, 
                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Classes="Flat danger"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>
      
      <!-- Empty State -->
      <Border Grid.Row="1" 
              Classes="GlassCard"
              IsVisible="{Binding SelectedPlaylist, Converter={x:Static ObjectConverters.IsNull}}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12">
          <TextBlock Text="📁" 
                     FontSize="72" 
                     HorizontalAlignment="Center" 
                     Opacity="0.3"/>
          <TextBlock Text="Select a playlist to view games"
                     FontSize="18"
                     HorizontalAlignment="Center"
                     Opacity="0.7"/>
          <TextBlock Text="Or create a new playlist to organize your games"
                     FontSize="14"
                     HorizontalAlignment="Center"
                     Opacity="0.5"/>
        </StackPanel>
      </Border>
      
      <!-- Empty Playlist State -->
      <Border Grid.Row="1" 
              Classes="GlassCard"
              IsVisible="{Binding SelectedPlaylist.Games.Count, Converter={x:Static ObjectConverters.IsNull}, FallbackValue=False}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12">
          <TextBlock Text="🎮" 
                     FontSize="72" 
                     HorizontalAlignment="Center" 
                     Opacity="0.3"/>
          <TextBlock Text="This playlist is empty"
                     FontSize="18"
                     HorizontalAlignment="Center"
                     Opacity="0.7"/>
          <TextBlock Text="Add games to this playlist from your library"
                     FontSize="14"
                     HorizontalAlignment="Center"
                     Opacity="0.5"/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
