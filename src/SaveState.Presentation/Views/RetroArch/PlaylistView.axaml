<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SaveState.Presentation.ViewModels.RetroArch"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="SaveState.Presentation.Views.RetroArch.PlaylistView"
             x:DataType="vm:RetroArchPlaylistViewModel">
  <Grid ColumnDefinitions="280,*">
    <!-- Left Panel - Playlists -->
    <Border Grid.Column="0" 
            Background="{DynamicResource CardBackgroundBrush}" 
            BorderBrush="{DynamicResource BorderBrush}" 
            BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- Header -->
        <TextBlock Grid.Row="0" 
                   Text="📁 PLAYLISTS" 
                   Classes="H6" 
                   Margin="16,20,16,12"/>
        
        <!-- Search -->
        <TextBox Grid.Row="1" 
                 Text="{Binding SearchQuery}" 
                 Watermark="🔍 Search..."
                 Margin="12,0,12,8"/>
        
        <!-- Playlist List -->
        <ScrollViewer Grid.Row="2" Margin="8,0">
          <ItemsControl ItemsSource="{Binding Playlists}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="Flat NavItem" 
                        HorizontalAlignment="Stretch"
                        Command="{Binding 
                                DataContext.SelectPlaylistCommand, 
                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="{Binding Name}" 
                                 FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding GameCount, StringFormat='{}{0} games'}" 
                                 Opacity="0.6" 
                                 FontSize="12"/>
                    </StackPanel>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        
        <!-- Create Button -->
        <Button Grid.Row="3" 
                Content="➕ Create Playlist"
                Command="{Binding CreatePlaylistCommand}"
                Classes="accent"
                HorizontalAlignment="Stretch"
                Margin="12,8,12,16"/>
      </Grid>
    </Border>
    
    <!-- Right Panel - Games -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*">
      <!-- Toolbar -->
      <Border Grid.Row="0" 
              Background="{DynamicResource CardBackgroundBrush}" 
              Padding="16,12"
              BorderBrush="{DynamicResource BorderBrush}" 
              BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" 
                     Text="{Binding SelectedPlaylist.Name, FallbackValue='Select a playlist'}"
                     Classes="H6"
                     VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" 
                      Orientation="Horizontal" 
                      Spacing="8">
            <Button Content="{Binding IsGridView, Converter={StaticResource BoolToStringConverter}, ConverterParameter='📋 List|⊞ Grid'}"
                    Command="{Binding ToggleViewCommand}"
                    Classes="Flat"/>
            <TextBox Text="{Binding SearchQuery}" 
                     Watermark="🔍 Search games..."
                     Width="200"/>
          </StackPanel>
        </Grid>
      </Border>
      
      <!-- Games Grid/List -->
      <ScrollViewer Grid.Row="1" Margin="16">
        <ItemsControl ItemsSource="{Binding SelectedPlaylist.Games}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="{Binding IsGridView, Converter={StaticResource BoolToIntConverter}, ConverterParameter='4|1'}" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="Card" Margin="8">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="4">
                    <Border Background="{DynamicResource HoverBackgroundBrush}" 
                            Height="{Binding IsGridView, Converter={StaticResource BoolToIntConverter}, ConverterParameter='120|48'}"
                            CornerRadius="4"/>
                    <TextBlock Text="{Binding Title}" 
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding System}" 
                               Opacity="0.6" 
                               FontSize="12"/>
                  </StackPanel>
                  <Button Grid.Column="1"
                          Content="🗑️"
                          Command="{Binding 
                                  DataContext.RemoveGameFromPlaylistCommand, 
                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}"
                          Classes="Flat danger"
                          VerticalAlignment="Center"
                          Margin="8,0,0,0"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      
      <!-- Empty State -->
      <StackPanel Grid.Row="1"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  IsVisible="{Binding SelectedPlaylist, Converter={x:Static ObjectConverters.IsNull}}"
                  Spacing="10">
        <TextBlock Text="📁" 
                   FontSize="64" 
                   HorizontalAlignment="Center" 
                   Opacity="0.3"/>
        <TextBlock Text="Select a playlist to view games"
                   FontSize="18"
                   HorizontalAlignment="Center"
                   Opacity="0.7"/>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
