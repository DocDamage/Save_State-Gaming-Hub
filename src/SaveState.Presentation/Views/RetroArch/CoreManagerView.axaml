<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SaveState.Presentation.ViewModels.RetroArch"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="SaveState.Presentation.Views.RetroArch.CoreManagerView"
             x:DataType="vm:RetroArchCoreManagerViewModel">
  <Grid RowDefinitions="Auto,Auto,*">
    <!-- Header -->
    <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" 
            Padding="20" Margin="16,16,16,8">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0">
          <TextBlock Text="Core Manager" Classes="H5"/>
          <TextBlock Text="Install and manage RetroArch emulator cores" 
                     Opacity="0.7" Margin="0,4,0,0"/>
        </StackPanel>
        <Button Grid.Column="1" 
                Content="🔄 Update All" 
                Command="{Binding UpdateAllCoresCommand}"
                Classes="accent"
                VerticalAlignment="Center"/>
      </Grid>
    </Border>
    
    <!-- Search -->
    <TextBox Grid.Row="1" 
             Text="{Binding SearchQuery}" 
             Watermark="🔍 Search cores..."
             Margin="16,8,16,8"/>
    
    <!-- Content -->
    <ScrollViewer Grid.Row="2" Margin="16,8,16,16">
      <StackPanel Spacing="16">
        <!-- Installed Cores Section -->
        <TextBlock Text="INSTALLED CORES" Classes="H6" Margin="0,0,0,8"/>
        <ItemsControl ItemsSource="{Binding InstalledCores}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="Card" Margin="0,4">
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding System}" Opacity="0.7" FontSize="12"/>
                    <TextBlock Text="{Binding Version, StringFormat='Version: {0}'}" 
                               Opacity="0.5" FontSize="11"/>
                  </StackPanel>
                  <TextBlock Grid.Column="1" 
                             Text="✅ Installed" 
                             VerticalAlignment="Center"
                             Margin="0,0,16,0"
                             Foreground="{DynamicResource SuccessBrush}"/>
                  <StackPanel Grid.Column="2" 
                              Orientation="Horizontal" 
                              Spacing="8">
                    <Button Content="🔄 Update"
                            Command="{Binding 
                                    DataContext.InstallCoreCommand, 
                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            IsVisible="{Binding IsUpdateAvailable}"/>
                    <Button Content="🗑️ Uninstall"
                            Command="{Binding 
                                    DataContext.UninstallCoreCommand, 
                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Classes="danger"/>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        
        <!-- Available Cores Section -->
        <TextBlock Text="AVAILABLE CORES" Classes="H6" Margin="0,16,0,8"/>
        <ItemsControl ItemsSource="{Binding AvailableCores}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="Card" Margin="0,4">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding System}" Opacity="0.7" FontSize="12"/>
                  </StackPanel>
                  <Button Grid.Column="1" 
                          Content="⬇️ Install"
                          Command="{Binding 
                                  DataContext.InstallCoreCommand, 
                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}"
                          Classes="accent"
                          VerticalAlignment="Center"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
    
    <!-- Loading Overlay -->
    <Border Grid.Row="0" Grid.RowSpan="3"
            Background="#CC000000"
            IsVisible="{Binding IsLoading}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="15">
        <ProgressBar IsIndeterminate="True" Width="48" Height="48"/>
        <TextBlock Text="Loading cores..."
                   FontSize="16"
                   HorizontalAlignment="Center"
                   Foreground="White"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
