<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SaveState.Presentation.ViewModels.RetroArch"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="SaveState.Presentation.Views.RetroArch.RetroArchTabView"
             x:DataType="vm:RetroArchTabViewModel">

  <UserControl.Styles>
    <!-- Glassmorphism Card Style -->
    <Style Selector="Border.GlassCard">
      <Setter Property="Background" Value="{DynamicResource GlassBackgroundBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="12"/>
      <Setter Property="BoxShadow" Value="0 4 16 0 #33000000"/>
    </Style>
    
    <Style Selector="Border.GlassCard:pointerover">
      <Setter Property="Background" Value="{DynamicResource GlassHoverBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <!-- Game Cover Placeholder -->
    <Style Selector="Border.GameCover">
      <Setter Property="Background">
        <Setter.Value>
          <SolidColorBrush Color="{DynamicResource AccentColor}" Opacity="0.2" />
        </Setter.Value>
      </Setter>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="260,*">
    <!-- Sidebar -->
    <Border Grid.Column="0" 
            Background="{DynamicResource GlassBackgroundBrush}"
            BorderBrush="{DynamicResource GlassBorderBrush}" 
            BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <Border Grid.Row="0" 
                Background="{DynamicResource AccentBrush}" 
                Height="60"
                Margin="0,0,0,8">
          <StackPanel Orientation="Horizontal" 
                      HorizontalAlignment="Center" 
                      VerticalAlignment="Center"
                      Spacing="8">
            <TextBlock Text="🎮" FontSize="24"/>
            <TextBlock Text="RETROARCH" 
                       Classes="H6" 
                       Foreground="White"
                       VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
        
        <!-- Navigation -->
        <StackPanel Grid.Row="1" Spacing="4" Margin="12,8">
          <Button Classes="Flat NavItem" 
                  HorizontalAlignment="Stretch"
                  Command="{Binding ScanLibraryCommand}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Text="▶" FontSize="16"/>
              <TextBlock Text="All Games" FontWeight="Medium"/>
            </StackPanel>
          </Button>
          <Button Classes="Flat NavItem" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Text="♥" FontSize="16"/>
              <TextBlock Text="Favorites" FontWeight="Medium"/>
            </StackPanel>
          </Button>
          <Button Classes="Flat NavItem" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Text="📁" FontSize="16"/>
              <TextBlock Text="Playlists" FontWeight="Medium"/>
            </StackPanel>
          </Button>
          <Button Classes="Flat NavItem" 
                  HorizontalAlignment="Stretch"
                  Command="{Binding RefreshCoresCommand}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Text="🎮" FontSize="16"/>
              <TextBlock Text="Cores" FontWeight="Medium"/>
            </StackPanel>
          </Button>
          <Button Classes="Flat NavItem" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Text="⚙️" FontSize="16"/>
              <TextBlock Text="Settings" FontWeight="Medium"/>
            </StackPanel>
          </Button>
          <Button Classes="Flat NavItem" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Text="🔄" FontSize="16"/>
              <TextBlock Text="Netplay" FontWeight="Medium"/>
            </StackPanel>
          </Button>
        </StackPanel>
        
        <!-- Scan Status -->
        <Border Grid.Row="2" 
                Classes="GlassCard"
                Margin="12,8,12,16">
          <StackPanel Spacing="8">
            <TextBlock Text="SCAN STATUS" 
                       Classes="Caption" 
                       Opacity="0.7"
                       FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Ellipse Width="10" Height="10" 
                       Fill="{DynamicResource SuccessBrush}"
                       IsVisible="{Binding !IsScanning}"/>
              <ProgressBar IsIndeterminate="True" 
                           Width="20" Height="20"
                           IsVisible="{Binding IsScanning}"/>
              <TextBlock Text="{Binding ScanStatus}" 
                         VerticalAlignment="Center"
                         FontWeight="Medium"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Border>
    
    <!-- Content -->
    <ScrollViewer Grid.Column="1" 
                  Background="{DynamicResource MainBackgroundBrush}">
      <StackPanel Margin="24">
        <!-- Recently Played Section -->
        <Border Classes="GlassCard" Margin="0,0,0,24">
          <StackPanel>
            <StackPanel Orientation="Horizontal" 
                        Margin="0,0,0,16"
                        Spacing="8">
              <TextBlock Text="🕐" FontSize="20"/>
              <TextBlock Text="RECENTLY PLAYED" Classes="H6"/>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding RecentGames}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="4"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Classes="Flat" 
                          HorizontalAlignment="Stretch"
                          Margin="6"
                          Command="{Binding 
                                  DataContext.LaunchGameCommand, 
                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}">
                    <Border Classes="GlassCard">
                      <StackPanel Spacing="8">
                        <Border Classes="GameCover" Height="120"/>
                        <TextBlock Text="{Binding Title}" 
                                   TextTrimming="CharacterEllipsis"
                                   FontWeight="SemiBold"
                                   FontSize="13"/>
                        <Border Background="{DynamicResource AccentBrush}" 
                                Opacity="0.2"
                                Padding="6,2"
                                CornerRadius="4"
                                HorizontalAlignment="Left">
                          <TextBlock Text="{Binding System}" 
                                     FontSize="11"
                                     Opacity="0.9"
                                     Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                      </StackPanel>
                    </Border>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            
            <!-- Empty State -->
            <StackPanel IsVisible="{Binding !RecentGames.Count}"
                        HorizontalAlignment="Center"
                        Margin="0,32"
                        Spacing="8">
              <TextBlock Text="🎮" FontSize="48" Opacity="0.3"/>
              <TextBlock Text="No recently played games" 
                         Opacity="0.6"/>
            </StackPanel>
          </StackPanel>
        </Border>
        
        <!-- All Games Section -->
        <Border Classes="GlassCard">
          <StackPanel>
            <StackPanel Orientation="Horizontal" 
                        Margin="0,0,0,16"
                        Spacing="8">
              <TextBlock Text="🎯" FontSize="20"/>
              <TextBlock Text="ALL GAMES" Classes="H6"/>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Games}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="4"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Classes="Flat" 
                          HorizontalAlignment="Stretch"
                          Margin="6"
                          Command="{Binding 
                                  DataContext.LaunchGameCommand, 
                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}">
                    <Border Classes="GlassCard">
                      <StackPanel Spacing="8">
                        <Border Classes="GameCover" Height="150"/>
                        <TextBlock Text="{Binding Title}" 
                                   TextTrimming="CharacterEllipsis"
                                   FontWeight="SemiBold"
                                   FontSize="14"/>
                        <StackPanel Orientation="Horizontal" 
                                    Spacing="8">
                          <Border Background="{DynamicResource AccentBrush}" 
                                  Opacity="0.2"
                                  Padding="6,2"
                                  CornerRadius="4">
                            <TextBlock Text="{Binding System}" 
                                       FontSize="11"
                                       Opacity="0.9"
                                       Foreground="{DynamicResource AccentBrush}"/>
                          </Border>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            
            <!-- Empty State -->
            <StackPanel IsVisible="{Binding !Games.Count}"
                        HorizontalAlignment="Center"
                        Margin="0,48"
                        Spacing="12">
              <TextBlock Text="🎮" FontSize="64" Opacity="0.3"/>
              <TextBlock Text="No games found" 
                         FontSize="18"
                         Opacity="0.7"/>
              <TextBlock Text="Scan your library to find RetroArch games" 
                         FontSize="14"
                         Opacity="0.5"/>
              <Button Content="Scan Library Now"
                      Command="{Binding ScanLibraryCommand}"
                      Classes="accent"
                      Margin="0,16,0,0"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    
    <!-- Loading Overlay -->
    <Border Grid.Column="1"
            Background="#CC000000"
            IsVisible="{Binding IsScanning}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="16">
        <ProgressBar IsIndeterminate="True" Width="56" Height="56"/>
        <TextBlock Text="{Binding ScanStatus}"
                   FontSize="18"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   Foreground="White"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
