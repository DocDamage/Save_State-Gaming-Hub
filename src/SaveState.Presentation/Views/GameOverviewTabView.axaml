<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SaveState.Presentation.ViewModels;assembly=SaveState.Presentation"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="SaveState.Presentation.Views.GameOverviewTabView"
             x:DataType="vm:GameOverviewTabViewModel"
             Background="Transparent">

    <ScrollViewer>
        <StackPanel Spacing="20">
            <!-- Description Section -->
            <StackPanel Spacing="10">
                <TextBlock Text="📖 DESCRIPTION" Classes="Subtitle" />
                <TextBlock Text="{Binding Description, FallbackValue='No description available.'}"
                          Classes="Body"
                          TextWrapping="Wrap" />
            </StackPanel>

            <!-- HLTB Information -->
            <StackPanel Spacing="10">
                <TextBlock Text="⏱️ HOW LONG TO BEAT" Classes="Subtitle" />
                <Grid ColumnDefinitions="*, *, *, *">
                    <Border Classes="StatCard" Margin="0,0,10,0">
                        <StackPanel Spacing="5" HorizontalAlignment="Center">
                            <TextBlock Text="Main Story" Classes="Caption" />
                            <TextBlock Text="{Binding HltbMainStory, StringFormat=\{0\}h, FallbackValue='--'}"
                                      Classes="Header" />
                        </StackPanel>
                    </Border>

                    <Border Classes="StatCard" Margin="0,0,10,0">
                        <StackPanel Spacing="5" HorizontalAlignment="Center">
                            <TextBlock Text="Main + Sides" Classes="Caption" />
                            <TextBlock Text="{Binding HltbMainPlusExtras, StringFormat=\{0\}h, FallbackValue='--'}"
                                      Classes="Header" />
                        </StackPanel>
                    </Border>

                    <Border Classes="StatCard" Margin="0,0,10,0">
                        <StackPanel Spacing="5" HorizontalAlignment="Center">
                            <TextBlock Text="Completionist" Classes="Caption" />
                            <TextBlock Text="{Binding HltbCompletionist, StringFormat=\{0\}h, FallbackValue='--'}"
                                      Classes="Header" />
                        </StackPanel>
                    </Border>

                    <Border Classes="StatCard">
                        <StackPanel Spacing="5" HorizontalAlignment="Center">
                            <TextBlock Text="All Styles" Classes="Caption" />
                            <TextBlock Text="{Binding HltbAllStyles, StringFormat=\{0\}h, FallbackValue='--'}"
                                      Classes="Header" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- Recent Activity -->
            <StackPanel Spacing="10">
                <TextBlock Text="📈 RECENT ACTIVITY" Classes="Subtitle" />
                <ListBox ItemsSource="{Binding RecentSessions}"
                        Background="Transparent"
                        BorderThickness="0"
                        MaxHeight="200">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,5">
                                <TextBlock Grid.Column="0"
                                          Text="▶"
                                          Classes="Body"
                                          Margin="0,0,10,0" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{Binding StartTime, StringFormat='Played on {0:d}'}"
                                              Classes="Caption"
                                              Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding Duration, StringFormat='Duration: {0:h\\:mm}'}"
                                              Classes="Caption"
                                              Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                          Text="{Binding AchievementsUnlocked, StringFormat='+{0} achievements'}"
                                          Classes="Caption"
                                          Foreground="{StaticResource SuccessBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <!-- File Information -->
            <StackPanel Spacing="10">
                <TextBlock Text="📁 GAME FILES" Classes="Subtitle" />
                <Border Classes="GlassContainer" Padding="10" MaxHeight="200">
                    <Grid RowDefinitions="Auto, *">
                        <!-- Table Header -->
                        <Grid Grid.Row="0" ColumnDefinitions="*, 2*, 120" Margin="5">
                            <TextBlock Grid.Column="0" Text="File Name" Classes="Caption" FontWeight="Bold" />
                            <TextBlock Grid.Column="1" Text="Path" Classes="Caption" FontWeight="Bold" />
                            <TextBlock Grid.Column="2" Text="Size" Classes="Caption" FontWeight="Bold" />
                        </Grid>
                        <!-- Table Rows -->
                        <ListBox Grid.Row="1" ItemsSource="{Binding GameFiles}" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*, 2*, 120" Margin="0,2">
                                        <TextBlock Grid.Column="0" Text="{Binding FileName}" Classes="Caption" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Path}" Classes="Caption" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding FileSize, StringFormat=\{0\} bytes}" Classes="Caption" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- System Requirements -->
            <StackPanel Spacing="10">
                <TextBlock Text="💻 SYSTEM REQUIREMENTS" Classes="Subtitle" />
                <TextBlock Text="{Binding SystemRequirements, FallbackValue='System requirements not available.'}"
                          Classes="Body"
                          TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
