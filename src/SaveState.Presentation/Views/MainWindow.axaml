<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SaveState.Presentation.ViewModels"
        xmlns:views="using:SaveState.Presentation.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="SaveState.Presentation.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding Title}"
        Background="{StaticResource BackgroundBrush}"
        AutomationProperties.Name="{Binding Title}"
        AutomationProperties.HelpText="SaveState application main window for managing game collections"
        MinWidth="800"
        MinHeight="600"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="False">

    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>

    <ContentControl Content="{Binding CurrentViewModel}" />
</Window>
