<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SaveState.Presentation.ViewModels.Shell.Mugen"
             x:Class="SaveState.Presentation.Views.Mugen.Sections.GenericMugenSection"
             x:DataType="vm:MugenSectionViewModelBase">
    <StackPanel Spacing="20" Margin="40" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="{Binding Title}" FontSize="48" FontWeight="Black" Foreground="{StaticResource FightingYellowBrush}"
                   RenderTransform="skewX(-10deg)" HorizontalAlignment="Center" />
        <Border Background="{StaticResource GlassBrush}" CornerRadius="12" Padding="40">
            <StackPanel Spacing="10">
                <TextBlock Text="SECTION COMING SOON" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                <TextBlock Text="This feature is being enhanced for the ultimate arcade experience."
                         Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
