<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SaveState.Presentation.ViewModels.Shell.Mugen"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="SaveState.Presentation.Views.Mugen.Sections.StatsSection"
             x:DataType="vm:MugenStatsViewModel">

    <Grid RowDefinitions="Auto, *">
        <Border Grid.Row="0" Margin="20" Background="{StaticResource GlassBrush}" CornerRadius="12" Padding="20">
            <TextBlock Text="BATTLE ANALYTICS" FontSize="24" FontWeight="Black" Foreground="White" />
        </Border>

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="20,0,20,20" Spacing="20">
                <!-- Summary Cards -->
                <Grid ColumnDefinitions="*, *, *">
                    <Border Grid.Column="0" Margin="0,0,10,0" Background="#1A1A1A" CornerRadius="12" Padding="20">
                        <StackPanel Spacing="20">
                            <TextBlock Text="🏆 MOST PLAYED" FontSize="14" FontWeight="Bold" Foreground="{StaticResource FightingYellowBrush}" />
                            <TextBlock Text="{Binding MostPlayedCharacter}" FontSize="20" FontWeight="Black" Foreground="White" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="The crowd favorite." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Margin="10,0" Background="#1A1A1A" CornerRadius="12" Padding="20">
                        <StackPanel Spacing="20">
                            <TextBlock Text="⚔️ TOTAL MATCHES" FontSize="14" FontWeight="Bold" Foreground="#00BCD4" />
                            <TextBlock Text="{Binding TotalMatches}" FontSize="32" FontWeight="Black" Foreground="White" />
                            <TextBlock Text="Battles recorded." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Margin="10,0,0,0" Background="#1A1A1A" CornerRadius="12" Padding="20">
                        <StackPanel Spacing="20">
                            <TextBlock Text="🔥 HIGHEST WIN RATE" FontSize="14" FontWeight="Bold" Foreground="{StaticResource FightingRedBrush}" />
                            <TextBlock Text="{Binding HighestWinRate}" FontSize="20" FontWeight="Black" Foreground="White" />
                            <TextBlock Text="Dominating performance." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid ColumnDefinitions="*, 400" RowDefinitions="Auto, Auto">
                    <!-- Recent Matches -->
                    <Border Grid.Column="0" Grid.RowSpan="2" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="20" Margin="0,0,20,0">
                        <StackPanel Spacing="15">
                            <TextBlock Text="RECENT MATCH HISTORY" Classes="SectionHeader" />
                            <ItemsControl ItemsSource="{Binding RecentMatches}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="ListItem" Padding="15" Margin="0,0,0,8">
                                            <Grid ColumnDefinitions="*, Auto">
                                                <StackPanel Spacing="5">
                                                    <TextBlock Text="{Binding Player1Name}" FontWeight="SemiBold" />
                                                    <TextBlock Text="vs" Classes="Subtitle" FontSize="10" />
                                                    <TextBlock Text="{Binding Player2Name}" FontWeight="SemiBold" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="5" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Result}" FontWeight="Bold" Foreground="{StaticResource FightingYellowBrush}" />
                                                    <TextBlock Text="{Binding PlayedAt, StringFormat='{}{0:g}'}" Classes="Caption" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Tier List -->
                    <Border Grid.Column="1" Grid.Row="0" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                        <StackPanel Spacing="15">
                            <TextBlock Text="OFFICIAL TIER LIST" Classes="SectionHeader" />
                            <ItemsControl ItemsSource="{Binding TierList}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="ListItem" Padding="10" Margin="0,0,0,6">
                                            <Grid ColumnDefinitions="40, *, Auto">
                                                <TextBlock Text="{Binding Tier}" FontWeight="Black" FontSize="18" Foreground="{StaticResource FightingYellowBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Margin="10,0" FontWeight="Bold" />
                                                <TextBlock Grid.Column="2" Text="{Binding WinRate, StringFormat='{}{0:P0}'}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- ELO Ratings -->
                    <Border Grid.Column="1" Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="20">
                        <StackPanel Spacing="15">
                            <TextBlock Text="ELO RATINGS" Classes="SectionHeader" />
                            <ItemsControl ItemsSource="{Binding EloRatings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="ListItem" Padding="10" Margin="0,0,0,6">
                                            <Grid ColumnDefinitions="*, Auto">
                                                <TextBlock Text="{Binding CharacterName}" FontWeight="Bold" />
                                                <TextBlock Grid.Column="1" Text="{Binding Rating, StringFormat='{}ELO {0:F0}'}" Foreground="{StaticResource FightingRedBrush}" FontWeight="Black" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
