<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SaveState.Presentation.ViewModels.Shell"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="SaveState.Presentation.Views.Shell.RetroArchView"
             x:DataType="vm:RetroArchViewModel"
             Loaded="OnLoaded">

    <UserControl.Styles>
        <Style Selector="Border.GlassContainer">
            <Setter Property="Background" Value="#11ffffff"/>
            <Setter Property="BorderBrush" Value="#22ffffff"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>

        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.accent:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.05)"/>
        </Style>

        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,20,0"/>
            <Setter Property="Padding" Value="0,8"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" Margin="30">

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="10" Margin="0,0,0,20">
            <TextBlock Text="🎮 RetroArch Integration"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="{DynamicResource AccentBrush}" />

            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="14"
                       Opacity="0.7" />

            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                <Button Content="🔄 Refresh Games"
                        Command="{Binding LoadGamesCommand}"
                        Classes="accent" />

                <Button Content="📥 Import to Library"
                        Command="{Binding ImportGamesCommand}"
                        Classes="success"
                        IsEnabled="{Binding !IsLoading}" />

                <Button Content="💾 Sync Saves"
                        Command="{Binding SyncSavesCommand}"
                        IsEnabled="{Binding !IsLoading}" />

                <TextBlock Text="{Binding GamesCount, StringFormat='{}{0} games'}"
                           VerticalAlignment="Center"
                           Margin="20,0,0,0"
                           FontWeight="SemiBold" />

                <TextBlock Text="{Binding InstalledCoresCount, StringFormat='{}{0} cores'}"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold" />
            </StackPanel>

            <!-- Search -->
            <TextBox Text="{Binding SearchText}"
                     Watermark="🔍 Search games..."
                     Width="300"
                     HorizontalAlignment="Left" />
        </StackPanel>

        <!-- Main Content -->
        <TabControl Grid.Row="1">

            <!-- Games Tab -->
            <TabItem Header="🎮 Games">
                <Grid RowDefinitions="*,Auto">

                    <!-- Games List -->
                    <ScrollViewer Grid.Row="0">
                        <ItemsControl ItemsSource="{Binding FilteredGames}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="GlassContainer"
                                            Padding="15"
                                            Margin="0,0,0,10">
                                        <Grid ColumnDefinitions="*,Auto">

                                            <!-- Game Info -->
                                            <StackPanel Grid.Column="0" Spacing="5">
                                                <TextBlock Text="{Binding Label}"
                                                           FontSize="16"
                                                           FontWeight="SemiBold" />

                                                <TextBlock Text="{Binding CoreName, StringFormat='Core: {0}'}"
                                                           FontSize="12"
                                                           Opacity="0.7" />

                                                <TextBlock Text="{Binding Path}"
                                                           FontSize="11"
                                                           Opacity="0.5"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <!-- Actions -->
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        Spacing="10"
                                                        VerticalAlignment="Center">
                                                <Button Content="▶️ Play"
                                                        Command="{Binding $parent[UserControl].((vm:RetroArchViewModel)DataContext).LaunchSpecificGameCommand}"
                                                        CommandParameter="{Binding}"
                                                        Classes="accent" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Empty State -->
                    <StackPanel Grid.Row="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="10"
                                IsVisible="{Binding !GamesCount}">
                        <TextBlock Text="🎮"
                                   FontSize="64"
                                   HorizontalAlignment="Center"
                                   Opacity="0.3" />
                        <TextBlock Text="No RetroArch games found"
                                   FontSize="18"
                                   HorizontalAlignment="Center"
                                   Opacity="0.7" />
                        <TextBlock Text="Make sure RetroArch is installed and has games in playlists"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   Opacity="0.5" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Installed Cores Tab -->
            <TabItem Header="💿 Installed Cores">
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding InstalledCores}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="GlassContainer"
                                        Padding="15"
                                        Margin="0,0,0,10">
                                    <Grid ColumnDefinitions="Auto,*,Auto">

                                        <TextBlock Grid.Column="0"
                                                   Text="✅"
                                                   FontSize="24"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,15,0" />

                                        <StackPanel Grid.Column="1" Spacing="5">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold" />

                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="12"
                                                       Opacity="0.7" />

                                            <TextBlock Text="{Binding Path}"
                                                       FontSize="11"
                                                       Opacity="0.5"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <Button Grid.Column="2"
                                                Content="🔄 Update"
                                                Command="{Binding $parent[UserControl].((vm:RetroArchViewModel)DataContext).UpdateCoreCommand}"
                                                CommandParameter="{Binding Name}"
                                                VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <!-- Available Cores Tab -->
            <TabItem Header="📦 Available Cores">
                <Grid>
                    <ScrollViewer IsVisible="{Binding AvailableCores.Count}">
                        <ItemsControl ItemsSource="{Binding AvailableCores}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="GlassContainer"
                                            Padding="15"
                                            Margin="0,0,0,10">
                                        <Grid ColumnDefinitions="Auto,*,Auto">

                                            <TextBlock Grid.Column="0"
                                                       Text="📦"
                                                       FontSize="24"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,15,0" />

                                            <StackPanel Grid.Column="1" Spacing="5">
                                                <TextBlock Text="{Binding DisplayName, FallbackValue='Unknown Core'}"
                                                           FontSize="16"
                                                           FontWeight="SemiBold" />

                                                <TextBlock Text="{Binding Name, FallbackValue='unknown'}"
                                                           FontSize="12"
                                                           Opacity="0.7" />
                                            </StackPanel>

                                            <Button Grid.Column="2"
                                                    Content="⬇️ Install"
                                                    Command="{Binding $parent[UserControl].((vm:RetroArchViewModel)DataContext).InstallCoreCommand}"
                                                    CommandParameter="{Binding Name}"
                                                    Classes="accent"
                                                    VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Empty State -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="10"
                                IsVisible="{Binding !AvailableCores.Count}">
                        <TextBlock Text="📦"
                                   FontSize="64"
                                   HorizontalAlignment="Center"
                                   Opacity="0.3" />
                        <TextBlock Text="Loading available cores..."
                                   FontSize="18"
                                   HorizontalAlignment="Center"
                                   Opacity="0.7" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Info Tab -->
            <TabItem Header="ℹ️ Info">
                <ScrollViewer>
                    <StackPanel Spacing="20" Margin="20">
                        <TextBlock Text="About RetroArch Integration"
                                   FontSize="24"
                                   FontWeight="Bold" />

                        <StackPanel Spacing="10">
                            <TextBlock Text="Features:" FontWeight="SemiBold" FontSize="16" />
                            <TextBlock Text="✅ Auto-detect RetroArch installation" />
                            <TextBlock Text="✅ Browse all games from RetroArch playlists" />
                            <TextBlock Text="✅ Import games into SaveState library" />
                            <TextBlock Text="✅ Launch games directly from SaveState" />
                            <TextBlock Text="✅ Manage emulator cores (install, update)" />
                            <TextBlock Text="✅ Cloud save synchronization" />
                            <TextBlock Text="✅ RetroAchievements support (coming soon)" />
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <TextBlock Text="How to use:" FontWeight="SemiBold" FontSize="16" />
                            <TextBlock Text="1. Make sure RetroArch is installed on your system" TextWrapping="Wrap" />
                            <TextBlock Text="2. Add games to RetroArch playlists" TextWrapping="Wrap" />
                            <TextBlock Text="3. Click 'Refresh Games' to scan your RetroArch library" TextWrapping="Wrap" />
                            <TextBlock Text="4. Click 'Import to Library' to add games to SaveState" TextWrapping="Wrap" />
                            <TextBlock Text="5. Launch games directly or manage cores" TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Background="{DynamicResource InfoBackgroundBrush}"
                                BorderBrush="{DynamicResource InfoBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="15">
                            <StackPanel Spacing="5">
                                <TextBlock Text="💡 Tip" FontWeight="Bold" />
                                <TextBlock Text="RetroArch is the premier multi-platform emulation frontend. It supports hundreds of systems and cores."
                                           TextWrapping="Wrap" />
                                <TextBlock Text="Download RetroArch from: https://www.retroarch.com"
                                           TextWrapping="Wrap"
                                           Opacity="0.7" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Loading Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                Background="#CC000000"
                IsVisible="{Binding IsLoading}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="15">
                <TextBlock Text="⏳"
                           FontSize="48"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="16"
                           HorizontalAlignment="Center"
                           Foreground="White" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
