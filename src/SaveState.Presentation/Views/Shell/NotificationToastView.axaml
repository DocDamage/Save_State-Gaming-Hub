<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:SaveState.Presentation.Services"
             x:Class="SaveState.Presentation.Views.Shell.NotificationToastView"
             x:DataType="services:NotificationViewModel">

    <Border Background="{Binding BackgroundColor}"
            BorderBrush="{Binding BorderColor}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16,12"
            Margin="0,0,0,8"
            MinWidth="300"
            MaxWidth="400">

        <Grid ColumnDefinitions="Auto,*,Auto">
            <!-- Icon -->
            <Border Grid.Column="0"
                    Width="32"
                    Height="32"
                    CornerRadius="16"
                    Background="#20FFFFFF"
                    Margin="0,0,12,0"
                    VerticalAlignment="Top">
                <TextBlock Text="{Binding Icon}"
                           FontSize="18"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="White" />
            </Border>

            <!-- Content -->
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="{Binding Title}"
                           FontWeight="SemiBold"
                           FontSize="14"
                           Foreground="White" />
                <TextBlock Text="{Binding Message}"
                           FontSize="13"
                           Foreground="#F0FFFFFF"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- Close Button -->
            <Button Grid.Column="2"
                    Width="24"
                    Height="24"
                    VerticalAlignment="Top"
                    Margin="12,0,0,0"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    ToolTip.Tip="Dismiss">
                <TextBlock Text="×"
                           FontSize="20"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Button>
        </Grid>
    </Border>
</UserControl>
