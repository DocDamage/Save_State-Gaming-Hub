<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SaveState.Presentation.ViewModels.Shell"
             xmlns:widgets="using:SaveState.Presentation.Views.Dashboard.Widgets"
             x:Class="SaveState.Presentation.Views.Shell.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <UserControl.Styles>
        <Style Selector="Border.widget-container">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BoxShadow" Value="0 2px 8px rgba(0,0,0,0.1)" />
        </Style>

        <Style Selector="TextBlock.widget-title">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style Selector="Button.widget-action">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.widget-action:hover">
            <Setter Property="Background" Value="{StaticResource HoverBrush}" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Grid RowDefinitions="Auto, *">
            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                <TextBlock Text="Dashboard" FontSize="24" FontWeight="Bold" />
                <Button Content="⚙️ Customize" Command="{Binding CustomizeCommand}" Margin="20,0,0,0" />
                <Button Content="🔄 Reset Layout" Command="{Binding ResetLayoutCommand}" Margin="10,0,0,0" />
            </StackPanel>

            <!-- Widget Grid -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Widgets}">
                <ItemsControl.Styles>
                    <Style Selector="ItemsControl > ContentPresenter">
                        <Setter Property="Grid.Column" Value="{Binding Column}"/>
                        <Setter Property="Grid.Row" Value="{Binding Row}"/>
                        <Setter Property="Grid.ColumnSpan" Value="{Binding ColumnSpan}"/>
                        <Setter Property="Grid.RowSpan" Value="{Binding RowSpan}"/>
                    </Style>
                </ItemsControl.Styles>

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid ShowGridLines="False">
                            <!-- Define 12 columns for the grid -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Define enough rows for the grid -->
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                        </Grid>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="widget-container"
                                Margin="8"
                                Padding="16">
                            <Grid RowDefinitions="Auto, *">
                                <!-- Widget Header -->
                                <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Widget.Icon}" FontSize="18" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Widget.Title}" Classes="widget-title" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Classes="widget-action"
                                                Content="−"
                                                Command="{Binding Widget.MinimizeCommand}"
                                                IsVisible="{Binding Widget.CanMinimize}" />
                                        <Button Classes="widget-action"
                                                Content="✕"
                                                Command="{Binding Widget.RemoveCommand}"
                                                IsVisible="{Binding Widget.CanRemove}" />
                                    </StackPanel>
                                </Grid>

                                <!-- Widget Content -->
                                <ContentControl Grid.Row="1"
                                              Content="{Binding Widget.ViewModel}"
                                              Margin="0,12,0,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </ScrollViewer>
</UserControl>
