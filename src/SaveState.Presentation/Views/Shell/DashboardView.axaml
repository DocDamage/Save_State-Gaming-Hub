<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SaveState.Presentation.ViewModels.Shell"
             xmlns:widgets="using:SaveState.Presentation.Views.Dashboard.Widgets"
             x:Class="SaveState.Presentation.Views.Shell.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <UserControl.Styles>
        <Style Selector="Border.widget-container">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="BoxShadow" Value="0 4 12 #20000000" />
            <Setter Property="Transitions">
                <Transitions>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border.widget-container:pointerover">
            <Setter Property="Background" Value="{StaticResource CardHoverBrush}" />
            <Setter Property="BoxShadow" Value="0 8 24 #40000000" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="RenderTransform" Value="translateY(-2px)" />
        </Style>

        <Style Selector="TextBlock.widget-title">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>

        <Style Selector="Button.header-action">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="CornerRadius" Value="20" /> <!-- Pill shape -->
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>

        <Style Selector="Button.header-action:pointerover">
            <Setter Property="Background" Value="{StaticResource CardHoverBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource TextSecondaryBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, *">
        <!-- Dashboard Header -->
        <Border Grid.Row="0" Margin="20,20,20,10">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel>
                    <TextBlock Text="Welcome back, Commander"
                               FontSize="32"
                               FontWeight="Heavy"
                               Foreground="White" />
                    <TextBlock Text="Your gaming command center is online."
                               FontSize="16"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Classes="header-action" Command="{Binding CustomizeCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="⚙️" VerticalAlignment="Center"/>
                            <TextBlock Text="Customize" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="header-action" Command="{Binding ResetLayoutCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="🔄" VerticalAlignment="Center"/>
                            <TextBlock Text="Reset" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Widgets}" Padding="12">
                <ItemsControl.Styles>
                    <Style Selector="ItemsControl > ContentPresenter">
                        <Setter Property="Grid.Column" Value="{Binding Column}"/>
                        <Setter Property="Grid.Row" Value="{Binding Row}"/>
                        <Setter Property="Grid.ColumnSpan" Value="{Binding ColumnSpan}"/>
                        <Setter Property="Grid.RowSpan" Value="{Binding RowSpan}"/>
                    </Style>
                </ItemsControl.Styles>

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid>
                            <!-- 12-column grid for maximum flexibility -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                        </Grid>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="widget-container"
                                Margin="8"
                                Padding="20">
                            <Grid RowDefinitions="Auto, *">
                                <!-- Widget Header -->
                                <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,15">
                                    <TextBlock Text="{Binding Widget.Icon}"
                                               FontSize="24"
                                               Margin="0,0,12,0"
                                               VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Widget.Title}"
                                               Classes="widget-title"
                                               VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                        <Button Classes="widget-action"
                                                Content="−"
                                                Command="{Binding Widget.MinimizeCommand}"
                                                IsVisible="{Binding Widget.CanMinimize}" />
                                        <Button Classes="widget-action"
                                                Content="✕"
                                                Command="{Binding $parent[UserControl].((vm:DashboardViewModel)DataContext).RemoveWidgetCommand}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding Widget.CanRemove}" />
                                    </StackPanel>
                                </Grid>

                                <!-- Widget Content -->
                                <ContentControl Grid.Row="1"
                                              Content="{Binding Widget.ViewModel}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
