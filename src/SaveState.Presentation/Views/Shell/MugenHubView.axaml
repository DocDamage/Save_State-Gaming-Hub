<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SaveState.Presentation.ViewModels.Shell"
             x:Class="SaveState.Presentation.Views.Shell.MugenHubView"
             x:DataType="vm:MugenHubViewModel"
             Background="{StaticResource BackgroundBrush}">

    <Grid RowDefinitions="Auto, *">
        <!-- Sub-Tab Header -->
        <Border Grid.Row="0" Classes="GlassContainer" Margin="20,20,20,10" Padding="20">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <!-- Tournaments Tab -->
                    <Button Content="🏆 Tournaments"
                            Command="{Binding ShowTournamentsCommand}"
                            Classes.Primary="{Binding SelectedTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Tournaments}"
                            Classes.Secondary="{Binding SelectedTab, Converter={StaticResource InequalityConverter}, ConverterParameter=Tournaments}"
                            Padding="15,8"
                            FontWeight="{Binding SelectedTab, Converter={StaticResource EqualityToFontWeightConverter}, ConverterParameter=Tournaments}" />

                    <!-- Characters Tab -->
                    <Button Content="🥊 Characters"
                            Command="{Binding ShowCharactersCommand}"
                            Classes.Primary="{Binding SelectedTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Characters}"
                            Classes.Secondary="{Binding SelectedTab, Converter={StaticResource InequalityConverter}, ConverterParameter=Characters}"
                            Padding="15,8"
                            FontWeight="{Binding SelectedTab, Converter={StaticResource EqualityToFontWeightConverter}, ConverterParameter=Characters}" />

                    <!-- Statistics Tab -->
                    <Button Content="📊 Statistics"
                            Command="{Binding ShowStatisticsCommand}"
                            Classes.Primary="{Binding SelectedTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Statistics}"
                            Classes.Secondary="{Binding SelectedTab, Converter={StaticResource InequalityConverter}, ConverterParameter=Statistics}"
                            Padding="15,8"
                            FontWeight="{Binding SelectedTab, Converter={StaticResource EqualityToFontWeightConverter}, ConverterParameter=Statistics}" />
                </StackPanel>

                <Button Grid.Column="2"
                        Content="🔄 Refresh"
                        Classes="Secondary"
                        Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding !IsLoading}"
                        Padding="12,8" />
            </Grid>
        </Border>

        <!-- Content Area -->
        <ScrollViewer Grid.Row="1">
            <StackPanel>
            <!-- TOURNAMENTS TAB -->
            <Grid IsVisible="{Binding SelectedTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Tournaments}">
                <Grid ColumnDefinitions="*, 400" Margin="20,0,20,20">
                    <!-- Tournaments List -->
                    <Border Classes="GlassContainer" Padding="20" Margin="0,0,10,0">
                        <Grid RowDefinitions="Auto, Auto, *">
                            <TextBlock Text="🏆 Tournaments" Classes="SectionHeader" />

                            <!-- Statistics -->
                            <Grid Grid.Row="1" ColumnDefinitions="*, *, *" Margin="0,15,0,15">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Total" Classes="Label" />
                                    <TextBlock Text="{Binding TotalTournaments}" FontWeight="Bold" FontSize="20" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="5">
                                    <TextBlock Text="Active" Classes="Label" />
                                    <TextBlock Text="{Binding ActiveTournaments}" FontWeight="Bold" FontSize="20" Foreground="#10B981" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Spacing="5">
                                    <TextBlock Text="Completed" Classes="Label" />
                                    <TextBlock Text="{Binding CompletedTournaments}" FontWeight="Bold" FontSize="20" />
                                </StackPanel>
                            </Grid>

                            <!-- Tournaments ItemsControl -->
                            <ItemsControl Grid.Row="2" ItemsSource="{Binding Tournaments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="ListItem" Padding="15" Margin="0,0,0,8">
                                            <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, Auto">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           FontSize="16" />

                                                <Border Grid.Column="1"
                                                        Background="#10B981"
                                                        CornerRadius="4"
                                                        Padding="6,2"
                                                        IsVisible="{Binding Status, Converter={StaticResource EqualityConverter}, ConverterParameter=InProgress}">
                                                    <TextBlock Text="Active" Foreground="White" FontSize="11" />
                                                </Border>

                                                <Border Grid.Column="1"
                                                        Background="#3B82F6"
                                                        CornerRadius="4"
                                                        Padding="6,2"
                                                        IsVisible="{Binding Status, Converter={StaticResource EqualityConverter}, ConverterParameter=Completed}">
                                                    <TextBlock Text="Completed" Foreground="White" FontSize="11" />
                                                </Border>

                                                <TextBlock Grid.Row="1"
                                                           Grid.ColumnSpan="2"
                                                           Text="{Binding Format}"
                                                           Classes="Subtitle"
                                                           Margin="0,5,0,0" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Empty State -->
                            <Border Grid.Row="2"
                                    IsVisible="{Binding Tournaments.Count, Converter={StaticResource IntToBoolConverter}, ConverterParameter=0}"
                                    Padding="40">
                                <StackPanel Spacing="15" HorizontalAlignment="Center">
                                    <TextBlock Text="🏆" FontSize="48" HorizontalAlignment="Center" />
                                    <TextBlock Text="No tournaments yet" Classes="Subtitle" HorizontalAlignment="Center" />
                                    <TextBlock Text="Create your first tournament to get started" Classes="Subtitle" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Create Tournament Panel -->
                    <Border Grid.Column="1" Classes="GlassContainer" Padding="20" IsVisible="{Binding ShowCreateTournament}">
                        <Grid RowDefinitions="Auto, *, Auto">
                            <TextBlock Text="🏆 New Tournament" Classes="SectionHeader" />

                            <StackPanel Grid.Row="1" Spacing="15" Margin="0,15,0,0">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Tournament Name" Classes="Label" />
                                    <TextBox Text="{Binding TournamentName}" Watermark="e.g. Summer Championship" />
                                </StackPanel>

                                <StackPanel Spacing="5">
                                    <TextBlock Text="Format" Classes="Label" />
                                    <ComboBox ItemsSource="{Binding TournamentFormats}"
                                              SelectedItem="{Binding SelectedFormat}"
                                              HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" Margin="0,15,0,0">
                                <Button Content="✅ Create"
                                        Classes="Primary"
                                        Command="{Binding CreateTournamentCommand}"
                                        HorizontalAlignment="Stretch" />

                                <Button Content="❌ Cancel"
                                        Classes="Secondary"
                                        Command="{Binding CancelCreateTournamentCommand}"
                                        HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Quick Info Panel -->
                    <Border Grid.Column="1" Classes="GlassContainer" Padding="20" IsVisible="{Binding !ShowCreateTournament}">
                        <Grid RowDefinitions="Auto, *">
                            <StackPanel Spacing="10">
                                <TextBlock Text="💡 Quick Actions" Classes="SectionHeader" />
                                <Button Content="➕ New Tournament"
                                        Classes="Primary"
                                        Command="{Binding ShowCreateTournamentDialogCommand}"
                                        HorizontalAlignment="Stretch"
                                        Padding="15,10"
                                        Margin="0,15,0,0" />
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" Margin="0,15,0,0">
                                <StackPanel Spacing="15">
                                    <Border Background="#1a1a1a" CornerRadius="8" Padding="15">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="🏆 Tournament Formats"
                                                       FontWeight="SemiBold"
                                                       FontSize="14" />
                                            <TextBlock Text="Single Elimination: Fast-paced, one loss and you're out"
                                                       TextWrapping="Wrap"
                                                       Classes="Subtitle" />
                                            <TextBlock Text="Double Elimination: Second chances, losers bracket"
                                                       TextWrapping="Wrap"
                                                       Classes="Subtitle" />
                                            <TextBlock Text="Round Robin: Everyone faces everyone"
                                                       TextWrapping="Wrap"
                                                       Classes="Subtitle" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- CHARACTERS TAB -->
            <Grid IsVisible="{Binding SelectedTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Characters}">
                <Border Classes="GlassContainer" Margin="20,0,20,20" Padding="20">
                    <Grid RowDefinitions="Auto, Auto, *">
                        <TextBlock Text="🥊 Characters" Classes="SectionHeader" />

                        <!-- Statistics -->
                        <Grid Grid.Row="1" ColumnDefinitions="*, *" Margin="0,15,0,15">
                            <StackPanel Spacing="5">
                                <TextBlock Text="Total Characters" Classes="Label" />
                                <TextBlock Text="{Binding TotalCharacters}" FontWeight="Bold" FontSize="20" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="5">
                                <TextBlock Text="Favorites" Classes="Label" />
                                <TextBlock Text="{Binding FavoriteCharacters}" FontWeight="Bold" FontSize="20" Foreground="#FBBF24" />
                            </StackPanel>
                        </Grid>

                        <!-- Characters Grid -->
                        <ItemsControl Grid.Row="2" ItemsSource="{Binding Characters}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="ListItem"
                                                Padding="15"
                                                Margin="0,0,10,10"
                                                Width="200">
                                            <Grid RowDefinitions="Auto, Auto, Auto">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontWeight="SemiBold"
                                                           FontSize="14"
                                                           TextTrimming="CharacterEllipsis" />

                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding Author}"
                                                           Classes="Subtitle"
                                                           Margin="0,5,0,0" />

                                                <Button Grid.Row="2"
                                                        Content="☆ Favorite"
                                                        Classes="Secondary"
                                                        Command="{Binding $parent[ItemsControl].((vm:MugenHubViewModel)DataContext).ToggleFavoriteCommand}"
                                                        CommandParameter="{Binding}"
                                                        Padding="8,4"
                                                        Margin="0,10,0,0"
                                                        HorizontalAlignment="Stretch" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Empty State -->
                            <Border IsVisible="{Binding Characters.Count, Converter={StaticResource IntToBoolConverter}, ConverterParameter=0}"
                                    Padding="40">
                                <StackPanel Spacing="15" HorizontalAlignment="Center">
                                    <TextBlock Text="🥊" FontSize="48" HorizontalAlignment="Center" />
                                    <TextBlock Text="No characters found" Classes="Subtitle" HorizontalAlignment="Center" />
                                    <TextBlock Text="Scan your MUGEN directory to import characters" Classes="Subtitle" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- STATISTICS TAB -->
            <Grid IsVisible="{Binding SelectedTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Statistics}">
                <Border Classes="GlassContainer" Margin="20,0,20,20" Padding="20">
                    <Grid RowDefinitions="Auto, *">
                        <TextBlock Text="📊 Recent Matches" Classes="SectionHeader" />

                        <ItemsControl Grid.Row="1" Margin="0,15,0,0" ItemsSource="{Binding RecentMatches}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="ListItem" Padding="15" Margin="0,0,0,8">
                                            <Grid ColumnDefinitions="*, Auto">
                                                <StackPanel Spacing="5">
                                                    <TextBlock Text="{Binding Player1CharacterId}"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="vs"
                                                               Classes="Subtitle"
                                                               FontSize="12" />
                                                    <TextBlock Text="{Binding Player2CharacterId}"
                                                               FontWeight="SemiBold" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Spacing="5" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding Result}"
                                                               FontWeight="Bold"
                                                               Foreground="#10B981" />
                                                    <TextBlock Text="{Binding Duration, StringFormat='{}{0:mm\\:ss}'}"
                                                               Classes="Subtitle" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Empty State -->
                            <Border IsVisible="{Binding RecentMatches.Count, Converter={StaticResource IntToBoolConverter}, ConverterParameter=0}"
                                    Padding="40">
                                <StackPanel Spacing="15" HorizontalAlignment="Center">
                                    <TextBlock Text="📊" FontSize="48" HorizontalAlignment="Center" />
                                    <TextBlock Text="No match history yet" Classes="Subtitle" HorizontalAlignment="Center" />
                                    <TextBlock Text="Play some matches to see statistics" Classes="Subtitle" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                    </Grid>
                </Border>
            </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
