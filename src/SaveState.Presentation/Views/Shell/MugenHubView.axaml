<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SaveState.Presentation.ViewModels.Shell;assembly=SaveState.Presentation"
             xmlns:mvm="using:SaveState.Presentation.ViewModels.Shell.Mugen"
             xmlns:mviews="using:SaveState.Presentation.Views.Shell.Mugen"
             x:Class="SaveState.Presentation.Views.Shell.MugenHubView"
             x:DataType="vm:MugenHubViewModel"
             Background="{StaticResource BackgroundBrush}">

    <Grid RowDefinitions="Auto, *">
        <!-- Sub-Tab Header -->
        <Border Grid.Row="0" Classes="GlassContainer" Margin="20,20,20,10" Padding="20">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <StackPanel Orientation="Horizontal" Spacing="10">






                    <!-- Netplay Tab -->
                    <Button Content="Netplay"
                            Command="{Binding ShowNetplayCommand}"
                            Classes="Secondary"
                            Padding="15,8"
                            FontWeight="{Binding SelectedTab, Converter={StaticResource EqualityToFontWeightConverter}, ConverterParameter=Netplay}" />



                    <!-- Statistics Tab -->
                    <Button Content="Statistics"
                            Command="{Binding ShowStatisticsCommand}"
                            Classes="Secondary"
                            Padding="15,8"
                            FontWeight="{Binding SelectedTab, Converter={StaticResource EqualityToFontWeightConverter}, ConverterParameter=Statistics}" />

                    <!-- Settings Tab -->
                    <Button Content="Settings"
                            Command="{Binding ShowSettingsCommand}"
                            Classes="Secondary"
                            Padding="15,8"
                            FontWeight="{Binding SelectedTab, Converter={StaticResource EqualityToFontWeightConverter}, ConverterParameter=Settings}" />
                </StackPanel>

                <Button Grid.Column="2"
                        Content="Refresh"
                        Classes="Secondary"
                        Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding !IsLoading}"
                        Padding="12,8" />
            </Grid>
        </Border>

        <!-- Content Area -->
        <ScrollViewer Grid.Row="1">
            <StackPanel>




            <!-- NETPLAY TAB -->
            <Grid IsVisible="{Binding SelectedTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Netplay}">
                <Border Classes="GlassContainer" Margin="20,0,20,20" Padding="20">
                    <Grid RowDefinitions="Auto, Auto, *">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Text="Netplay Lobbies" Classes="SectionHeader" />
                            <Button Grid.Column="1"
                                    Content="Refresh"
                                    Classes="Secondary"
                                    Command="{Binding LoadNetplayCommand}"
                                    Padding="8,4" />
                        </Grid>

                        <StackPanel Grid.Row="1" Spacing="6">
                            <TextBlock Text="{Binding NetplayStatus}" Classes="Caption" />
                            <ProgressBar IsIndeterminate="True"
                                         Height="4"
                                         IsVisible="{Binding IsNetplayLoading}" />
                        </StackPanel>

                        <ItemsControl Grid.Row="2" ItemsSource="{Binding NetplayLobbies}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="ListItem" Padding="12" Margin="0,0,0,8">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Host}" Classes="Caption" />
                                                <TextBlock Text="{Binding Region, StringFormat='Region: {0}'}" Classes="Caption" />
                                                <TextBlock Text="{Binding Description}"
                                                           Classes="Caption"
                                                           TextWrapping="Wrap"
                                                           IsVisible="{Binding Description, Converter={StaticResource NullOrEmptyToBoolConverter}, ConverterParameter=Invert}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="6" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding Players, StringFormat='Players: {0}'}" Classes="Caption" />
                                                <TextBlock Text="{Binding MaxPlayers, StringFormat='Max: {0}'}" Classes="Caption" />
                                                <Button Content="Join"
                                                        Classes="Secondary"
                                                        Command="{Binding $parent[ItemsControl].((vm:MugenHubViewModel)DataContext).JoinLobbyCommand}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding JoinUrl, Converter={StaticResource NullOrEmptyToBoolConverter}, ConverterParameter=Invert}"
                                                        Padding="6,4" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Grid.Row="2"
                                IsVisible="{Binding NetplayLobbies.Count, Converter={StaticResource IntToBoolConverter}, ConverterParameter=0}"
                                Padding="20">
                            <TextBlock Text="No lobbies available." Classes="Subtitle" HorizontalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- STATISTICS TAB -->
            <Grid IsVisible="{Binding SelectedTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Statistics}">
                <Border Classes="GlassContainer" Margin="20,0,20,20" Padding="20">
                    <Grid ColumnDefinitions="*, 360" RowDefinitions="Auto, *">
                        <TextBlock Grid.ColumnSpan="2" Text="Recent Matches" Classes="SectionHeader" />

                        <Grid Grid.Row="1" ColumnDefinitions="*, 360" Margin="0,15,0,0">
                            <StackPanel Grid.Column="0" Spacing="10">
                                <ItemsControl ItemsSource="{Binding RecentMatches}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Classes="ListItem" Padding="15" Margin="0,0,0,8">
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <StackPanel Spacing="5">
                                                        <TextBlock Text="{Binding Player1CharacterId}"
                                                                   FontWeight="SemiBold" FontSize="10"/>
                                                        <TextBlock Text="vs"
                                                                   Classes="Subtitle"
                                                                   FontSize="12" />
                                                        <TextBlock Text="{Binding Player2CharacterId}"
                                                                   FontWeight="SemiBold" FontSize="10"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" Spacing="5" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding PlayedAt, StringFormat='{}{0:g}'}"
                                                                   Classes="Subtitle" />
                                                        <TextBlock Text="{Binding MatchDuration, StringFormat='{}{0:mm\\:ss}'}"
                                                                   Classes="Subtitle" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Empty State -->
                                <Border IsVisible="{Binding RecentMatches.Count, Converter={StaticResource IntToBoolConverter}, ConverterParameter=0}"
                                        Padding="40">
                                    <StackPanel Spacing="15" HorizontalAlignment="Center">
                                        <TextBlock Text="No match history yet" Classes="Subtitle" HorizontalAlignment="Center" />
                                        <TextBlock Text="Play some matches to see statistics" Classes="Subtitle" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="15" Margin="15,0,0,0">
                                <!-- Tier List -->
                                <Border Classes="GlassContainer" Padding="15">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Tier List" Classes="SectionHeader" />
                                        <ItemsControl ItemsSource="{Binding TierList}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Classes="ListItem" Padding="10" Margin="0,0,0,6">
                                                        <Grid ColumnDefinitions="30, *, Auto, Auto">
                                                            <TextBlock Text="{Binding Tier}"
                                                                       FontWeight="Bold"
                                                                       Foreground="#F59E0B" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}" />
                                                            <TextBlock Grid.Column="2" Text="{Binding WinRate, StringFormat='{}{0:P0}'}" Classes="Caption" />
                                                            <TextBlock Grid.Column="3" Text="{Binding Matches}" Classes="Caption" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Border IsVisible="{Binding TierList.Count, Converter={StaticResource IntToBoolConverter}, ConverterParameter=0}"
                                                Padding="10">
                                            <TextBlock Text="No tier data yet" Classes="Subtitle" />
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- ELO Ratings -->
                                <Border Classes="GlassContainer" Padding="15">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="ELO Ratings" Classes="SectionHeader" />
                                        <ItemsControl ItemsSource="{Binding EloRatings}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Classes="ListItem" Padding="10" Margin="0,0,0,6">
                                                        <Grid ColumnDefinitions="*, Auto, Auto">
                                                            <TextBlock Text="{Binding CharacterName}" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding Rating, StringFormat='ELO {0:F0}'}"
                                                                       Classes="Caption" />
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding WinRate, StringFormat='{}{0:P0}'}"
                                                                       Classes="Caption" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Border IsVisible="{Binding EloRatings.Count, Converter={StaticResource IntToBoolConverter}, ConverterParameter=0}"
                                                Padding="10">
                                            <TextBlock Text="No ELO data yet" Classes="Subtitle" />
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- AI Tournament Simulation -->
                                <Border Classes="GlassContainer" Padding="15">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="AI Tournament Simulation" Classes="SectionHeader" />
                                        <Grid ColumnDefinitions="*, *">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Participants" Classes="Label" />
                                                <NumericUpDown Value="{Binding SimulationParticipants}"
                                                               Minimum="2"
                                                               Maximum="32"
                                                               Width="120" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Text="Sims per Match" Classes="Label" />
                                                <NumericUpDown Value="{Binding SimulationsPerMatch}"
                                                               Minimum="10"
                                                               Maximum="2000"
                                                               Width="140" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid ColumnDefinitions="*, *">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Spectator Credits" Classes="Label" />
                                                <TextBlock Text="{Binding SpectatorCredits}" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Text="Bet Amount" Classes="Label" />
                                                <NumericUpDown Value="{Binding BetAmount}"
                                                               Minimum="0"
                                                               Maximum="{Binding SpectatorCredits}"
                                                               Width="140" />
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Bet On" Classes="Label" />
                                            <ComboBox ItemsSource="{Binding Characters}"
                                                      SelectedItem="{Binding SelectedBetCharacter}"
                                                      Width="240">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding DisplayName}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>

                                        <Button Content="Simulate"
                                                Classes="Secondary"
                                                Command="{Binding SimulateTournamentCommand}"
                                                Padding="8,4" />

                                        <ProgressBar IsIndeterminate="True"
                                                     Height="4"
                                                     IsVisible="{Binding IsSimulationLoading}" />

                                        <TextBlock Text="{Binding SimulationStatus}" Classes="Caption" />
                                        <TextBlock Text="{Binding BetStatus}" Classes="Caption" />

                                        <Border IsVisible="{Binding SimulationWinnerName, Converter={StaticResource NullOrEmptyToBoolConverter}, ConverterParameter=Invert}"
                                                Padding="6">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding SimulationWinnerName}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding SimulationWinnerConfidence, StringFormat='Confidence: {0:P0}'}"
                                                           Classes="Caption" />
                                            </StackPanel>
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding SimulationMatches}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Classes="ListItem" Padding="8" Margin="0,0,0,6">
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Text="{Binding RoundName}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding Player1Name, StringFormat='P1: {0}'}" Classes="Caption" />
                                                            <TextBlock Text="{Binding Player2Name, StringFormat='P2: {0}'}" Classes="Caption" />
                                                            <TextBlock Text="{Binding WinnerName, StringFormat='Winner: {0}'}" Classes="Caption" />
                                                            <TextBlock Text="{Binding Confidence, StringFormat='Confidence: {0:P0}'}" Classes="Caption" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Border IsVisible="{Binding SimulationMatches.Count, Converter={StaticResource IntToBoolConverter}, ConverterParameter=0}"
                                                Padding="10">
                                            <TextBlock Text="Run a simulation to see predictions." Classes="Subtitle" />
                                        </Border>

                                        <TextBlock Text="Bet History" FontWeight="SemiBold" Margin="0,6,0,0" />
                                        <ItemsControl ItemsSource="{Binding BetHistory}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Classes="ListItem" Padding="8" Margin="0,0,0,6">
                                                        <Grid ColumnDefinitions="*, Auto">
                                                            <StackPanel Spacing="2">
                                                                <TextBlock Text="{Binding CharacterName}" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding PlacedAt, StringFormat='Placed: {0:g}'}" Classes="Caption" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Right">
                                                                <TextBlock Text="{Binding Amount, StringFormat='Bet: {0}'}" Classes="Caption" />
                                                                <TextBlock Text="{Binding ResultLabel, StringFormat='Result: {0}'}" Classes="Caption" />
                                                                <TextBlock Text="{Binding CreditsAfter, StringFormat='Credits: {0}'}" Classes="Caption" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Border IsVisible="{Binding BetHistory.Count, Converter={StaticResource IntToBoolConverter}, ConverterParameter=0}"
                                                Padding="10">
                                            <TextBlock Text="No bets recorded yet." Classes="Subtitle" />
                                        </Border>

                                        <TextBlock Text="Bet Leaderboard" FontWeight="SemiBold" Margin="0,6,0,0" />
                                        <ItemsControl ItemsSource="{Binding BetLeaderboard}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Classes="ListItem" Padding="8" Margin="0,0,0,6">
                                                        <Grid ColumnDefinitions="*, Auto, Auto">
                                                            <TextBlock Text="{Binding CharacterName}" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding Bets, StringFormat='Bets: {0}'}"
                                                                       Classes="Caption" />
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding WinRate, StringFormat='{}{0:P0}'}"
                                                                       Classes="Caption" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Border IsVisible="{Binding BetLeaderboard.Count, Converter={StaticResource IntToBoolConverter}, ConverterParameter=0}"
                                                Padding="10">
                                            <TextBlock Text="No leaderboard data yet." Classes="Subtitle" />
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Replay Viewer -->
                                <Border Classes="GlassContainer" Padding="15">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Replay Viewer" Classes="SectionHeader" />
                                        <ItemsControl ItemsSource="{Binding Replays}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Classes="ListItem" Padding="10" Margin="0,0,0,6">
                                                        <Grid ColumnDefinitions="*, Auto">
                                                            <StackPanel Spacing="4">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding PlayedAt, StringFormat='Played: {0:g}'}" Classes="Caption" />
                                                                <TextBlock Text="{Binding Duration, StringFormat='Duration: {0:mm\\:ss}'}" Classes="Caption" />
                                                            </StackPanel>
                                                            <Button Grid.Column="1"
                                                                    Content="Open"
                                                                    Classes="Secondary"
                                                                    Command="{Binding $parent[ItemsControl].((vm:MugenHubViewModel)DataContext).OpenReplayCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    Padding="8,4" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Border IsVisible="{Binding Replays.Count, Converter={StaticResource IntToBoolConverter}, ConverterParameter=0}"
                                                Padding="10">
                                            <TextBlock Text="No replays found" Classes="Subtitle" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
            <!-- SETTINGS TAB -->
            <Grid IsVisible="{Binding SelectedTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Settings}">
                <Border Classes="GlassContainer" Margin="20,0,20,20" Padding="20">
                    <StackPanel Spacing="20">
                        <TextBlock Text="Fight Settings" Classes="SectionHeader" />

                        <StackPanel Spacing="10">
                            <TextBlock Text="Rounds to Win" Classes="Label"/>
                            <NumericUpDown Value="{Binding RoundsToWin}" Minimum="1" Maximum="5" Width="150" HorizontalAlignment="Left" />
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <TextBlock Text="Time Limit (Seconds)" Classes="Label"/>
                            <NumericUpDown Value="{Binding TimeLimit}" Minimum="30" Maximum="999" Width="150" HorizontalAlignment="Left" />
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <TextBlock Text="AI Difficulty (1-8)" Classes="Label"/>
                            <Slider Value="{Binding AiDifficulty}" Minimum="1" Maximum="8" Width="300" HorizontalAlignment="Left" TickPlacement="BottomRight" TickFrequency="1" IsSnapToTickEnabled="True"/>
                            <TextBlock Text="{Binding AiDifficulty}" FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <TextBlock Text="Default Stage" Classes="Label"/>
                            <ComboBox ItemsSource="{Binding Stages}"
                                      SelectedItem="{Binding SelectedStage}"
                                      Width="300"
                                      HorizontalAlignment="Left">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{Binding SelectedStage.Path}" Classes="Caption" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Loading Overlay -->
        <Border Grid.RowSpan="2"
                IsVisible="{Binding IsLoading}"
                Background="#66000000"
                ZIndex="200">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4" />
                <TextBlock Text="Loading MUGEN Data..."
                          HorizontalAlignment="Center"
                          Classes="Subtitle" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>



