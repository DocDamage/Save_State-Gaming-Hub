<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SaveState.Presentation.ViewModels.Shell"
             xmlns:views="using:SaveState.Presentation.Views.Shell"
             x:Class="SaveState.Presentation.Views.Shell.ToolsView"
             x:DataType="vm:ToolsViewModel">

    <Grid ColumnDefinitions="200, *">
        <!-- Left Sidebar: Categories -->
        <Border Grid.Column="0" Classes="GlassContainer" Margin="20,20,10,20" Padding="15">
            <StackPanel Spacing="10">
                <TextBlock Text="🛠️ TOOLS"
                          Classes="Subtitle"
                          FontWeight="Bold"
                          Margin="0,0,0,15"/>

                <ItemsControl ItemsSource="{Binding ToolCategories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Classes="SidebarButton"
                                   Command="{Binding $parent[UserControl].DataContext.SelectCategoryCommand}"
                                   CommandParameter="{Binding}"
                                   Margin="0,0,0,5">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="{Binding Icon}" FontSize="20"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Right Panel: Content -->
        <ScrollViewer Grid.Column="1" Margin="10,20,20,20">
            <StackPanel Spacing="15">

                <!-- Performance Monitor Section -->
                <Border Classes="GlassContainer" Padding="20"
                       IsVisible="{Binding SelectedCategory.Id, Converter={StaticResource EqualToConverter}, ConverterParameter='Performance'}">
                    <StackPanel Spacing="15">
                        <TextBlock Text="⚡ PERFORMANCE MONITOR" Classes="Subtitle" FontWeight="Bold"/>

                        <!-- Real-time Stats -->
                        <Grid ColumnDefinitions="*, *, *">
                            <!-- CPU -->
                            <Border Classes="GlassContainer" Padding="20" Margin="0,0,7.5,0">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="💻 CPU" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding CpuUsage, StringFormat='{}{0:F1}%'}"
                                              FontSize="32"
                                              FontWeight="Bold"
                                              Foreground="{StaticResource AccentBrush}"/>
                                    <TextBlock Text="{Binding CpuTemp, StringFormat='Temp: {0:F0}°C'}"
                                              Classes="Caption"
                                              Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- GPU -->
                            <Border Grid.Column="1" Classes="GlassContainer" Padding="20" Margin="7.5,0,7.5,0">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="🎮 GPU" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding GpuUsage, StringFormat='{}{0:F1}%'}"
                                              FontSize="32"
                                              FontWeight="Bold"
                                              Foreground="#ff6b35"/>
                                    <TextBlock Text="{Binding GpuTemp, StringFormat='Temp: {0:F0}°C'}"
                                              Classes="Caption"
                                              Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- RAM -->
                            <Border Grid.Column="2" Classes="GlassContainer" Padding="20" Margin="7.5,0,0,0">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="🧠 RAM" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding RamUsageMb, StringFormat='{}{0:N0} MB'}"
                                              FontSize="32"
                                              FontWeight="Bold"
                                              Foreground="#4ecdc4"/>
                                    <TextBlock Text="Memory Usage"
                                              Classes="Caption"
                                              Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- FPS Stats -->
                        <Grid ColumnDefinitions="*, *">
                            <Border Classes="GlassContainer" Padding="15" Margin="0,0,7.5,0">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="FPS" Classes="Caption" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding Fps, StringFormat='{}{0:F0}'}"
                                              FontSize="24"
                                              FontWeight="Bold"
                                              Foreground="#44cc11"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Classes="GlassContainer" Padding="15" Margin="7.5,0,0,0">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Frame Time" Classes="Caption" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding FrameTimeMs, StringFormat='{}{0:F1} ms'}"
                                              FontSize="24"
                                              FontWeight="Bold"
                                              Foreground="{StaticResource AccentBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Quick Actions -->
                        <TextBlock Text="QUICK ACTIONS" Classes="Caption" FontWeight="Bold" Margin="0,10,0,5"/>
                        <Grid ColumnDefinitions="*, *, *, *">
                            <Button Classes="ActionButton" Command="{Binding ToggleGameModeCommand}" Margin="0,0,5,0">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="🚀" FontSize="24" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Game Mode" Classes="Caption" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="1" Classes="ActionButton" Command="{Binding ToggleQuietModeCommand}" Margin="5,0,5,0">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="🔇" FontSize="24" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Quiet Mode" Classes="Caption" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2" Classes="ActionButton" Command="{Binding ApplyPerformanceModeCommand}" Margin="5,0,5,0">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="⚡" FontSize="24" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Performance" Classes="Caption" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="3" Classes="ActionButton" Command="{Binding ApplyPowerSaverCommand}" Margin="5,0,0,0">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="🔋" FontSize="24" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Power Saver" Classes="Caption" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Game Memory Section -->
                <views:GameMemoryView DataContext="{Binding GameMemoryViewModel}"
                                     IsVisible="{Binding SelectedCategory.Id, Converter={StaticResource EqualToConverter}, ConverterParameter='Memory'}" />

                <!-- Emulators Section -->
                <Border Classes="GlassContainer" Padding="20"
                       IsVisible="{Binding SelectedCategory.Id, Converter={StaticResource EqualToConverter}, ConverterParameter='Emulators'}">
                    <StackPanel Spacing="15">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Text="🎮 EMULATOR MANAGEMENT" Classes="Subtitle" FontWeight="Bold"/>
                            <Button Grid.Column="1" Content="Scan for Emulators" IsEnabled="{Binding !IsLoadingEmulators}"/>
                        </Grid>

                        <ProgressBar IsIndeterminate="True"
                                    IsVisible="{Binding IsLoadingEmulators}"
                                    Margin="0,10"/>

                        <ItemsControl ItemsSource="{Binding Emulators}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="GlassContainer" Padding="15" Margin="0,0,0,10">
                                        <Grid ColumnDefinitions="Auto, *, Auto">
                                            <TextBlock Text="{Binding StatusIcon}"
                                                       FontSize="24"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,15,0"/>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="18"
                                                           FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Platform}"
                                                           FontSize="12"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding ExecutablePath}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           IsVisible="{Binding IsInstalled}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{Binding Version}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,10,0"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <Button Content="Launch"
                                                        Command="{Binding LaunchCommand}"
                                                        IsVisible="{Binding IsInstalled}"/>
                                                <Button Content="{Binding StatusText}"
                                                        Command="{Binding ConfigureCommand}"
                                                        IsEnabled="True"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Voice Tools Section -->
                <Border Classes="GlassContainer" Padding="20"
                       IsVisible="{Binding SelectedCategory.Id, Converter={StaticResource EqualToConverter}, ConverterParameter='Voice'}">
                    <StackPanel Spacing="15">
                        <TextBlock Text="🎤 VOICE TOOLS" Classes="Subtitle" FontWeight="Bold"/>

                        <!-- Voice Command Status -->
                        <TextBlock Text="VOICE COMMAND STATUS" Classes="Caption" FontWeight="Bold" Margin="0,10,0,5"/>
                        <Border Classes="GlassContainer" Padding="15">
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Voice Commands" Classes="Body" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding VoiceCommandStatus}"
                                              Classes="Caption"
                                              Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                    <Button Content="Enable"
                                           Command="{Binding EnableVoiceCommandsCommand}"
                                           IsVisible="{Binding !VoiceCommandsEnabled}"/>
                                    <Button Content="Disable"
                                           Command="{Binding DisableVoiceCommandsCommand}"
                                           IsVisible="{Binding VoiceCommandsEnabled}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Microphone Setup -->
                        <TextBlock Text="MICROPHONE SETUP" Classes="Caption" FontWeight="Bold" Margin="0,10,0,5"/>
                        <Border Classes="GlassContainer" Padding="15">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Text="Input Device" Classes="Body"/>
                                    <ComboBox Grid.Column="1"
                                             Width="200"
                                             ItemsSource="{Binding AvailableMicrophones}"
                                             SelectedItem="{Binding SelectedMicrophone}"
                                             PlaceholderText="Select microphone..."/>
                                </Grid>

                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Text="Sensitivity" Classes="Body"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                        <Slider Width="150"
                                               Minimum="0"
                                               Maximum="100"
                                               Value="{Binding MicrophoneSensitivity}"/>
                                        <TextBlock Text="{Binding MicrophoneSensitivity, StringFormat='{}{0:F0}%'}"
                                                  Classes="Caption"
                                                  VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <Button Content="Test Microphone"
                                       Command="{Binding TestMicrophoneCommand}"
                                       HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <!-- Voice Commands List -->
                        <TextBlock Text="AVAILABLE COMMANDS" Classes="Caption" FontWeight="Bold" Margin="0,10,0,5"/>
                        <ScrollViewer MaxHeight="300">
                            <ItemsControl ItemsSource="{Binding VoiceCommands}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="GlassContainer" Padding="12" Margin="0,0,0,8">
                                            <Grid ColumnDefinitions="Auto, *, Auto">
                                                <TextBlock Grid.Column="0"
                                                          Text="🎤"
                                                          FontSize="20"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,12,0"/>
                                                <StackPanel Grid.Column="1" Spacing="3">
                                                    <TextBlock Text="{Binding Command}"
                                                              Classes="Body"
                                                              FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding Description}"
                                                              Classes="Caption"
                                                              Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                                <CheckBox Grid.Column="2"
                                                         IsChecked="{Binding IsEnabled}"
                                                         VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Text-to-Speech Settings -->
                        <TextBlock Text="TEXT-TO-SPEECH" Classes="Caption" FontWeight="Bold" Margin="0,10,0,5"/>
                        <Border Classes="GlassContainer" Padding="15">
                            <StackPanel Spacing="10">
                                <CheckBox Content="Enable Text-to-Speech" IsChecked="{Binding TtsEnabled}"/>

                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Text="Voice" Classes="Body"/>
                                    <ComboBox Grid.Column="1"
                                             Width="200"
                                             ItemsSource="{Binding AvailableVoices}"
                                             SelectedItem="{Binding SelectedVoice}"
                                             PlaceholderText="Select voice..."/>
                                </Grid>

                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Text="Speed" Classes="Body"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                        <Slider Width="150"
                                               Minimum="50"
                                               Maximum="200"
                                               Value="{Binding TtsSpeed}"/>
                                        <TextBlock Text="{Binding TtsSpeed, StringFormat='{}{0:F0}%'}"
                                                  Classes="Caption"
                                                  VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <Button Content="Test Voice"
                                       Command="{Binding TestTtsCommand}"
                                       HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Automation Tools Section -->
                <Border Classes="GlassContainer" Padding="20"
                       IsVisible="{Binding SelectedCategory.Id, Converter={StaticResource EqualToConverter}, ConverterParameter='Automation'}">
                    <StackPanel Spacing="15">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Text="🤖 AUTOMATION" Classes="Subtitle" FontWeight="Bold"/>
                            <Button Grid.Column="1"
                                   Content="+ Create Macro"
                                   Command="{Binding CreateMacroCommand}"/>
                        </Grid>

                        <!-- Macros List -->
                        <TextBlock Text="YOUR MACROS" Classes="Caption" FontWeight="Bold" Margin="0,10,0,5"/>
                        <ScrollViewer MaxHeight="400">
                            <ItemsControl ItemsSource="{Binding Macros}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="GlassContainer" Padding="15" Margin="0,0,0,10">
                                            <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                                                <TextBlock Grid.Column="0"
                                                          Text="⚡"
                                                          FontSize="24"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,15,0"/>

                                                <StackPanel Grid.Column="1" Spacing="5">
                                                    <TextBlock Text="{Binding Name}"
                                                              Classes="Body"
                                                              FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding Description}"
                                                              Classes="Caption"
                                                              Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <TextBlock Text="{Binding StepCount, StringFormat='{}Steps: {0}'}"
                                                                  Classes="Caption"/>
                                                        <TextBlock Text="{Binding Hotkey, StringFormat='{}Hotkey: {0}'}"
                                                                  Classes="Caption"
                                                                  Foreground="{StaticResource AccentBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="10,0">
                                                    <Button Content="▶ Run"
                                                           Command="{Binding RunCommand}"
                                                           Classes="Secondary"/>
                                                    <Button Content="✏️ Edit"
                                                           Command="{Binding EditCommand}"
                                                           Classes="Secondary"/>
                                                </StackPanel>

                                                <Button Grid.Column="3"
                                                       Content="🗑️"
                                                       Command="{Binding DeleteCommand}"
                                                       Classes="Danger"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Scheduled Tasks -->
                        <TextBlock Text="SCHEDULED TASKS" Classes="Caption" FontWeight="Bold" Margin="0,10,0,5"/>
                        <Border Classes="GlassContainer" Padding="15">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Text="Active Tasks" Classes="Body" FontWeight="Bold"/>
                                    <Button Grid.Column="1"
                                           Content="+ Add Task"
                                           Command="{Binding AddScheduledTaskCommand}"/>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding ScheduledTasks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#1a1a1a"
                                                   CornerRadius="6"
                                                   Padding="12"
                                                   Margin="0,5,0,0">
                                                <Grid ColumnDefinitions="Auto, *, Auto">
                                                    <CheckBox Grid.Column="0"
                                                             IsChecked="{Binding IsEnabled}"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,10,0"/>
                                                    <StackPanel Grid.Column="1" Spacing="3">
                                                        <TextBlock Text="{Binding Name}"
                                                                  Classes="Body"
                                                                  FontWeight="Bold"/>
                                                        <TextBlock Text="{Binding Schedule}"
                                                                  Classes="Caption"
                                                                  Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="2"
                                                           Content="⚙️"
                                                           Command="{Binding ConfigureCommand}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Workflow Builder -->
                        <TextBlock Text="WORKFLOWS" Classes="Caption" FontWeight="Bold" Margin="0,10,0,5"/>
                        <Border Classes="GlassContainer" Padding="15">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Build complex automation workflows by chaining multiple actions together."
                                          Classes="Caption"
                                          Foreground="{StaticResource TextSecondaryBrush}"
                                          TextWrapping="Wrap"/>

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="🔧 Workflow Builder"
                                           Command="{Binding OpenWorkflowBuilderCommand}"/>
                                    <Button Content="📋 Templates"
                                           Command="{Binding ViewWorkflowTemplatesCommand}"
                                           Classes="Secondary"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Cloud Tools Section -->
                <Border Classes="GlassContainer" Padding="20"
                       IsVisible="{Binding SelectedCategory.Id, Converter={StaticResource EqualToConverter}, ConverterParameter='Cloud'}">
                    <StackPanel Spacing="15">
                        <TextBlock Text="☁️ CLOUD SYNC" Classes="Subtitle" FontWeight="Bold"/>

                        <!-- Sync Status -->
                        <TextBlock Text="SYNC STATUS" Classes="Caption" FontWeight="Bold" Margin="0,10,0,5"/>
                        <Border Classes="GlassContainer" Padding="15">
                            <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="*, Auto">
                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="3">
                                    <TextBlock Text="Cloud Storage" Classes="Body" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding CloudProvider}"
                                              Classes="Caption"
                                              Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                          Text="{Binding CloudStatus}"
                                          Classes="Body"
                                          VerticalAlignment="Center"
                                          Foreground="{Binding CloudStatusColor}"/>

                                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="3" Margin="0,10,0,0">
                                    <TextBlock Text="Last Sync" Classes="Body"/>
                                    <TextBlock Text="{Binding LastSyncTime}"
                                              Classes="Caption"
                                              Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <Button Grid.Row="1" Grid.Column="1"
                                       Content="🔄 Sync Now"
                                       Command="{Binding SyncNowCommand}"
                                       VerticalAlignment="Center"
                                       IsEnabled="{Binding !IsSyncing}"/>

                                <ProgressBar Grid.Row="2" Grid.ColumnSpan="2"
                                            Value="{Binding SyncProgress}"
                                            Maximum="100"
                                            Height="8"
                                            Margin="0,10,0,0"
                                            IsVisible="{Binding IsSyncing}"/>
                            </Grid>
                        </Border>

                        <!-- Storage Usage -->
                        <TextBlock Text="STORAGE USAGE" Classes="Caption" FontWeight="Bold" Margin="0,10,0,5"/>
                        <Border Classes="GlassContainer" Padding="15">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Text="Used Space" Classes="Body"/>
                                    <TextBlock Grid.Column="1"
                                              Text="{Binding UsedSpace}"
                                              Classes="Body"
                                              FontWeight="Bold"/>
                                </Grid>

                                <ProgressBar Value="{Binding StorageUsagePercent}"
                                            Maximum="100"
                                            Height="12"/>

                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Text="Available" Classes="Caption" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1"
                                              Text="{Binding AvailableSpace}"
                                              Classes="Caption"
                                              Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Sync Settings -->
                        <TextBlock Text="SYNC SETTINGS" Classes="Caption" FontWeight="Bold" Margin="0,10,0,5"/>
                        <Border Classes="GlassContainer" Padding="15">
                            <StackPanel Spacing="10">
                                <CheckBox Content="Auto-sync on startup" IsChecked="{Binding AutoSyncOnStartup}"/>
                                <CheckBox Content="Sync save states" IsChecked="{Binding SyncSaveStates}"/>
                                <CheckBox Content="Sync screenshots" IsChecked="{Binding SyncScreenshots}"/>
                                <CheckBox Content="Sync game settings" IsChecked="{Binding SyncGameSettings}"/>
                                <CheckBox Content="Sync achievements" IsChecked="{Binding SyncAchievements}"/>

                                <Separator Margin="0,10"/>

                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Text="Sync Interval" Classes="Body"/>
                                    <ComboBox Grid.Column="1"
                                             Width="150"
                                             ItemsSource="{Binding SyncIntervals}"
                                             SelectedItem="{Binding SelectedSyncInterval}"
                                             PlaceholderText="Select..."/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Sync History -->
                        <TextBlock Text="RECENT SYNC ACTIVITY" Classes="Caption" FontWeight="Bold" Margin="0,10,0,5"/>
                        <ScrollViewer MaxHeight="250">
                            <ItemsControl ItemsSource="{Binding SyncHistory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1a1a1a"
                                               CornerRadius="6"
                                               Padding="12"
                                               Margin="0,0,0,8">
                                            <Grid ColumnDefinitions="Auto, *, Auto">
                                                <TextBlock Grid.Column="0"
                                                          Text="{Binding StatusIcon}"
                                                          FontSize="20"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,12,0"/>
                                                <StackPanel Grid.Column="1" Spacing="3">
                                                    <TextBlock Text="{Binding Action}"
                                                              Classes="Body"
                                                              FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding Details}"
                                                              Classes="Caption"
                                                              Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2"
                                                          Text="{Binding TimeAgo}"
                                                          Classes="Caption"
                                                          Foreground="{StaticResource TextSecondaryBrush}"
                                                          VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Cloud Provider Settings -->
                        <TextBlock Text="CLOUD PROVIDER" Classes="Caption" FontWeight="Bold" Margin="0,10,0,5"/>
                        <Border Classes="GlassContainer" Padding="15">
                            <StackPanel Spacing="10">
                                <ComboBox ItemsSource="{Binding AvailableProviders}"
                                         SelectedItem="{Binding SelectedProvider}"
                                         PlaceholderText="Select cloud provider..."
                                         HorizontalAlignment="Stretch"/>

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="🔗 Connect"
                                           Command="{Binding ConnectCloudCommand}"
                                           IsVisible="{Binding !IsCloudConnected}"/>
                                    <Button Content="🔓 Disconnect"
                                           Command="{Binding DisconnectCloudCommand}"
                                           IsVisible="{Binding IsCloudConnected}"
                                           Classes="Danger"/>
                                    <Button Content="⚙️ Configure"
                                           Command="{Binding ConfigureCloudCommand}"
                                           Classes="Secondary"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Diagnostics Section -->
                <Border Classes="GlassContainer" Padding="20"
                       IsVisible="{Binding SelectedCategory.Id, Converter={StaticResource EqualToConverter}, ConverterParameter='Diagnostics'}">
                    <StackPanel Spacing="15">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Text="🔍 DIAGNOSTICS" Classes="Subtitle" FontWeight="Bold"/>
                            <Button Grid.Column="1" Content="Run Health Check" Command="{Binding RunHealthCheckCommand}"/>
                        </Grid>

                        <!-- System Health -->
                        <TextBlock Text="SYSTEM HEALTH" Classes="Caption" FontWeight="Bold" Margin="0,10,0,5"/>
                        <Border Classes="GlassContainer" Padding="15">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Text="Database" Classes="Body"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DatabaseStatus}" Classes="Body"/>
                                </Grid>

                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Text="API Connections" Classes="Body"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ApiStatus}" Classes="Body"/>
                                </Grid>

                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Text="System Status" Classes="Body"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SystemStatus}" Classes="Body"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Database Info -->
                        <TextBlock Text="DATABASE INFO" Classes="Caption" FontWeight="Bold" Margin="0,10,0,5"/>
                        <Border Classes="GlassContainer" Padding="15">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Text="Total Games" Classes="Body"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TotalGames}" Classes="Body" FontWeight="Bold"/>
                                </Grid>

                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Text="Total Sessions" Classes="Body"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TotalSessions}" Classes="Body" FontWeight="Bold"/>
                                </Grid>

                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Text="Database Size" Classes="Body"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DatabaseSize}" Classes="Body" FontWeight="Bold"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Database Tools -->
                        <TextBlock Text="DATABASE TOOLS" Classes="Caption" FontWeight="Bold" Margin="0,10,0,5"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="Compact Database" Command="{Binding CompactDatabaseCommand}"/>
                            <Button Content="Clear Cache"/>
                            <Button Content="Backup Now"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Themes Section -->
                <Border Classes="GlassContainer" Padding="20"
                       IsVisible="{Binding SelectedCategory.Id, Converter={StaticResource EqualToConverter}, ConverterParameter='Themes'}">
                    <StackPanel Spacing="15">
                        <TextBlock Text="🎨 THEMES" Classes="Subtitle" FontWeight="Bold"/>

                        <TextBlock Text="CURRENT THEME" Classes="Caption" FontWeight="Bold" Margin="0,10,0,5"/>
                        <Border Classes="GlassContainer" Padding="15">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="{Binding CurrentTheme}" Classes="Body" FontSize="16" FontWeight="Bold"/>
                                <Button Grid.Column="1" Content="Edit"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="AVAILABLE THEMES" Classes="Caption" FontWeight="Bold" Margin="0,10,0,5"/>
                        <ItemsControl ItemsSource="{Binding AvailableThemes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="GlassContainer" Padding="15" Margin="0,0,0,10">
                                        <Grid ColumnDefinitions="Auto, *, Auto">
                                            <TextBlock Text="🎨" FontSize="24" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding}" Classes="Body" VerticalAlignment="Center"/>
                                            <Button Grid.Column="2"
                                                   Content="Apply"
                                                   Command="{Binding $parent[UserControl].DataContext.ApplyThemeCommand}"
                                                   CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
