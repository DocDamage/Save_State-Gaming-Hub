<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SaveState.Presentation.ViewModels.Shell"
             x:Class="SaveState.Presentation.Views.Shell.TitleBarView"
             x:DataType="vm:TitleBarViewModel"
             Height="32">

    <UserControl.Styles>
        <Style Selector="Button.title-button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TitleBarForegroundBrush}" />
        </Style>

        <Style Selector="Button.title-button:hover">
            <Setter Property="Background" Value="{StaticResource TitleBarHoverBrush}" />
        </Style>

        <Style Selector="Button.title-button:pointerover">
            <Setter Property="Background" Value="{StaticResource TitleBarHoverBrush}" />
        </Style>

        <Style Selector="Button.close-button:hover">
            <Setter Property="Background" Value="#E81123" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="Auto, *, Auto, Auto, Auto">
        <!-- Logo and App Info -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="🎮"
                      FontSize="16"
                      VerticalAlignment="Center"
                      Margin="0,0,8,0" />
            <TextBlock Text="{Binding AppName}"
                      FontSize="13"
                      FontWeight="SemiBold"
                      VerticalAlignment="Center" />
            <TextBlock Text="{Binding Version, StringFormat=' v{0}'}"
                      FontSize="11"
                      Foreground="{StaticResource TitleBarSecondaryBrush}"
                      VerticalAlignment="Center"
                      Margin="4,0,0,0" />
        </StackPanel>

        <!-- Drag Region -->
        <Border Grid.Column="1"
                Background="Transparent"
                PointerPressed="OnDragRegionPressed" />

        <!-- Minimize Button -->
        <Button Grid.Column="2"
                Classes="title-button"
                Content="─"
                Command="{Binding MinimizeCommand}"
                ToolTip.Tip="Minimize (Win+Down)" />

        <!-- Maximize Button -->
        <Button Grid.Column="3"
                Classes="title-button"
                Content="□"
                Command="{Binding MaximizeCommand}"
                ToolTip.Tip="Maximize (Win+Up)" />

        <!-- Close Button -->
        <Button Grid.Column="4"
                Classes="title-button close-button"
                Content="✕"
                Command="{Binding CloseCommand}"
                ToolTip.Tip="Close (Alt+F4)" />
    </Grid>
</UserControl>