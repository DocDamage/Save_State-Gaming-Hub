<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SaveState.Presentation.ViewModels.Shell"
             x:Class="SaveState.Presentation.Views.Shell.Overlays.CommandPaletteView"
             x:DataType="vm:CommandPaletteViewModel">

    <UserControl.Styles>
        <Style Selector="TextBox.search">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="ListBox.commands">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="16" />
            <Setter Property="Height" Value="40" />
        </Style>

        <Style Selector="ListBoxItem.selected">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, *">
        <!-- Search Input -->
        <TextBox Grid.Row="0"
                 Classes="search"
                 Text="{Binding SearchText}"
                 Watermark="Type a command..."
                 KeyDown="OnKeyDown" />

        <!-- Commands List -->
        <ListBox Grid.Row="1"
                 Classes="commands"
                 ItemsSource="{Binding FilteredCommands}"
                 SelectedIndex="{Binding SelectedIndex}"
                 IsVisible="{Binding HasCommands}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Vertical" Spacing="2">
                        <TextBlock Text="{Binding Name}"
                                 FontWeight="SemiBold"
                                 FontSize="14" />
                        <TextBlock Text="{Binding Description}"
                                 FontSize="12"
                                 Opacity="0.7" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- No Results -->
        <TextBlock Grid.Row="1"
                  Text="No commands found"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  IsVisible="{Binding !HasCommands}"
                  Opacity="0.5" />
    </Grid>
</UserControl>