<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SaveState.Presentation.ViewModels.Shell"
             x:Class="SaveState.Presentation.Views.Shell.Overlays.VoiceIndicator"
             x:DataType="vm:VoiceIndicatorViewModel">

    <Border Background="{StaticResource VoiceIndicatorBackgroundBrush}"
            CornerRadius="20"
            Padding="16">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="🎤"
                     FontSize="16" />
            <TextBlock Text="{Binding StatusText}"
                     FontSize="14"
                     VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>