<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SaveState.Presentation.ViewModels.Shell.Mugen"
             x:Class="SaveState.Presentation.Views.Shell.Mugen.TournamentBracketView"
             x:DataType="vm:TournamentBracketViewModel">

  <!-- 
    PERFORMANCE OPTIMIZATION NOTES:
    - Uses ListBox for efficient rendering of large tournaments
    - Nested ItemsControls optimized for typical bracket sizes
  -->

  <Grid RowDefinitions="Auto, *">
    <!-- Tournament Header -->
    <Border Grid.Row="0" Classes="GlassContainer" Margin="10" Padding="15">
      <Grid ColumnDefinitions="*, Auto">
        <StackPanel>
          <TextBlock Text="{Binding TournamentName, Mode=OneTime}" FontSize="24" FontWeight="Bold" />
          <TextBlock Text="{Binding Status, Mode=OneTime}" Classes="Subtitle" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Bracket Area - Virtualized for performance -->
    <ScrollViewer Grid.Row="1" 
                  HorizontalScrollBarVisibility="Auto" 
                  VerticalScrollBarVisibility="Auto">
      <ListBox ItemsSource="{Binding Rounds, Mode=OneWay}" 
               Margin="20"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.VerticalScrollBarVisibility="Disabled"
               Background="Transparent"
               BorderThickness="0">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="40" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemContainerTheme>
          <ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
          </ControlTheme>
        </ListBox.ItemContainerTheme>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Spacing="20">
              <!-- Round Header -->
              <TextBlock Text="{Binding RoundName, Mode=OneTime}"
                         HorizontalAlignment="Center"
                         FontWeight="Bold"
                         FontSize="16"
                         Foreground="{StaticResource AccentBrush}" />

              <!-- Matches in Round - ItemsControl OK for small match counts -->
              <ItemsControl ItemsSource="{Binding Matches, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="GlassContainer"
                            Padding="10"
                            Margin="0,0,0,15"
                            Width="180"
                            BorderThickness="1"
                            BorderBrush="{Binding IsComplete, Converter={StaticResource BoolToAccentBrushConverter}, Mode=OneWay}">
                      <StackPanel Spacing="5">
                        <!-- Player 1 -->
                        <Grid ColumnDefinitions="*, Auto">
                          <TextBlock Text="{Binding Player1Name, Mode=OneTime}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="1" Text="🏆" IsVisible="{Binding Result, Converter={StaticResource StringContainsConverter}, ConverterParameter=P1, Mode=OneWay}" />
                        </Grid>

                        <Separator Background="#333" Height="1" Margin="0,2" />

                        <!-- Player 2 -->
                        <Grid ColumnDefinitions="*, Auto">
                          <TextBlock Text="{Binding Player2Name, Mode=OneTime}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="1" Text="🏆" IsVisible="{Binding Result, Converter={StaticResource StringContainsConverter}, ConverterParameter=P2, Mode=OneWay}" />
                        </Grid>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </ScrollViewer>
  </Grid>
</UserControl>
