<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SaveState.Presentation.ViewModels.Shell.Mugen"
             x:Class="SaveState.Presentation.Views.Shell.Mugen.TournamentBracketView"
             x:DataType="vm:TournamentBracketViewModel">

    <Grid RowDefinitions="Auto, *">
        <!-- Tournament Header -->
        <Border Grid.Row="0" Classes="GlassContainer" Margin="10" Padding="15">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel>
                    <TextBlock Text="{Binding TournamentName}" FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="{Binding Status}" Classes="Subtitle" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Bracket Area -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rounds}" Margin="20">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="40" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Spacing="20">
                            <!-- Round Header -->
                            <TextBlock Text="{Binding RoundName}"
                                       HorizontalAlignment="Center"
                                       FontWeight="Bold"
                                       FontSize="16"
                                       Foreground="{StaticResource AccentBrush}" />

                            <!-- Matches in Round -->
                            <ItemsControl ItemsSource="{Binding Matches}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="GlassContainer"
                                                Padding="10"
                                                Margin="0,0,0,15"
                                                Width="180"
                                                BorderThickness="1"
                                                BorderBrush="{Binding IsComplete, Converter={StaticResource BoolToAccentBrushConverter}}">
                                            <StackPanel Spacing="5">
                                                <!-- Player 1 -->
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <TextBlock Text="{Binding Player1Name}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="🏆" IsVisible="{Binding Result, Converter={StaticResource StringContainsConverter}, ConverterParameter=P1}" />
                                                </Grid>

                                                <Separator Background="#333" Height="1" Margin="0,2" />

                                                <!-- Player 2 -->
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <TextBlock Text="{Binding Player2Name}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="🏆" IsVisible="{Binding Result, Converter={StaticResource StringContainsConverter}, ConverterParameter=P2}" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
