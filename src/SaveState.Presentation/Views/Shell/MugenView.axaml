<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SaveState.Presentation.ViewModels.Shell;assembly=SaveState.Presentation"
             xmlns:vmSections="clr-namespace:SaveState.Presentation.ViewModels.Shell.Mugen;assembly=SaveState.Presentation"
             xmlns:sections="clr-namespace:SaveState.Presentation.Views.Mugen.Sections;assembly=SaveState.Presentation"
             xmlns:shellViews="clr-namespace:SaveState.Presentation.Views.Shell;assembly=SaveState.Presentation"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="SaveState.Presentation.Views.Shell.MugenView"
             x:DataType="vm:MugenViewModel"
             x:Name="MugenRoot">

    <UserControl.DataTemplates>
        <DataTemplate DataType="{x:Type vmSections:MugenHubSectionAdapter}">
            <shellViews:MugenHubView DataContext="{Binding Hub}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmSections:MugenRosterViewModel}">
            <sections:RosterSection />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmSections:MugenDeathBattleViewModel}">
            <sections:DeathBattleSection />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmSections:MugenTournamentViewModel}">
            <sections:TournamentSection />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmSections:MugenStatsViewModel}">
            <sections:StatsSection />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmSections:MugenTrainingViewModel}">
            <sections:TrainingSection />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmSections:MugenReplayViewModel}">
            <sections:ReplaySection />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmSections:MugenCoachViewModel}">
            <sections:CoachSection />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmSections:MugenFusionViewModel}">
            <sections:FusionSection />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmSections:MugenEngineModsViewModel}">
            <sections:EngineModsSection />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmSections:MugenDownloadsViewModel}">
            <sections:DownloadsSection />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmSections:MoveCreationViewModel}">
            <sections:MoveCreationView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmSections:MachineLearningViewModel}">
            <sections:MachineLearningView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmSections:MugenSectionViewModelBase}">
            <sections:GenericMugenSection />
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid RowDefinitions="Auto, Auto, *, Auto">
        <!-- SF Style Header -->
        <Border Grid.Row="0" Background="{StaticResource SFFireGradientBrush}" Height="80">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <Button Command="{Binding GoBackCommand}"
                        Background="Transparent" BorderThickness="0"
                        Margin="20,0">
                    <TextBlock Text="⬅ BACK" FontSize="20" FontWeight="Black" Foreground="White" />
                </Button>

                <TextBlock Grid.Column="1" Text="MUGEN BATTLE HUB"
                           FontSize="42" FontWeight="Black"
                           Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderTransform="skewX(-10deg)">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="10" Color="Black" OffsetX="3" OffsetY="3" />
                    </TextBlock.Effect>
                </TextBlock>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="20,0" Spacing="10">
                    <!-- Global Actions if any -->
                </StackPanel>
            </Grid>
        </Border>

        <!-- Player Selection Bar (Shared across sections) -->
        <Border Grid.Row="1" Background="{StaticResource GlassBrush}" Height="140" Margin="10,0,10,10">
            <Grid ColumnDefinitions="*, Auto, *">
                <Border Grid.Column="0" Margin="10" BorderBrush="{StaticResource FightingRedBrush}" BorderThickness="3" CornerRadius="8">
                    <Grid>
                        <TextBlock Text="P1" HorizontalAlignment="Left" VerticalAlignment="Top"
                                   Margin="5" FontWeight="Black" Foreground="{StaticResource FightingRedBrush}" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Player1.Name, FallbackValue='SELECT CHARACTER'}"
                                       FontSize="24" FontWeight="Black" Foreground="White" TextAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Grid.Column="1" Text="VS" FontSize="48" FontWeight="Black"
                           Foreground="{StaticResource FightingYellowBrush}"
                           VerticalAlignment="Center" Margin="20,0"
                           RenderTransform="scale(1.1) skewX(-15deg)" />

                <Border Grid.Column="2" Margin="10" BorderBrush="#00BCD4" BorderThickness="3" CornerRadius="8">
                    <Grid>
                        <TextBlock Text="P2" HorizontalAlignment="Right" VerticalAlignment="Top"
                                   Margin="5" FontWeight="Black" Foreground="#00BCD4" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Player2.Name, FallbackValue='SELECT CHARACTER'}"
                                       FontSize="24" FontWeight="Black" Foreground="White" TextAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content with Sidebar -->
        <Grid Grid.Row="2" ColumnDefinitions="220, *">
            <!-- Navigation Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer>
                    <StackPanel Spacing="5" Margin="10">
                        <RadioButton Classes="NavButton" Content="🏠 HUB"
                                     Command="{Binding SetSectionCommand}" CommandParameter="Hub"
                                     IsChecked="True" />
                        <RadioButton Classes="NavButton" Content="🎮 ROSTER"
                                     Command="{Binding SetSectionCommand}" CommandParameter="Roster" />
                        <RadioButton Classes="NavButton" Content="📥 DOWNLOADS"
                                     Command="{Binding SetSectionCommand}" CommandParameter="Downloads" />
                        <RadioButton Classes="NavButton" Content="💀 DEATH BATTLE"
                                     Command="{Binding SetSectionCommand}" CommandParameter="DeathBattle" />
                        <RadioButton Classes="NavButton" Content="🥋 TRAINING"
                                     Command="{Binding SetSectionCommand}" CommandParameter="Training" />
                        <RadioButton Classes="NavButton" Content="🏆 TOURNAMENT"
                                     Command="{Binding SetSectionCommand}" CommandParameter="Tournament" />
                        <RadioButton Classes="NavButton" Content="🎬 REPLAYS"
                                     Command="{Binding SetSectionCommand}" CommandParameter="Replays" />
                        <RadioButton Classes="NavButton" Content="📊 STATS"
                                     Command="{Binding SetSectionCommand}" CommandParameter="Stats" />
                        <RadioButton Classes="NavButton" Content="🎓 COACH"
                                     Command="{Binding SetSectionCommand}" CommandParameter="Coach" />
                        <RadioButton Classes="NavButton" Content="🧬 FUSION"
                                     Command="{Binding SetSectionCommand}" CommandParameter="Fusion" />
                        <RadioButton Classes="NavButton" Content="🛠️ ENGINE MODS"
                                     Command="{Binding SetSectionCommand}" CommandParameter="EngineMods" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Dynamic Section Content -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentSection}" />
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" Height="40" Padding="15,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*, Auto">
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                <ProgressBar Grid.Column="1" IsIndeterminate="True" Width="200" Height="4" IsVisible="{Binding IsLoading}" />
            </Grid>
        </Border>
    </Grid>

    <UserControl.Styles>
        <Style Selector="RadioButton.NavButton">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Highlight" Background="Transparent" Padding="15,12" CornerRadius="4" Margin="0,2">
                        <ContentPresenter Content="{TemplateBinding Content}" FontWeight="Bold" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.NavButton:pointerover /template/ Border#Highlight">
            <Setter Property="Background" Value="#33FFFFFF" />
        </Style>
        <Style Selector="RadioButton.NavButton:checked /template/ Border#Highlight">
            <Setter Property="Background" Value="{StaticResource FightingRedBrush}" />
            <Setter Property="TextBlock.Foreground" Value="White" />
        </Style>
    </UserControl.Styles>
</UserControl>
