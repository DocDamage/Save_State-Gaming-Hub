<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SaveState.Presentation.ViewModels.Shell"
             x:Class="SaveState.Presentation.Views.Shell.SocialView"
             x:DataType="vm:SocialViewModel">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="👥" FontSize="64" HorizontalAlignment="Center" />
            <TextBlock Text="Social Hub" FontSize="24" FontWeight="Bold" Margin="0,20" />
            <TextBlock Text="Activity feed and friend management coming soon." Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>
    </Grid>
</UserControl>
