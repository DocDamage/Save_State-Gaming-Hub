root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.cs]
# Code quality rules
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_predefined_type_for_member_access = true:warning

# Complexity limits (ENFORCED)
max_lines_per_file = 200:error
dotnet_diagnostic.CA1502.severity = error
dotnet_diagnostic.CA1505.severity = error
dotnet_diagnostic.CA1822.severity = error
dotnet_diagnostic.CA2007.severity = error

# Naming conventions
dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_rule.public_members_must_be_capitalized.severity = error
dotnet_naming_rule.public_members_must_be_capitalized.symbols = public_symbols
dotnet_naming_rule.public_members_must_be_capitalized.style = pascal_case
dotnet_naming_symbols.public_symbols.applicable_kinds = property,method,field,event,delegate
dotnet_naming_symbols.public_symbols.applicable_accessibilities = public,internal

# Suppress test-specific warnings globally for test projects
[**/tests/**/*.cs]
# CA1707: Test method names with underscores are standard practice
dotnet_diagnostic.CA1707.severity = none

[**/*Tests*/**/*.cs]
# CA1707: Test method names with underscores are standard practice
dotnet_diagnostic.CA1707.severity = none

[**/*.Tests.cs]
# CA1707: Test method names with underscores are standard practice
dotnet_diagnostic.CA1707.severity = none

# Heuristic files - cyclomatic complexity is intentional for pattern matching
[src/SaveState.Infrastructure/GameLibrary/Heuristics/**/*.cs]
# CA1502: Cyclomatic complexity - heuristics need complex pattern matching to detect game values
# Per AGENTS.md: "Cyclomatic complexity >15 - 46 warnings accepted as algorithmic code"
dotnet_diagnostic.CA1502.severity = none

# Performance warnings that are acceptable for non-hot-path code
[*.cs]
# CA1848: LoggerMessage delegates - being addressed progressively (750/2178 done)
dotnet_diagnostic.CA1848.severity = suggestion

# CA1305: Culture-specific formatting - acceptable for internal debugging/logging
dotnet_diagnostic.CA1305.severity = suggestion

# CA1725: Parameter name mismatches - often intentional for brevity (ct vs cancellationToken)
dotnet_diagnostic.CA1725.severity = suggestion

# CA1861: Constant array arguments - micro-optimization, not worth code complexity
dotnet_diagnostic.CA1861.severity = suggestion

# CA1860: Prefer Count to Any() - micro-optimization
dotnet_diagnostic.CA1860.severity = suggestion

# CA1805: Explicitly initialized to default - improves code clarity
dotnet_diagnostic.CA1805.severity = none

# Naming conventions that conflict with established patterns
# CA1711: Type names ending with known suffixes (Collection, EventArgs, Permission, etc.)
dotnet_diagnostic.CA1711.severity = suggestion

# CA1716: Reserved keywords in other languages (Friend, Mod, Set, Date, End, etc.)
dotnet_diagnostic.CA1716.severity = suggestion

# Platform-specific warnings - acceptable for Windows-focused features
# CA1416: Platform compatibility (Registry, System.Drawing, etc.)
dotnet_diagnostic.CA1416.severity = suggestion

# Globalization warnings - acceptable for internal tools
# CA1310: StringComparison for correctness
dotnet_diagnostic.CA1310.severity = suggestion

# CA1304: Specify CultureInfo
dotnet_diagnostic.CA1304.severity = suggestion

# CA1311: Specify culture or use invariant
dotnet_diagnostic.CA1311.severity = suggestion

# String optimization warnings - micro-optimizations
# CA1852: Seal internal types
dotnet_diagnostic.CA1852.severity = suggestion

# CA1859: Use concrete types when possible
dotnet_diagnostic.CA1859.severity = suggestion

# CA1866: Use char overload instead of string
dotnet_diagnostic.CA1866.severity = suggestion

# CA1869: Cache JsonSerializerOptions
dotnet_diagnostic.CA1869.severity = suggestion

# Async/dispose patterns
# CA2016: Forward CancellationToken parameter
dotnet_diagnostic.CA2016.severity = suggestion

# CA1816: Dispose should call SuppressFinalize
dotnet_diagnostic.CA1816.severity = suggestion

# Collection usage
# CA1826: Use property instead of Enumerable method
dotnet_diagnostic.CA1826.severity = suggestion

# CA1862: Use StringComparison overload
dotnet_diagnostic.CA1862.severity = suggestion

# CA1510: Use ArgumentNullException.ThrowIfNull
dotnet_diagnostic.CA1510.severity = suggestion

# Disposal
# CA1001: Types that own disposable fields should be disposable
dotnet_diagnostic.CA1001.severity = suggestion

# CA2201: Do not raise reserved exception types
dotnet_diagnostic.CA2201.severity = suggestion

# CA1707: Identifiers should not contain underscores
# Resources use underscore naming convention for localization keys
dotnet_diagnostic.CA1707.severity = suggestion

# CA1854: Prefer Dictionary.TryGetValue - micro-optimization
dotnet_diagnostic.CA1854.severity = suggestion

# CA1868: Unnecessary call to Contains - micro-optimization
dotnet_diagnostic.CA1868.severity = suggestion

# CA1845: Use Span<char>.CopyTo instead - micro-optimization
dotnet_diagnostic.CA1845.severity = suggestion

# CA1051: Do not declare visible instance fields - acceptable for record properties
dotnet_diagnostic.CA1051.severity = suggestion

# Async method warnings
# CS1998: Async method lacks await - often valid for interface implementation
dotnet_diagnostic.CS1998.severity = suggestion

# CS4014: Fire-and-forget call not awaited - often intentional for background tasks
dotnet_diagnostic.CS4014.severity = suggestion

# Nullability warnings - progressive adoption
# CS8602: Dereference of a possibly null reference
dotnet_diagnostic.CS8602.severity = suggestion

# CS8604: Possible null reference argument
dotnet_diagnostic.CS8604.severity = suggestion

# CS8601: Possible null reference assignment
dotnet_diagnostic.CS8601.severity = suggestion

# CS8618: Non-nullable field must contain a non-null value when exiting constructor
dotnet_diagnostic.CS8618.severity = suggestion

# CS8603: Possible null reference return
dotnet_diagnostic.CS8603.severity = suggestion

# CS8620: Argument cannot be used for parameter due to differences in nullability
dotnet_diagnostic.CS8620.severity = suggestion

# CS8625: Cannot convert null literal to non-nullable reference type
dotnet_diagnostic.CS8625.severity = suggestion

# CS8600: Converting null literal or possible null value to non-nullable type
dotnet_diagnostic.CS8600.severity = suggestion

# CS8629: Nullable value type may be null
dotnet_diagnostic.CS8629.severity = suggestion

# CS8633: Nullability in constraints for type parameter doesn't match the constraints for type parameter in implicitly implemented interface method
dotnet_diagnostic.CS8633.severity = suggestion

# Other CS warnings
# CS0067: Event is never used
dotnet_diagnostic.CS0067.severity = suggestion

# CS0114: Member hides inherited member
dotnet_diagnostic.CS0114.severity = suggestion

# CS0169: Field is never used
dotnet_diagnostic.CS0169.severity = suggestion

# CS0105: Using directive appeared previously
dotnet_diagnostic.CS0105.severity = suggestion

# CS1571: XML comment has duplicate param tag
dotnet_diagnostic.CS1571.severity = suggestion

# CS0219: Variable is assigned but never used
dotnet_diagnostic.CS0219.severity = suggestion

# CS0618: Type or member is obsolete
dotnet_diagnostic.CS0618.severity = suggestion

# CS8609: Nullability of reference types in return type doesn't match overridden member
dotnet_diagnostic.CS8609.severity = suggestion

# CS0168: Variable is declared but never used
dotnet_diagnostic.CS0168.severity = suggestion

# CS0162: Unreachable code detected
dotnet_diagnostic.CS0162.severity = suggestion

# CS8767: Nullability of reference types in type of parameter doesn't match implicitly implemented member
dotnet_diagnostic.CS8767.severity = suggestion

# CS1570: XML comment has badly formed XML
dotnet_diagnostic.CS1570.severity = suggestion

# Additional CA warnings
# CA1715: Identifiers should have correct prefix
dotnet_diagnostic.CA1715.severity = suggestion

# CA1720: Identifier contains type name
dotnet_diagnostic.CA1720.severity = suggestion

# CA1847: Use string.Contains(char) instead of string.Contains(string)
dotnet_diagnostic.CA1847.severity = suggestion

# CA1825: Avoid zero-length array allocations
dotnet_diagnostic.CA1825.severity = suggestion

# CA1835: Prefer the memory-based overloads for ReadAsync and WriteAsync
dotnet_diagnostic.CA1835.severity = suggestion

# CA2020: Prevent behavioral change caused by built-in operators
dotnet_diagnostic.CA2020.severity = suggestion

# CA2263: Prefer generic overload when type is known
dotnet_diagnostic.CA2263.severity = suggestion

# CA2254: Template should be a static expression
dotnet_diagnostic.CA2254.severity = suggestion

# CA1865: Use char overload
dotnet_diagnostic.CA1865.severity = suggestion

# CA1850: Prefer static HashData method over ComputeHash
dotnet_diagnostic.CA1850.severity = suggestion

# CA1829: Use Length/Count property instead of Count() when available
dotnet_diagnostic.CA1829.severity = suggestion

# CA2012: Use ValueTasks correctly
dotnet_diagnostic.CA2012.severity = suggestion

# CA2101: Specify marshaling for P/Invoke string arguments
dotnet_diagnostic.CA2101.severity = suggestion

# CA2208: Instantiate argument exceptions correctly
dotnet_diagnostic.CA2208.severity = suggestion

# CA1872: Prefer 'Convert.ToHexString' and 'Convert.ToHexStringLower' over call chains based on 'BitConverter.ToString'
dotnet_diagnostic.CA1872.severity = suggestion

# CA1050: Declare types in namespaces
dotnet_diagnostic.CA1050.severity = suggestion
