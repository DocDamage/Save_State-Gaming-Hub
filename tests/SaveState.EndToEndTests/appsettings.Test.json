{
    "ConnectionStrings": {
        "DefaultConnection": "DataSource=savestate_test.db;Cache=Shared"
    },
    "Database": {
        "ConnectionString": "DataSource=savestate_test.db;Cache=Shared",
        "CommandTimeoutSeconds": 60,
        "MaxRetryCount": 5
    },
    "OpenAi": {
        "ApiKey": "test-key",
        "BaseUrl": "https://api.openai.com/v1/",
        "DefaultModel": "gpt-4",
        "MaxTokens": 2048,
        "Temperature": 0.7
    },
    "Groq": {
        "ApiKey": "test-key-groq",
        "BaseUrl": "https://api.groq.com/v1/",
        "DefaultModel": "mixtral-8x7b-32768"
    },
    "Steam": {
        "ApiKey": "test-steam-key",
        "SteamId": "123456789"
    },
    "Gog": {
        "Username": "test-user",
        "Password": "test-password"
    },
    "Epic": {
        "AccountId": "test-account",
        "AuthToken": "test-token"
    },
    "Igdb": {
        "ClientId": "test-client",
        "ClientSecret": "test-secret"
    },
    "SteamGridDB": {
        "ApiKey": "test-sgdb-key",
        "BaseUrl": "https://www.steamgriddb.com/api/v2/",
        "MaxConcurrentRequests": 4,
        "CacheDurationHours": 24
    },
    "Resilience": {
        "CircuitBreakerThreshold": 5,
        "CircuitBreakerDurationMs": 30000,
        "MaxRetries": 3,
        "InitialRetryDelayMs": 1000,
        "RetryBackoffMultiplier": 2.0,
        "DefaultTimeoutMs": 30000
    },
    "Memory": {
        "MaxShortTermItems": 100,
        "MaxLongTermItems": 1000,
        "ShortTermCleanupThreshold": 0.9
    },
    "Application": {
        "Version": "1.0.0-test",
        "Environment": "Testing"
    },
    "Launch": {
        "EnableImmersiveFeatures": true,
        "AutoOptimizationEnabled": true
    },
    "CheatDetection": {
        "Enabled": false
    },
    "RateLimiting": {
        "RequestsPerMinute": 100,
        "BurstSize": 20
    },
    "Jwt": {
        "Secret": "test-secret-must-be-long-enough-for-hs256",
        "Issuer": "SaveState",
        "Audience": "SaveStateTests",
        "ExpirationMinutes": 60
    }
}
